import "std/io.diva"

func main(): int {
    var a: tensor<int, 4> = tensor_fill(2, 4)
    var b: tensor<int, 4> = tensor_fill(3, 4)
    var c: tensor<int, 4> = tensor_add(a, b)
    print_int(tensor_get(c, 0))
    print_int(tensor_get(c, 3))
    print_int(tensor_dot(a, b))
    var m: tensor<int, 2, 3> = tensor_new(2, 3)
    tensor_set(m, 0, 0, 1)
    tensor_set(m, 0, 1, 2)
    tensor_set(m, 0, 2, 3)
    tensor_set(m, 1, 0, 4)
    tensor_set(m, 1, 1, 5)
    tensor_set(m, 1, 2, 6)
    var n: tensor<int, 3, 2> = tensor_new(3, 2)
    tensor_set(n, 0, 0, 7)
    tensor_set(n, 0, 1, 8)
    tensor_set(n, 1, 0, 9)
    tensor_set(n, 1, 1, 10)
    tensor_set(n, 2, 0, 11)
    tensor_set(n, 2, 1, 12)
    var p: tensor<int, 2, 2> = tensor_matmul(m, n)
    print_int(tensor_get(p, 0, 0))
    print_int(tensor_get(p, 0, 1))
    print_int(tensor_get(p, 1, 0))
    print_int(tensor_get(p, 1, 1))
    return 0
}
