import "std/io.diva"

func sum(s: [int]): int {
    var i = 0
    var total = 0
    while i < s.len {
        total = total + s[i]
        i = i + 1
    }
    return total
}

func main(): int {
    var xs: [int] = [10, 20, 30, 40]
    print_int(xs.len)
    print_int(xs[0])
    print_int(xs[2])
    print_int(sum(xs))
    return 0
}
