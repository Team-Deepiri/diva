// #96: an unannotated struct binding keeps its struct type, so field access
// and mutation work without an explicit annotation. (Struct assignment is a
// move under #88, so the source is not read after the move.)
extern func print_int(x: int): void

struct Point {
    var x: int
    var y: int
}

func main(): int {
    let p = Point { x: 20, y: 22 }
    let q = p
    q.x = 1
    print_int(q.x)
    return q.x + q.y
}
