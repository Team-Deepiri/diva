struct Point {
    var x: int
    var y: int
}

func main(): int {
    let p: Point = Point { x: 5, y: 7 }
    let q: Point = p
    // Issue #88: `p` is moved into `q`; reassignment revives it so this case
    // still checks that the two bindings have independent field storage.
    p = Point { x: 5, y: 7 }
    q.x = 30
    return p.x * 8 + q.x + q.y
}
