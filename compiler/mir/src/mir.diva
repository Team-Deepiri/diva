// Diva MIR (Mid-level IR) layer — bridges typed AST and backend codegen.
// The real IR definitions live in compiler/src/ir.diva.
// This package provides the MIR abstraction boundary for the compiler pipeline.

import "std/vec.diva"

class MirBlock {
    id: int
}

class MirFn {
    name: str
    entry_block: int
}

func mir_layer_version(): int {
    return 2
}

func mir_pipeline_stage(): str {
    return "Diva source -> tokens -> AST -> Diva IR -> x86_64 asm -> native"
}
