// `diva text` — inspect and transform text from the CLI (Issue #189).
//
// Implemented over `str` (byte + NUL-terminated) rather than the native `text`
// value type so the compiler driver keeps its seed-bootstrap property: the
// pinned bootstrap seed predates `text"..."` syntax and must still be able to
// build the compiler. UTF-8 awareness is therefore done inline here (codepoint
// decoding, display width) instead of importing std/text.diva.
import "std/host.diva"
import "std/io.diva"
import "std/str.diva"
import "std/vec.diva"

func ct_utf8_seq_len(b: int): int {
    if b <= 127 { return 1 }
    if (b >= 194) & (b <= 223) { return 2 }
    if (b >= 224) & (b <= 239) { return 3 }
    if (b >= 240) & (b <= 244) { return 4 }
    return 1
}

// Decode one codepoint at byte offset `off`; returns cp, or -1 when invalid.
func ct_utf8_cp(s: str, off: int, n: int): int {
    if off >= n { return 0 - 1 }
    var b0 = str_byte(s, off)
    if b0 <= 127 { return b0 }
    var need = ct_utf8_seq_len(b0)
    if (need == 1) | (off + need > n) { return 0 - 1 }
    if need == 2 {
        var b1 = str_byte(s, off + 1)
        if (b1 < 128) | (b1 > 191) { return 0 - 1 }
        return (b0 - 194) * 64 + (b1 - 128) + 128
    }
    if need == 3 {
        var c1 = str_byte(s, off + 1)
        var c2 = str_byte(s, off + 2)
        if (c1 < 128) | (c1 > 191) { return 0 - 1 }
        if (c2 < 128) | (c2 > 191) { return 0 - 1 }
        return (b0 - 224) * 4096 + (c1 - 128) * 64 + (c2 - 128) + 2048
    }
    var d1 = str_byte(s, off + 1)
    var d2 = str_byte(s, off + 2)
    var d3 = str_byte(s, off + 3)
    if (d1 < 128) | (d1 > 191) { return 0 - 1 }
    if (d2 < 128) | (d2 > 191) { return 0 - 1 }
    if (d3 < 128) | (d3 > 191) { return 0 - 1 }
    return (b0 - 240) * 262144 + (d1 - 128) * 4096 + (d2 - 128) * 64 + (d3 - 128) + 65536
}

func ct_is_wide(cp: int): int {
    if (cp >= 4352) & (cp <= 4447) { return 1 }
    if (cp >= 11904) & (cp <= 42191) { return 1 }
    if (cp >= 44032) & (cp <= 55203) { return 1 }
    if (cp >= 65280) & (cp <= 65519) { return 1 }
    if (cp >= 127744) & (cp <= 129791) { return 1 }
    return 0
}

func ct_is_ws(b: int): int {
    if (b == 32) | (b == 9) | (b == 10) | (b == 13) { return 1 }
    return 0
}

func ct_cp_count(s: str, n: int): int {
    var i = 0
    var c = 0
    while i < n {
        var cp = ct_utf8_cp(s, i, n)
        if cp < 0 { i = i + 1 } else { i = i + ct_utf8_seq_len(str_byte(s, i)) }
        c = c + 1
    }
    return c
}

func ct_line_count(s: str, n: int): int {
    if n == 0 { return 0 }
    var i = 0
    var c = 1
    while i < n {
        if str_byte(s, i) == 10 { c = c + 1 }
        i = i + 1
    }
    return c
}

func ct_word_count(s: str, n: int): int {
    var i = 0
    var c = 0
    var inw = 0
    while i < n {
        var b = str_byte(s, i)
        if ct_is_ws(b) == 1 { inw = 0 } else {
            if inw == 0 { c = c + 1 inw = 1 }
        }
        i = i + 1
    }
    return c
}

func ct_width(s: str, n: int): int {
    var i = 0
    var w = 0
    while i < n {
        var cp = ct_utf8_cp(s, i, n)
        if cp < 0 {
            w = w + 1
            i = i + 1
        } else {
            if ct_is_wide(cp) == 1 { w = w + 2 } else { w = w + 1 }
            i = i + ct_utf8_seq_len(str_byte(s, i))
        }
    }
    return w
}

func ct_valid_utf8(s: str, n: int): int {
    var i = 0
    while i < n {
        var cp = ct_utf8_cp(s, i, n)
        if cp < 0 { return 0 }
        i = i + ct_utf8_seq_len(str_byte(s, i))
    }
    return 1
}

func ct_ascii_upper(b: int): int {
    if (b >= 97) & (b <= 122) { return b - 32 }
    return b
}

func ct_ascii_lower(b: int): int {
    if (b >= 65) & (b <= 90) { return b + 32 }
    return b
}

// Print `s` with each byte mapped; returns nothing. Byte-wise (ASCII) transform.
// ASCII case transform that preserves all non-letter bytes (incl. multi-byte
// UTF-8 sequences) by copying the original single-byte slice through.
func ct_print_mapped(s: str, n: int, upper: int): void {
    var buf_h = str_builder_new()
    var i = 0
    while i < n {
        var b = str_byte(s, i)
        if upper == 1 {
            if (b >= 97) & (b <= 122) {
                str_builder_append(buf_h, ct_char_of_byte(b - 32))
            } else {
                str_builder_append(buf_h, str_slice(s, i, 1))
            }
        } else {
            if (b >= 65) & (b <= 90) {
                str_builder_append(buf_h, ct_char_of_byte(b + 32))
            } else {
                str_builder_append(buf_h, str_slice(s, i, 1))
            }
        }
        i = i + 1
    }
    print_str(str_builder_to_str(buf_h))
    str_builder_free(buf_h)
}

// ASCII byte -> 1-char str. Covers 0..127.
func ct_char_of_byte(b: int): str {
    if b == 0 { return "\0" }
    if b == 9 { return "\t" }
    if b == 10 { return "\n" }
    if b == 13 { return "\r" }
    if b == 32 { return " " }
    if (b >= 33) & (b <= 126) {
        var all = "!\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
        return str_slice(all, b - 33, 1)
    }
    // Outside printable ASCII: emit a '?' placeholder (CLI is ASCII case only).
    return "?"
}

func ct_usage(): int {
    print_str("usage: diva text <subcommand> <file>")
    print_str("  inspect <file>        bytes, lines, codepoints, words, width, utf8")
    print_str("  count   <file>        print counts only")
    print_str("  upper   <file>        ASCII uppercase")
    print_str("  lower   <file>        ASCII lowercase")
    print_str("  width   <file>        display width (CJK/emoji wide)")
    print_str("  lines   <file>        numbered lines")
    print_str("  words   <file>        one word per line")
    print_str("  contains <needle> <file>")
    return 0
}

func ct_inspect(path: str): int {
    var s = read_file(path)
    var n = str_len(s)
    print_str("bytes:      ")
    print_str(int_to_str(n))
    print_str("\nlines:      ")
    print_str(int_to_str(ct_line_count(s, n)))
    print_str("\ncodepoints: ")
    print_str(int_to_str(ct_cp_count(s, n)))
    print_str("\nwords:      ")
    print_str(int_to_str(ct_word_count(s, n)))
    print_str("\nwidth:      ")
    print_str(int_to_str(ct_width(s, n)))
    print_str("\nutf8:       ")
    if ct_valid_utf8(s, n) == 1 { print_str("valid") } else { print_str("invalid") }
    print_str("\n")
    return 0
}

func ct_count(path: str): int {
    var s = read_file(path)
    var n = str_len(s)
    print_str(int_to_str(n))
    print_str(" ")
    print_str(int_to_str(ct_line_count(s, n)))
    print_str(" ")
    print_str(int_to_str(ct_cp_count(s, n)))
    print_str(" ")
    print_str(int_to_str(ct_word_count(s, n)))
    print_str(" ")
    print_str(int_to_str(ct_width(s, n)))
    print_str("\n")
    return 0
}

func ct_lines(path: str): int {
    var s = read_file(path)
    var n = str_len(s)
    var i = 0
    var start = 0
    var ln = 1
    while i <= n {
        if (i == n) | (str_byte(s, i) == 10) {
            print_str(int_to_str(ln))
            print_str(": ")
            if i > start {
                print_str(str_slice(s, start, i - start))
            }
            print_str("\n")
            ln = ln + 1
            start = i + 1
        }
        i = i + 1
    }
    return 0
}

func ct_words(path: str): int {
    var s = read_file(path)
    var n = str_len(s)
    var i = 0
    var start = 0 - 1
    while i <= n {
        var b = 10
        if i < n { b = str_byte(s, i) }
        if (i == n) | (ct_is_ws(b) == 1) {
            if start >= 0 {
                print_str(str_slice(s, start, i - start))
                print_str("\n")
                start = 0 - 1
            }
        } else {
            if start < 0 { start = i }
        }
        i = i + 1
    }
    return 0
}

// Command entry: host_argv(2) is the subcommand, later args follow.
func cmd_text_cmd(): int {
    var argc = host_argc()
    if argc < 3 { return ct_usage() }
    var sub = host_argv(2)
    if str_eq(sub, "inspect") == 1 {
        if argc < 4 { return ct_usage() }
        return ct_inspect(host_argv(3))
    }
    if str_eq(sub, "count") == 1 {
        if argc < 4 { return ct_usage() }
        return ct_count(host_argv(3))
    }
    if str_eq(sub, "upper") == 1 {
        if argc < 4 { return ct_usage() }
        var s = read_file(host_argv(3))
        ct_print_mapped(s, str_len(s), 1)
        return 0
    }
    if str_eq(sub, "lower") == 1 {
        if argc < 4 { return ct_usage() }
        var s2 = read_file(host_argv(3))
        ct_print_mapped(s2, str_len(s2), 0)
        return 0
    }
    if str_eq(sub, "width") == 1 {
        if argc < 4 { return ct_usage() }
        var s3 = read_file(host_argv(3))
        print_str(int_to_str(ct_width(s3, str_len(s3))))
        print_str("\n")
        return 0
    }
    if str_eq(sub, "lines") == 1 {
        if argc < 4 { return ct_usage() }
        return ct_lines(host_argv(3))
    }
    if str_eq(sub, "words") == 1 {
        if argc < 4 { return ct_usage() }
        return ct_words(host_argv(3))
    }
    if str_eq(sub, "contains") == 1 {
        if argc < 5 { return ct_usage() }
        var needle = host_argv(3)
        var hay = read_file(host_argv(4))
        if str_contains(hay, needle) == 1 { print_str("yes\n") return 0 }
        print_str("no\n")
        return 0
    }
    return ct_usage()
}
