// Diva-implemented lexer (token scanner) for .diva sources. Used by `diva lex <file>`.
import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"

func is_space(b: int): int {
    if b == 32 { return 1 }
    if b == 9 { return 1 }
    if b == 10 { return 1 }
    if b == 13 { return 1 }
    return 0
}

func is_digit(b: int): int {
    if b >= 48 & b <= 57 { return 1 }
    return 0
}

func is_ident_start(b: int): int {
    if b >= 65 & b <= 90 { return 1 }
    if b >= 97 & b <= 122 { return 1 }
    if b == 95 { return 1 }
    return 0
}

func is_ident_cont(b: int): int {
    if is_ident_start(b) == 1 { return 1 }
    if is_digit(b) == 1 { return 1 }
    return 0
}

func classify_ident(name: str): str {
    if str_eq(name, "func") == 1 { return "KW_FUNC" }
    if str_eq(name, "extern") == 1 { return "KW_EXTERN" }
    if str_eq(name, "var") == 1 { return "KW_VAR" }
    if str_eq(name, "let") == 1 { return "KW_LET" }
    if str_eq(name, "if") == 1 { return "KW_IF" }
    if str_eq(name, "else") == 1 { return "KW_ELSE" }
    if str_eq(name, "while") == 1 { return "KW_WHILE" }
    if str_eq(name, "return") == 1 { return "KW_RETURN" }
    if str_eq(name, "import") == 1 { return "KW_IMPORT" }
    if str_eq(name, "package") == 1 { return "KW_PACKAGE" }
    if str_eq(name, "class") == 1 { return "KW_CLASS" }
    if str_eq(name, "trait") == 1 { return "KW_TRAIT" }
    if str_eq(name, "impl") == 1 { return "KW_IMPL" }
    if str_eq(name, "flux") == 1 { return "KW_FLUX" }
    if str_eq(name, "in") == 1 { return "KW_IN" }
    if str_eq(name, "true") == 1 { return "KW_TRUE" }
    if str_eq(name, "false") == 1 { return "KW_FALSE" }
    if str_eq(name, "void") == 1 { return "KW_VOID" }
    if str_eq(name, "int") == 1 { return "KW_INT" }
    if str_eq(name, "str") == 1 { return "KW_STR" }
    if str_eq(name, "bool") == 1 { return "KW_BOOL" }
    return "IDENT"
}

func emit_tok(kind: str, lex: str): void {
    var b = str_builder_new()
    if b != 0 {
        str_builder_append(b, kind)
        str_builder_append(b, " ")
        str_builder_append(b, lex)
        var line = str_builder_to_str(b)
        print_str(line)
        str_builder_free(b)
    }
}

func punct_name(b: int): str {
    if b == 40 { return "LPAREN" }
    if b == 41 { return "RPAREN" }
    if b == 123 { return "LBRACE" }
    if b == 125 { return "RBRACE" }
    if b == 91 { return "LBRACK" }
    if b == 93 { return "RBRACK" }
    if b == 44 { return "COMMA" }
    if b == 59 { return "SEMI" }
    if b == 58 { return "COLON" }
    if b == 46 { return "DOT" }
    if b == 43 { return "PLUS" }
    if b == 45 { return "MINUS" }
    if b == 42 { return "STAR" }
    if b == 47 { return "SLASH" }
    if b == 60 { return "LT" }
    if b == 62 { return "GT" }
    if b == 33 { return "BANG" }
    if b == 38 { return "AMP" }
    if b == 124 { return "PIPE" }
    if b == 61 { return "EQ" }
    return "UNKNOWN"
}

func try_two_char(src: str, i: int, n: int, a: int, a2: int, name: str): int {
    if i + 1 >= n {
        return 0
    }
    var b = str_byte(src, i)
    var c = str_byte(src, i + 1)
    if b == a & c == a2 {
        var lex = str_slice(src, i, 2)
        emit_tok(name, lex)
        return 2
    }
    return 0
}

func lex_file_to_stdout(path: str): int {
    if file_size(path) < 0 {
        stderr("diva lex: cannot read file\n")
        return 1
    }
    var src = read_file(path)
    var n = str_len(src)
    var i = 0
    while i < n {
        var b = str_byte(src, i)
        if b < 0 {
            stderr("diva lex: invalid string data\n")
            return 1
        }
        if is_space(b) == 1 {
            i = i + 1
        } else {
            if b == 47 {
                var b2 = str_byte(src, i + 1)
                if b2 == 47 {
                    i = i + 2
                    var nl = 0
                    while i < n & nl == 0 {
                        var c = str_byte(src, i)
                        if c == 10 {
                            nl = 1
                        }
                        i = i + 1
                    }
                } else {
                    var px = str_slice(src, i, 1)
                    emit_tok("SLASH", px)
                    i = i + 1
                }
            } else {
                if b == 34 {
                    var start = i
                    i = i + 1
                    var done = 0
                    while i < n & done == 0 {
                        var c = str_byte(src, i)
                        if c == 34 {
                            done = 1
                        } else {
                            if c == 92 {
                                i = i + 1
                            }
                            i = i + 1
                        }
                    }
                    if done == 0 {
                        stderr("diva lex: unterminated string\n")
                        return 1
                    }
                    var len = i - start + 1
                    var lex = str_slice(src, start, len)
                    emit_tok("STRING", lex)
                    i = i + 1
                } else {
                    if is_digit(b) == 1 {
                        var start = i
                        var more = 1
                        while i < n & more == 1 {
                            var d = str_byte(src, i)
                            if is_digit(d) == 1 {
                                i = i + 1
                            } else {
                                more = 0
                            }
                        }
                        var ln = i - start
                        var lx = str_slice(src, start, ln)
                        emit_tok("INT", lx)
                    } else {
                        if is_ident_start(b) == 1 {
                            var start = i
                            var more = 1
                            while i < n & more == 1 {
                                var d = str_byte(src, i)
                                if is_ident_cont(d) == 1 {
                                    i = i + 1
                                } else {
                                    more = 0
                                }
                            }
                            var ln = i - start
                            var name = str_slice(src, start, ln)
                            var kind = classify_ident(name)
                            emit_tok(kind, name)
                        } else {
                            var adv = try_two_char(src, i, n, 61, 61, "EQEQ")
                            if adv == 0 {
                                adv = try_two_char(src, i, n, 33, 61, "NE")
                            }
                            if adv == 0 {
                                adv = try_two_char(src, i, n, 60, 61, "LE")
                            }
                            if adv == 0 {
                                adv = try_two_char(src, i, n, 62, 61, "GE")
                            }
                            if adv == 0 {
                                adv = try_two_char(src, i, n, 61, 62, "FATARROW")
                            }
                            if adv > 0 {
                                i = i + adv
                            } else {
                                var nm = punct_name(b)
                                if str_eq(nm, "UNKNOWN") == 1 {
                                    stderr("diva lex: unexpected byte\n")
                                    return 1
                                }
                                var px = str_slice(src, i, 1)
                                emit_tok(nm, px)
                                i = i + 1
                            }
                        }
                    }
                }
            }
        }
    }
    emit_tok("EOF", "")
    return 0
}
