// Package loader: merge package sources in dependency order for native build (no subprocess compiler).

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "std/str.diva"

func loader_stdlib_dir(): str {
    var p = host_getenv("DI_STDLIB_DIR")
    if str_len(p) > 0 {
        return p
    }
    return "stdlib"
}

func path_join_dir(base: str, rel: str): str {
    var nb = str_len(base)
    if nb == 0 {
        return rel
    }
    if str_byte(base, nb - 1) == 47 {
        var b = str_builder_new()
        str_builder_append(b, base)
        str_builder_append(b, rel)
        var r = str_builder_to_str(b)
        str_builder_free(b)
        return r
    }
    var b2 = str_builder_new()
    str_builder_append(b2, base)
    str_builder_append(b2, "/")
    str_builder_append(b2, rel)
    var r2 = str_builder_to_str(b2)
    str_builder_free(b2)
    return r2
}

func dirname_of_file(path: str): str {
    var n = str_len(path)
    var i = n - 1
    while i >= 0 {
        if str_byte(path, i) == 47 {
            if i == 0 {
                return "/"
            }
            return str_slice(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

func path_is_package_dir(root: str): int {
    if file_size(path_join_dir(root, "package.diva")) < 0 {
        return 0
    }
    return 1
}

func package_entry_relative(manifest_path: str): str {
    var text = read_file(manifest_path)
    if str_len(text) == 0 {
        return ""
    }
    var n = str_len(text)
    var i = 0
    while i < n {
        var line_end = i
        while line_end < n & str_byte(text, line_end) != 10 {
            line_end = line_end + 1
        }
        var line = str_slice(text, i, line_end - i)
        var j = 0
        var ln = str_len(line)
        while j < ln & (str_byte(line, j) == 32 | str_byte(line, j) == 9) {
            j = j + 1
        }
        if j + 5 <= ln {
            if str_slice(line, j, 5) == "entry" {
                var k = j + 5
                while k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9) {
                    k = k + 1
                }
                if k < ln & str_byte(line, k) == 61 {
                    k = k + 1
                    while k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9) {
                        k = k + 1
                    }
                    if k < ln & str_byte(line, k) == 34 {
                        var q = k + 1
                        while q < ln & str_byte(line, q) != 34 {
                            q = q + 1
                        }
                        if q > k + 1 {
                            return str_slice(line, k + 1, q - k - 1)
                        }
                    }
                }
            }
        }
        i = line_end + 1
    }
    return ""
}

func resolve_import_path(cur_file: str, imp: str, stdroot: str): str {
    if str_len(imp) >= 4 {
        if str_slice(imp, 0, 4) == "std/" {
            return path_join_dir(stdroot, imp)
        }
    }
    return path_join_dir(dirname_of_file(cur_file), imp)
}

func list_resolved_imports(src: str, cur_abs: str, stdroot: str): str {
    var b = str_builder_new()
    var n = str_len(src)
    var i = 0
    while i < n {
        if i + 8 <= n {
            if str_slice(src, i, 7) == "import " & str_byte(src, i + 7) == 34 {
                var q = i + 8
                while q < n & str_byte(src, q) != 34 {
                    q = q + 1
                }
                if q < n {
                    var inner = str_slice(src, i + 8, q - i - 8)
                    var rp = resolve_import_path(cur_abs, inner, stdroot)
                    str_builder_append(b, rp)
                    str_builder_append(b, "\n")
                }
                i = q + 1
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    var r = str_builder_to_str(b)
    str_builder_free(b)
    return r
}

func path_in_done(done: str, p: str): int {
    var b = str_builder_new()
    str_builder_append(b, "\n")
    str_builder_append(b, done)
    var wrapped = str_builder_to_str(b)
    str_builder_free(b)
    var b2 = str_builder_new()
    str_builder_append(b2, "\n")
    str_builder_append(b2, p)
    str_builder_append(b2, "\n")
    var search = str_builder_to_str(b2)
    str_builder_free(b2)
    if str_contains(wrapped, search) == 1 {
        return 1
    }
    return 0
}

// Returns updated done list, or "" on error (message on stderr).
func merge_emit_file(abs_path: str, done: str, stack: str, stdroot: str, out: int): str {
    if path_in_done(done, abs_path) == 1 {
        return done
    }
    if path_in_done(stack, abs_path) == 1 {
        stderr("loader: import cycle at ")
        stderr(abs_path)
        stderr("\n")
        return ""
    }
    if file_size(abs_path) < 0 {
        stderr("loader: cannot read ")
        stderr(abs_path)
        stderr("\n")
        return ""
    }
    var src = read_file(abs_path)
    var deps = list_resolved_imports(src, abs_path, stdroot)
    var done2 = done
    var b_stack = str_builder_new()
    str_builder_append(b_stack, stack)
    str_builder_append(b_stack, abs_path)
    str_builder_append(b_stack, "\n")
    var stack2 = str_builder_to_str(b_stack)
    str_builder_free(b_stack)
    var pos = 0
    var dn = str_len(deps)
    while pos < dn {
        var le = pos
        while le < dn & str_byte(deps, le) != 10 {
            le = le + 1
        }
        var dep = str_slice(deps, pos, le - pos)
        pos = le + 1
        if str_len(dep) > 0 {
            var dr = merge_emit_file(dep, done2, stack2, stdroot, out)
            if str_len(dr) == 0 {
                return ""
            }
            done2 = dr
        }
    }
    str_builder_append(out, src)
    str_builder_append(out, "\n")
    var b_done = str_builder_new()
    str_builder_append(b_done, done2)
    str_builder_append(b_done, abs_path)
    str_builder_append(b_done, "\n")
    var new_done = str_builder_to_str(b_done)
    str_builder_free(b_done)
    return new_done
}

func merge_package_sources(root: str): str {
    var man = path_join_dir(root, "package.diva")
    var ent = package_entry_relative(man)
    if str_len(ent) == 0 {
        stderr("loader: no entry= in package.diva under ")
        stderr(root)
        stderr("\n")
        return ""
    }
    var ep = path_join_dir(root, ent)
    var b = str_builder_new()
    var done = ""
    var stdroot = loader_stdlib_dir()
    var r = merge_emit_file(ep, done, "", stdroot, b)
    if str_len(r) == 0 {
        str_builder_free(b)
        return ""
    }
    var merged = str_builder_to_str(b)
    str_builder_free(b)
    return merged
}
