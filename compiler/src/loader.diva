// Package loader: merge package sources in dependency order for native build (no subprocess compiler).

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "std/str.diva"

func loader_stdlib_dir(): str {
    var p = host_getenv("DI_STDLIB_DIR")
    if (str_len(p) > 0) {
        return p
    }
    return "stdlib"
}

func loader_newline(): str {
    var p = path_join_dir(loader_stdlib_dir(), "std/lf.txt")
    var s = read_file(p)
    if (!(str_len(s) < 1)) {
        return str_slice(s, 0, 1)
    }
    return ""
}

func path_join_dir(base: str, rel: str): str {
    var nb = str_len(base)
    if nb == 0 {
        return rel
    }
    if str_byte(base, nb - 1) == 47 {
        var b = str_builder_new()
        str_builder_append(b, base)
        str_builder_append(b, rel)
        var r = str_builder_to_str(b)
        str_builder_free(b)
        return r
    }
    var b2 = str_builder_new()
    str_builder_append(b2, base)
    str_builder_append(b2, "/")
    str_builder_append(b2, rel)
    var r2 = str_builder_to_str(b2)
    str_builder_free(b2)
    return r2
}

func dirname_of_file(path: str): str {
    var n = str_len(path)
    var i = n - 1
    while ((i < 0) == 0) {
        if str_byte(path, i) == 47 {
            if i == 0 {
                return "/"
            }
            return str_slice(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

func path_is_package_dir(root: str): int {
    var nl = str_len(root)
    if nl >= 5 {
        var suf = str_slice(root, nl - 5, 5)
        if str_eq(suf, ".diva") == 1 {
            return 0
        }
    }
    var msz = file_size(path_join_dir(root, "package.diva"))
    if str_eq(int_to_str(msz), "-1") == 1 {
        return 0
    }
    return 1
}

func package_manifest_kind_value(root: str): str {
    var mf = path_join_dir(root, "package.diva")
    if (file_size(mf) < 0) {
        return ""
    }
    var text = read_file(mf)
    var text_len = str_len(text)
    if text_len == 0 {
        return ""
    }
    var n = text_len
    var i = 0
    while (i < n) {
        var line_end = i
        while (line_end < n & str_byte(text, line_end) != 10) {
            line_end = line_end + 1
        }
        var line = str_slice(text, i, line_end - i)
        var ln = str_len(line)
        while (ln > 0 & str_byte(line, ln - 1) == 13) {
            ln = ln - 1
        }
        if (ln > 0) {
            var j = 0
            while (j < ln & (str_byte(line, j) == 32 | str_byte(line, j) == 9)) {
                j = j + 1
            }
            if !((j + 4) > ln) {
                if str_eq(str_slice(line, j, 4), "kind") == 1 {
                    var k = j + 4
                    while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                        k = k + 1
                    }
                    if (k < ln & str_byte(line, k) == 61) {
                        k = k + 1
                        while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                            k = k + 1
                        }
                        if (k < ln & str_byte(line, k) == 34) {
                            var q = k + 1
                            while (q < ln & str_byte(line, q) != 34) {
                                q = q + 1
                            }
                            if (q > k + 1) {
                                return str_slice(line, k + 1, q - k - 1)
                            }
                        }
                    }
                }
            }
        }
        i = line_end + 1
    }
    return ""
}

func package_is_kernel_dir(root: str): int {
    return str_eq(package_manifest_kind_value(root), "kernel")
}

func package_entry_relative(manifest_path: str): str {
    var text = read_file(manifest_path)
    var text_len = str_len(text)
    if text_len == 0 {
        return ""
    }
    var n = text_len
    var i = 0
    while (i < n) {
        var line_end = i
        while (line_end < n & str_byte(text, line_end) != 10) {
            line_end = line_end + 1
        }
        var line = str_slice(text, i, line_end - i)
        var ln = str_len(line)
        while (ln > 0 & str_byte(line, ln - 1) == 13) {
            ln = ln - 1
        }
        if (ln > 0) {
            var j = 0
            while (j < ln & (str_byte(line, j) == 32 | str_byte(line, j) == 9)) {
                j = j + 1
            }
            if !((j + 5) > ln) {
                if str_eq(str_slice(line, j, 5), "entry") == 1 {
                    var k = j + 5
                    while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                        k = k + 1
                    }
                    if (k < ln & str_byte(line, k) == 61) {
                        k = k + 1
                        while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                            k = k + 1
                        }
                        if (k < ln & str_byte(line, k) == 34) {
                            var q = k + 1
                            while (q < ln & str_byte(line, q) != 34) {
                                q = q + 1
                            }
                            if (q > k + 1) {
                                return str_slice(line, k + 1, q - k - 1)
                            }
                        }
                    }
                }
            }
        }
        i = line_end + 1
    }
    return ""
}

func resolve_import_path(cur_file: str, imp: str, stdroot: str): str {
    if !((str_len(imp)) < 4) {
        if str_eq(str_slice(imp, 0, 4), "std/") == 1 {
            return path_join_dir(stdroot, imp)
        }
    }
    return path_join_dir(dirname_of_file(cur_file), imp)
}

func import_kw_match(src: str, i: int): int {
    if str_byte(src, i) != 105     { return 0 }
    if str_byte(src, i + 1) != 109 { return 0 }
    if str_byte(src, i + 2) != 112 { return 0 }
    if str_byte(src, i + 3) != 111 { return 0 }
    if str_byte(src, i + 4) != 114 { return 0 }
    if str_byte(src, i + 5) != 116 { return 0 }
    if str_byte(src, i + 6) != 32  { return 0 }
    if str_byte(src, i + 7) != 34  { return 0 }
    return 1
}

func list_resolved_imports(src: str, cur_abs: str, stdroot: str, nl: str): str {
    var b = str_builder_new()
    var n = str_len(src)
    var i = 0
    while (i < n) {
        if !((i + 8) > n) {
            if import_kw_match(src, i) == 1 {
                var at_sol = 0
                if i == 0 {
                    at_sol = 1
                } else {
                    if str_byte(src, i - 1) == 10 {
                        at_sol = 1
                    }
                }
                if at_sol == 1 {
                    var q = i + 8
                    while (q < n & str_byte(src, q) != 34) {
                        q = q + 1
                    }
                    if (q < n) {
                        var inner = str_slice(src, i + 8, q - i - 8)
                        var rp = resolve_import_path(cur_abs, inner, stdroot)
                        str_builder_append(b, rp)
                        str_builder_append(b, nl)
                    }
                    i = q + 1
                } else {
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    var r = str_builder_to_str(b)
    str_builder_free(b)
    return r
}

func path_in_done(done: str, p: str, nl: str): int {
    var b = str_builder_new()
    str_builder_append(b, nl)
    str_builder_append(b, done)
    var wrapped = str_builder_to_str(b)
    str_builder_free(b)
    var b2 = str_builder_new()
    str_builder_append(b2, nl)
    str_builder_append(b2, p)
    str_builder_append(b2, nl)
    var search = str_builder_to_str(b2)
    str_builder_free(b2)
    if str_contains(wrapped, search) == 1 {
        return 1
    }
    return 0
}

func merge_emit_file(abs_path: str, done: str, stack: str, stdroot: str, out: int): str {
    var nl = loader_newline()
    if path_in_done(done, abs_path, nl) == 1 {
        return done
    }
    if path_in_done(stack, abs_path, nl) == 1 {
        stderr("loader: import cycle at ")
        stderr(abs_path)
        stderr(nl)
        return ""
    }
    if (file_size(abs_path) < 0) {
        stderr("loader: cannot read ")
        stderr(abs_path)
        stderr(nl)
        return ""
    }
    var src = read_file(abs_path)
    var deps = list_resolved_imports(src, abs_path, stdroot, nl)
    var done2 = done
    var b_stack = str_builder_new()
    str_builder_append(b_stack, stack)
    str_builder_append(b_stack, abs_path)
    str_builder_append(b_stack, nl)
    var stack2 = str_builder_to_str(b_stack)
    str_builder_free(b_stack)
    var pos = 0
    var dn = str_len(deps)
    while (pos < dn) {
        var le = pos
        while (le < dn & str_byte(deps, le) != 10) {
            le = le + 1
        }
        var dep = str_slice(deps, pos, le - pos)
        pos = le + 1
        if (str_len(dep) > 0) {
            var dr = merge_emit_file(dep, done2, stack2, stdroot, out)
            var dr_len = str_len(dr)
            if dr_len == 0 {
                return ""
            }
            done2 = dr
        }
    }
    str_builder_append(out, src)
    str_builder_append(out, nl)
    var b_done = str_builder_new()
    str_builder_append(b_done, done2)
    str_builder_append(b_done, abs_path)
    str_builder_append(b_done, nl)
    var new_done = str_builder_to_str(b_done)
    str_builder_free(b_done)
    return new_done
}

func merge_file_sources(path: str): str {
    var src = read_file(path)
    var src_len = str_len(src)
    if src_len == 0 {
        return ""
    }
    var nl = loader_newline()
    var stdroot = loader_stdlib_dir()
    var b = str_builder_new()
    var done = ""
    var r = merge_emit_file(path, done, "", stdroot, b)
    var r_len = str_len(r)
    if r_len == 0 {
        str_builder_free(b)
        return ""
    }
    var merged = str_builder_to_str(b)
    str_builder_free(b)
    return merged
}

func merge_package_sources(root: str): str {
    var man = path_join_dir(root, "package.diva")
    var ent = package_entry_relative(man)
    var ent_len = str_len(ent)
    if ent_len == 0 {
        stderr("loader: no entry= in package.diva under ")
        stderr(root)
        stderr(loader_newline())
        return ""
    }
    var ep = path_join_dir(root, ent)
    var b = str_builder_new()
    var done = ""
    var stdroot = loader_stdlib_dir()
    var r = merge_emit_file(ep, done, "", stdroot, b)
    var r_len = str_len(r)
    if r_len == 0 {
        str_builder_free(b)
        return ""
    }
    var merged = str_builder_to_str(b)
    str_builder_free(b)
    return merged
}