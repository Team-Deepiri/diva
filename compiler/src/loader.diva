// Package loader: merge package sources in dependency order for native build (no subprocess compiler).

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "std/str.diva"

// When DIVA_CHECK_TRACE is set, merge/check prints stderr milestones (pure-driver debugging).
func loader_check_trace(): int {
    var v = host_getenv("DIVA_CHECK_TRACE")
    var v_hold = v
    if str_len(v_hold) > 0 {
        return 1
    }
    return 0
}

func loader_stdlib_dir(): str {
    var p = host_getenv("DI_STDLIB_DIR")
    var p_hold = p
    if (str_len(p_hold) > 0) {
        return p_hold
    }
    return "stdlib"
}

func loader_newline(): str {
    var std = loader_stdlib_dir()
    var std_hold = std
    var p = path_join_dir(std_hold, "std/lf.txt")
    var s = read_file(p)
    var s_hold = s
    if (!(str_len(s_hold) < 1)) {
        return str_slice(s_hold, 0, 1)
    }
    return ""
}

func path_join_dir(base: str, rel: str): str {
    var nb = str_len(base)
    if nb == 0 {
        return rel
    }
    if str_byte(base, nb - 1) == 47 {
        var b = str_builder_new()
        str_builder_append(b, base)
        str_builder_append(b, rel)
        var r = str_builder_to_str(b)
        str_builder_free(b)
        return r
    }
    var b2 = str_builder_new()
    str_builder_append(b2, base)
    str_builder_append(b2, "/")
    str_builder_append(b2, rel)
    var r2 = str_builder_to_str(b2)
    str_builder_free(b2)
    return r2
}

func dirname_of_file(path: str): str {
    var n = str_len(path)
    var i = n - 1
    while ((i < 0) == 0) {
        if str_byte(path, i) == 47 {
            if i == 0 {
                return "/"
            }
            return str_slice(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

func path_is_package_dir(root: str): int {
    var nl = str_len(root)
    if nl >= 5 {
        var suf = str_slice(root, nl - 5, 5)
        if str_eq(suf, ".diva") == 1 {
            return 0
        }
    }
    var msz = file_size(path_join_dir(root, "package.diva"))
    if msz < 0 {
        return 0
    }
    return 1
}

func package_manifest_kind_value(root: str): str {
    var mf = path_join_dir(root, "package.diva")
    if (file_size(mf) < 0) {
        return ""
    }
    var text = read_file(mf)
    var text_hold = text
    var text_len = str_len(text_hold)
    if text_len == 0 {
        return ""
    }
    var n = text_len
    var i = 0
    while (i < n) {
        var line_end = i
        while (line_end < n & str_byte(text, line_end) != 10) {
            line_end = line_end + 1
        }
        var line = str_slice(text, i, line_end - i)
        var ln = str_len(line)
        while (ln > 0 & str_byte(line, ln - 1) == 13) {
            ln = ln - 1
        }
        if (ln > 0) {
            var j = 0
            while (j < ln & (str_byte(line, j) == 32 | str_byte(line, j) == 9)) {
                j = j + 1
            }
            if !((j + 4) > ln) {
                if str_eq(str_slice(line, j, 4), "kind") == 1 {
                    var k = j + 4
                    while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                        k = k + 1
                    }
                    if (k < ln & str_byte(line, k) == 61) {
                        k = k + 1
                        while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                            k = k + 1
                        }
                        if (k < ln & str_byte(line, k) == 34) {
                            var q = k + 1
                            while (q < ln & str_byte(line, q) != 34) {
                                q = q + 1
                            }
                            if (q > k + 1) {
                                return str_slice(line, k + 1, q - k - 1)
                            }
                        }
                    }
                }
            }
        }
        i = line_end + 1
    }
    return ""
}

func package_is_kernel_dir(root: str): int {
    return str_eq(package_manifest_kind_value(root), "kernel")
}

// Look up `dep.<name> = "..."` in package.diva. Returns relative path or "".
func package_manifest_dep_value(root: str, dep_name: str): str {
    var mf = path_join_dir(root, "package.diva")
    if (file_size(mf) < 0) {
        return ""
    }
    var text = read_file(mf)
    var text_hold = text
    var text_len = str_len(text_hold)
    if text_len == 0 {
        return ""
    }
    var key_b = str_builder_new()
    str_builder_append(key_b, "dep.")
    str_builder_append(key_b, dep_name)
    var key = str_builder_to_str(key_b)
    str_builder_free(key_b)
    var key_len = str_len(key)
    var n = text_len
    var i = 0
    while (i < n) {
        var line_end = i
        while (line_end < n & str_byte(text, line_end) != 10) {
            line_end = line_end + 1
        }
        var line = str_slice(text, i, line_end - i)
        var ln = str_len(line)
        while (ln > 0 & str_byte(line, ln - 1) == 13) {
            ln = ln - 1
        }
        if (ln > 0) {
            var j = 0
            while (j < ln & (str_byte(line, j) == 32 | str_byte(line, j) == 9)) {
                j = j + 1
            }
            if !((j + key_len) > ln) {
                if str_eq(str_slice(line, j, key_len), key) == 1 {
                    var k = j + key_len
                    while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                        k = k + 1
                    }
                    if (k < ln & str_byte(line, k) == 61) {
                        k = k + 1
                        while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                            k = k + 1
                        }
                        if (k < ln & str_byte(line, k) == 34) {
                            var q = k + 1
                            while (q < ln & str_byte(line, q) != 34) {
                                q = q + 1
                            }
                            if (q > k + 1) {
                                return str_slice(line, k + 1, q - k - 1)
                            }
                        }
                    }
                }
            }
        }
        i = line_end + 1
    }
    return ""
}

// Walk parents of a source file until a directory containing package.diva is found.
func find_enclosing_package_root(file_path: str): str {
    var dir = dirname_of_file(file_path)
    var guard = 0
    while (guard < 32) {
        if path_is_package_dir(dir) == 1 {
            return dir
        }
        if str_eq(dir, ".") == 1 | str_eq(dir, "/") == 1 {
            return ""
        }
        var climb = dirname_of_file(dir)
        if str_eq(climb, dir) == 1 {
            return ""
        }
        dir = climb
        guard = guard + 1
    }
    return ""
}

func import_looks_like_dep_alias(imp: str): int {
    var n = str_len(imp)
    if n == 0 {
        return 0
    }
    // Canonical: pkg/<name>
    if !(n < 4) {
        if str_eq(str_slice(imp, 0, 4), "pkg/") == 1 {
            return 1
        }
    }
    // Bare alias: math_lib (no slash / dot)
    var i = 0
    while (i < n) {
        var b = str_byte(imp, i)
        if b == 47 {
            return 0
        }
        if b == 46 {
            return 0
        }
        i = i + 1
    }
    return 1
}

func import_dep_alias_name(imp: str): str {
    var n = str_len(imp)
    if !(n < 4) {
        if str_eq(str_slice(imp, 0, 4), "pkg/") == 1 {
            return str_slice(imp, 4, n - 4)
        }
    }
    return imp
}

func resolve_dep_alias_import(cur_file: str, imp: str): str {
    if import_looks_like_dep_alias(imp) == 0 {
        return ""
    }
    var alias = import_dep_alias_name(imp)
    var root = find_enclosing_package_root(cur_file)
    if str_len(root) == 0 {
        if !(str_len(imp) < 4) {
            if str_eq(str_slice(imp, 0, 4), "pkg/") == 1 {
                stderr("loader: pkg/ import requires package.diva ancestor\n")
            }
        }
        return ""
    }
    var rel = package_manifest_dep_value(root, alias)
    if str_len(rel) == 0 {
        stderr("loader: unknown package dependency '")
        stderr(alias)
        stderr("'\n")
        return ""
    }
    var target = path_join_dir(root, rel)
    if path_is_package_dir(target) == 1 {
        var man = path_join_dir(target, "package.diva")
        var ent = package_entry_relative(man)
        if str_len(ent) == 0 {
            return ""
        }
        return path_join_dir(target, ent)
    }
    return target
}

func package_entry_relative(manifest_path: str): str {
    var text = read_file(manifest_path)
    var text_hold = text
    var text_len = str_len(text_hold)
    if text_len == 0 {
        return ""
    }
    var n = text_len
    var i = 0
    while (i < n) {
        var line_end = i
        while (line_end < n & str_byte(text, line_end) != 10) {
            line_end = line_end + 1
        }
        var line = str_slice(text, i, line_end - i)
        var ln = str_len(line)
        while (ln > 0 & str_byte(line, ln - 1) == 13) {
            ln = ln - 1
        }
        if (ln > 0) {
            var j = 0
            while (j < ln & (str_byte(line, j) == 32 | str_byte(line, j) == 9)) {
                j = j + 1
            }
            if !((j + 5) > ln) {
                if str_eq(str_slice(line, j, 5), "entry") == 1 {
                    var k = j + 5
                    while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                        k = k + 1
                    }
                    if (k < ln & str_byte(line, k) == 61) {
                        k = k + 1
                        while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                            k = k + 1
                        }
                        if (k < ln & str_byte(line, k) == 34) {
                            var q = k + 1
                            while (q < ln & str_byte(line, q) != 34) {
                                q = q + 1
                            }
                            if (q > k + 1) {
                                return str_slice(line, k + 1, q - k - 1)
                            }
                        }
                    }
                }
            }
        }
        i = line_end + 1
    }
    return ""
}

func resolve_import_path(cur_file: str, imp: str, stdroot: str): str {
    var imp_p = imp
    var cur_p = cur_file
    var std_p = stdroot
    if !((str_len(imp_p)) < 4) {
        if str_eq(str_slice(imp_p, 0, 4), "std/") == 1 {
            return path_join_dir(std_p, imp_p)
        }
    }
    var via_dep = resolve_dep_alias_import(cur_p, imp_p)
    if str_len(via_dep) > 0 {
        return via_dep
    }
    return path_join_dir(dirname_of_file(cur_p), imp_p)
}

func import_kw_match(src: str, i: int): int {
    if str_byte(src, i) != 105     { return 0 }
    if str_byte(src, i + 1) != 109 { return 0 }
    if str_byte(src, i + 2) != 112 { return 0 }
    if str_byte(src, i + 3) != 111 { return 0 }
    if str_byte(src, i + 4) != 114 { return 0 }
    if str_byte(src, i + 5) != 116 { return 0 }
    if str_byte(src, i + 6) != 32  { return 0 }
    if str_byte(src, i + 7) != 34  { return 0 }
    return 1
}

func list_resolved_imports(src: str, cur_abs: str, stdroot: str, nl: str): str {
    var src_p = src
    var cur_p = cur_abs
    var std_p = stdroot
    var nl_p = nl
    var b = str_builder_new()
    var n = str_len(src_p)
    var i = 0
    while (i < n) {
        if !((i + 8) > n) {
            if import_kw_match(src_p, i) == 1 {
                var at_sol = 0
                if i == 0 {
                    at_sol = 1
                } else {
                    if str_byte(src_p, i - 1) == 10 {
                        at_sol = 1
                    }
                }
                if at_sol == 1 {
                    var q = i + 8
                    while (q < n & str_byte(src_p, q) != 34) {
                        q = q + 1
                    }
                    if (q < n) {
                        var inner = str_slice(src_p, i + 8, q - i - 8)
                        var rp = resolve_import_path(cur_p, inner, std_p)
                        str_builder_append(b, rp)
                        str_builder_append(b, nl_p)
                    }
                    i = q + 1
                } else {
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    var r = str_builder_to_str(b)
    str_builder_free(b)
    return r
}

func path_in_done(done: str, p: str, nl: str): int {
    var b = str_builder_new()
    str_builder_append(b, nl)
    str_builder_append(b, done)
    var wrapped = str_builder_to_str(b)
    str_builder_free(b)
    var b2 = str_builder_new()
    str_builder_append(b2, nl)
    str_builder_append(b2, p)
    str_builder_append(b2, nl)
    var search = str_builder_to_str(b2)
    str_builder_free(b2)
    if str_contains(wrapped, search) == 1 {
        return 1
    }
    return 0
}

func merge_emit_file(abs_path: str, done: str, stack: str, stdroot: str, out: int): str {
    var abs_p = abs_path
    var done_p = done
    var stack_p = stack
    var std_p = stdroot
    var nl = loader_newline()
    if path_in_done(done_p, abs_p, nl) == 1 {
        return done_p
    }
    if path_in_done(stack_p, abs_p, nl) == 1 {
        stderr("loader: import cycle at ")
        stderr(abs_p)
        stderr(nl)
        return ""
    }
    if (file_size(abs_p) < 0) {
        stderr("loader: cannot read ")
        stderr(abs_p)
        stderr(nl)
        return ""
    }
    var src = read_file(abs_p)
    var src_hold = src
    var deps = list_resolved_imports(src_hold, abs_p, std_p, nl)
    var deps_hold = deps
    var done2 = done_p
    var b_stack = str_builder_new()
    str_builder_append(b_stack, stack_p)
    str_builder_append(b_stack, abs_p)
    str_builder_append(b_stack, nl)
    var stack2 = str_builder_to_str(b_stack)
    str_builder_free(b_stack)
    var pos = 0
    var dn = str_len(deps_hold)
    while (pos < dn) {
        var le = pos
        while (le < dn & str_byte(deps_hold, le) != 10) {
            le = le + 1
        }
        var dep = str_slice(deps_hold, pos, le - pos)
        pos = le + 1
        var dep_hold = dep
        if (str_len(dep_hold) > 0) {
            var dr = merge_emit_file(dep_hold, done2, stack2, std_p, out)
            var dr_hold = dr
            var dr_len = str_len(dr_hold)
            if dr_len == 0 {
                return ""
            }
            done2 = dr_hold
        }
    }
    str_builder_append(out, src_hold)
    str_builder_append(out, nl)
    var b_done = str_builder_new()
    str_builder_append(b_done, done2)
    str_builder_append(b_done, abs_p)
    str_builder_append(b_done, nl)
    var new_done = str_builder_to_str(b_done)
    str_builder_free(b_done)
    return new_done
}

func merge_file_sources(path: str): str {
    // Resolve stdlib + newline before read_file(path): pure builtins must leave r15 (environ
    // anchor for host_getenv) valid across IO builtins (see pure_elf_builtins.diva).
    var path_p = path
    var stdroot = loader_stdlib_dir()
    var std_hold = stdroot
    var nl = loader_newline()
    var src = read_file(path_p)
    var src_hold = src
    var src_len = str_len(src_hold)
    if src_len == 0 {
        return ""
    }
    var b = str_builder_new()
    var done = ""
    var r = merge_emit_file(path_p, done, "", std_hold, b)
    var r_hold = r
    var r_len = str_len(r_hold)
    if r_len == 0 {
        str_builder_free(b)
        return ""
    }
    var merged = str_builder_to_str(b)
    str_builder_free(b)
    return merged
}

func merge_package_sources(root: str): str {
    var root_p = root
    var stdroot = loader_stdlib_dir()
    var std_hold = stdroot
    if loader_check_trace() == 1 {
        stderr("[check-trace] merge_package_sources: after loader_stdlib_dir\n")
    }
    var man = path_join_dir(root_p, "package.diva")
    var ent = package_entry_relative(man)
    if loader_check_trace() == 1 {
        stderr("[check-trace] merge_package_sources: after package_entry_relative\n")
    }
    var ent_hold = ent
    var ent_len = str_len(ent_hold)
    if ent_len == 0 {
        stderr("loader: no entry= in package.diva under ")
        stderr(root_p)
        stderr(loader_newline())
        return ""
    }
    var ep = path_join_dir(root_p, ent_hold)
    if loader_check_trace() == 1 {
        stderr("[check-trace] merge_package_sources: before merge_emit_file\n")
    }
    var b = str_builder_new()
    var done = ""
    var r = merge_emit_file(ep, done, "", std_hold, b)
    var r_hold = r
    var r_len = str_len(r_hold)
    if r_len == 0 {
        str_builder_free(b)
        return ""
    }
    var merged = str_builder_to_str(b)
    str_builder_free(b)
    return merged
}