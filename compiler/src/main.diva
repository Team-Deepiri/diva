// Diva compiler driver — native pipeline (lexer → parser → sema → IR → x86).
// Default: pure in-process ELF (no external toolchain). If DI_RUNTIME_O points at
// runtime-linux-amd64.o, we emit gas and link with cc + that object (hosted di_runtime_*).

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "std/conv.diva"
import "std/str.diva"
import "cell.diva"
import "tokens.diva"
import "lexer.diva"
import "ast.diva"
import "parser.diva"
import "ir.diva"
import "ir_builder.diva"
import "ir_dump.diva"
import "codegen_x86.diva"
import "ast_dump.diva"
import "sema.diva"
import "loader.diva"

func cmd_print_usage(): int {
    stderr("usage: diva <command> [args]\n")
    stderr("  lex <file.diva> | parse <file.diva> | ir <file.diva> | asm <file.diva>\n")
    stderr("  emit-ir <file.diva|package-dir> | build <file.diva|package-dir> [--ast] | run <...>\n")
    stderr("  check <package-dir> | new <path> [--lib|--kernel]\n")
    stderr("  compiler-version | pipeline\n")
    stderr("Environment: DI_STDLIB_DIR; DI_RUNTIME_O overrides auto path; else ROOT_DIR/bootstrap/runtime-linux-amd64.o is used for native build+link (cc); DIVA_BOOTSTRAP / DI_BOOTSTRAP for check/new/\n")
    stderr("  package emit-ir and kernel package build (delegates to seed when set)\n")
    return 1
}

func native_tmp_exe(): str {
    return "/tmp/diva-native-exe"
}

func system_exit_code(rc: int): int {
    if (rc < 0) {
        return 1
    }
    if rc == 0 {
        return 0
    }
    if (rc < 256) {
        return rc
    }
    return rc / 256
}

func bootstrap_path(): str {
    var p = host_getenv("DIVA_BOOTSTRAP")
    if (str_len(p) > 0) {
        return p
    }
    p = host_getenv("DI_BOOTSTRAP")
    if (str_len(p) > 0) {
        return p
    }
    var root = host_getenv("ROOT_DIR")
    if str_len(root) == 0 {
        root = "."
    }
    var auto = str_concat(root, "/bootstrap/diva-linux-amd64")
    if (file_size(auto) < 0) {
        return ""
    }
    return auto
}

// ASCII 32..126 as contiguous bytes (see stdlib/std/char_to_str_table.bin).
func ascii_table_load(): str {
    var root = host_getenv("DI_STDLIB_DIR")
    if str_len(root) == 0 {
        root = "stdlib"
    }
    var b = str_builder_new()
    str_builder_append(b, root)
    str_builder_append(b, "/std/char_to_str_table.bin")
    var p = str_builder_to_str(b)
    str_builder_free(b)
    return read_file(p)
}

func shell_byte_to_str(c: int, table: str): str {
    if (!(c < 32) & !(c > 126)) {
        var need = (c - 32) + 1
        if (!(need > str_len(table))) {
            return str_slice(table, c - 32, 1)
        }
    }
    return ""
}

// Shell-escape one argument as a single-quoted word (safe for sh -c via system()).
func shell_append_single_quoted(sb: int, s: str, table: str): int {
    str_builder_append(sb, "'")
    var n = str_len(s)
    var i = 0
    while (i < n) {
        var c = str_byte(s, i)
        if c == 39 {
            str_builder_append(sb, "'")
            str_builder_append(sb, shell_byte_to_str(92, table))
            str_builder_append(sb, "'")
            str_builder_append(sb, "'")
        } else {
            str_builder_append(sb, shell_byte_to_str(c, table))
        }
        i = i + 1
    }
    str_builder_append(sb, "'")
    return 0
}

func forward_bootstrap_argv(): int {
    var boot = bootstrap_path()
    if str_len(boot) == 0 {
        err_line("set DIVA_BOOTSTRAP or DI_BOOTSTRAP to the seed diva binary for this command")
        return 1
    }
    var tbl = ascii_table_load()
    if (str_len(tbl) < 95) {
        err_line("bootstrap forward: missing stdlib/std/char_to_str_table.bin (check DI_STDLIB_DIR)")
        return 1
    }
    var b = str_builder_new()
    shell_append_single_quoted(b, boot, tbl)
    var i = 1
    while (i < host_argc()) {
        str_builder_append(b, " ")
        shell_append_single_quoted(b, host_argv(i), tbl)
        i = i + 1
    }
    var cmd = str_builder_to_str(b)
    str_builder_free(b)
    return system_exit_code(host_system(cmd))
}

// Native x86_64 PIE ELF generator - no cc, no as, no ld!
func get_low_byte(x: int): int {
    return x - (x / 256) * 256
}

func encode_elf_header(out: int, code_len: int): int {
    int_vec_push(out, 127) // ELF magic
    int_vec_push(out, 69)
    int_vec_push(out, 76)
    int_vec_push(out, 70)
    int_vec_push(out, 2)   // 64-bit
    int_vec_push(out, 1)   // little endian
    int_vec_push(out, 1)   // version
    int_vec_push(out, 0)   // OS ABI
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 3)   // e_type: ET_DYN (PIE)
    int_vec_push(out, 0)
    int_vec_push(out, 62)  // e_machine: x86_64
    int_vec_push(out, 0)
    int_vec_push(out, 1)   // e_version
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_entry: 0x1000
    int_vec_push(out, 16)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 64)  // e_phoff
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_shoff
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_flags
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 64)  // e_ehsize
    int_vec_push(out, 0)
    int_vec_push(out, 56)  // e_phentsize
    int_vec_push(out, 0)
    int_vec_push(out, 1)   // e_phnum (1 segment for now)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_shentsize
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_shnum
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_shstrndx
    int_vec_push(out, 0)
    return 0
}

func encode_phdr(out: int, code_len: int): int {
    int_vec_push(out, 1)   // p_type: PT_LOAD
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 5)   // p_flags: rwx
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // p_offset
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // p_vaddr (PIE base)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // p_paddr
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    var lo = get_low_byte(code_len + 64 + 56)
    var hi = get_low_byte((code_len + 64 + 56) / 256)
    int_vec_push(out, lo)   // p_filesz
    int_vec_push(out, hi)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, lo)   // p_memsz
    int_vec_push(out, hi)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // p_align
    int_vec_push(out, 16)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    return 0
}

func hex_char(n: int): int {
    if (n < 10) { return 48 + n }
    return 87 + n
}

// Materialize ELF bytes without building one giant hex string (large programs OOM the builder).
func native_write_exe(data: int, path: str): int {
    var b0 = str_builder_new()
    str_builder_append(b0, "rm -f ")
    str_builder_append(b0, path)
    var cmd0 = str_builder_to_str(b0)
    str_builder_free(b0)
    if host_system(cmd0) != 0 {
        return 1
    }
    var n = int_vec_len(data)
    var pos = 0
    while (pos < n) {
        // Larger chunks cut down fork/exec storms on big ELFs (merged compiler).
        // Each byte is two hex chars in the python argv; Linux caps each argv string (~128KiB),
        // well below total ARG_MAX. 64000 bytes -> 128000 hex chars + wrapper stays safe.
        var take = 64000
        if (pos + take > n) {
            take = n - pos
        }
        var sb = str_builder_new()
        var j = 0
        while (j < take) {
            var b = int_vec_get(data, pos + j)
            var hi = (b / 16) & 15
            var lo = b & 15
            str_builder_append(sb, char_to_str(hex_char(hi)))
            str_builder_append(sb, char_to_str(hex_char(lo)))
            j = j + 1
        }
        var chunk = str_builder_to_str(sb)
        str_builder_free(sb)
        var sbp = str_builder_new()
        str_builder_append(sbp, "python3 -c 'open(\"")
        str_builder_append(sbp, path)
        str_builder_append(sbp, "\",\"ab\").write(bytes.fromhex(\"")
        str_builder_append(sbp, chunk)
        str_builder_append(sbp, "\"))'")
        var pyc = str_builder_to_str(sbp)
        str_builder_free(sbp)
        if host_system(pyc) != 0 {
            return 1
        }
        pos = pos + take
    }
    var sb2 = str_builder_new()
    str_builder_append(sb2, "chmod +x ")
    str_builder_append(sb2, path)
    var cmd2 = str_builder_to_str(sb2)
    str_builder_free(sb2)
    return host_system(cmd2)
}

// Write UTF-8-ish ASCII (one byte per str_byte) via chunked hex + python append.
func native_write_text_bytes(path: str, data: str): int {
    var b0 = str_builder_new()
    str_builder_append(b0, "rm -f ")
    str_builder_append(b0, path)
    var cmd0 = str_builder_to_str(b0)
    str_builder_free(b0)
    if host_system(cmd0) != 0 {
        return 1
    }
    var n = str_len(data)
    var pos = 0
    while (pos < n) {
        var take = 64000
        if (pos + take > n) {
            take = n - pos
        }
        var sb = str_builder_new()
        var j = 0
        while (j < take) {
            var b = str_byte(data, pos + j)
            var hi = (b / 16) & 15
            var lo = b & 15
            str_builder_append(sb, char_to_str(hex_char(hi)))
            str_builder_append(sb, char_to_str(hex_char(lo)))
            j = j + 1
        }
        var chunk = str_builder_to_str(sb)
        str_builder_free(sb)
        var sbp = str_builder_new()
        str_builder_append(sbp, "python3 -c 'open(\"")
        str_builder_append(sbp, path)
        str_builder_append(sbp, "\",\"ab\").write(bytes.fromhex(\"")
        str_builder_append(sbp, chunk)
        str_builder_append(sbp, "\"))'")
        var pyc = str_builder_to_str(sbp)
        str_builder_free(sbp)
        if host_system(pyc) != 0 {
            return 1
        }
        pos = pos + take
    }
    return 0
}

// Emit gas from IR and link with prebuilt runtime (.o) + small crt (requires cc on PATH).
func native_build_linked_with_runtime(asm: str, exe_out: str, runtime_o: str, quiet: int): int {
    var root = host_getenv("ROOT_DIR")
    if str_len(root) == 0 {
        root = "."
    }
    var user_s = "/tmp/diva-user.s"
    var user_o = "/tmp/diva-user.o"
    var crt_o = "/tmp/diva-native-crt.o"
    var crt_src = str_concat(root, "/compiler/res/native_crt.s")
    if native_write_text_bytes(user_s, asm) != 0 {
        if quiet == 0 {
            err_line("native link: writing /tmp/diva-user.s failed")
        }
        return 1
    }
    var b1 = str_builder_new()
    str_builder_append(b1, "cc -c -o ")
    str_builder_append(b1, user_o)
    str_builder_append(b1, " ")
    str_builder_append(b1, user_s)
    str_builder_append(b1, " -no-pie -fno-stack-protector")
    var c1 = str_builder_to_str(b1)
    str_builder_free(b1)
    if host_system(c1) != 0 {
        if quiet == 0 {
            err_line("native link: cc -c user.s failed (need cc on PATH)")
        }
        return 1
    }
    var b2 = str_builder_new()
    str_builder_append(b2, "cc -c -fPIC -o ")
    str_builder_append(b2, crt_o)
    str_builder_append(b2, " ")
    str_builder_append(b2, crt_src)
    str_builder_append(b2, " -no-pie")
    var c2 = str_builder_to_str(b2)
    str_builder_free(b2)
    if host_system(c2) != 0 {
        if quiet == 0 {
            err_line("native link: cc -c native_crt.s failed (check ROOT_DIR and compiler/res/native_crt.s)")
        }
        return 1
    }
    var b3 = str_builder_new()
    str_builder_append(b3, "cc -no-pie -nostartfiles ")
    str_builder_append(b3, crt_o)
    str_builder_append(b3, " ")
    str_builder_append(b3, user_o)
    str_builder_append(b3, " ")
    str_builder_append(b3, runtime_o)
    str_builder_append(b3, " -o ")
    str_builder_append(b3, exe_out)
    str_builder_append(b3, " -lc -Wl,-z,noexecstack")
    var c3 = str_builder_to_str(b3)
    str_builder_free(b3)
    if host_system(c3) != 0 {
        if quiet == 0 {
            err_line("native link: final cc link failed (runtime .o + -lc)")
        }
        return 1
    }
    var b4 = str_builder_new()
    str_builder_append(b4, "chmod +x ")
    str_builder_append(b4, exe_out)
    var c4 = str_builder_to_str(b4)
    str_builder_free(b4)
    if host_system(c4) != 0 {
        return 1
    }
    return 0
}

// Split ELF phdr helpers: native codegen cannot pass >6 ints to one callee (rdi gets clobbered).
func make_phdr_ro_load(out: int, file_size: int, align: int): int {
    int_vec_push(out, 1)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 4)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, file_size & 255)
    int_vec_push(out, (file_size / 256) & 255)
    int_vec_push(out, (file_size / 65536) & 255)
    int_vec_push(out, (file_size / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, file_size & 255)
    int_vec_push(out, (file_size / 256) & 255)
    int_vec_push(out, (file_size / 65536) & 255)
    int_vec_push(out, (file_size / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, align & 255)
    int_vec_push(out, (align / 256) & 255)
    int_vec_push(out, (align / 65536) & 255)
    int_vec_push(out, (align / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    return 0
}

// Second half of make_phdr_rx_load: emits code_len, code_size, and final align fields.
func make_phdr_rx_load_b(out: int, code_len: int, code_size: int, align: int): int {
    int_vec_push(out, code_len & 255)
    int_vec_push(out, (code_len / 256) & 255)
    int_vec_push(out, (code_len / 65536) & 255)
    int_vec_push(out, (code_len / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, code_size & 255)
    int_vec_push(out, (code_size / 256) & 255)
    int_vec_push(out, (code_size / 65536) & 255)
    int_vec_push(out, (code_size / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, align & 255)
    int_vec_push(out, (align / 256) & 255)
    int_vec_push(out, (align / 65536) & 255)
    int_vec_push(out, (align / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    return 0
}

func make_phdr_rx_load(out: int, code_len: int, code_size: int, align: int): int {
    int_vec_push(out, 1)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 5)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, align & 255)
    int_vec_push(out, (align / 256) & 255)
    int_vec_push(out, (align / 65536) & 255)
    int_vec_push(out, (align / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, align & 255)
    int_vec_push(out, (align / 256) & 255)
    int_vec_push(out, (align / 65536) & 255)
    int_vec_push(out, (align / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, align & 255)
    int_vec_push(out, (align / 256) & 255)
    int_vec_push(out, (align / 65536) & 255)
    int_vec_push(out, (align / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    make_phdr_rx_load_b(out, code_len, code_size, align)
    return 0
}

// Prefer DI_RUNTIME_O; otherwise bootstrap/runtime-linux-amd64.o under ROOT_DIR (or ".").
func di_runtime_object_path(): str {
    var v = host_getenv("DI_RUNTIME_O")
    if str_len(v) != 0 {
        return v
    }
    var root = host_getenv("ROOT_DIR")
    if str_len(root) == 0 {
        root = "."
    }
    var guess = str_concat(root, "/bootstrap/runtime-linux-amd64.o")
    if (file_size(guess) < 0) {
        var empty = ""
        return empty
    }
    return guess
}

func native_force_no_external(): int {
    var v = host_getenv("DIVA_NO_EXTERNAL")
    if str_eq(v, "1") == 1 { return 1 }
    if str_eq(v, "true") == 1 { return 1 }
    if str_eq(v, "yes") == 1 { return 1 }
    return 0
}

func native_require_no_externs(m: int, src: str, toks: int): int {
    var ec = mod_extern_count(m)
    var unresolved = 0
    var i = 0
    while (i < ec) {
        var etok = int_vec_get(mod_externs(m), i)
        var nm = tok_text(src, toks, etok)
        var supported = 0
        if str_eq(nm, "write") == 1 { supported = 1 }
        if str_eq(nm, "exit") == 1 { supported = 1 }
        if str_eq(nm, "abort") == 1 { supported = 1 }
        if str_eq(nm, "print_str") == 1 { supported = 1 }
        if str_eq(nm, "print_int") == 1 { supported = 1 }
        if str_eq(nm, "str_len") == 1 { supported = 1 }
        if str_eq(nm, "str_byte") == 1 { supported = 1 }
        if str_eq(nm, "str_eq") == 1 { supported = 1 }
        if str_eq(nm, "int_vec_new") == 1 { supported = 1 }
        if str_eq(nm, "int_vec_push") == 1 { supported = 1 }
        if str_eq(nm, "int_vec_len") == 1 { supported = 1 }
        if str_eq(nm, "int_vec_get") == 1 { supported = 1 }
        if str_eq(nm, "int_vec_free") == 1 { supported = 1 }
        if str_eq(nm, "str_builder_new") == 1 { supported = 1 }
        if str_eq(nm, "str_builder_append") == 1 { supported = 1 }
        if str_eq(nm, "str_builder_len") == 1 { supported = 1 }
        if str_eq(nm, "str_builder_to_str") == 1 { supported = 1 }
        if str_eq(nm, "str_builder_free") == 1 { supported = 1 }
        if str_eq(nm, "print_hex") == 1 { supported = 1 }
        if str_eq(nm, "int_to_str") == 1 { supported = 1 }
        if str_eq(nm, "str_slice") == 1 { supported = 1 }
        if str_eq(nm, "file_size") == 1 { supported = 1 }
        if str_eq(nm, "read_file") == 1 { supported = 1 }
        if str_eq(nm, "host_argc") == 1 { supported = 1 }
        if str_eq(nm, "host_argv") == 1 { supported = 1 }
        if str_eq(nm, "host_getenv") == 1 { supported = 1 }
        if str_eq(nm, "host_system") == 1 { supported = 1 }
        if supported == 0 {
            if unresolved == 0 {
                err_line("native pure mode: unresolved extern runtime dependencies remain:")
            }
            stderr("  - ")
            stderr(nm)
            stderr(char_to_str(10))
            unresolved = unresolved + 1
        }
        i = i + 1
    }
    if unresolved != 0 {
        err_line("native pure mode: disable DIVA_NO_EXTERNAL or implement these builtins in pure ELF path")
        return 1
    }
    return 0
}

// Emit ELF binary from code bytes (main_ent = entry offset) and write to exe_out. Returns 0 on success.
func native_emit_elf_hdr(elf: int, entry: int): int {
    int_vec_push(elf, 127) int_vec_push(elf, 69) int_vec_push(elf, 76) int_vec_push(elf, 70)
    int_vec_push(elf, 2) int_vec_push(elf, 1) int_vec_push(elf, 1) int_vec_push(elf, 0)
    var i = 0 while (i < 8) { int_vec_push(elf, 0) i = i + 1 }
    int_vec_push(elf, 3) int_vec_push(elf, 0)
    int_vec_push(elf, 62) int_vec_push(elf, 0)
    int_vec_push(elf, 1) int_vec_push(elf, 0) int_vec_push(elf, 0) int_vec_push(elf, 0)
    int_vec_push(elf, entry & 255)
    int_vec_push(elf, (entry / 256) & 255)
    int_vec_push(elf, (entry / 65536) & 255)
    int_vec_push(elf, (entry / 16777216) & 255)
    int_vec_push(elf, 0) int_vec_push(elf, 0) int_vec_push(elf, 0) int_vec_push(elf, 0)
    int_vec_push(elf, 64) i = 1 while (i < 8) { int_vec_push(elf, 0) i = i + 1 }
    i = 0 while (i < 8) { int_vec_push(elf, 0) i = i + 1 }
    int_vec_push(elf, 0) int_vec_push(elf, 0) int_vec_push(elf, 0) int_vec_push(elf, 0)
    int_vec_push(elf, 64) int_vec_push(elf, 0)
    int_vec_push(elf, 56) int_vec_push(elf, 0)
    int_vec_push(elf, 2) int_vec_push(elf, 0)
    int_vec_push(elf, 0) int_vec_push(elf, 0)
    int_vec_push(elf, 0) int_vec_push(elf, 0)
    int_vec_push(elf, 0) int_vec_push(elf, 0)
    return 0
}

func native_emit_pure_elf(code: int, main_ent: int, exe_out: str, quiet: int): int {
    var code_len = int_vec_len(code)
    var align = 4096
    var code_size = code_len
    var rem = code_size % align
    if rem != 0 { code_size = code_size + align - rem }
    var file_sz = align + code_size
    var elf = int_vec_new()
    var entry = 4096 + main_ent
    native_emit_elf_hdr(elf, entry)
    make_phdr_ro_load(elf, file_sz, align)
    make_phdr_rx_load(elf, code_len, code_size, align)
    var i = int_vec_len(elf) while (i < align) { int_vec_push(elf, 0) i = i + 1 }
    i = 0 while (i < code_len) { int_vec_push(elf, int_vec_get(code, i)) i = i + 1 }
    i = code_len while (i < code_size) { int_vec_push(elf, 0) i = i + 1 }
    var res = native_write_exe(elf, exe_out)
    int_vec_free(elf)
    if res != 0 {
        if quiet == 0 { err_line("build: writing native ELF failed (native_write_exe); need working sh, python3, and chmod on PATH") }
        return 1
    }
    return 0
}

// quiet: when 1, omit stderr on failure (caller may fall back to bootstrap).
func native_compile_and_link(merged_src: str, quiet: int): int {
    var stream = lex_source(merged_src)
    if stream == 0 {
        if quiet == 0 { err_line("lexer error") }
        return 1
    }
    var pr = parse_source(merged_src, stream, 0)
    if int_vec_get(pr, 1) != 0 {
        if quiet == 0 { err_line("parse error") }
        return 1
    }
    var ast = int_vec_get(pr, 0)
    if sema_file_only_native_subset(ast) == 0 {
        if quiet == 0 { err_line("native build: unsupported surface (package/struct/class/trait/toplevel let)") }
        return 1
    }
    if sema_check_file(merged_src, stream, ast) != 0 { return 1 }
    var ir_result = build_ir(merged_src, stream, ast)
    var m = int_vec_get(ir_result, 0)
    var strv = int_vec_get(ir_result, 1)
    var exe_out = native_tmp_exe()
    var rt_o = di_runtime_object_path()
    if native_force_no_external() == 1 { rt_o = "" }
    if str_len(rt_o) != 0 {
        var asm_text = cg_module_to_str(m, merged_src, stream, strv, newline_str())
        if (file_size(rt_o) < 0) {
            if quiet == 0 { err_line("native build: runtime object not readable (DI_RUNTIME_O or ROOT_DIR/bootstrap/runtime-linux-amd64.o)") }
            return 1
        }
        if native_build_linked_with_runtime(asm_text, exe_out, rt_o, quiet) == 0 { return 0 }
        return 1
    }
    if native_require_no_externs(m, merged_src, stream) != 0 { return 1 }
    var code = int_vec_new()
    var main_ent = cg_module_to_bin(m, merged_src, stream, strv, code)
    if main_ent < 0 {
        if quiet == 0 { err_line("native codegen failed: unresolved branch/call target or offset-size mismatch") }
        int_vec_free(code)
        return 1
    }
    return native_emit_pure_elf(code, main_ent, exe_out, quiet)
}

// 1 = source needs the bootstrap compiler (parse/native-subset gap); 0 = try native pipeline.
func native_driver_should_delegate(merged: str): int {
    return 0
}

func err_line(msg: str): int {
    stderr(msg)
    stderr(char_to_str(10))
    return 0
}

func read_source(path: str): str {
    if (file_size(path) < 0) {
        stderr("error: cannot read file: ")
        stderr(path)
        stderr(char_to_str(10))
        return ""
    }
    return read_file(path)
}

func path_is_diva_file(p: str): int {
    var n = str_len(p)
    if (n < 5) {
        return 0
    }
    var suf = str_slice(p, n - 5, 5)
    return str_eq(suf, ".diva")
}

func build_path_is_package_dir(path: str): int {
    if path_is_diva_file(path) == 1 {
        return 0
    }
    return path_is_package_dir(path)
}

// Real LF byte from file — Diva `"\n"` in source is two chars (backslash + n), not ASCII 10.
func newline_str(): str {
    var s = read_file("compiler/res/lf.txt")
    if (!(str_len(s) < 1)) {
        return str_slice(s, 0, 1)
    }
    s = read_file("res/lf.txt")
    if (!(str_len(s) < 1)) {
        return str_slice(s, 0, 1)
    }
    var empty = ""
    return empty
}

func cmd_lex(path: str): int {
    return lex_file_to_stdout(path)
}

func cmd_parse(path: str): int {
    var src = read_source(path)
    if str_len(src) == 0 { return 1 }
    var stream = lex_source(src)
    if stream == 0 { err_line("lexer error") return 1 }
    var pr = parse_source(src, stream, 0)
    var ast = int_vec_get(pr, 0)
    var had_err = int_vec_get(pr, 1)
    if had_err != 0 { err_line("parse failed") return 1 }
    var children = ast_child(ast, 0)
    var n = int_vec_len(children)
    var b = str_builder_new()
    str_builder_append(b, "parsed ")
    str_builder_append(b, int_to_str(n))
    str_builder_append(b, " top-level declarations")
    print_str(str_builder_to_str(b))
    str_builder_free(b)
    return 0
}

func cmd_ir(path: str): int {
    var src = merge_file_sources(path)
    if str_len(src) == 0 { return 1 }
    var stream = lex_source(src)
    if stream == 0 { return 1 }
    var pr = parse_source(src, stream, 0)
    var ast = int_vec_get(pr, 0)
    if int_vec_get(pr, 1) != 0 { err_line("parse failed") return 1 }
    if sema_check_file(src, stream, ast) != 0 { return 1 }
    var ir_result = build_ir(src, stream, ast)
    var m = int_vec_get(ir_result, 0)
    dump_module(m, src, stream)
    return 0
}

func cmd_asm(path: str): int {
    var src = merge_file_sources(path)
    if str_len(src) == 0 { return 1 }
    var stream = lex_source(src)
    if stream == 0 { return 1 }
    var pr = parse_source(src, stream, 0)
    var ast = int_vec_get(pr, 0)
    if int_vec_get(pr, 1) != 0 { print_str("parse failed") return 1 }
    if sema_check_file(src, stream, ast) != 0 { return 1 }
    var ir_result = build_ir(src, stream, ast)
    var m = int_vec_get(ir_result, 0)
    cg_module_print(m, src, stream, int_vec_get(ir_result, 1), newline_str())
    return 0
}

func cmd_emit_ir(path: str): int {
    var src = merge_file_sources(path)
    if str_len(src) == 0 { return 1 }
    var stream = lex_source(src)
    if stream == 0 { return 1 }
    var pr = parse_source(src, stream, 1)
    if int_vec_get(pr, 1) != 0 {
        err_line("emit-ir: parse failed")
        return 1
    }
    var ast = int_vec_get(pr, 0)
    if sema_check_file(src, stream, ast) != 0 { return 1 }
    var ir_result = build_ir(src, stream, ast)
    var m = int_vec_get(ir_result, 0)
    dump_module(m, src, stream)
    return 0
}

func cmd_build_ast(path: str): int {
    var src = read_source(path)
    if str_len(src) == 0 { return 1 }
    var stream = lex_source(src)
    if stream == 0 { return 1 }
    var pr = parse_source(src, stream, 0)
    var ast = int_vec_get(pr, 0)
    if int_vec_get(pr, 1) != 0 {
        err_line("parse failed")
        return 1
    }
    ast_dump_program(path, src, stream, ast, newline_str())
    return 0
}

func pick_build_path(): str {
    var path = ""
    var i = 2
    while (i < host_argc()) {
        var a = host_argv(i)
        if str_byte(a, 0) != 45 {
            if str_len(path) == 0 {
                path = a
            }
        }
        i = i + 1
    }
    return path
}

func build_wants_ast(): int {
    var i = 2
    while (i < host_argc()) {
        if str_eq(host_argv(i), "--ast") == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

// Lex + parse + sema for a lib/app package (merged sources). Kernel packages still use the seed.
func cmd_check(): int {
    if (host_argc() < 3) {
        err_line("usage: diva check <package-dir>")
        return 1
    }
    var path = host_argv(2)
    if path_is_package_dir(path) == 0 {
        err_line("check: expected a package directory (with package.diva)")
        return 1
    }
    if package_is_kernel_dir(path) == 1 {
        return forward_bootstrap_argv()
    }
    var merged = merge_package_sources(path)
    if str_len(merged) == 0 {
        if (str_len(bootstrap_path()) > 0) {
            return forward_bootstrap_argv()
        }
        return 1
    }
    if native_driver_should_delegate(merged) == 1 {
        if str_len(bootstrap_path()) == 0 {
            err_line("native driver: set DIVA_BOOTSTRAP (or DI_BOOTSTRAP) for this source")
            return 1
        }
        return forward_bootstrap_argv()
    }
    var stream = lex_source(merged)
    if stream == 0 {
        err_line("lexer error")
        return 1
    }
    var pr = parse_source(merged, stream, 0)
    if int_vec_get(pr, 1) != 0 {
        err_line("check: parse failed")
        return 1
    }
    var ast = int_vec_get(pr, 0)
    if sema_check_file(merged, stream, ast) != 0 {
        return 1
    }
    return 0
}

func cmd_build(): int {
    var path = pick_build_path()
    if str_len(path) == 0 {
        err_line("build: missing output path (e.g. diva build compiler)")
        return 1
    }
    if build_wants_ast() == 1 {
        if path_is_package_dir(path) == 1 {
            err_line("build --ast: use a single .diva file")
            return 1
        }
        if path_is_diva_file(path) == 0 {
            err_line("build --ast: expected a .diva file")
            return 1
        }
        return cmd_build_ast(path)
    }
    if build_path_is_package_dir(path) == 1 {
        if package_is_kernel_dir(path) == 1 {
            return forward_bootstrap_argv()
        }
    }
    var merged = ""
    if build_path_is_package_dir(path) == 1 {
        merged = merge_package_sources(path)
        if str_len(merged) == 0 {
            if (str_len(bootstrap_path()) > 0) {
                return forward_bootstrap_argv()
            }
            return 1
        }
    } else {
        if path_is_diva_file(path) == 0 {
            err_line("build: expected a .diva file or a package directory containing package.diva")
            return 1
        }
        // Use merged source to handle imports
        merged = merge_file_sources(path)
        if str_len(merged) == 0 {
            merged = read_source(path)
        }
    }
    if str_len(merged) == 0 {
        return 1
    }
    if native_driver_should_delegate(merged) == 1 {
        if str_len(bootstrap_path()) == 0 {
            err_line("native driver: set DIVA_BOOTSTRAP (or DI_BOOTSTRAP) for this source")
            return 1
        }
        return forward_bootstrap_argv()
    }
    if native_compile_and_link(merged, 0) != 0 {
        return 1
    }
    print_str("[native] built executable at ")
    print_str(native_tmp_exe())
    stdout(newline_str())
    return 0
}

func cmd_run_file(path: str): int {
    var merged = ""
    if build_path_is_package_dir(path) == 1 {
        merged = merge_package_sources(path)
        if str_len(merged) == 0 {
            if (str_len(bootstrap_path()) > 0) {
                return forward_bootstrap_argv()
            }
            return 1
        }
    } else {
        if path_is_diva_file(path) == 0 {
            err_line("run: expected a .diva file or a package directory")
            return 1
        }
        // Use merged source to handle imports
        merged = merge_file_sources(path)
        if str_len(merged) == 0 {
            merged = read_source(path)
        }
    }
    if str_len(merged) == 0 {
        return 1
    }
    if native_driver_should_delegate(merged) == 1 {
        if str_len(bootstrap_path()) == 0 {
            err_line("native driver: set DIVA_BOOTSTRAP (or DI_BOOTSTRAP) for this source")
            return 1
        }
        return forward_bootstrap_argv()
    }
    var quiet_native = 0
    if (str_len(bootstrap_path()) > 0) {
        quiet_native = 1
    }
    if native_compile_and_link(merged, quiet_native) != 0 {
        if (str_len(bootstrap_path()) > 0) {
            return forward_bootstrap_argv()
        }
        return 1
    }
    var rc = host_system(native_tmp_exe())
    return system_exit_code(rc)
}

func main(): int {
    if (host_argc() < 2) {
        return cmd_print_usage()
    }
    var a1 = host_argv(1)

    if str_eq(a1, "check") == 1 {
        return cmd_check()
    }

    if str_eq(a1, "new") == 1 {
        return forward_bootstrap_argv()
    }

    if str_eq(a1, "lex") == 1 {
        if (host_argc() < 3) {
            err_line("usage: diva lex <file.diva>")
            return 1
        }
        return cmd_lex(host_argv(2))
    }

    if str_eq(a1, "parse") == 1 {
        if (host_argc() < 3) {
            err_line("usage: diva parse <file.diva>")
            return 1
        }
        return cmd_parse(host_argv(2))
    }

    if str_eq(a1, "ir") == 1 {
        if (host_argc() < 3) {
            err_line("usage: diva ir <file.diva>")
            return 1
        }
        return cmd_ir(host_argv(2))
    }

    if str_eq(a1, "asm") == 1 {
        if (host_argc() < 3) {
            err_line("usage: diva asm <file.diva>")
            return 1
        }
        return cmd_asm(host_argv(2))
    }

    if str_eq(a1, "emit-ir") == 1 {
        if (host_argc() < 3) {
            err_line("usage: diva emit-ir <file.diva|package-dir>")
            return 1
        }
        var p = host_argv(2)
        if path_is_package_dir(p) == 1 {
            return forward_bootstrap_argv()
        }
        if path_is_diva_file(p) == 0 {
            err_line("emit-ir: expected a .diva file or package directory")
            return 1
        }
        return cmd_emit_ir(p)
    }

    if str_eq(a1, "build") == 1 {
        return cmd_build()
    }

    if str_eq(a1, "run") == 1 {
        if (host_argc() < 3) {
            err_line("usage: diva run <file.diva|package-dir>")
            return 1
        }
        return cmd_run_file(host_argv(2))
    }

    if str_eq(a1, "compiler-version") == 1 {
        print_str("diva compiler v0.5.0")
        print_str("  native: lex, parse, sema, Diva IR, x86_64 binary (ELF PIE)")
        print_str("  build/run: single .diva or package directory (pure native, no cc/as/ld)")
        return 0
    }

    if str_eq(a1, "pipeline") == 1 {
        print_str("Diva compiler pipeline:")
        print_str("  source -> lexer -> parser -> AST -> sema -> IR -> x86_64 binary -> ELF PIE")
        return 0
    }

    err_line("unknown command; try: diva (no args shows usage)")
    return 1
}
