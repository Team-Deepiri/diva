// Second positional after source: `diva build <src> <out>`. Else DIVA_NATIVE_EXE_OUT, else build/diva-native-exe.
func pick_build_out_path(): str {
    var first = ""
    var second = ""
    var i = 2
    while (i < host_argc()) {
        var a = host_argv(i)
        if str_eq(a, "--target") == 1 {
            i = i + 2
        } else {
            if str_byte(a, 0) != 45 {
                if str_len(first) == 0 {
                    first = a
                } else {
                    if str_len(second) == 0 {
                        second = a
                    }
                }
            }
            i = i + 1
        }
    }
    if str_len(second) > 0 {
        return second
    }
    var envp = host_getenv("DIVA_NATIVE_EXE_OUT")
    if str_len(envp) > 0 {
        return envp
    }
    return native_default_exe_out()
}

