// Diva compiler driver.
// Commands handled natively (in Diva):
//   diva lex <file>            — tokenize and dump tokens
//   diva parse <file>          — parse and report declarations
//   diva ir <file>             — lower to Diva IR and dump
//   diva asm <file>            — generate x86_64 assembly
//   diva compiler-version      — print version info
//   diva pipeline              — show compiler pipeline stages
// All other commands forwarded to the bootstrap seed binary.

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "cell.diva"
import "tokens.diva"
import "lexer.diva"
import "ast.diva"
import "parser.diva"
import "ir.diva"
import "ir_builder.diva"
import "ir_dump.diva"
import "codegen_x86.diva"

func bootstrap_path(): str {
    var p = host_getenv("DIVA_BOOTSTRAP")
    if str_len(p) > 0 {
        return p
    }
    p = host_getenv("DI_BOOTSTRAP")
    if str_len(p) > 0 {
        return p
    }
    return "bootstrap/diva-linux-amd64"
}

func forward_to_seed(): int {
    var b = str_builder_new()
    if b == 0 {
        return 1
    }
    str_builder_append(b, bootstrap_path())
    var i = 1
    while i < host_argc() {
        str_builder_append(b, " ")
        str_builder_append(b, host_argv(i))
        i = i + 1
    }
    var cmd = str_builder_to_str(b)
    str_builder_free(b)
    var r = host_system(cmd)
    if r < 0 {
        return 1
    }
    if r == 0 {
        return 0
    }
    if r < 256 {
        return r
    }
    return r / 256
}

func read_source(path: str): str {
    if file_size(path) < 0 {
        stderr("error: cannot read file: ")
        stderr(path)
        stderr("\n")
        return ""
    }
    return read_file(path)
}

func cmd_lex(path: str): int {
    return lex_file_to_stdout(path)
}

func cmd_parse(path: str): int {
    var src = read_source(path)
    if str_len(src) == 0 { return 1 }
    var stream = lex_source(src)
    if stream == 0 { stderr("lexer error\n") return 1 }
    var pr = parse_source(src, stream)
    var ast = int_vec_get(pr, 0)
    var had_err = int_vec_get(pr, 1)
    if had_err != 0 { stderr("parse failed\n") return 1 }
    var children = ast_child(ast, 0)
    var n = int_vec_len(children)
    var b = str_builder_new()
    str_builder_append(b, "parsed ")
    str_builder_append(b, int_to_str(n))
    str_builder_append(b, " top-level declarations")
    print_str(str_builder_to_str(b))
    str_builder_free(b)
    return 0
}

func cmd_ir(path: str): int {
    var src = read_source(path)
    if str_len(src) == 0 { return 1 }
    var stream = lex_source(src)
    if stream == 0 { return 1 }
    var pr = parse_source(src, stream)
    var ast = int_vec_get(pr, 0)
    if int_vec_get(pr, 1) != 0 { stderr("parse failed\n") return 1 }
    var ir_result = build_ir(src, stream, ast)
    var m = int_vec_get(ir_result, 0)
    dump_module(m)
    return 0
}

func cmd_asm(path: str): int {
    var src = read_source(path)
    if str_len(src) == 0 { return 1 }
    var stream = lex_source(src)
    if stream == 0 { return 1 }
    var pr = parse_source(src, stream)
    var ast = int_vec_get(pr, 0)
    if int_vec_get(pr, 1) != 0 { print_str("parse failed") return 1 }
    var ir_result = build_ir(src, stream, ast)
    var m = int_vec_get(ir_result, 0)
    var strvec = int_vec_get(ir_result, 1)
    cg_module_print(m, src, stream, strvec)
    return 0
}

func main(): int {
    if host_argc() < 2 {
        return forward_to_seed()
    }
    var a1 = host_argv(1)

    if str_eq(a1, "lex") == 1 {
        if host_argc() < 3 {
            stderr("usage: diva lex <file.diva>\n")
            return 1
        }
        return cmd_lex(host_argv(2))
    }

    if str_eq(a1, "parse") == 1 {
        if host_argc() < 3 {
            stderr("usage: diva parse <file.diva>\n")
            return 1
        }
        return cmd_parse(host_argv(2))
    }

    if str_eq(a1, "ir") == 1 {
        if host_argc() < 3 {
            stderr("usage: diva ir <file.diva>\n")
            return 1
        }
        return cmd_ir(host_argv(2))
    }

    if str_eq(a1, "asm") == 1 {
        if host_argc() < 3 {
            stderr("usage: diva asm <file.diva>\n")
            return 1
        }
        return cmd_asm(host_argv(2))
    }

    if str_eq(a1, "compiler-version") == 1 {
        print_str("diva compiler v0.3.0")
        print_str("  native stages: lex, parse, ir, asm (all in Diva)")
        print_str("  fallback: seed binary for build/run/emit-ir/check")
        return 0
    }

    if str_eq(a1, "pipeline") == 1 {
        print_str("Diva compiler pipeline:")
        print_str("  source.diva -> lexer -> tokens -> parser -> AST")
        print_str("    -> IR builder -> Diva IR -> x86_64 codegen -> assembly")
        print_str("  All stages implemented in Diva.")
        print_str("  Backend target: GNU as + ld (no LLVM required)")
        return 0
    }

    return forward_to_seed()
}
