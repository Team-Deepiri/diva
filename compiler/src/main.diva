// When DIVA_NATIVE_CMD_IR_DEBUG is non-empty, cmd_ir prints stderr milestones (native-driver bring-up).
func native_cmd_ir_debug(): int {
    var v = host_getenv("DIVA_NATIVE_CMD_IR_DEBUG")
    var v_hold = v
    if str_len(v_hold) > 0 { return 1 }
    return 0
}

func target_flag_missing_value(): int {
    var i = 2
    while i < host_argc() {
        if str_eq(host_argv(i), "--target") == 1 {
            if i + 1 >= host_argc() {
                return 1
            }
        }
        i = i + 1
    }
    return 0
}

func target_flag_value(): str {
    var i = 2
    while i < host_argc() {
        if str_eq(host_argv(i), "--target") == 1 {
            var raw = host_argv(i + 1)
            var raw_hold = raw
            return str_slice(raw_hold, 0, str_len(raw_hold))
        }
        i = i + 1
    }
    return ""
}

func target_from_args(): str {
    var flag_seen = 0
    var i = 2
    while i < host_argc() {
        if str_eq(host_argv(i), "--target") == 1 { flag_seen = 1 }
        i = i + 1
    }
    if flag_seen == 0 { return target_native_name() }
    if target_flag_missing_value() == 1 {
        err_line(target_missing_value_error())
        return ""
    }
    var raw = target_flag_value()
    var st = target_status(raw)
    if st == target_status_ok() { return target_canonical(raw) }
    if st == target_status_unsupported() {
        err_line(target_unsupported_error(raw))
        return ""
    }
    err_line(target_malformed_error(raw))
    return ""
}

func cmd_print_usage(): int {
    stderr("usage: diva <command> [args]\n")
    stderr("  lex <file.diva> | parse <file.diva> | ir [--types] <file.diva> | asm <file.diva>\n")
    stderr("  grad <file.diva> <func>  (emit #[differentiate] companion functions)\n")
    stderr("  analyze [--escape] <file.diva>\n")
    stderr("  opt [--no-opt] [--no-inline] <file.diva> (dump optimized / unoptimized IR)\n")
    stderr("  emit-ir <file.diva|package-dir> | emit-mlir [--auto] <file.diva>\n")
    stderr("  build <file.diva|package-dir> [--ast|-g|--debug-info|--no-inline]\n")
    stderr("  run [--no-inline] <file.diva|package-dir>\n")
    stderr("  watch <file.diva|package-dir> | check <package-dir> | new <path> [--lib|--kernel]\n")
    stderr("  compiler-version | pipeline | target <list|current>\n")
    stderr("  build|ir|opt [--target <triple>] ...   (native: x86_64-linux-gnu)\n")
    stderr("  text <inspect|count|upper|lower|width|lines|words|contains> <file>\n")
    stderr("  onnx-check <file.onnx.txt> | onnx-run <file.onnx.txt> | onnx-mlir <file.onnx.txt>\n")
    stderr("Environment: DI_STDLIB_DIR (stdlib search path)\n")
    stderr("  DIVA_WATCH_MAX_ITERS=N exits after N poll cycles (CI smoke)\n")
    stderr("  diva build --debug-info emits native DWARF v4 line tables (no python3 needed)\n")
    stderr("  diva build -g embeds DWARF via scripts/embed-dwarf-debug.py (needs python3)\n")
    stderr("  diva new <path> [--lib|--kernel|--system] (native scaffolding)\n")
    return 1
}

// Default write target when `build` has no second path and DIVA_NATIVE_EXE_OUT is unset.
// Prefer ROOT_DIR/build/ — never /tmp (wiped; we already lost good builds that way).
func native_default_exe_out(): str {
    var root = host_getenv("ROOT_DIR")
    if str_len(root) > 0 {
        return path_join_dir(root, "build/diva-native-exe")
    }
    return "build/diva-native-exe"
}

func native_tmp_exe(): str {
    return native_default_exe_out()
}

func system_exit_code(rc: int): int {
    if (rc < 0) {
        return 1
    }
    if rc == 0 {
        return 0
    }
    if (rc < 256) {
        return rc
    }
    return rc / 256
}

// Native x86_64 PIE ELF generator - no cc, no as, no ld!
func get_low_byte(x: int): int {
    return x - (x / 256) * 256
}

func encode_elf_header(out: int, code_len: int): int {
    int_vec_push(out, 127) // ELF magic
    int_vec_push(out, 69)
    int_vec_push(out, 76)
    int_vec_push(out, 70)
    int_vec_push(out, 2)   // 64-bit
    int_vec_push(out, 1)   // little endian
    int_vec_push(out, 1)   // version
    int_vec_push(out, 0)   // OS ABI
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 3)   // e_type: ET_DYN (PIE)
    int_vec_push(out, 0)
    int_vec_push(out, 62)  // e_machine: x86_64
    int_vec_push(out, 0)
    int_vec_push(out, 1)   // e_version
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_entry: 0x1000
    int_vec_push(out, 16)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 64)  // e_phoff
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_shoff
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_flags
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 64)  // e_ehsize
    int_vec_push(out, 0)
    int_vec_push(out, 56)  // e_phentsize
    int_vec_push(out, 0)
    int_vec_push(out, 1)   // e_phnum (1 segment for now)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_shentsize
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_shnum
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_shstrndx
    int_vec_push(out, 0)
    return 0
}

func encode_phdr(out: int, code_len: int): int {
    int_vec_push(out, 1)   // p_type: PT_LOAD
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 5)   // p_flags: rwx
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // p_offset
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // p_vaddr (PIE base)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // p_paddr
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    var lo = get_low_byte(code_len + 64 + 56)
    var hi = get_low_byte((code_len + 64 + 56) / 256)
    int_vec_push(out, lo)   // p_filesz
    int_vec_push(out, hi)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, lo)   // p_memsz
    int_vec_push(out, hi)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // p_align
    int_vec_push(out, 16)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    return 0
}

func hex_char(n: int): int {
    if (n < 10) { return 48 + n }
    return 87 + n
}

// Write text via syscall-backed builtin — no shell for content.
func native_write_text_bytes(path: str, data: str): int {
    return write_text_file(path, data)
}

// Materialize ELF bytes without building one giant hex string (large programs OOM the builder).
func native_write_exe(data: int, path: str): int {
    if unlink(path) != 0 {
        return 1
    }
    var n = int_vec_len(data)
    var pos = 0
    var first = 1
    while (pos < n) {
        var take = 64000
        if (pos + take > n) {
            take = n - pos
        }
        if write_elf_chunk(path, data, pos, take, first) != 0 {
            return 1
        }
        pos = pos + take
        first = 0
    }
    if chmod_executable(path) != 0 {
        return 1
    }
    return 0
}

// Split ELF phdr helpers: native codegen cannot pass >6 ints to one callee (rdi gets clobbered).
func make_phdr_ro_load(out: int, file_size: int, align: int): int {
    int_vec_push(out, 1)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 4)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, file_size & 255)
    int_vec_push(out, (file_size / 256) & 255)
    int_vec_push(out, (file_size / 65536) & 255)
    int_vec_push(out, (file_size / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, file_size & 255)
    int_vec_push(out, (file_size / 256) & 255)
    int_vec_push(out, (file_size / 65536) & 255)
    int_vec_push(out, (file_size / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, align & 255)
    int_vec_push(out, (align / 256) & 255)
    int_vec_push(out, (align / 65536) & 255)
    int_vec_push(out, (align / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    return 0
}

// Second half of make_phdr_rx_load: emits code_len, code_size, and final align fields.
func make_phdr_rx_load_b(out: int, code_len: int, code_size: int, align: int): int {
    int_vec_push(out, code_len & 255)
    int_vec_push(out, (code_len / 256) & 255)
    int_vec_push(out, (code_len / 65536) & 255)
    int_vec_push(out, (code_len / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, code_size & 255)
    int_vec_push(out, (code_size / 256) & 255)
    int_vec_push(out, (code_size / 65536) & 255)
    int_vec_push(out, (code_size / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, align & 255)
    int_vec_push(out, (align / 256) & 255)
    int_vec_push(out, (align / 65536) & 255)
    int_vec_push(out, (align / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    return 0
}

func make_phdr_rx_load(out: int, code_len: int, code_size: int, align: int): int {
    int_vec_push(out, 1)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 5)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, align & 255)
    int_vec_push(out, (align / 256) & 255)
    int_vec_push(out, (align / 65536) & 255)
    int_vec_push(out, (align / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, align & 255)
    int_vec_push(out, (align / 256) & 255)
    int_vec_push(out, (align / 65536) & 255)
    int_vec_push(out, (align / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, align & 255)
    int_vec_push(out, (align / 256) & 255)
    int_vec_push(out, (align / 65536) & 255)
    int_vec_push(out, (align / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    make_phdr_rx_load_b(out, code_len, code_size, align)
    return 0
}

func native_require_no_externs(m: int, src: str, toks: int): int {
    // Pinned seed may lag codegen (new pure builtins). One-shot bootstrap: set
    // DIVA_SKIP_NATIVE_EXTERN_CHECK=1 when rebuilding the driver from sources.
    var skip = host_getenv("DIVA_SKIP_NATIVE_EXTERN_CHECK")
    var skip_hold = skip
    if (!(str_len(skip_hold) < 1)) {
        return 0
    }
    var ec = mod_extern_count(m)
    var unresolved = 0
    var i = 0
    while (i < ec) {
        var etok = int_vec_get(mod_externs(m), i)
        var nm = tok_text(src, toks, etok)
        var supported = 0
        if str_eq(nm, "write") == 1 { supported = 1 }
        if str_eq(nm, "exit") == 1 { supported = 1 }
        if str_eq(nm, "abort") == 1 { supported = 1 }
        if str_eq(nm, "print_str") == 1 { supported = 1 }
        if str_eq(nm, "print_int") == 1 { supported = 1 }
        if str_eq(nm, "str_len") == 1 { supported = 1 }
        if str_eq(nm, "str_byte") == 1 { supported = 1 }
        if str_eq(nm, "str_eq") == 1 { supported = 1 }
        if str_eq(nm, "int_vec_new") == 1 { supported = 1 }
        if str_eq(nm, "int_vec_push") == 1 { supported = 1 }
        if str_eq(nm, "int_vec_len") == 1 { supported = 1 }
        if str_eq(nm, "int_vec_get") == 1 { supported = 1 }
        if str_eq(nm, "int_vec_free") == 1 { supported = 1 }
        if str_eq(nm, "str_builder_new") == 1 { supported = 1 }
        if str_eq(nm, "str_builder_append") == 1 { supported = 1 }
        if str_eq(nm, "str_builder_len") == 1 { supported = 1 }
        if str_eq(nm, "str_builder_to_str") == 1 { supported = 1 }
        if str_eq(nm, "str_builder_free") == 1 { supported = 1 }
        if str_eq(nm, "print_hex") == 1 { supported = 1 }
        if str_eq(nm, "int_to_str") == 1 { supported = 1 }
        if str_eq(nm, "str_slice") == 1 { supported = 1 }
        if str_eq(nm, "file_size") == 1 { supported = 1 }
        if str_eq(nm, "read_file") == 1 { supported = 1 }
        if str_eq(nm, "host_argc") == 1 { supported = 1 }
        if str_eq(nm, "host_argv") == 1 { supported = 1 }
        if str_eq(nm, "host_getenv") == 1 { supported = 1 }
        if str_eq(nm, "host_system") == 1 { supported = 1 }
        if str_eq(nm, "mkdir") == 1 { supported = 1 }
        if str_eq(nm, "write_text_file") == 1 { supported = 1 }
        if str_eq(nm, "unlink") == 1 { supported = 1 }
        if str_eq(nm, "chmod_executable") == 1 { supported = 1 }
        if str_eq(nm, "write_elf_chunk") == 1 { supported = 1 }
        if str_eq(nm, "host_now_ns") == 1 { supported = 1 }
        if str_eq(nm, "host_sleep_ms") == 1 { supported = 1 }
        if str_eq(nm, "mem_alloc") == 1 { supported = 1 }
        if str_eq(nm, "mem_free") == 1 { supported = 1 }
        if str_eq(nm, "mem_get") == 1 { supported = 1 }
        if str_eq(nm, "mem_set") == 1 { supported = 1 }
        if str_eq(nm, "str_from_text") == 1 { supported = 1 }
        if str_eq(nm, "text_len") == 1 { supported = 1 }
        if str_eq(nm, "text_from_str") == 1 { supported = 1 }
        if str_eq(nm, "text_byte") == 1 { supported = 1 }
        if str_eq(nm, "text_cmp") == 1 { supported = 1 }
        if str_eq(nm, "text_concat") == 1 { supported = 1 }
        if str_eq(nm, "text_slice") == 1 { supported = 1 }
        if supported == 0 {
            if unresolved == 0 {
                err_line("native build: unresolved extern runtime dependencies remain:")
            }
            stderr("  - ")
            stderr(nm)
            stderr(char_to_str(10))
            unresolved = unresolved + 1
        }
        i = i + 1
    }
    if unresolved != 0 {
        err_line("native build: implement these builtins in pure ELF path (see pure_elf_builtins.diva). If the pinned seed lags new externs, set DIVA_SKIP_NATIVE_EXTERN_CHECK=1 for a one-shot driver rebuild.")
        return 1
    }
    return 0
}

func dwarf_push_u8(out: int, v: int): int {
    int_vec_push(out, v & 255)
    return 0
}

func dwarf_push_u16(out: int, v: int): int {
    int_vec_push(out, v & 255)
    int_vec_push(out, (v / 256) & 255)
    return 0
}

func dwarf_push_u32(out: int, v: int): int {
    var x = v
    var i = 0
    while (i < 4) {
        int_vec_push(out, x & 255)
        x = x / 256
        i = i + 1
    }
    return 0
}

func dwarf_push_u64(out: int, v: int): int {
    var x = v
    var i = 0
    while (i < 8) {
        int_vec_push(out, x & 255)
        x = x / 256
        i = i + 1
    }
    return 0
}

func dwarf_push_uleb(out: int, v: int): int {
    var x = v
    var more = 1
    while (more == 1) {
        var b = x & 127
        x = x / 128
        if (x > 0) {
            b = b | 128
        } else {
            more = 0
        }
        int_vec_push(out, b)
    }
    return 0
}

func dwarf_push_cstr(out: int, s: str): int {
    var text = s
    var text_hold = text
    var n = str_len(text_hold)
    var i = 0
    while (i < n) {
        int_vec_push(out, str_byte(text_hold, i) & 255)
        i = i + 1
    }
    int_vec_push(out, 0)
    return 0
}

func dwarf_append_bytes(out: int, src: int, start: int, count: int): int {
    var i = 0
    while (i < count) {
        int_vec_push(out, int_vec_get(src, start + i))
        i = i + 1
    }
    return 0
}

func dwarf_guess_entry_line(src: str): int {
    var text = src
    var text_hold = text
    var main_at = str_index_of(text_hold, "func main")
    var kmain_at = str_index_of(text_hold, "func kmain")
    var pos = 0
    if (main_at < 0) & (kmain_at >= 0) {
        pos = kmain_at
    } else {
        if main_at >= 0 {
            pos = main_at
        }
    }
    var line = 1
    var i = 0
    while (i < pos) {
        if str_byte(text_hold, i) == 10 {
            line = line + 1
        }
        i = i + 1
    }
    return line
}

func dwarf_build_abbrev(out: int): int {
    int_vec_push(out, 1)
    int_vec_push(out, 17)
    int_vec_push(out, 0)
    int_vec_push(out, 3) int_vec_push(out, 8)
    int_vec_push(out, 16) int_vec_push(out, 23)
    int_vec_push(out, 17) int_vec_push(out, 1)
    int_vec_push(out, 18) int_vec_push(out, 7)
    int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, 0)
    return 0
}

func dwarf_build_info(out: int, src_path: str, code_len: int): int {
    var body = int_vec_new()
    dwarf_push_u16(body, 4)
    dwarf_push_u32(body, 0)
    dwarf_push_u8(body, 8)
    dwarf_push_u8(body, 1)
    dwarf_push_cstr(body, src_path)
    dwarf_push_u32(body, 0)
    dwarf_push_u64(body, 4096)
    dwarf_push_u64(body, 4096 + code_len)
    dwarf_push_u8(body, 0)
    dwarf_push_u32(out, int_vec_len(body))
    dwarf_append_bytes(out, body, 0, int_vec_len(body))
    int_vec_free(body)
    return 0
}

func dwarf_build_line(out: int, src_path: str, entry_line: int, code_len: int): int {
    var header = int_vec_new()
    dwarf_push_u8(header, 1)
    dwarf_push_u8(header, 1)
    dwarf_push_u8(header, 1)
    dwarf_push_u8(header, 251)
    dwarf_push_u8(header, 14)
    dwarf_push_u8(header, 13)
    dwarf_push_u8(header, 0)
    dwarf_push_u8(header, 1)
    dwarf_push_u8(header, 1)
    dwarf_push_u8(header, 1)
    dwarf_push_u8(header, 1)
    dwarf_push_u8(header, 0)
    dwarf_push_u8(header, 0)
    dwarf_push_u8(header, 0)
    dwarf_push_u8(header, 1)
    dwarf_push_u8(header, 0)
    dwarf_push_u8(header, 0)
    dwarf_push_u8(header, 1)
    dwarf_push_u8(header, 0)
    dwarf_push_cstr(header, src_path)
    dwarf_push_uleb(header, 0)
    dwarf_push_uleb(header, 0)
    dwarf_push_uleb(header, 0)
    dwarf_push_u8(header, 0)
    var header_len = int_vec_len(header)
    var ops = int_vec_new()
    dwarf_push_u8(ops, 0)
    dwarf_push_uleb(ops, 9)
    dwarf_push_u8(ops, 2)
    dwarf_push_u64(ops, 4096)
    var delta = entry_line - 1
    if (delta < 0) {
        delta = 0
    }
    dwarf_push_u8(ops, 3)
    dwarf_push_uleb(ops, delta)
    dwarf_push_u8(ops, 1)
    dwarf_push_u8(ops, 0)
    dwarf_push_uleb(ops, 9)
    dwarf_push_u8(ops, 2)
    dwarf_push_u64(ops, 4096 + code_len)
    dwarf_push_u8(ops, 0)
    dwarf_push_uleb(ops, 1)
    dwarf_push_u8(ops, 1)
    var unit_len = 2 + 4 + header_len + int_vec_len(ops)
    dwarf_push_u32(out, unit_len)
    dwarf_push_u16(out, 4)
    dwarf_push_u32(out, header_len)
    dwarf_append_bytes(out, header, 0, header_len)
    dwarf_append_bytes(out, ops, 0, int_vec_len(ops))
    int_vec_free(header)
    int_vec_free(ops)
    return 0
}

func dwarf_shstr_add(out: int, name: str): int {
    var off = int_vec_len(out)
    dwarf_push_cstr(out, name)
    return off
}

func native_build_dwarf_sections(src_path: str, entry_line: int, code_len: int): int {
    var meta = int_vec_new()
    var abbrev = int_vec_new()
    var info = int_vec_new()
    var line = int_vec_new()
    var shstr = int_vec_new()
    dwarf_build_abbrev(abbrev)
    dwarf_build_info(info, src_path, code_len)
    dwarf_build_line(line, src_path, entry_line, code_len)
    dwarf_push_u8(shstr, 0)
    var name_text = dwarf_shstr_add(shstr, ".text")
    var name_abbrev = dwarf_shstr_add(shstr, ".debug_abbrev")
    var name_info = dwarf_shstr_add(shstr, ".debug_info")
    var name_line = dwarf_shstr_add(shstr, ".debug_line")
    var name_shstr = dwarf_shstr_add(shstr, ".shstrtab")
    int_vec_push(meta, int_vec_len(abbrev))
    int_vec_push(meta, int_vec_len(info))
    int_vec_push(meta, int_vec_len(line))
    int_vec_push(meta, int_vec_len(shstr))
    int_vec_push(meta, name_text)
    int_vec_push(meta, name_abbrev)
    int_vec_push(meta, name_info)
    int_vec_push(meta, name_line)
    int_vec_push(meta, name_shstr)
    dwarf_append_bytes(meta, abbrev, 0, int_vec_len(abbrev))
    dwarf_append_bytes(meta, info, 0, int_vec_len(info))
    dwarf_append_bytes(meta, line, 0, int_vec_len(line))
    dwarf_append_bytes(meta, shstr, 0, int_vec_len(shstr))
    int_vec_free(abbrev)
    int_vec_free(info)
    int_vec_free(line)
    int_vec_free(shstr)
    return meta
}

func dwarf_emit_shdr_head(out: int, name_off: int, sh_type: int, flags: int): int {
    dwarf_push_u32(out, name_off)
    dwarf_push_u32(out, sh_type)
    dwarf_push_u64(out, flags)
    return 0
}

func dwarf_emit_shdr_tail(out: int, addr: int, offset: int, size: int, addralign: int): int {
    dwarf_push_u64(out, addr)
    dwarf_push_u64(out, offset)
    dwarf_push_u64(out, size)
    dwarf_push_u32(out, 0)
    dwarf_push_u32(out, 0)
    dwarf_push_u64(out, addralign)
    dwarf_push_u64(out, 0)
    return 0
}

// Emit ELF binary from code bytes (main_ent = entry offset) and write to exe_out. Returns 0 on success.
func native_emit_elf_hdr(elf: int, entry: int, shoff: int, shnum: int, shstrndx: int): int {
    int_vec_push(elf, 127) int_vec_push(elf, 69) int_vec_push(elf, 76) int_vec_push(elf, 70)
    int_vec_push(elf, 2) int_vec_push(elf, 1) int_vec_push(elf, 1) int_vec_push(elf, 0)
    var i = 0 while (i < 8) { int_vec_push(elf, 0) i = i + 1 }
    int_vec_push(elf, 3) int_vec_push(elf, 0)
    int_vec_push(elf, 62) int_vec_push(elf, 0)
    int_vec_push(elf, 1) int_vec_push(elf, 0) int_vec_push(elf, 0) int_vec_push(elf, 0)
    dwarf_push_u32(elf, entry)
    dwarf_push_u32(elf, 0)
    dwarf_push_u32(elf, 64)
    dwarf_push_u32(elf, 0)
    dwarf_push_u32(elf, shoff)
    dwarf_push_u32(elf, 0)
    dwarf_push_u32(elf, 0)
    dwarf_push_u16(elf, 64)
    dwarf_push_u16(elf, 56)
    dwarf_push_u16(elf, 2)
    if shnum != 0 {
        dwarf_push_u16(elf, 64)
    } else {
        dwarf_push_u16(elf, 0)
    }
    dwarf_push_u16(elf, shnum)
    dwarf_push_u16(elf, shstrndx)
    return 0
}

func native_emit_pure_elf(code: int, main_ent: int, exe_out: str, quiet: int, dwarf: int): int {
    var code_len = int_vec_len(code)
    var align = 4096
    var code_size = code_len
    var rem = code_size % align
    if rem != 0 { code_size = code_size + align - rem }
    var file_sz = align + code_size
    var shoff = 0
    var shnum = 0
    var shstrndx = 0
    var off_abbrev = 0
    var off_info = 0
    var off_line = 0
    var off_shstr = 0
    var off_shdr = 0
    var abbrev_len = 0
    var info_len = 0
    var line_len = 0
    var shstr_len = 0
    if dwarf != 0 {
        abbrev_len = int_vec_get(dwarf, 0)
        info_len = int_vec_get(dwarf, 1)
        line_len = int_vec_get(dwarf, 2)
        shstr_len = int_vec_get(dwarf, 3)
        off_abbrev = align + code_size
        off_info = off_abbrev + abbrev_len
        off_line = off_info + info_len
        off_shstr = off_line + line_len
        off_shdr = off_shstr + shstr_len
        rem = off_shdr % 8
        if rem != 0 {
            off_shdr = off_shdr + 8 - rem
        }
        shoff = off_shdr
        shnum = 6
        shstrndx = 5
    }
    var elf = int_vec_new()
    var entry = 4096 + main_ent
    native_emit_elf_hdr(elf, entry, shoff, shnum, shstrndx)
    make_phdr_ro_load(elf, file_sz, align)
    make_phdr_rx_load(elf, code_len, code_size, align)
    var i = int_vec_len(elf) while (i < align) { int_vec_push(elf, 0) i = i + 1 }
    i = 0 while (i < code_len) { int_vec_push(elf, int_vec_get(code, i)) i = i + 1 }
    i = code_len while (i < code_size) { int_vec_push(elf, 0) i = i + 1 }
    if dwarf != 0 {
        dwarf_append_bytes(elf, dwarf, 9, abbrev_len)
        dwarf_append_bytes(elf, dwarf, 9 + abbrev_len, info_len)
        dwarf_append_bytes(elf, dwarf, 9 + abbrev_len + info_len, line_len)
        dwarf_append_bytes(elf, dwarf, 9 + abbrev_len + info_len + line_len, shstr_len)
        i = int_vec_len(elf)
        while (i < off_shdr) {
            int_vec_push(elf, 0)
            i = i + 1
        }
        dwarf_emit_shdr_head(elf, 0, 0, 0)
        dwarf_emit_shdr_tail(elf, 0, 0, 0, 0)
        dwarf_emit_shdr_head(elf, int_vec_get(dwarf, 4), 1, 6)
        dwarf_emit_shdr_tail(elf, 4096, 4096, code_len, 16)
        dwarf_emit_shdr_head(elf, int_vec_get(dwarf, 5), 1, 0)
        dwarf_emit_shdr_tail(elf, 0, off_abbrev, abbrev_len, 1)
        dwarf_emit_shdr_head(elf, int_vec_get(dwarf, 6), 1, 0)
        dwarf_emit_shdr_tail(elf, 0, off_info, info_len, 1)
        dwarf_emit_shdr_head(elf, int_vec_get(dwarf, 7), 1, 0)
        dwarf_emit_shdr_tail(elf, 0, off_line, line_len, 1)
        dwarf_emit_shdr_head(elf, int_vec_get(dwarf, 8), 3, 0)
        dwarf_emit_shdr_tail(elf, 0, off_shstr, shstr_len, 1)
    }
    var res = native_write_exe(elf, exe_out)
    int_vec_free(elf)
    if res != 0 {
        if quiet == 0 { err_line("build: writing native ELF failed (native_write_exe); check write_elf_chunk, unlink, chmod_executable") }
        return 1
    }
    return 0
}

func native_validate_target(target: str, quiet: int): int {
    var td = TargetDescriptor {
        arch: target_arch(target),
        os: target_os(target),
        pointer_width: target_pointer_width(target),
        endianness: target_endianness(target),
        name: target,
        supported: target_supported(target)
    }
    if td.supported != target_status_ok() {
        if quiet == 0 { err_line(target_unsupported_error(td.name)) }
        return 1
    }
    if (str_eq(td.arch, "x86_64") == 0) | (str_eq(td.endianness, "little") == 0) | (td.pointer_width != 8) {
        if quiet == 0 { err_line(target_unsupported_error(td.name)) }
        return 1
    }
    return 0
}

// quiet: when 1, omit stderr on failure (caller may fall back to bootstrap).
func native_compile_and_link(merged_src: str, quiet: int, exe_out: str, debug_info: int, src_path: str, entry_line: int): int {
    var stream = lex_source(merged_src)
    if stream == 0 {
        if quiet == 0 { err_line("lexer error") }
        return 1
    }
    var pr = parse_source(merged_src, stream, 0)
    if int_vec_get(pr, 1) != 0 {
        if quiet == 0 { err_line("parse error") }
        return 1
    }
    var ast = int_vec_get(pr, 0)
    if sema_file_only_native_subset(ast) == 0 {
        if quiet == 0 { err_line("native build: unsupported surface (package/struct/class/trait/toplevel let)") }
        return 1
    }
    if sema_check_file(merged_src, stream, ast) != 0 { return 1 }
    var ir_result = build_ir(merged_src, stream, ast)
    var m = int_vec_get(ir_result, 0)
    if verify_ir_module(m, merged_src, stream) != 0 { return 1 }
    var strv = int_vec_get(ir_result, 1)
    var inline_on = 1
    if opt_wants_no_inline() == 1 { inline_on = 0 }
    m = optimize_module(m, merged_src, stream, inline_on)
    if native_require_no_externs(m, merged_src, stream) != 0 { return 1 }
    var code = int_vec_new()
    var main_ent = cg_module_to_bin(m, merged_src, stream, strv, code)
    if main_ent < 0 {
        if quiet == 0 { err_line("native codegen failed: unresolved branch/call target or offset-size mismatch") }
        int_vec_free(code)
        return 1
    }
    var dwarf = 0
    if debug_info == 1 {
        dwarf = native_build_dwarf_sections(src_path, entry_line, int_vec_len(code))
    }
    var rc = native_emit_pure_elf(code, main_ent, exe_out, quiet, dwarf)
    if dwarf != 0 {
        int_vec_free(dwarf)
    }
    return rc
}

// 1 = source needs the bootstrap compiler (parse/native-subset gap); 0 = try native pipeline.
func native_driver_should_delegate(merged: str): int {
    return 0
}

func err_line(msg: str): int {
    stderr(msg)
    stderr(char_to_str(10))
    return 0
}

func read_source(path: str): str {
    var path_p = path
    if (file_size(path_p) < 0) {
        stderr("error: cannot read file: ")
        stderr(path_p)
        stderr(char_to_str(10))
        return ""
    }
    return read_file(path_p)
}

func path_is_diva_file(p: str): int {
    var n = str_len(p)
    if (n < 5) {
        return 0
    }
    var suf = str_slice(p, n - 5, 5)
    return str_eq(suf, ".diva")
}

func build_path_is_package_dir(path: str): int {
    if path_is_diva_file(path) == 1 {
        return 0
    }
    return path_is_package_dir(path)
}

// Real LF byte from file (bootstrap / cwd-agnostic). String literals use `tok_str_value` (`\n` → ASCII 10).
// Resolve via cwd-relative paths first, then DI_STDLIB_DIR/std/lf.txt, then ROOT_DIR.
func newline_str(): str {
    var s = read_file("compiler/res/lf.txt")
    var s_hold = s
    if (!(str_len(s_hold) < 1)) {
        return str_slice(s_hold, 0, 1)
    }
    s = read_file("res/lf.txt")
    s_hold = s
    if (!(str_len(s_hold) < 1)) {
        return str_slice(s_hold, 0, 1)
    }
    var stdroot = loader_stdlib_dir()
    s = read_file(path_join_dir(stdroot, "std/lf.txt"))
    s_hold = s
    if (!(str_len(s_hold) < 1)) {
        return str_slice(s_hold, 0, 1)
    }
    var root = host_getenv("ROOT_DIR")
    var root_hold = root
    if str_len(root_hold) > 0 {
        s = read_file(path_join_dir(root_hold, "compiler/res/lf.txt"))
        s_hold = s
        if (!(str_len(s_hold) < 1)) {
            return str_slice(s_hold, 0, 1)
        }
    }
    var empty = ""
    return empty
}

func path_basename(path: str): str {
    var n = str_len(path)
    while (n > 0 & str_byte(path, n - 1) == 47) {
        n = n - 1
    }
    if n == 0 {
        var empty = ""
        return empty
    }
    var i = n - 1
    while (i >= 0) {
        if str_byte(path, i) == 47 {
            return str_slice(path, i + 1, n - (i + 1))
        }
        i = i - 1
    }
    return str_slice(path, 0, n)
}

// Shell-safe subset for mkdir -p (no spaces, quotes, globs, dot-segments).
// No `continue` here: the driver subset may not implement continue, which would
// make every path look invalid after the first character.
func new_path_shell_safe(p: str): int {
    var n = str_len(p)
    if n == 0 {
        return 0
    }
    var i = 0
    while (i < n) {
        var c = str_byte(p, i)
        var ok = 0
        if c == 47 { ok = 1 }
        if c == 45 { ok = 1 }
        if c == 95 { ok = 1 }
        if (c >= 48 & c <= 57) { ok = 1 }
        if (c >= 65 & c <= 90) { ok = 1 }
        if (c >= 97 & c <= 122) { ok = 1 }
        if ok == 0 {
            return 0
        }
        i = i + 1
    }
    return 1
}

// Create directory trees one component at a time (mkdir / EEXIST); paths are caller-validated safe.
func native_mkdir_p(path: str): int {
    var n = str_len(path)
    if n == 0 {
        return 0
    }
    var acc = ""
    var i = 0
    if str_byte(path, 0) == 47 {
        acc = "/"
        i = 1
        while ((i < n) & (str_byte(path, i) == 47)) {
            i = i + 1
        }
    }
    while (i < n) {
        var j = i
        while ((j < n) & (str_byte(path, j) != 47)) {
            j = j + 1
        }
        var seg = str_slice(path, i, j - i)
        if str_len(seg) > 0 {
            acc = path_join_dir(acc, seg)
            if mkdir(acc) != 0 {
                err_line("new: could not create directory tree")
                return 1
            }
        }
        i = j
        while ((i < n) & (str_byte(path, i) == 47)) {
            i = i + 1
        }
    }
    return 0
}

func cmd_new(): int {
    if (host_argc() < 3) {
        err_line("usage: diva new <path> [--lib|--kernel|--system]   (or: diva new --lib <path>)")
        return 1
    }
    var want_lib = 0
    var want_kernel = 0
    var want_system = 0
    var path = ""
    var i = 2
    while (i < host_argc()) {
        var a = host_argv(i)
        if str_eq(a, "--lib") == 1 {
            want_lib = 1
        } else {
            if str_eq(a, "--kernel") == 1 {
                want_kernel = 1
            } else {
                if str_eq(a, "--system") == 1 {
                    want_system = 1
                } else {
                if str_byte(a, 0) != 45 {
                    if str_len(path) == 0 {
                        // Copy argv text: host_argv pointers may alias one buffer reused each call.
                        path = str_concat(a, "")
                    }
                }
                }
            }
        }
        i = i + 1
    }
    var kind_count = want_lib + want_kernel + want_system
    if kind_count > 1 {
        err_line("new: choose at most one of --lib, --kernel, --system")
        return 1
    }
    if str_len(path) == 0 {
        err_line("usage: diva new <path> [--lib|--kernel|--system]")
        return 1
    }
    if new_path_shell_safe(path) == 0 {
        err_line("new: path must use only [A-Za-z0-9_/-] (no dots, spaces, or shell metacharacters)")
        return 1
    }
    var manifest_path = path_join_dir(path, "package.diva")
    var msz = file_size(manifest_path)
    // di_runtime_file_size returns -1 on ENOENT. Native subset may lower signed compares / `!= 0`
    // incorrectly for negative values; int_to_str + str_eq matches the working check used elsewhere.
    if str_eq(int_to_str(msz), "-1") == 0 {
        err_line("new: destination already exists (package.diva present)")
        return 1
    }
    if native_mkdir_p(path) != 0 {
        return 1
    }
    var src_dir = path_join_dir(path, "src")
    if native_mkdir_p(src_dir) != 0 {
        return 1
    }
    var nm = path_basename(path)
    if str_len(nm) == 0 {
        nm = "app"
    }
    var nl = newline_str()
    if str_len(nl) == 0 {
        err_line("new: could not load a newline byte (lf.txt); set DI_STDLIB_DIR or ROOT_DIR, or run from the repo tree")
        return 1
    }
    var mf = str_builder_new()
    str_builder_append(mf, "name = \"")
    str_builder_append(mf, nm)
    str_builder_append(mf, "\"")
    str_builder_append(mf, nl)
    if want_lib == 1 {
        str_builder_append(mf, "kind = \"lib\"")
        str_builder_append(mf, nl)
        str_builder_append(mf, "entry = \"src/lib.diva\"")
        str_builder_append(mf, nl)
    } else if want_kernel == 1 {
        str_builder_append(mf, "kind = \"kernel\"")
        str_builder_append(mf, nl)
        str_builder_append(mf, "entry = \"src/boot.diva\"")
        str_builder_append(mf, nl)
    } else if want_system == 1 {
        str_builder_append(mf, "kind = \"system\"")
        str_builder_append(mf, nl)
        str_builder_append(mf, "entry = \"src/system.diva\"")
        str_builder_append(mf, nl)
    } else {
        str_builder_append(mf, "kind = \"app\"")
        str_builder_append(mf, nl)
        str_builder_append(mf, "entry = \"src/main.diva\"")
        str_builder_append(mf, nl)
    }
    var mf_s = str_builder_to_str(mf)
    str_builder_free(mf)
    if native_write_text_bytes(path_join_dir(path, "package.diva"), mf_s) != 0 {
        err_line("new: writing package.diva failed")
        return 1
    }
    var main_body = ""
    if want_lib == 1 {
        main_body = "// Library package: add funcs here; depend from apps via package.diva deps."
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "func lib_ping(): int {")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "    return 1")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "}")
        main_body = str_concat(main_body, nl)
        if native_write_text_bytes(path_join_dir(src_dir, "lib.diva"), main_body) != 0 {
            err_line("new: writing src/lib.diva failed")
            return 1
        }
    } else if want_kernel == 1 {
        main_body = "func kmain(): int {"
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "    var boot_magic = 42")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "    return boot_magic")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "}")
        main_body = str_concat(main_body, nl)
        if native_write_text_bytes(path_join_dir(src_dir, "boot.diva"), main_body) != 0 {
            err_line("new: writing src/boot.diva failed")
            return 1
        }
    } else if want_system == 1 {
        main_body = "// Freestanding/system template — see docs/freestanding.md"
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "extern func sys_exit(code: int): void")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "func main(): int {")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "    sys_exit(0)")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "    return 0")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "}")
        main_body = str_concat(main_body, nl)
        if native_write_text_bytes(path_join_dir(src_dir, "system.diva"), main_body) != 0 {
            err_line("new: writing src/system.diva failed")
            return 1
        }
    } else {
        main_body = "extern func print_str(s: str): void"
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "func main(): int {")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "    print_str(\"new_smoke_ok\")")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "    return 0")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "}")
        main_body = str_concat(main_body, nl)
        if native_write_text_bytes(path_join_dir(src_dir, "main.diva"), main_body) != 0 {
            err_line("new: writing src/main.diva failed")
            return 1
        }
    }
    var gitig = str_builder_new()
    str_builder_append(gitig, "/build/")
    str_builder_append(gitig, nl)
    str_builder_append(gitig, "*.o")
    str_builder_append(gitig, nl)
    str_builder_append(gitig, "/tmp/")
    str_builder_append(gitig, nl)
    if native_write_text_bytes(path_join_dir(path, ".gitignore"), str_builder_to_str(gitig)) != 0 {
        str_builder_free(gitig)
        err_line("new: writing .gitignore failed")
        return 1
    }
    str_builder_free(gitig)
    var rd = str_builder_new()
    str_builder_append(rd, "# ")
    str_builder_append(rd, nm)
    str_builder_append(rd, nl)
    str_builder_append(rd, nl)
    str_builder_append(rd, "Created with `diva new`.")
    str_builder_append(rd, nl)
    str_builder_append(rd, nl)
    if want_kernel == 1 {
        str_builder_append(rd, "Kernel package scaffold. Validate with:")
        str_builder_append(rd, nl)
        str_builder_append(rd, "`diva parse ")
        str_builder_append(rd, path_join_dir(path, "src/boot.diva"))
        str_builder_append(rd, "`")
        str_builder_append(rd, nl)
    } else if want_system == 1 {
        str_builder_append(rd, "System/freestanding scaffold. See docs/freestanding.md.")
        str_builder_append(rd, nl)
        str_builder_append(rd, "Validate: `diva check ")
        str_builder_append(rd, path)
        str_builder_append(rd, "`")
        str_builder_append(rd, nl)
    } else if want_lib == 1 {
        str_builder_append(rd, "Library scaffold. Validate with:")
        str_builder_append(rd, nl)
        str_builder_append(rd, "`diva check ")
        str_builder_append(rd, path)
        str_builder_append(rd, "`")
        str_builder_append(rd, nl)
    } else {
        str_builder_append(rd, "Run: `diva run ")
        str_builder_append(rd, path)
        str_builder_append(rd, "`")
        str_builder_append(rd, nl)
    }
    if native_write_text_bytes(path_join_dir(path, "README.md"), str_builder_to_str(rd)) != 0 {
        str_builder_free(rd)
        err_line("new: writing README.md failed")
        return 1
    }
    str_builder_free(rd)
    print_str("[native] created package at ")
    print_str(path)
    stdout(nl)
    return 0
}

func cmd_lex(path: str): int {
    return lex_file_to_stdout(path)
}

func cmd_parse(path: str): int {
    var src = read_source(path)
    var src_hold = src
    var src_len = str_len(src_hold)
    if src_len == 0 { return 1 }
    var stream = lex_source(src_hold)
    if stream == 0 { err_line("lexer error") return 1 }
    var pr = parse_source(src_hold, stream, 0)
    var ast = int_vec_get(pr, 0)
    var had_err = int_vec_get(pr, 1)
    if had_err != 0 { err_line("parse failed") return 1 }
    var children = ast_child(ast, 0)
    var n = int_vec_len(children)
    var b = str_builder_new()
    str_builder_append(b, "parsed ")
    str_builder_append(b, int_to_str(n))
    str_builder_append(b, " top-level declarations")
    print_str(str_builder_to_str(b))
    str_builder_free(b)
    return 0
}

func cmd_grad(path: str, fname: str): int {
    var src = read_source(path)
    var src_hold = src
    if str_len(src_hold) == 0 { return 1 }
    var stream = lex_source(src_hold)
    if stream == 0 { err_line("grad: lexer error") return 1 }
    var pr = parse_source(src_hold, stream, 0)
    var ast = int_vec_get(pr, 0)
    var marked = int_vec_get(pr, 2)
    if int_vec_get(pr, 1) != 0 { err_line("grad: parse failed") return 1 }
    var adfn = ad_find_func(src_hold, stream, ast, fname)
    if adfn < 0 {
        err_line("grad: function not found: ")
        err_line(fname)
        return 1
    }
    if ad_is_marked(src_hold, stream, marked, adfn) == 0 {
        err_line("grad: function is not marked #[differentiate]: ")
        err_line(fname)
        return 1
    }
    var err_cell = mut_new(0)
    var out = ad_emit_file(err_cell, src_hold, stream, adfn, fname)
    if mut_get(err_cell) != 0 { return 1 }
    print_str(out)
    return 0
}

func verify_ir_module(m: int, src: str, toks: int): int {
    return ity_verify_module(m, src, toks)
}

func cmd_ir(path: str, want_types: int): int {
    var path_p = path
    var dbg = native_cmd_ir_debug()
    var src = merge_file_sources(path_p)
    // Pin merged source: downstream calls (including debug printing) may reuse the same slot as `src`.
    var src_hold = src
    var src_len = str_len(src_hold)
    if src_len == 0 { return 1 }
    if dbg == 1 { err_line("native cmd_ir: merged") }
    var stream = lex_source(src_hold)
    if stream == 0 { return 1 }
    if dbg == 1 { err_line("native cmd_ir: lexed") }
    var pr = parse_source(src_hold, stream, 0)
    var ast = int_vec_get(pr, 0)
    if int_vec_get(pr, 1) != 0 { err_line("parse failed") return 1 }
    if dbg == 1 { err_line("native cmd_ir: parsed") }
    if sema_check_file(src_hold, stream, ast) != 0 { return 1 }
    if dbg == 1 { err_line("native cmd_ir: sema ok") }
    var ir_result = build_ir(src_hold, stream, ast)
    if dbg == 1 { err_line("native cmd_ir: build_ir ok") }
    var m = int_vec_get(ir_result, 0)
    if want_types == 0 {
        if verify_ir_module(m, src_hold, stream) != 0 { return 1 }
        dump_module(m, src_hold, stream)
        return 0
    }
    var err_cell = mut_new(0)
    var warn_cell = mut_new(0)
    var types = ity_infer_module(m, src_hold, stream, err_cell, warn_cell)
    ity_report_warn(warn_cell)
    if mut_get(err_cell) != 0 {
        ity_free_types(types)
        return 1
    }
    dump_module_t(m, src_hold, stream, types)
    ity_free_types(types)
    return 0
}

func opt_wants_no_opt(): int {
    var i = 2
    while (i < host_argc()) {
        if str_eq(host_argv(i), "--no-opt") == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

func opt_wants_no_inline(): int {
    var i = 2
    while i < host_argc() {
        if str_eq(host_argv(i), "--no-inline") == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

func opt_pick_path(): str {
    var path = ""
    var i = 2
    while (i < host_argc()) {
        var a = host_argv(i)
        if str_eq(a, "--target") == 1 {
            i = i + 2
        } else {
            if str_byte(a, 0) != 45 {
                if str_len(path) == 0 {
                    path = a
                }
            }
            i = i + 1
        }
    }
    return path
}

func cmd_opt(): int {
    var path = opt_pick_path()
    if str_len(path) == 0 {
        err_line("usage: diva opt [--no-opt] [--no-inline] <file.diva>")
        return 1
    }
    var src = merge_file_sources(path)
    var src_hold = src
    var src_len = str_len(src_hold)
    if src_len == 0 { return 1 }
    var stream = lex_source(src_hold)
    if stream == 0 { return 1 }
    var pr = parse_source(src_hold, stream, 0)
    var ast = int_vec_get(pr, 0)
    if int_vec_get(pr, 1) != 0 { err_line("parse failed") return 1 }
    if sema_check_file(src_hold, stream, ast) != 0 { return 1 }
    var ir_result = build_ir(src_hold, stream, ast)
    var m = int_vec_get(ir_result, 0)
    if verify_ir_module(m, src_hold, stream) != 0 { return 1 }
    var inline_on = 1
    if opt_wants_no_inline() == 1 { inline_on = 0 }
    if opt_wants_no_opt() == 0 {
        m = optimize_module(m, src_hold, stream, inline_on)
    }
    dump_module(m, src_hold, stream)
    return 0
}

func cmd_analyze(): int {
    if host_argc() >= 3 {
        var probe = host_argv(2)
        if str_eq(probe, "--selftest-undefined-label") == 1 {
            if host_argc() < 4 {
                err_line("usage: diva analyze --selftest-undefined-label <file.diva>")
                return 1
            }
            var probe_path = host_argv(3)
            var probe_src = merge_file_sources(probe_path)
            var probe_src_hold = probe_src
            var probe_toks = lex_source(probe_src_hold)
            if probe_toks == 0 { return 1 }
            return cfg_selftest_undefined_label(probe_src_hold, probe_toks)
        }
        if str_eq(probe, "--escape") == 1 {
            if host_argc() < 4 {
                err_line("usage: diva analyze --escape <file.diva>")
                return 1
            }
            var esc_path = host_argv(3)
            if path_is_diva_file(esc_path) == 0 {
                err_line("analyze: expected a .diva file")
                return 1
            }
            var esc_src = merge_file_sources(esc_path)
            var esc_src_hold = esc_src
            if str_len(esc_src_hold) == 0 { return 1 }
            var esc_stream = lex_source(esc_src_hold)
            if esc_stream == 0 { return 1 }
            var esc_pr = parse_source(esc_src_hold, esc_stream, 0)
            var esc_ast = int_vec_get(esc_pr, 0)
            if int_vec_get(esc_pr, 1) != 0 {
                err_line("analyze: parse failed")
                return 1
            }
            if sema_check_file(esc_src_hold, esc_stream, esc_ast) != 0 { return 1 }
            var esc_ir_result = build_ir(esc_src_hold, esc_stream, esc_ast)
            var esc_m = int_vec_get(esc_ir_result, 0)
            return escape_analyze_module(esc_m, esc_src_hold, esc_stream)
        }
    }
    if host_argc() < 3 {
        err_line("usage: diva analyze <file.diva>")
        return 1
    }
    var path = host_argv(2)
    if path_is_diva_file(path) == 0 {
        err_line("analyze: expected a .diva file")
        return 1
    }
    var src = merge_file_sources(path)
    var src_hold = src
    var src_len = str_len(src_hold)
    if src_len == 0 { return 1 }
    var stream = lex_source(src_hold)
    if stream == 0 { return 1 }
    var pr = parse_source(src_hold, stream, 0)
    var ast = int_vec_get(pr, 0)
    if int_vec_get(pr, 1) != 0 {
        err_line("analyze: parse failed")
        return 1
    }
    if sema_check_file(src_hold, stream, ast) != 0 { return 1 }
    var ir_result = build_ir(src_hold, stream, ast)
    var m = int_vec_get(ir_result, 0)
    if verify_ir_module(m, src_hold, stream) != 0 { return 1 }
    return cfg_analyze_module(m, src_hold, stream)
}

func cmd_asm(path: str): int {
