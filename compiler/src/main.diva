// Diva compiler driver.
// Commands handled natively (in Diva):
//   diva lex <file>      — tokenize and dump tokens
//   diva parse <file>    — parse and dump AST summary
//   diva ir <file>       — parse, lower to Diva IR, dump IR text
//   diva asm <file>      — full pipeline to x86_64 assembly (stdout)
//   diva compile <file>  — full pipeline to native executable
//   diva compiler-version — print version info
// All other commands forwarded to the bootstrap seed binary.

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "tokens.diva"
import "lexer.diva"
import "ast.diva"
import "parser.diva"
import "ir.diva"
import "ir_builder.diva"
import "ir_dump.diva"
import "codegen_x86.diva"

func bootstrap_path(): str {
    var p = host_getenv("DIVA_BOOTSTRAP")
    if str_len(p) > 0 {
        return p
    }
    p = host_getenv("DI_BOOTSTRAP")
    if str_len(p) > 0 {
        return p
    }
    return "bootstrap/diva-linux-amd64"
}

func forward_to_seed(): int {
    var b = str_builder_new()
    if b == 0 {
        return 1
    }
    str_builder_append(b, bootstrap_path())
    var i = 1
    while i < host_argc() {
        str_builder_append(b, " ")
        str_builder_append(b, host_argv(i))
        i = i + 1
    }
    var cmd = str_builder_to_str(b)
    str_builder_free(b)
    var r = host_system(cmd)
    if r < 0 {
        return 1
    }
    if r == 0 {
        return 0
    }
    if r < 256 {
        return r
    }
    return r / 256
}

func read_source(path: str): str {
    if file_size(path) < 0 {
        stderr("diva: cannot read file: ")
        stderr(path)
        stderr("\n")
        return ""
    }
    return read_file(path)
}

func cmd_lex(path: str): int {
    return lex_file_to_stdout(path)
}

func cmd_parse(path: str): int {
    var src = read_source(path)
    if str_len(src) == 0 { return 1 }
    var stream = lex_source(src)
    if stream == 0 {
        stderr("diva parse: tokenization failed\n")
        return 1
    }
    var ast = parse_source(src, stream)
    if parse_had_error() != 0 {
        stderr("diva parse: parse errors encountered\n")
        return 1
    }
    var children = ast_child(ast, 0)
    var n = int_vec_len(children)
    stdout("parsed ")
    stdout(int_to_str(n))
    stdout(" top-level declarations from ")
    stdout(path)
    stdout("\n")
    var i = 0
    while i < n {
        var child = int_vec_get(children, i)
        var kind = ast_kind(child)
        stdout("  [")
        stdout(int_to_str(i))
        stdout("] ")
        if kind == nd_import()      { stdout("import") }
        if kind == nd_package_decl() { stdout("package") }
        if kind == nd_func()        {
            stdout("func ")
            stdout(tok_text(src, stream, ast_child(child, 0)))
        }
        if kind == nd_extern_func() {
            stdout("extern func ")
            stdout(tok_text(src, stream, ast_child(child, 0)))
        }
        if kind == nd_class()       {
            stdout("class ")
            stdout(tok_text(src, stream, ast_child(child, 0)))
        }
        if kind == nd_var_decl()    {
            stdout("var ")
            stdout(tok_text(src, stream, ast_child(child, 0)))
        }
        stdout("\n")
        i = i + 1
    }
    int_vec_free(stream)
    return 0
}

func cmd_ir(path: str): int {
    var src = read_source(path)
    if str_len(src) == 0 { return 1 }
    var stream = lex_source(src)
    if stream == 0 {
        stderr("diva ir: tokenization failed\n")
        return 1
    }
    var ast = parse_source(src, stream)
    if parse_had_error() != 0 {
        stderr("diva ir: parse errors encountered\n")
        return 1
    }
    var m = build_ir(src, stream, ast)
    dump_module(m)
    return 0
}

func cmd_asm(path: str): int {
    var src = read_source(path)
    if str_len(src) == 0 { return 1 }
    var stream = lex_source(src)
    if stream == 0 {
        stderr("diva asm: tokenization failed\n")
        return 1
    }
    var ast = parse_source(src, stream)
    if parse_had_error() != 0 {
        stderr("diva asm: parse errors encountered\n")
        return 1
    }
    var m = build_ir(src, stream, ast)
    var asm_text = cg_module(m, src, stream, ib_str_vec)
    stdout(asm_text)
    return 0
}

func main(): int {
    if host_argc() < 2 {
        return forward_to_seed()
    }
    var a1 = host_argv(1)

    if str_eq(a1, "lex") == 1 {
        if host_argc() < 3 {
            stderr("usage: diva lex <file.diva>\n")
            return 1
        }
        return cmd_lex(host_argv(2))
    }

    if str_eq(a1, "parse") == 1 {
        if host_argc() < 3 {
            stderr("usage: diva parse <file.diva>\n")
            return 1
        }
        return cmd_parse(host_argv(2))
    }

    if str_eq(a1, "ir") == 1 {
        if host_argc() < 3 {
            stderr("usage: diva ir <file.diva>\n")
            return 1
        }
        return cmd_ir(host_argv(2))
    }

    if str_eq(a1, "asm") == 1 {
        if host_argc() < 3 {
            stderr("usage: diva asm <file.diva>\n")
            return 1
        }
        return cmd_asm(host_argv(2))
    }

    if str_eq(a1, "compiler-version") == 1 {
        print_str("diva compiler v0.2.0: lex, parse, ir, asm in Diva; pipeline via seed for build/run\n")
        return 0
    }

    if str_eq(a1, "pipeline") == 1 {
        print_str("Diva compiler pipeline:\n")
        print_str("  source.diva -> lexer -> tokens -> parser -> AST -> IR builder -> Diva IR -> x86_64 codegen -> assembly\n")
        print_str("  Stages implemented in Diva: lex, parse, ir, asm\n")
        print_str("  Backend: GNU as + ld (no LLVM required)\n")
        return 0
    }

    return forward_to_seed()
}
