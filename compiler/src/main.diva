// Source path recorded in DWARF (entry .diva for packages).
func dwarf_debug_src_path(path: str): str {
    if build_path_is_package_dir(path) == 1 {
        var man = path_join_dir(path, "package.diva")
        var ent = package_entry_relative(man)
        if str_len(ent) == 0 {
            return path
        }
        return path_join_dir(path, ent)
    }
    return path
}

// Post-process pure ELF with scripts/embed-dwarf-debug.py (Issue #63).
func native_embed_dwarf(exe_out: str, src_path: str): int {
    var root = host_getenv("ROOT_DIR")
    var script = "scripts/embed-dwarf-debug.py"
    if str_len(root) > 0 {
        script = path_join_dir(root, "scripts/embed-dwarf-debug.py")
    }
    var b = str_builder_new()
    str_builder_append(b, "python3 ")
    str_builder_append(b, script)
    str_builder_append(b, " ")
    str_builder_append(b, exe_out)
    str_builder_append(b, " ")
    str_builder_append(b, src_path)
    var cmd = str_builder_to_str(b)
    str_builder_free(b)
    var rc = host_system(cmd)
    return system_exit_code(rc)
}

// Lex + parse + sema for a lib/app package (merged sources). No seed forwarding.
func cmd_check(): int {
    if (host_argc() < 3) {
        err_line("usage: diva check <package-dir>")
        return 1
    }
    var path = host_argv(2)
    var path_h = path
    if path_is_package_dir(path_h) == 0 {
        err_line("check: expected a package directory (with package.diva)")
        return 1
    }
    var merged = merge_package_sources(path_h)
    // Pin before loader_check_trace / err_line (getenv + IO may clobber `merged`'s slot).
    var merged_hold = merged
    if loader_check_trace() == 1 {
        err_line("check-trace: after merge_package_sources")
    }
    var merged_len = str_len(merged_hold)
    if merged_len == 0 {
        err_line("check: could not merge package sources (see loader messages above)")
        return 1
    }
    if native_driver_should_delegate(merged_hold) == 1 {
        err_line("check: native driver cannot handle this source surface yet")
        return 1
    }
    if loader_check_trace() == 1 {
        err_line("check-trace: before lex_source")
    }
    var stream = lex_source(merged_hold)
    if stream == 0 {
        err_line("lexer error")
        return 1
    }
    if loader_check_trace() == 1 {
        err_line("check-trace: before parse_source")
    }
    var pr = parse_source(merged_hold, stream, 0)
    if int_vec_get(pr, 1) != 0 {
        err_line("check: parse failed")
        return 1
    }
    if loader_check_trace() == 1 {
        err_line("check-trace: before sema_check_file")
    }
    var ast = int_vec_get(pr, 0)
    if sema_check_file(merged_hold, stream, ast) != 0 {
        return 1
    }
    return 0
}

func cache_disabled(): int {
    var env = host_getenv("DIVA_NO_CACHE")
    var env_hold = env
    if str_eq(env_hold, "1") == 1 {
        return 1
    }
    var i = 2
    while (i < host_argc()) {
        var a = host_argv(i)
        var a_hold = a
        if str_eq(a_hold, "--no-cache") == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

func cache_version_id(): str {
    var build_id = host_getenv("DIVA_BUILD_ID")
    var build_hold = build_id
    if str_len(build_hold) > 0 {
        return build_hold
    }
    var version = host_getenv("DIVA_COMPILER_VERSION")
    var version_hold = version
    if str_len(version_hold) > 0 {
        return version_hold
    }
    return "diva-v0.5.0"
}

func fnv_offset_basis(): int {
    var two32 = 65536 * 65536
    var low = 131072 * 16384 + 69346085
    var high = -873292572
    return high * two32 + low
}

func fnv_prime(): int {
    var two40 = 1048576 * 1048576
    return two40 + 435
}

func fnv_xor_byte(a: int, b: int): int {
    return (a | b) & ((0 - (a & b)) - 1)
}

func fnv_mix(h: int, byte_value: int, prime: int): int {
    var low = h & 255
    return (h - low + fnv_xor_byte(low, byte_value)) * prime
}

func fnv_add_str(h: int, s: str, prime: int): int {
    var acc = h
    var text = s
    var text_hold = text
    var n = str_len(text_hold)
    var i = 0
    while (i < n) {
        acc = fnv_mix(acc, str_byte(text_hold, i), prime)
        i = i + 1
    }
    return acc
}

func fnv_hex16(h: int): str {
    var digits = "0123456789abcdef"
    var b = str_builder_new()
    var i = 15
    while (i >= 0) {
        var d = (h >> (i * 4)) & 15
        str_builder_append(b, str_slice(digits, d, 1))
        i = i - 1
    }
    var out = str_builder_to_str(b)
    str_builder_free(b)
    return out
}

func cache_hash_sources(files: str, version: str, debug_build: int): int {
    var file_list = files
    var list_hold = file_list
    var version_text = version
    var version_hold = version_text
    var prime = fnv_prime()
    var acc = fnv_offset_basis()
    var n = str_len(list_hold)
    var pos = 0
    while (pos < n) {
        var line_end = pos
        while ((line_end < n) & (str_byte(list_hold, line_end) != 10)) {
            line_end = line_end + 1
        }
        var path = str_slice(list_hold, pos, line_end - pos)
        var path_hold = path
        if str_len(path_hold) > 0 {
            var sz = file_size(path_hold)
            if sz < 0 {
                return 0
            }
            var data = read_file(path_hold)
            var data_hold = data
            var i = 0
            while (i < sz) {
                acc = fnv_mix(acc, str_byte(data_hold, i), prime)
                i = i + 1
            }
        }
        pos = line_end + 1
    }
    acc = fnv_add_str(acc, version_hold, prime)
    var cfg = "g0"
    if debug_build == 1 {
        cfg = "g1"
    }
    return fnv_add_str(acc, cfg, prime)
}

func build_cache_dir(exe_out: str): str {
    return path_join_dir(dirname_of_file(exe_out), ".diva-cache")
}

func build_cache_bin_path(dir: str, hash: str): str {
    return path_join_dir(dir, str_concat(hash, ".bin"))
}

func build_cache_meta_path(dir: str, hash: str): str {
    return path_join_dir(dir, str_concat(hash, ".meta"))
}

func cache_meta_text(hash: str, version: str, files: str): str {
    var b = str_builder_new()
    str_builder_append(b, "hash ")
    str_builder_append(b, hash)
    str_builder_append(b, "\n")
    str_builder_append(b, "version ")
    str_builder_append(b, version)
    str_builder_append(b, "\n")
    var list = files
    var list_hold = list
    var n = str_len(list_hold)
    var pos = 0
    while (pos < n) {
        var line_end = pos
        while ((line_end < n) & (str_byte(list_hold, line_end) != 10)) {
            line_end = line_end + 1
        }
        var path = str_slice(list_hold, pos, line_end - pos)
        if str_len(path) > 0 {
            str_builder_append(b, "source ")
            str_builder_append(b, path)
            str_builder_append(b, "\n")
        }
        pos = line_end + 1
    }
    var out = str_builder_to_str(b)
    str_builder_free(b)
    return out
}

func cache_write_bytes(path: str, data: str, size: int): int {
    var target = path
    var target_hold = target
    var payload = data
    var payload_hold = payload
    var bytes = int_vec_new()
    if bytes == 0 {
        return 1
    }
    var i = 0
    while (i < size) {
        int_vec_push(bytes, str_byte(payload_hold, i))
        i = i + 1
    }
    var pos = 0
    var first = 1
    while (pos < size) {
        var take = 64000
        if pos + take > size {
            take = size - pos
        }
        if write_elf_chunk(target_hold, bytes, pos, take, first) != 0 {
            int_vec_free(bytes)
            return 1
        }
        pos = pos + take
        first = 0
    }
    int_vec_free(bytes)
    if chmod_executable(target_hold) != 0 {
        return 1
    }
    return 0
}

func cache_copy_file(src: str, dst: str): int {
    var source = src
    var source_hold = source
    var target = dst
    var target_hold = target
    var n = file_size(source_hold)
    if n < 0 {
        return 1
    }
    var data = read_file(source_hold)
    var data_hold = data
    return cache_write_bytes(target_hold, data_hold, n)
}

func cache_try_restore(hash: str, exe_out: str): int {
    var out = exe_out
    var out_hold = out
    var dir = build_cache_dir(out_hold)
    var bin = build_cache_bin_path(dir, hash)
    var bin_hold = bin
    if file_size(bin_hold) < 0 {
        return 0
    }
    if cache_copy_file(bin_hold, out_hold) != 0 {
        return 0
    }
    stderr("[cache] hit ")
    stderr(hash)
    stderr("\n")
    return 1
}

func cache_store(hash: str, exe_out: str, files: str, version: str): int {
    var out = exe_out
    var out_hold = out
    var dir = build_cache_dir(out_hold)
    if loader_mkdir_p(dir) != 0 {
        return 1
    }
    var bin = build_cache_bin_path(dir, hash)
    if cache_copy_file(out_hold, bin) != 0 {
        return 1
    }
    var meta = build_cache_meta_path(dir, hash)
    var text = cache_meta_text(hash, version, files)
    var text_hold = text
    if write_text_file(meta, text_hold) != 0 {
        return 1
    }
    return 0
}

func cache_print_miss(hash: str): int {
    stderr("[cache] miss ")
    stderr(hash)
    stderr("\n")
    return 0
}

func cmd_build(): int {
    var target = target_from_args()
    if str_len(target) == 0 {
        return 1
    }
    var path = pick_build_path()
    if str_len(path) == 0 {
        err_line("build: missing output path (e.g. diva build compiler)")
        return 1
    }
    if build_wants_ast() == 1 {
        if path_is_package_dir(path) == 1 {
            err_line("build --ast: use a single .diva file")
            return 1
        }
        if path_is_diva_file(path) == 0 {
            err_line("build --ast: expected a .diva file")
            return 1
        }
        return cmd_build_ast(path)
    }
    return native_build_path(path, 0, 1, target)
}

// Shared by `build` and `watch`. quiet=1 suppresses the success line (watch prints its own).
func native_build_path(path: str, quiet: int, use_cache: int, target: str): int {
    var merged = ""
    if build_path_is_package_dir(path) == 1 {
        merged = merge_package_sources(path)
        var merged_hold = merged
        var merged_len = str_len(merged_hold)
        if merged_len == 0 {
            err_line("build: could not merge package sources (see loader messages above)")
            return 1
        }
    } else {
        if path_is_diva_file(path) == 0 {
            err_line("build: expected a .diva file or a package directory containing package.diva")
            return 1
        }
        merged = merge_file_sources(path)
        var merged_try = merged
        var merged_try_len = str_len(merged_try)
        if merged_try_len == 0 {
            merged = read_source(path)
        }
    }
    var merged_out = merged
    var merged_out_hold = merged_out
    var merged_final_len = str_len(merged_out_hold)
    if merged_final_len == 0 {
        return 1
    }
    if native_driver_should_delegate(merged_out_hold) == 1 {
        err_line("build: native driver cannot handle this source surface yet")
        return 1
    }
    var exe_out = pick_build_out_path()
    var exe_hold = exe_out
    var debug_info = build_wants_debug_info()
    var dbg_src = ""
    var entry_line = 0
    if debug_info == 1 {
        dbg_src = dwarf_debug_src_path(path)
        var dbg_src_text = read_source(dbg_src)
        entry_line = dwarf_guess_entry_line(dbg_src_text)
        if quiet == 0 {
            err_line("[native] DWARF line tables enabled (--debug-info)")
        }
    }
    var cache_active = 0
    var cache_key = ""
    var cache_files = ""
    var cache_version = ""
    if use_cache == 1 {
        if debug_info == 0 {
            if cache_disabled() == 0 {
                var files = collect_watch_files(path)
                var files_hold = files
                if str_len(files_hold) > 0 {
                    var version = cache_version_id()
                    var version_hold = version
                    var key = cache_hash_sources(files_hold, version_hold, build_wants_g())
                    if key != 0 {
                        cache_key = fnv_hex16(key)
                        cache_files = files_hold
                        cache_version = version_hold
                        cache_active = 1
                    }
                }
            }
        }
    }
    var cache_hit = 0
    if cache_active == 1 {
        var key_hold = cache_key
        cache_hit = cache_try_restore(key_hold, exe_hold)
    }
    if cache_hit == 0 {
        if cache_active == 1 {
            cache_print_miss(cache_key)
        }
        if native_validate_target(target, quiet) != 0 {
            return 1
        }
        if native_compile_and_link(merged_out_hold, quiet, exe_hold, debug_info, dbg_src, entry_line) != 0 {
            return 1
        }
        if build_wants_g() == 1 {
            if debug_info == 0 {
                var legacy_src = dwarf_debug_src_path(path)
                if native_embed_dwarf(exe_hold, legacy_src) != 0 {
                    if quiet == 0 {
                        err_line("build -g: embed-dwarf-debug.py failed (need python3 + scripts/embed-dwarf-debug.py)")
                    }
                    return 1
                }
                if quiet == 0 {
                    err_line("[native] DWARF -g sections embedded (addr2line)")
                }
            }
        }
        if cache_active == 1 {
            cache_store(cache_key, exe_hold, cache_files, cache_version)
        }
    }
    if quiet == 0 {
        if build_path_is_package_dir(path) == 1 {
            if package_is_kernel_dir(path) == 1 {
                var kmsg = str_concat("[native] built kernel ELF (kmain entry) at ", exe_out)
                print_str(kmsg)
                stdout(newline_str())
                return 0
            }
        }
        var built_msg = str_concat("[native] built executable at ", exe_out)
        print_str(built_msg)
        stdout(newline_str())
    }
    return 0
}

func watch_file_fp(path: str): int {
    var sz = file_size(path)
    if sz < 0 {
        return 0 - 1
    }
    var s = read_file(path)
    var h = sz + 1
    var i = 0
    var n = str_len(s)
    while (i < n) {
        h = h * 131 + str_byte(s, i)
        i = i + 1
    }
    return h
}

func watch_make_snapshot(files: str): str {
    var nl = newline_str()
    var b = str_builder_new()
    var pos = 0
    var n = str_len(files)
    while (pos < n) {
        var le = pos
        while (le < n & str_byte(files, le) != 10) {
            le = le + 1
        }
        var p = str_slice(files, pos, le - pos)
        pos = le + 1
        if str_len(p) > 0 {
            str_builder_append(b, p)
            str_builder_append(b, "|")
            str_builder_append(b, int_to_str(watch_file_fp(p)))
            str_builder_append(b, nl)
        }
    }
    var out = str_builder_to_str(b)
    str_builder_free(b)
    return out
}

func watch_count_lines(s: str): int {
    var n = str_len(s)
    var c = 0
    var i = 0
    while (i < n) {
        if str_byte(s, i) == 10 {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

func watch_poll_sleep(): int {
    host_system("sleep 1")
    return 0
}

func watch_max_iters(): int {
    var v = host_getenv("DIVA_WATCH_MAX_ITERS")
    var v_hold = v
    if str_len(v_hold) == 0 {
        return 0
    }
    return str_to_int(v_hold)
}

func cmd_watch(): int {
    var target = target_native_name()
    if host_argc() < 3 {
        err_line("usage: diva watch <file.diva|package-dir>")
        return 1
    }
    var path = host_argv(2)
    var path_h = path
    if build_path_is_package_dir(path_h) == 0 {
        if path_is_diva_file(path_h) == 0 {
            err_line("watch: expected a .diva file or a package directory")
            return 1
        }
    }
    var files = collect_watch_files(path_h)
    var files_h = files
    if str_len(files_h) == 0 {
        err_line("watch: could not resolve dependency files (see loader messages above)")
        return 1
    }
    var nfiles = watch_count_lines(files_h)
    err_line(str_concat("[watch] watching ", str_concat(int_to_str(nfiles), " files (poll 1s; DIVA_WATCH_MAX_ITERS to exit)")))
    err_line("[watch] building...")
    if native_build_path(path_h, 1, 0, target) != 0 {
        err_line("[watch] build failed (continuing)")
    } else {
        err_line(str_concat("[watch] ok -> ", pick_build_out_path()))
    }
    var snap = watch_make_snapshot(files_h)
    var iters = 0
    var max_i = watch_max_iters()
    while (1 == 1) {
        if max_i > 0 {
            if iters >= max_i {
                err_line("[watch] max iters reached; exiting")
                return 0
            }
        }
        watch_poll_sleep()
        iters = iters + 1
        files = collect_watch_files(path_h)
        files_h = files
        if str_len(files_h) == 0 {
            err_line("[watch] dependency resolve failed (continuing)")
        } else {
            var snap2 = watch_make_snapshot(files_h)
            if str_eq(snap, snap2) == 0 {
                err_line("[watch] change detected; debouncing...")
                watch_poll_sleep()
                files = collect_watch_files(path_h)
                files_h = files
                snap2 = watch_make_snapshot(files_h)
                err_line("[watch] rebuilding...")
                if native_build_path(path_h, 1, 0, target) != 0 {
                    err_line("[watch] build failed (continuing)")
                } else {
                    err_line(str_concat("[watch] ok -> ", pick_build_out_path()))
                }
                snap = snap2
            }
        }
    }
    return 0
}

func cmd_run_file(path: str): int {
    var target = target_native_name()
    var merged = ""
    if build_path_is_package_dir(path) == 1 {
        merged = merge_package_sources(path)
        var merged_hold = merged
        var merged_len = str_len(merged_hold)
        if merged_len == 0 {
            err_line("run: could not merge package sources (see loader messages above)")
            return 1
        }
    } else {
        if path_is_diva_file(path) == 0 {
            err_line("run: expected a .diva file or a package directory")
            return 1
        }
        // Use merged source to handle imports
        merged = merge_file_sources(path)
        var merged_try = merged
        var merged_try_len = str_len(merged_try)
        if merged_try_len == 0 {
            merged = read_source(path)
        }
    }
    var merged_out = merged
    var merged_out_hold = merged_out
    var merged_final_len = str_len(merged_out_hold)
    if merged_final_len == 0 {
        return 1
    }
    if native_driver_should_delegate(merged_out_hold) == 1 {
        err_line("run: native driver cannot handle this source surface yet")
        return 1
    }
    var exe_out = native_default_exe_out()
    if native_validate_target(target, 0) != 0 {
        return 1
    }
    if native_compile_and_link(merged_out_hold, 0, exe_out, 0, "", 0) != 0 {
        return 1
    }
    var rc = host_system(exe_out)
    return system_exit_code(rc)
}

func cmd_onnx_load(path: str, g: int): str {
    if file_size(path) < 0 {
        err_line("error: cannot read ONNX text file")
        return ""
    }
    var src = read_source(path)
    var src_hold = src
    onnx_parse(src_hold, g)
    onnx_validate(src_hold, g)
    if onnx_error_count(g) > 0 {
        stderr(str_builder_to_str(onnx_errors(g)))
        return ""
    }
    return src
}

func cmd_onnx_check(path: str): int {
    var g = onnx_graph_new()
    var src = cmd_onnx_load(path, g)
    if str_len(src) == 0 {
        onnx_free(g)
        return 1
    }
    print_str("ok: ")
    print_str(int_to_str(onnx_node_count(g)))
    print_str(" nodes\n")
    onnx_free(g)
    return 0
}

func cmd_onnx_run(path: str): int {
    var g = onnx_graph_new()
    var src = cmd_onnx_load(path, g)
    if str_len(src) == 0 {
        onnx_free(g)
        return 1
    }
    if onnx_has_input(g) == 1 {
        err_line("error: runtime inputs are deferred; onnx-run supports constant-only graphs")
        onnx_free(g)
        return 1
    }
    var di_src = onnx_emit_diva(src, g)
    var exe = host_getenv("DIVA_NATIVE_EXE_OUT")
    if str_len(exe) == 0 {
        mkdir("build")
        exe = native_default_exe_out()
    }
    var rc = native_compile_and_link(di_src, 0, exe, 0, "", 0)
    if rc != 0 {
        onnx_free(g)
        return rc
    }
    var r = host_system(exe)
    onnx_free(g)
    return system_exit_code(r)
}

func cmd_onnx_mlir(path: str): int {
    var g = onnx_graph_new()
    var src = cmd_onnx_load(path, g)
    if str_len(src) == 0 {
        onnx_free(g)
        return 1
    }
    var di_src = onnx_emit_diva(src, g)
    var stream = lex_source(di_src)
    if stream == 0 {
        err_line("error: generated Diva source failed to lex")
        onnx_free(g)
        return 1
    }
    var pr = parse_source(di_src, stream, 1)
    if int_vec_get(pr, 1) != 0 {
        err_line("error: generated Diva source failed to parse")
        onnx_free(g)
        return 1
    }
    var ast = int_vec_get(pr, 0)
    if sema_check_file(di_src, stream, ast) != 0 {
        onnx_free(g)
        return 1
    }
    var ir_result = build_ir_with_mode(di_src, stream, ast, 1)
    var m = int_vec_get(ir_result, 0)
    print_str(onnx_mlir_prologue(src, g))
    var rc = mlir_emit_module(m, di_src, stream)
    onnx_free(g)
    return rc
}

func main(): int {
    if (host_argc() < 2) {
        return cmd_print_usage()
    }
    var a1 = host_argv(1)

    if str_eq(a1, "check") == 1 {
        return cmd_check()
    }

    if str_eq(a1, "new") == 1 {
        return cmd_new()
    }

    if str_eq(a1, "lex") == 1 {
        if (host_argc() < 3) {
            err_line("usage: diva lex <file.diva>")
            return 1
        }
        return cmd_lex(host_argv(2))
    }

    if str_eq(a1, "parse") == 1 {
        if (host_argc() < 3) {
            err_line("usage: diva parse <file.diva>")
            return 1
        }
        return cmd_parse(host_argv(2))
    }

    if str_eq(a1, "ir") == 1 {
        if str_len(target_from_args()) == 0 {
            return 1
        }
        if host_argc() >= 3 {
            var ir_probe = host_argv(2)
            if str_eq(ir_probe, "--selftest-type-conflict") == 1 {
                return ity_verify_conflict_selftest()
            }
        }
        var want_ir_types = 0
        var ir_i = 2
        while ir_i < host_argc() {
            if str_eq(host_argv(ir_i), "--types") == 1 { want_ir_types = 1 }
            ir_i = ir_i + 1
        }
        var ir_path = opt_pick_path()
        if str_len(ir_path) == 0 {
            err_line("usage: diva ir [--types|--target <triple>] <file.diva>")
            return 1
        }
        return cmd_ir(ir_path, want_ir_types)
    }

    if str_eq(a1, "opt") == 1 {
        if str_len(target_from_args()) == 0 {
            return 1
        }
        if host_argc() < 3 {
            err_line("usage: diva opt [--no-opt] [--no-inline] [--target <triple>] <file.diva>")
            return 1
        }
        return cmd_opt()
    }

    if str_eq(a1, "analyze") == 1 {
        return cmd_analyze()
    }

    if str_eq(a1, "asm") == 1 {
        if (host_argc() < 3) {
            err_line("usage: diva asm <file.diva>")
            return 1
        }
        return cmd_asm(host_argv(2))
    }

    if str_eq(a1, "emit-ir") == 1 {
        if (host_argc() < 3) {
            err_line("usage: diva emit-ir <file.diva|package-dir>")
            return 1
        }
        var p = host_argv(2)
        return cmd_emit_ir(p)
    }

    if str_eq(a1, "emit-mlir") == 1 {
        var mp = mlir_pick_path()
        if str_len(mp) == 0 {
            err_line("usage: diva emit-mlir [--auto] <file.diva>")
            return 1
        }
        return cmd_emit_mlir(mp)
    }

    if str_eq(a1, "build") == 1 {
        return cmd_build()
    }

    if str_eq(a1, "grad") == 1 {
        if (host_argc() < 4) {
            err_line("usage: diva grad <file.diva> <func>")
            return 1
        }
        return cmd_grad(host_argv(2), host_argv(3))
    }

    if str_eq(a1, "watch") == 1 {
        return cmd_watch()
    }

    if str_eq(a1, "run") == 1 {
        var rpath = opt_pick_path()
        if str_len(rpath) == 0 {
            err_line("usage: diva run [--no-inline] <file.diva|package-dir>")
            return 1
        }
        return cmd_run_file(rpath)
    }

    if str_eq(a1, "compiler-version") == 1 {
        print_str("diva compiler v0.5.0")
        print_str("  native: lex, parse, sema, Diva IR, x86_64 binary (ELF PIE)")
        print_str("  build/run: in-process x86_64 ELF PIE (no external linker)")
        return 0
    }

    if str_eq(a1, "pipeline") == 1 {
        print_str("Diva compiler pipeline:")
        print_str("  source -> lexer -> parser -> AST -> sema -> IR -> x86_64 binary -> ELF PIE")
        return 0
    }

    if str_eq(a1, "text") == 1 {
        return cmd_text_cmd()
    }

    if str_eq(a1, "target") == 1 {
        if host_argc() < 3 {
            err_line("usage: diva target <list|current>")
            return 1
        }
        var sub = host_argv(2)
        var sub_hold = sub
        if str_eq(sub_hold, "list") == 1 { return target_list() }
        if str_eq(sub_hold, "current") == 1 { return target_current() }
        err_line("usage: diva target <list|current>")
        return 1
    }

    if str_eq(a1, "onnx-check") == 1 {
        if host_argc() < 3 {
            err_line("usage: diva onnx-check <file.onnx.txt>")
            return 1
        }
        return cmd_onnx_check(host_argv(2))
    }

    if str_eq(a1, "onnx-run") == 1 {
        if host_argc() < 3 {
            err_line("usage: diva onnx-run <file.onnx.txt>")
            return 1
        }
        return cmd_onnx_run(host_argv(2))
    }

    if str_eq(a1, "onnx-mlir") == 1 {
        if host_argc() < 3 {
            err_line("usage: diva onnx-mlir <file.onnx.txt>")
            return 1
        }
        return cmd_onnx_mlir(host_argv(2))
    }

    err_line("unknown command; try: diva (no args shows usage)")
    return 1
}
