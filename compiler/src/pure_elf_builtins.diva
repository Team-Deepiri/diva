// Second-stage extern name match (ids 9..32). Split from codegen_x86.diva — see docs/seed-codegen-workarounds.md §1.
func pure_builtin_extern_id_hi_vec(nm: str): int {
    if str_eq(nm, "int_vec_new") == 1 { return 9 }
    if str_eq(nm, "int_vec_push") == 1 { return 10 }
    if str_eq(nm, "int_vec_len") == 1 { return 11 }
    if str_eq(nm, "int_vec_get") == 1 { return 12 }
    if str_eq(nm, "int_vec_free") == 1 { return 13 }
    if str_eq(nm, "str_builder_new") == 1 { return 14 }
    if str_eq(nm, "str_builder_append") == 1 { return 15 }
    if str_eq(nm, "str_builder_len") == 1 { return 16 }
    if str_eq(nm, "str_builder_to_str") == 1 { return 17 }
    if str_eq(nm, "str_builder_free") == 1 { return 18 }
    return 0
}

func pure_builtin_extern_id_hi_io(nm: str): int {
    if str_eq(nm, "print_hex") == 1 { return 19 }
    if str_eq(nm, "int_to_str") == 1 { return 20 }
    if str_eq(nm, "str_slice") == 1 { return 21 }
    if str_eq(nm, "file_size") == 1 { return 22 }
    if str_eq(nm, "read_file") == 1 { return 23 }
    if str_eq(nm, "mkdir") == 1 { return 28 }
    if str_eq(nm, "write_text_file") == 1 { return 29 }
    if str_eq(nm, "unlink") == 1 { return 30 }
    if str_eq(nm, "chmod_executable") == 1 { return 31 }
    if str_eq(nm, "write_elf_chunk") == 1 { return 32 }
    return 0
}

func pure_builtin_extern_id_hi_host(nm: str): int {
    if str_eq(nm, "host_argc") == 1 { return 24 }
    if str_eq(nm, "host_argv") == 1 { return 25 }
    if str_eq(nm, "host_getenv") == 1 { return 26 }
    if str_eq(nm, "host_system") == 1 { return 27 }
    return 0
}

func pure_builtin_extern_id_hi(nm: str): int {
    var v = pure_builtin_extern_id_hi_vec(nm)
    if (v != 0) {
        return v
    }
    v = pure_builtin_extern_id_hi_io(nm)
    if (v != 0) {
        return v
    }
    return pure_builtin_extern_id_hi_host(nm)
}

// Dispatch high builtin ids — see docs/seed-codegen-workarounds.md §2.
func emit_pure_builtin_high_vec(out: int, id: int): int {
    if id == 9 { return emit_pure_int_vec_new(out) }
    if id == 10 { return emit_pure_int_vec_push(out) }
    if id == 11 { return emit_pure_int_vec_len(out) }
    if id == 12 { return emit_pure_int_vec_get(out) }
    if id == 13 { return emit_pure_int_vec_free(out) }
    if id == 14 { return emit_pure_str_builder_new(out) }
    if id == 15 { return emit_pure_str_builder_append(out) }
    if id == 16 { return emit_pure_str_builder_len(out) }
    if id == 17 { return emit_pure_str_builder_to_str(out) }
    if id == 18 { return emit_pure_str_builder_free(out) }
    return 0
}

func emit_pure_builtin_high_misc(out: int, id: int): int {
    if id == 19 { return emit_pure_print_hex(out) }
    if id == 20 { return emit_pure_int_to_str(out) }
    if id == 21 { return emit_pure_str_slice(out) }
    if id == 22 { return emit_pure_file_size(out) }
    if id == 23 { return emit_pure_read_file(out) }
    if id == 24 { return emit_pure_host_argc(out) }
    if id == 25 { return emit_pure_host_argv(out) }
    if id == 26 { return emit_pure_host_getenv(out) }
    if id == 27 { return emit_pure_host_system(out) }
    if id == 28 { return emit_pure_mkdir(out) }
    if id == 29 { return emit_pure_write_text_file(out) }
    if id == 30 { return emit_pure_unlink(out) }
    if id == 31 { return emit_pure_chmod_executable(out) }
    if id == 32 { return emit_pure_write_elf_chunk(out) }
    return 0
}

func emit_pure_builtin_high(out: int, id: int): int {
    if (id < 19) {
        return emit_pure_builtin_high_vec(out, id)
    }
    return emit_pure_builtin_high_misc(out, id)
}
