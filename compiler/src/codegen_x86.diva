// x86_64 assembly codegen from Diva IR.
// Emits AT&T syntax for GNU assembler (gas).
// Uses a "line printer" (lp) pattern: build each line with str_builder,
// flush with print_str (which adds a real newline).

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "ir.diva"
import "tokens.diva"
import "cell.diva"

// --- Line printer: cell wrapping a str_builder, flushed per line ---

func lp_new(): int { return mut_new(str_builder_new()) }

func lp_add(lp: int, s: str): int {
    str_builder_append(mut_get(lp), s)
    return 0
}

func lp_add_int(lp: int, n: int): int {
    str_builder_append(mut_get(lp), int_to_str(n))
    return 0
}

func lp_flush(lp: int): int {
    var old = mut_get(lp)
    print_str(str_builder_to_str(old))
    str_builder_free(old)
    mut_set(lp, str_builder_new())
    return 0
}

// --- Helpers ---

func stack_offset(slot: int): str {
    var b = str_builder_new()
    str_builder_append(b, "-")
    str_builder_append(b, int_to_str((slot + 1) * 8))
    str_builder_append(b, "(%rbp)")
    var r = str_builder_to_str(b)
    str_builder_free(b)
    return r
}

func func_label(name_idx: int): str {
    var b = str_builder_new()
    str_builder_append(b, "_diva_fn")
    str_builder_append(b, int_to_str(name_idx))
    var r = str_builder_to_str(b)
    str_builder_free(b)
    return r
}

func bb_label(func_idx: int, lbl: int): str {
    var b = str_builder_new()
    str_builder_append(b, ".L")
    str_builder_append(b, int_to_str(func_idx))
    str_builder_append(b, "_")
    str_builder_append(b, int_to_str(lbl))
    var r = str_builder_to_str(b)
    str_builder_free(b)
    return r
}

// --- Instruction codegen ---

func cg_inst(lp: int, inst: int, fi: int): int {
    var op = inst_op(inst)
    var res = inst_result(inst)
    var a = inst_a(inst)
    var bv = inst_b(inst)

    if op == ir_const() {
        lp_add(lp, "    movq $") lp_add_int(lp, a) lp_add(lp, ", ") lp_add(lp, stack_offset(res)) lp_flush(lp)
        return 0
    }

    if op == ir_const_str() {
        lp_add(lp, "    leaq .Lstr") lp_add_int(lp, a) lp_add(lp, "(%rip), %rax") lp_flush(lp)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush(lp)
        return 0
    }

    if op == ir_add() | op == ir_sub() | op == ir_mul() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush(lp)
        if op == ir_add() { lp_add(lp, "    addq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush(lp) }
        if op == ir_sub() { lp_add(lp, "    subq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush(lp) }
        if op == ir_mul() { lp_add(lp, "    imulq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush(lp) }
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush(lp)
        return 0
    }

    if op == ir_div() | op == ir_mod() {
        lp_add(lp, "    movq $0, %rdx") lp_flush(lp)
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush(lp)
        lp_add(lp, "    cqto") lp_flush(lp)
        lp_add(lp, "    idivq ") lp_add(lp, stack_offset(bv)) lp_flush(lp)
        if op == ir_div() { lp_add(lp, "    movq %rax, ") } else { lp_add(lp, "    movq %rdx, ") }
        lp_add(lp, stack_offset(res)) lp_flush(lp)
        return 0
    }

    if op == ir_neg() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush(lp)
        lp_add(lp, "    negq %rax") lp_flush(lp)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush(lp)
        return 0
    }

    if op == ir_eq() | op == ir_ne() | op == ir_lt() | op == ir_le() | op == ir_gt() | op == ir_ge() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush(lp)
        lp_add(lp, "    cmpq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush(lp)
        if op == ir_eq() { lp_add(lp, "    sete %al") lp_flush(lp) }
        if op == ir_ne() { lp_add(lp, "    setne %al") lp_flush(lp) }
        if op == ir_lt() { lp_add(lp, "    setl %al") lp_flush(lp) }
        if op == ir_le() { lp_add(lp, "    setle %al") lp_flush(lp) }
        if op == ir_gt() { lp_add(lp, "    setg %al") lp_flush(lp) }
        if op == ir_ge() { lp_add(lp, "    setge %al") lp_flush(lp) }
        lp_add(lp, "    movzbq %al, %rax") lp_flush(lp)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush(lp)
        return 0
    }

    if op == ir_and() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush(lp)
        lp_add(lp, "    andq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush(lp)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush(lp)
        return 0
    }

    if op == ir_or() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush(lp)
        lp_add(lp, "    orq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush(lp)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush(lp)
        return 0
    }

    if op == ir_not() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush(lp)
        lp_add(lp, "    testq %rax, %rax") lp_flush(lp)
        lp_add(lp, "    sete %al") lp_flush(lp)
        lp_add(lp, "    movzbq %al, %rax") lp_flush(lp)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush(lp)
        return 0
    }

    if op == ir_load() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush(lp)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush(lp)
        return 0
    }

    if op == ir_store() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush(lp)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush(lp)
        return 0
    }

    if op == ir_alloca() {
        lp_add(lp, "    movq $0, ") lp_add(lp, stack_offset(res)) lp_flush(lp)
        return 0
    }

    if op == ir_param() {
        if a == 0 { lp_add(lp, "    movq %rdi, ") lp_add(lp, stack_offset(res)) lp_flush(lp) }
        if a == 1 { lp_add(lp, "    movq %rsi, ") lp_add(lp, stack_offset(res)) lp_flush(lp) }
        if a == 2 { lp_add(lp, "    movq %rdx, ") lp_add(lp, stack_offset(res)) lp_flush(lp) }
        if a == 3 { lp_add(lp, "    movq %rcx, ") lp_add(lp, stack_offset(res)) lp_flush(lp) }
        if a == 4 { lp_add(lp, "    movq %r8, ")  lp_add(lp, stack_offset(res)) lp_flush(lp) }
        if a == 5 { lp_add(lp, "    movq %r9, ")  lp_add(lp, stack_offset(res)) lp_flush(lp) }
        return 0
    }

    if op == ir_call() {
        lp_add(lp, "    call ") lp_add(lp, func_label(a)) lp_flush(lp)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush(lp)
        return 0
    }

    if op == ir_ret() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush(lp)
        lp_add(lp, "    leave") lp_flush(lp)
        lp_add(lp, "    ret") lp_flush(lp)
        return 0
    }

    if op == ir_ret_void() {
        lp_add(lp, "    leave") lp_flush(lp)
        lp_add(lp, "    ret") lp_flush(lp)
        return 0
    }

    if op == ir_br() {
        lp_add(lp, "    jmp ") lp_add(lp, bb_label(fi, a)) lp_flush(lp)
        return 0
    }

    if op == ir_br_cond() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(res)) lp_add(lp, ", %rax") lp_flush(lp)
        lp_add(lp, "    testq %rax, %rax") lp_flush(lp)
        lp_add(lp, "    jne ") lp_add(lp, bb_label(fi, a)) lp_flush(lp)
        lp_add(lp, "    jmp ") lp_add(lp, bb_label(fi, bv)) lp_flush(lp)
        return 0
    }

    return 0
}

// --- Function codegen ---

func cg_func(lp: int, f: int, fi: int): int {
    var flabel = func_label(func_name_idx(f))
    lp_add(lp, "    .globl ") lp_add(lp, flabel) lp_flush(lp)
    lp_add(lp, flabel) lp_add(lp, ":") lp_flush(lp)

    lp_add(lp, "    pushq %rbp") lp_flush(lp)
    lp_add(lp, "    movq %rsp, %rbp") lp_flush(lp)
    lp_add(lp, "    subq $2048, %rsp") lp_flush(lp)

    var bc = func_block_count(f)
    var bi = 0
    while bi < bc {
        var blk = func_get_block(f, bi)
        if bi > 0 {
            lp_add(lp, bb_label(fi, block_label(blk))) lp_add(lp, ":") lp_flush(lp)
        }
        var insts = block_insts(blk)
        var ic = int_vec_len(insts)
        var ii = 0
        while ii < ic {
            cg_inst(lp, int_vec_get(insts, ii), fi)
            ii = ii + 1
        }
        bi = bi + 1
    }
    lp_flush(lp)
    return 0
}

// --- Module codegen (prints directly) ---

func cg_module_print(m: int, src: str, toks: int, str_toks: int): int {
    var lp = lp_new()

    lp_add(lp, "    .text") lp_flush(lp)
    lp_flush(lp)

    var fc = mod_func_count(m)
    var fi = 0
    while fi < fc {
        cg_func(lp, mod_get_func(m, fi), fi)
        fi = fi + 1
    }

    if int_vec_len(str_toks) > 0 {
        lp_add(lp, "    .section .rodata") lp_flush(lp)
        var si = 0
        while si < int_vec_len(str_toks) {
            lp_add(lp, ".Lstr") lp_add_int(lp, si) lp_add(lp, ":") lp_flush(lp)
            var tok_idx = int_vec_get(str_toks, si)
            var s = tok_text(src, toks, tok_idx)
            lp_add(lp, "    .asciz ") lp_add(lp, s) lp_flush(lp)
            si = si + 1
        }
    }

    return 0
}
