// x86_64 assembly codegen from Diva IR (AT&T / gas).
// Labels: user main() -> main (CRT entry); other user funcs -> _diva_<name>;
// extern calls -> di_runtime_<name> (matches runtime .o symbols).

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "ir.diva"
import "tokens.diva"
import "cell.diva"

func lp_new(): int { return mut_new(str_builder_new()) }

func lp_add(lp: int, s: str): int {
    str_builder_append(mut_get(lp), s)
    return 0
}

func lp_add_int(lp: int, n: int): int {
    str_builder_append(mut_get(lp), int_to_str(n))
    return 0
}

// Append completed line to sb followed by nl (real newline str).
func lp_flush_sb(lp: int, sb: int, nl: str): int {
    var cur = mut_get(lp)
    str_builder_append(sb, str_builder_to_str(cur))
    str_builder_append(sb, nl)
    str_builder_free(cur)
    mut_set(lp, str_builder_new())
    return 0
}

func lp_flush_print(lp: int): int {
    var old = mut_get(lp)
    print_str(str_builder_to_str(old))
    str_builder_free(old)
    mut_set(lp, str_builder_new())
    return 0
}

func stack_offset(slot: int): str {
    var b = str_builder_new()
    str_builder_append(b, "-")
    str_builder_append(b, int_to_str((slot + 1) * 8))
    str_builder_append(b, "(%rbp)")
    var r = str_builder_to_str(b)
    str_builder_free(b)
    return r
}

func asm_user_label(src: str, toks: int, name_tok: int): str {
    var nm = tok_text(src, toks, name_tok)
    if str_eq(nm, "main") == 1 {
        return "main"
    }
    var b = str_builder_new()
    str_builder_append(b, "_diva_")
    str_builder_append(b, nm)
    var r = str_builder_to_str(b)
    str_builder_free(b)
    return r
}

func asm_runtime_label(src: str, toks: int, name_tok: int): str {
    var nm = tok_text(src, toks, name_tok)
    if str_eq(nm, "set_argv") == 1 { return "di_runtime_set_argv" }
    if str_eq(nm, "argc") == 1 { return "di_runtime_argc" }
    if str_eq(nm, "argv") == 1 { return "di_runtime_argv" }
    if str_eq(nm, "getenv") == 1 { return "di_runtime_getenv" }
    if str_eq(nm, "system") == 1 { return "di_runtime_system" }
    if str_eq(nm, "file_size") == 1 { return "di_runtime_file_size" }
    if str_eq(nm, "read_file") == 1 { return "di_runtime_read_file" }
    if str_eq(nm, "str_len") == 1 { return "di_runtime_str_len" }
    if str_eq(nm, "str_byte") == 1 { return "di_runtime_str_byte" }
    if str_eq(nm, "str_slice") == 1 { return "di_runtime_str_slice" }
    if str_eq(nm, "str_eq") == 1 { return "di_runtime_str_eq" }
    if str_eq(nm, "int_to_str") == 1 { return "di_runtime_int_to_str" }
    if str_eq(nm, "int_vec_new") == 1 { return "di_runtime_int_vec_new" }
    if str_eq(nm, "int_vec_push") == 1 { return "di_runtime_int_vec_push" }
    if str_eq(nm, "int_vec_len") == 1 { return "di_runtime_int_vec_len" }
    if str_eq(nm, "int_vec_get") == 1 { return "di_runtime_int_vec_get" }
    if str_eq(nm, "int_vec_free") == 1 { return "di_runtime_int_vec_free" }
    if str_eq(nm, "str_builder_new") == 1 { return "di_runtime_str_builder_new" }
    if str_eq(nm, "str_builder_append") == 1 { return "di_runtime_str_builder_append" }
    if str_eq(nm, "str_builder_len") == 1 { return "di_runtime_str_builder_len" }
    if str_eq(nm, "str_builder_to_str") == 1 { return "di_runtime_str_builder_to_str" }
    if str_eq(nm, "str_builder_free") == 1 { return "di_runtime_str_builder_free" }
    if str_eq(nm, "print_int") == 1 { return "di_runtime_print_int" }
    if str_eq(nm, "print_str") == 1 { return "di_runtime_print_str" }
    if str_eq(nm, "print_hex") == 1 { return "di_runtime_print_hex" }
    if str_eq(nm, "write") == 1 { return "di_runtime_write" }
    if str_eq(nm, "exit") == 1 { return "di_runtime_exit" }
    if str_eq(nm, "abort") == 1 { return "di_runtime_abort" }
    return nm
}

func call_is_extern(m: int, src: str, toks: int, call_tok: int): int {
    var cname = tok_text(src, toks, call_tok)
    var fc = mod_func_count(m)
    var i = 0
    while (i < fc) {
        var ftok = func_name_tok(mod_get_func(m, i))
        if str_eq(tok_text(src, toks, ftok), cname) == 1 {
            return 0
        }
        i = i + 1
    }
    return 1
}

func abi_reg_name(i: int): str {
    if i == 0 { return "%rdi" }
    if i == 1 { return "%rsi" }
    if i == 2 { return "%rdx" }
    if i == 3 { return "%rcx" }
    if i == 4 { return "%r8" }
    if i == 5 { return "%r9" }
    return "%rdi"
}

func bb_label(func_idx: int, lbl: int): str {
    var b = str_builder_new()
    str_builder_append(b, ".L")
    str_builder_append(b, int_to_str(func_idx))
    str_builder_append(b, "_")
    str_builder_append(b, int_to_str(lbl))
    var r = str_builder_to_str(b)
    str_builder_free(b)
    return r
}

// Pack int-only codegen context to avoid >6 arg call sites in self-hosted codegen.
// [0]=lp [1]=sb [2]=m [3]=toks [4]=fi
func cg_ctx_new(lp: int, sb: int, m: int, toks: int, fi: int): int {
    var c = int_vec_new()
    int_vec_push(c, lp)
    int_vec_push(c, sb)
    int_vec_push(c, m)
    int_vec_push(c, toks)
    int_vec_push(c, fi)
    return c
}

func cg_ctx_lp(c: int): int { return int_vec_get(c, 0) }
func cg_ctx_sb(c: int): int { return int_vec_get(c, 1) }
func cg_ctx_m(c: int): int { return int_vec_get(c, 2) }
func cg_ctx_toks(c: int): int { return int_vec_get(c, 3) }
func cg_ctx_fi(c: int): int { return int_vec_get(c, 4) }

func cg_inst(ctx: int, src: str, nl: str, inst: int): int {
    var lp = cg_ctx_lp(ctx)
    var sb = cg_ctx_sb(ctx)
    var m = cg_ctx_m(ctx)
    var toks = cg_ctx_toks(ctx)
    var fi = cg_ctx_fi(ctx)
    var op = inst_op(inst)
    var res = inst_result(inst)
    var a = inst_a(inst)
    var bv = inst_b(inst)

    if op == ir_const() {
        lp_add(lp, "    movq $") lp_add_int(lp, a) lp_add(lp, ", ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 0
    }

    if op == ir_const_str() {
        lp_add(lp, "    leaq .Lstr") lp_add_int(lp, a) lp_add(lp, "(%rip), %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 0
    }

    if op == ir_add() | op == ir_sub() | op == ir_mul() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        if op == ir_add() { lp_add(lp, "    addq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl) }
        if op == ir_sub() { lp_add(lp, "    subq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl) }
        if op == ir_mul() { lp_add(lp, "    imulq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl) }
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 0
    }

    if op == ir_div() | op == ir_mod() {
        lp_add(lp, "    movq $0, %rdx") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    cqto") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    idivq ") lp_add(lp, stack_offset(bv)) lp_flush_sb(lp, sb, nl)
        if op == ir_div() { lp_add(lp, "    movq %rax, ") } else { lp_add(lp, "    movq %rdx, ") }
        lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 0
    }

    if op == ir_neg() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    negq %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 0
    }

    if op == ir_eq() | op == ir_ne() | op == ir_lt() | op == ir_le() | op == ir_gt() | op == ir_ge() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    cmpq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        if op == ir_eq() { lp_add(lp, "    sete %al") lp_flush_sb(lp, sb, nl) }
        if op == ir_ne() { lp_add(lp, "    setne %al") lp_flush_sb(lp, sb, nl) }
        if op == ir_lt() { lp_add(lp, "    setl %al") lp_flush_sb(lp, sb, nl) }
        if op == ir_le() { lp_add(lp, "    setle %al") lp_flush_sb(lp, sb, nl) }
        if op == ir_gt() { lp_add(lp, "    setg %al") lp_flush_sb(lp, sb, nl) }
        if op == ir_ge() { lp_add(lp, "    setge %al") lp_flush_sb(lp, sb, nl) }
        lp_add(lp, "    movzbq %al, %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 0
    }

    if op == ir_and() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    andq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 0
    }

    if op == ir_or() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    orq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 0
    }
    
    if op == ir_shl() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rcx") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    salq %cl, %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 0
    }
    
    if op == ir_shr() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rcx") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    sarq %cl, %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 0
    }
    
    if op == ir_not() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    testq %rax, %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    sete %al") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movzbq %al, %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 0
    }

    if op == ir_load() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 0
    }

    if op == ir_store() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 0
    }

    if op == ir_alloca() {
        lp_add(lp, "    movq $0, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 0
    }

    if op == ir_param() {
        if a == 0 { lp_add(lp, "    movq %rdi, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl) }
        if a == 1 { lp_add(lp, "    movq %rsi, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl) }
        if a == 2 { lp_add(lp, "    movq %rdx, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl) }
        if a == 3 { lp_add(lp, "    movq %rcx, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl) }
        if a == 4 { lp_add(lp, "    movq %r8, ")  lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl) }
        if a == 5 { lp_add(lp, "    movq %r9, ")  lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl) }
        return 0
    }

    if op == ir_call() {
        var argc = inst_b(inst)
        if argc == 1 {
            var only_vr = inst_extra(inst)
            lp_add(lp, "    movq ")
            lp_add(lp, stack_offset(only_vr))
            lp_add(lp, ", %rdi")
            lp_flush_sb(lp, sb, nl)
        } else {
            var args = inst_extra(inst)
            var ci = 0
            while (ci < argc) {
                var vr = int_vec_get(args, ci)
                lp_add(lp, "    movq ")
                lp_add(lp, stack_offset(vr))
                lp_add(lp, ", ")
                lp_add(lp, abi_reg_name(ci))
                lp_flush_sb(lp, sb, nl)
                ci = ci + 1
            }
        }
        var ctok = inst_a(inst)
        var lab = ""
        if call_is_extern(m, src, toks, ctok) == 1 {
            lab = asm_runtime_label(src, toks, ctok)
        } else {
            lab = asm_user_label(src, toks, ctok)
        }
        lp_add(lp, "    call ")
        lp_add(lp, lab)
        lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ")
        lp_add(lp, stack_offset(res))
        lp_flush_sb(lp, sb, nl)
        return 0
    }

    if op == ir_ret() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    leave") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    ret") lp_flush_sb(lp, sb, nl)
        return 0
    }

    if op == ir_ret_void() {
        lp_add(lp, "    leave") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    ret") lp_flush_sb(lp, sb, nl)
        return 0
    }

    if op == ir_br() {
        lp_add(lp, "    jmp ") lp_add(lp, bb_label(fi, a)) lp_flush_sb(lp, sb, nl)
        return 0
    }

    if op == ir_br_cond() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(res)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    testq %rax, %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    jne ") lp_add(lp, bb_label(fi, a)) lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    jmp ") lp_add(lp, bb_label(fi, bv)) lp_flush_sb(lp, sb, nl)
        return 0
    }

    return 0
}

func cg_func(ctx: int, src: str, nl: str, f: int, fi: int): int {
    var lp = cg_ctx_lp(ctx)
    var sb = cg_ctx_sb(ctx)
    var m = cg_ctx_m(ctx)
    var toks = cg_ctx_toks(ctx)
    var fctx = cg_ctx_new(lp, sb, m, toks, fi)
    var flabel = asm_user_label(src, toks, func_name_tok(f))
    lp_add(lp, "    .globl ") lp_add(lp, flabel) lp_flush_sb(lp, sb, nl)
    lp_add(lp, flabel) lp_add(lp, ":") lp_flush_sb(lp, sb, nl)

    if str_eq(flabel, "main") == 1 {
        lp_add(lp, "    call di_runtime_set_argv") lp_flush_sb(lp, sb, nl)
    }

    lp_add(lp, "    pushq %rbp") lp_flush_sb(lp, sb, nl)
    lp_add(lp, "    movq %rsp, %rbp") lp_flush_sb(lp, sb, nl)
    lp_add(lp, "    subq $2048, %rsp") lp_flush_sb(lp, sb, nl)

    var bc = func_block_count(f)
    var bi = 0
    while (bi < bc) {
        var blk = func_get_block(f, bi)
        if (bi > 0) {
            lp_add(lp, bb_label(fi, block_label(blk))) lp_add(lp, ":") lp_flush_sb(lp, sb, nl)
        }
        var insts = block_insts(blk)
        var ic = int_vec_len(insts)
        var ii = 0
        while (ii < ic) {
            cg_inst(fctx, src, nl, int_vec_get(insts, ii))
            ii = ii + 1
        }
        bi = bi + 1
    }
    int_vec_free(fctx)
    lp_flush_sb(lp, sb, nl)
    return 0
}

// Full assembly text (caller frees builder if needed — str is a copy).
func cg_module_to_str(m: int, src: str, toks: int, str_toks: int, nl: str): str {
    var sb = str_builder_new()
    var lp = lp_new()

    lp_add(lp, "    .text") lp_flush_sb(lp, sb, nl)
    lp_flush_sb(lp, sb, nl)

    var fc = mod_func_count(m)
    var fi = 0
    while (fi < fc) {
        // Build per-function ctx so helpers never use >6 args.
        var ctx = cg_ctx_new(lp, sb, m, toks, fi)
        cg_func(ctx, src, nl, mod_get_func(m, fi), fi)
        int_vec_free(ctx)
        fi = fi + 1
    }

    var gc = mod_global_count(m)
    if (gc > 0) {
        lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    .data") lp_flush_sb(lp, sb, nl)
        var gi = 0
        while (gi < gc) {
            var g = mod_get_global(m, gi)
            var gname = tok_text(src, toks, global_name_tok(g))
            lp_add(lp, "    .globl ") lp_add(lp, gname) lp_flush_sb(lp, sb, nl)
            lp_add(lp, gname) lp_add(lp, ":") lp_flush_sb(lp, sb, nl)
            var ginit = global_init(g)
            lp_add(lp, "    .quad ")
            lp_add_int(lp, ginit)
            lp_flush_sb(lp, sb, nl)
            gi = gi + 1
        }
    }

    if (int_vec_len(str_toks) > 0) {
        lp_add(lp, "    .section .rodata") lp_flush_sb(lp, sb, nl)
        var si = 0
        while (si < int_vec_len(str_toks)) {
            lp_add(lp, ".Lstr") lp_add_int(lp, si) lp_add(lp, ":") lp_flush_sb(lp, sb, nl)
            var tok_idx = int_vec_get(str_toks, si)
            var s = tok_str_value(src, toks, tok_idx)
            var bi = 0
            var bn = str_len(s)
            while (bi < bn) {
                lp_add(lp, "    .byte ")
                lp_add_int(lp, str_byte(s, bi))
                lp_flush_sb(lp, sb, nl)
                bi = bi + 1
            }
            lp_add(lp, "    .byte 0")
            lp_flush_sb(lp, sb, nl)
            si = si + 1
        }
    }

    var out = str_builder_to_str(sb)
    str_builder_free(sb)
    return out
}

func emit_i32(out: int, val: int): void {
    int_vec_push(out, val & 255)
    int_vec_push(out, (val / 256) & 255)
    int_vec_push(out, (val / 65536) & 255)
    int_vec_push(out, (val / 16777216) & 255)
}

func find_func_index_by_tok(m: int, src: str, toks: int, call_tok: int): int {
    var cname = tok_text(src, toks, call_tok)
    var fc = mod_func_count(m)
    var i = 0
    while (i < fc) {
        var ftok = func_name_tok(mod_get_func(m, i))
        if str_eq(tok_text(src, toks, ftok), cname) == 1 {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

func emit_arg_move_to_abi_reg(out: int, arg_idx: int, src_slot: int): int {
    if arg_idx == 0 {
        int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 125) int_vec_push(out, src_slot & 255) // rdi
        return 4
    }
    if arg_idx == 1 {
        int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 117) int_vec_push(out, src_slot & 255) // rsi
        return 4
    }
    if arg_idx == 2 {
        int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 85) int_vec_push(out, src_slot & 255) // rdx
        return 4
    }
    if arg_idx == 3 {
        int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 77) int_vec_push(out, src_slot & 255) // rcx
        return 4
    }
    if arg_idx == 4 {
        int_vec_push(out, 76) int_vec_push(out, 139) int_vec_push(out, 69) int_vec_push(out, src_slot & 255) // r8
        return 4
    }
    if arg_idx == 5 {
        int_vec_push(out, 76) int_vec_push(out, 139) int_vec_push(out, 77) int_vec_push(out, src_slot & 255) // r9
        return 4
    }
    return 0
}

func cg_module_to_bin(m: int, src: str, toks: int, str_toks: int, out: int): int {
    var fc = mod_func_count(m)
    if fc == 0 { return 0 }
    var main_off = 0
    // Byte offset in the RX segment where the inline string pool starts (after all insns).
    var str_cum = int_vec_new()
    var str_si = 0
    var str_acc = 0
    while (str_si < int_vec_len(str_toks)) {
        int_vec_push(str_cum, str_acc)
        var stok = int_vec_get(str_toks, str_si)
        var s = tok_str_value(src, toks, stok)
        str_acc = str_acc + str_len(s) + 1
        str_si = str_si + 1
    }
    var instr_total = 0
    var main_fi = 0 - 1
    var fmj = 0
    while (fmj < fc) {
        var ffn = mod_get_func(m, fmj)
        if str_eq(tok_text(src, toks, func_name_tok(ffn)), "main") == 1 {
            main_fi = fmj
        }
        fmj = fmj + 1
    }
    
    // Pass 1: Label resolution
    var block_offsets = int_vec_new()
    var func_offsets = int_vec_new()
    var current_offset = 0

    var fi = 0
    while (fi < fc) {
        var f = mod_get_func(m, fi)
        int_vec_push(func_offsets, current_offset)
        current_offset = current_offset + 12 // function prologue
        var bc = func_block_count(f)
        var bi = 0
        while (bi < bc) {
            var blk = func_get_block(f, bi)
            int_vec_push(block_offsets, current_offset)
            var insts = block_insts(blk)
            var ic = int_vec_len(insts)
            var ii = 0
            while (ii < ic) {
                var inst = int_vec_get(insts, ii)
                var op = inst_op(inst)
                if op == ir_const() { current_offset = current_offset + 8 }
                if op == ir_const_str() { current_offset = current_offset + 11 }
                if op == ir_add() | op == ir_sub() | op == ir_mul() { current_offset = current_offset + 15 }
                if op == ir_div() | op == ir_mod() { current_offset = current_offset + 14 }
                if op == ir_eq() | op == ir_ne() | op == ir_lt() | op == ir_le() | op == ir_gt() | op == ir_ge() { current_offset = current_offset + 18 }
                if op == ir_and() | op == ir_or() { current_offset = current_offset + 15 }
                if op == ir_not() | op == ir_neg() { current_offset = current_offset + 11 }
                if op == ir_shl() | op == ir_shr() { current_offset = current_offset + 15 }
                if op == ir_load() | op == ir_store() | op == ir_copy() { current_offset = current_offset + 8 }
                if op == ir_alloca() { current_offset = current_offset + 8 }
                if op == ir_param() { current_offset = current_offset + 4 }
                if op == ir_ret() {
                    if (fi == main_fi) == 1 {
                        current_offset = current_offset + 15
                    } else {
                        current_offset = current_offset + 6
                    }
                }
                if op == ir_ret_void() {
                    if (fi == main_fi) == 1 {
                        current_offset = current_offset + 11
                    } else {
                        current_offset = current_offset + 2
                    }
                }
                if op == ir_br() { current_offset = current_offset + 5 }
                if op == ir_br_cond() { current_offset = current_offset + 12 }
                if op == ir_call() {
                    var argc = inst_b(inst)
                    var usec = argc
                    if usec > 6 { usec = 6 }
                    if argc == 1 {
                        current_offset = current_offset + 4 + 5 + 4
                    } else {
                        current_offset = current_offset + usec * 4 + 5 + 4
                    }
                }
                ii = ii + 1
            }
            bi = bi + 1
        }
        fi = fi + 1
    }
    var fk = 0
    while (fk < fc) {
        var ff = mod_get_func(m, fk)
        if str_eq(tok_text(src, toks, func_name_tok(ff)), "main") == 1 {
            main_off = int_vec_get(func_offsets, fk)
        }
        fk = fk + 1
    }
    instr_total = current_offset

    // Pass 2: Code emission
    fi = 0
    var code_ptr = 0
    while (fi < fc) {
        int_vec_push(out, 85) // push rbp
        int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 229) // mov rbp, rsp
        int_vec_push(out, 72) int_vec_push(out, 129) int_vec_push(out, 236) // sub rsp, 2048
        int_vec_push(out, 0) int_vec_push(out, 8) int_vec_push(out, 0) int_vec_push(out, 0)
        code_ptr = code_ptr + 12

        var f = mod_get_func(m, fi)
        var bc = func_block_count(f)
        var bi = 0
        while (bi < bc) {
            var blk = func_get_block(f, bi)
            var insts = block_insts(blk)
            var ic = int_vec_len(insts)
            var ii = 0
            while (ii < ic) {
                var inst = int_vec_get(insts, ii)
                var op = inst_op(inst)
                var res = inst_result(inst)
                var a = inst_a(inst)
                var bv = inst_b(inst)
                
                if op == ir_const() {
                    var offset = 256 - (res + 1) * 8
                    int_vec_push(out, 72) int_vec_push(out, 199) int_vec_push(out, 69) int_vec_push(out, offset & 255)
                    emit_i32(out, a)
                    code_ptr = code_ptr + 8
                }
                if op == ir_const_str() {
                    var sid = a
                    var lea_off = int_vec_len(out)
                    var rel = instr_total + int_vec_get(str_cum, sid) - (lea_off + 7)
                    int_vec_push(out, 72) int_vec_push(out, 141) int_vec_push(out, 5)
                    emit_i32(out, rel)
                    var off_res = 256 - (res + 1) * 8
                    int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 69) int_vec_push(out, off_res & 255)
                    code_ptr = code_ptr + 11
                }
                if op == ir_add() | op == ir_sub() | op == ir_mul() {
                    var off_a = 256 - (a + 1) * 8
                    var off_b = 256 - (bv + 1) * 8
                    var off_res = 256 - (res + 1) * 8
                    int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 69) int_vec_push(out, off_a & 255)
                    if op == ir_add() { int_vec_push(out, 72) int_vec_push(out, 3) int_vec_push(out, 69) int_vec_push(out, off_b & 255) }
                    if op == ir_sub() { int_vec_push(out, 72) int_vec_push(out, 43) int_vec_push(out, 69) int_vec_push(out, off_b & 255) }
                    if op == ir_mul() { int_vec_push(out, 72) int_vec_push(out, 15) int_vec_push(out, 175) int_vec_push(out, 69) int_vec_push(out, off_b & 255) }
                    int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 69) int_vec_push(out, off_res & 255)
                    code_ptr = code_ptr + 15
                }
                if op == ir_div() | op == ir_mod() {
                    var off_a = 256 - (a + 1) * 8
                    var off_b = 256 - (bv + 1) * 8
                    var off_res = 256 - (res + 1) * 8
                    int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 69) int_vec_push(out, off_a & 255)
                    int_vec_push(out, 72) int_vec_push(out, 153)
                    int_vec_push(out, 72) int_vec_push(out, 247) int_vec_push(out, 125) int_vec_push(out, off_b & 255)
                    if op == ir_div() {
                        int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 69) int_vec_push(out, off_res & 255)
                    } else {
                        int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 85) int_vec_push(out, off_res & 255)
                    }
                    code_ptr = code_ptr + 14
                }
                if op == ir_eq() | op == ir_ne() | op == ir_lt() | op == ir_le() | op == ir_gt() | op == ir_ge() {
                    var off_a = 256 - (a + 1) * 8
                    var off_b = 256 - (bv + 1) * 8
                    var off_res = 256 - (res + 1) * 8
                    int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 69) int_vec_push(out, off_a & 255)
                    int_vec_push(out, 72) int_vec_push(out, 59) int_vec_push(out, 69) int_vec_push(out, off_b & 255)
                    if op == ir_eq() { int_vec_push(out, 15) int_vec_push(out, 148) int_vec_push(out, 192) }
                    if op == ir_ne() { int_vec_push(out, 15) int_vec_push(out, 149) int_vec_push(out, 192) }
                    if op == ir_lt() { int_vec_push(out, 15) int_vec_push(out, 156) int_vec_push(out, 192) }
                    if op == ir_le() { int_vec_push(out, 15) int_vec_push(out, 158) int_vec_push(out, 192) }
                    if op == ir_gt() { int_vec_push(out, 15) int_vec_push(out, 159) int_vec_push(out, 192) }
                    if op == ir_ge() { int_vec_push(out, 15) int_vec_push(out, 157) int_vec_push(out, 192) }
                    int_vec_push(out, 72) int_vec_push(out, 15) int_vec_push(out, 182) int_vec_push(out, 192)
                    int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 69) int_vec_push(out, off_res & 255)
                    code_ptr = code_ptr + 18
                }
                if op == ir_and() | op == ir_or() {
                    var off_a = 256 - (a + 1) * 8
                    var off_b = 256 - (bv + 1) * 8
                    var off_res = 256 - (res + 1) * 8
                    int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 69) int_vec_push(out, off_a & 255)
                    if op == ir_and() { int_vec_push(out, 72) int_vec_push(out, 35) int_vec_push(out, 69) int_vec_push(out, off_b & 255) }
                    if op == ir_or() { int_vec_push(out, 72) int_vec_push(out, 11) int_vec_push(out, 69) int_vec_push(out, off_b & 255) }
                    int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 69) int_vec_push(out, off_res & 255)
                    code_ptr = code_ptr + 15
                }
                if op == ir_shl() | op == ir_shr() {
                    var off_a = 256 - (a + 1) * 8
                    var off_b = 256 - (bv + 1) * 8
                    var off_res = 256 - (res + 1) * 8
                    int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 77) int_vec_push(out, off_b & 255)
                    int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 69) int_vec_push(out, off_a & 255)
                    if op == ir_shl() { int_vec_push(out, 72) int_vec_push(out, 211) int_vec_push(out, 224) }
                    if op == ir_shr() { int_vec_push(out, 72) int_vec_push(out, 211) int_vec_push(out, 248) }
                    int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 69) int_vec_push(out, off_res & 255)
                    code_ptr = code_ptr + 15
                }
                if op == ir_not() | op == ir_neg() {
                    var off_a = 256 - (a + 1) * 8
                    var off_res = 256 - (res + 1) * 8
                    int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 69) int_vec_push(out, off_a & 255)
                    if op == ir_neg() { int_vec_push(out, 72) int_vec_push(out, 247) int_vec_push(out, 216) }
                    if op == ir_not() { int_vec_push(out, 72) int_vec_push(out, 133) int_vec_push(out, 192) int_vec_push(out, 15) int_vec_push(out, 148) int_vec_push(out, 192) int_vec_push(out, 72) int_vec_push(out, 15) int_vec_push(out, 182) int_vec_push(out, 192) }
                    int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 69) int_vec_push(out, off_res & 255)
                    code_ptr = code_ptr + 11
                }
                if op == ir_load() | op == ir_store() | op == ir_copy() {
                    var off_a = 256 - (a + 1) * 8
                    var off_res = 256 - (res + 1) * 8
                    int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 69) int_vec_push(out, off_a & 255)
                    int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 69) int_vec_push(out, off_res & 255)
                    code_ptr = code_ptr + 8
                }
                if op == ir_alloca() {
                    var off_res = 256 - (res + 1) * 8
                    int_vec_push(out, 72) int_vec_push(out, 199) int_vec_push(out, 69) int_vec_push(out, off_res & 255)
                    emit_i32(out, 0)
                    code_ptr = code_ptr + 8
                }
                if op == ir_param() {
                    var off_res = 256 - (res + 1) * 8
                    if a == 0 { int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 125) int_vec_push(out, off_res & 255) }
                    code_ptr = code_ptr + 4
                }
                if op == ir_br() {
                    var target_off = int_vec_get(block_offsets, a)
                    var rel = target_off - (code_ptr + 5)
                    int_vec_push(out, 233)
                    emit_i32(out, rel)
                    code_ptr = code_ptr + 5
                }
                if op == ir_br_cond() {
                    var off_cond = 256 - (res + 1) * 8
                    int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 69) int_vec_push(out, off_cond & 255)
                    int_vec_push(out, 72) int_vec_push(out, 133) int_vec_push(out, 192)
                    var then_off = int_vec_get(block_offsets, a)
                    var else_off = int_vec_get(block_offsets, bv)
                    var rel_then = then_off - (code_ptr + 12)
                    int_vec_push(out, 15) int_vec_push(out, 133)
                    emit_i32(out, rel_then)
                    var rel_else = else_off - (code_ptr + 12)
                    int_vec_push(out, 233)
                    emit_i32(out, rel_else)
                    code_ptr = code_ptr + 12
                }
                if op == ir_call() {
                    var argc = inst_b(inst)
                    if argc == 1 {
                        var only_vr = inst_extra(inst)
                        var only_off = 256 - (only_vr + 1) * 8
                        code_ptr = code_ptr + emit_arg_move_to_abi_reg(out, 0, only_off)
                    } else {
                        var args_h = inst_extra(inst)
                        var usec = argc
                        if usec > 6 { usec = 6 }
                        var ai = 0
                        while (ai < usec) {
                            var vr = int_vec_get(args_h, ai)
                            var off = 256 - (vr + 1) * 8
                            code_ptr = code_ptr + emit_arg_move_to_abi_reg(out, ai, off)
                            ai = ai + 1
                        }
                    }

                    var target_fi = find_func_index_by_tok(m, src, toks, a)
                    if (target_fi < 0) == 0 {
                        var target_off = int_vec_get(func_offsets, target_fi)
                        var rel = target_off - (code_ptr + 5)
                        int_vec_push(out, 232)
                        emit_i32(out, rel)
                    } else {
                        // Native bin path currently supports only intra-module direct calls.
                        int_vec_push(out, 49) int_vec_push(out, 192) // xor eax,eax
                        int_vec_push(out, 144) int_vec_push(out, 144) int_vec_push(out, 144) // nop,nop,nop
                    }
                    code_ptr = code_ptr + 5

                    var off_res = 256 - (res + 1) * 8
                    int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 69) int_vec_push(out, off_res & 255)
                    code_ptr = code_ptr + 4
                }
                if op == ir_ret() {
                    var offset = 256 - (a + 1) * 8
                    int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 69) int_vec_push(out, offset & 255)
                    int_vec_push(out, 201)
                    if (fi == main_fi) == 1 {
                        int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 199)
                        int_vec_push(out, 184) int_vec_push(out, 60) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
                        int_vec_push(out, 15) int_vec_push(out, 5)
                        code_ptr = code_ptr + 15
                    } else {
                        int_vec_push(out, 195)
                        code_ptr = code_ptr + 6
                    }
                }
                if op == ir_ret_void() {
                    if (fi == main_fi) == 1 {
                        int_vec_push(out, 201)
                        int_vec_push(out, 72) int_vec_push(out, 49) int_vec_push(out, 255)
                        int_vec_push(out, 184) int_vec_push(out, 60) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
                        int_vec_push(out, 15) int_vec_push(out, 5)
                        code_ptr = code_ptr + 11
                    } else {
                        int_vec_push(out, 201) int_vec_push(out, 195)
                        code_ptr = code_ptr + 2
                    }
                }
                ii = ii + 1
            }
            bi = bi + 1
        }
        fi = fi + 1
    }
    var ap = 0
    while (ap < int_vec_len(str_toks)) {
        var atok = int_vec_get(str_toks, ap)
        var s2 = tok_str_value(src, toks, atok)
        var bi2 = 0
        var bn2 = str_len(s2)
        while (bi2 < bn2) {
            int_vec_push(out, str_byte(s2, bi2))
            bi2 = bi2 + 1
        }
        int_vec_push(out, 0)
        ap = ap + 1
    }
    int_vec_free(block_offsets)
    int_vec_free(func_offsets)
    int_vec_free(str_cum)
    return main_off
}

func cg_module_print(m: int, src: str, toks: int, str_toks: int, nl: str): int {
    var s = cg_module_to_str(m, src, toks, str_toks, nl)
    stdout(s)
    return 0
}
