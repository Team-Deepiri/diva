// Token kind constants and token stream accessors for the Diva compiler.
// A token stream is an int_vec of [kind, start, length] triples.

import "std/host.diva"
import "std/vec.diva"

// --- Token kinds ---

func tk_eof(): int       { return 0 }
func tk_ident(): int     { return 1 }
func tk_int_lit(): int   { return 2 }
func tk_str_lit(): int   { return 3 }

func tk_func(): int      { return 10 }
func tk_extern(): int    { return 11 }
func tk_var(): int       { return 12 }
func tk_let(): int       { return 13 }
func tk_if(): int        { return 14 }
func tk_else(): int      { return 15 }
func tk_while(): int     { return 16 }
func tk_return(): int    { return 17 }
func tk_import(): int    { return 18 }
func tk_package(): int   { return 19 }
func tk_class(): int     { return 20 }
func tk_trait(): int     { return 21 }
func tk_impl(): int      { return 22 }
func tk_flux(): int      { return 23 }
func tk_in(): int        { return 24 }
func tk_true(): int      { return 25 }
func tk_false(): int     { return 26 }
func tk_void(): int      { return 27 }
func tk_int_kw(): int    { return 28 }
func tk_str_kw(): int    { return 29 }
func tk_bool_kw(): int   { return 30 }
func tk_struct(): int    { return 31 }
func tk_for(): int       { return 32 }
func tk_self(): int      { return 33 }

func tk_lparen(): int    { return 40 }
func tk_rparen(): int    { return 41 }
func tk_lbrace(): int    { return 42 }
func tk_rbrace(): int    { return 43 }
func tk_lbrack(): int    { return 44 }
func tk_rbrack(): int    { return 45 }
func tk_comma(): int     { return 46 }
func tk_semi(): int      { return 47 }
func tk_colon(): int     { return 48 }
func tk_dot(): int       { return 49 }
func tk_plus(): int      { return 50 }
func tk_minus(): int     { return 51 }
func tk_star(): int      { return 52 }
func tk_slash(): int     { return 53 }
func tk_lt(): int        { return 54 }
func tk_gt(): int        { return 55 }
func tk_bang(): int      { return 56 }
func tk_amp(): int       { return 57 }
func tk_pipe(): int      { return 58 }
func tk_eq(): int        { return 59 }
func tk_eqeq(): int     { return 60 }
func tk_ne(): int        { return 61 }
func tk_le(): int        { return 62 }
func tk_ge(): int        { return 63 }
func tk_fatarrow(): int  { return 64 }
func tk_dotdot(): int    { return 65 }
func tk_coloncolon(): int { return 66 }
func tk_percent(): int   { return 67 }

// --- Token stream ---

func tok_stream_new(): int {
    return int_vec_new()
}

func tok_stream_push(stream: int, kind: int, start: int, length: int): int {
    int_vec_push(stream, kind)
    int_vec_push(stream, start)
    int_vec_push(stream, length)
    return 0
}

func tok_count(stream: int): int {
    return int_vec_len(stream) / 3
}

func tok_kind(stream: int, index: int): int {
    return int_vec_get(stream, index * 3)
}

func tok_start(stream: int, index: int): int {
    return int_vec_get(stream, index * 3 + 1)
}

func tok_len(stream: int, index: int): int {
    return int_vec_get(stream, index * 3 + 2)
}

func tok_text(src: str, stream: int, index: int): str {
    var s = tok_start(stream, index)
    var l = tok_len(stream, index)
    return str_slice(src, s, l)
}

func tok_int_value(src: str, stream: int, index: int): int {
    var s = tok_start(stream, index)
    var l = tok_len(stream, index)
    var result = 0
    var i = 0
    while i < l {
        result = result * 10 + (str_byte(src, s + i) - 48)
        i = i + 1
    }
    return result
}

func tok_str_value(src: str, stream: int, index: int): str {
    var s = tok_start(stream, index) + 1
    var l = tok_len(stream, index) - 2
    if l <= 0 {
        return ""
    }
    return str_slice(src, s, l)
}

// --- Token kind names (for diagnostics) ---

func tk_name(kind: int): str {
    if kind == 0  { return "EOF" }
    if kind == 1  { return "IDENT" }
    if kind == 2  { return "INT" }
    if kind == 3  { return "STRING" }
    if kind == 10 { return "func" }
    if kind == 11 { return "extern" }
    if kind == 12 { return "var" }
    if kind == 13 { return "let" }
    if kind == 14 { return "if" }
    if kind == 15 { return "else" }
    if kind == 16 { return "while" }
    if kind == 17 { return "return" }
    if kind == 18 { return "import" }
    if kind == 19 { return "package" }
    if kind == 20 { return "class" }
    if kind == 21 { return "trait" }
    if kind == 22 { return "impl" }
    if kind == 23 { return "flux" }
    if kind == 24 { return "in" }
    if kind == 25 { return "true" }
    if kind == 26 { return "false" }
    if kind == 27 { return "void" }
    if kind == 28 { return "int" }
    if kind == 29 { return "str" }
    if kind == 30 { return "bool" }
    if kind == 31 { return "struct" }
    if kind == 40 { return "(" }
    if kind == 41 { return ")" }
    if kind == 42 { return "{" }
    if kind == 43 { return "}" }
    if kind == 44 { return "[" }
    if kind == 45 { return "]" }
    if kind == 46 { return "," }
    if kind == 47 { return ";" }
    if kind == 48 { return ":" }
    if kind == 49 { return "." }
    if kind == 50 { return "+" }
    if kind == 51 { return "-" }
    if kind == 52 { return "*" }
    if kind == 53 { return "/" }
    if kind == 54 { return "<" }
    if kind == 55 { return ">" }
    if kind == 56 { return "!" }
    if kind == 57 { return "&" }
    if kind == 58 { return "|" }
    if kind == 59 { return "=" }
    if kind == 60 { return "==" }
    if kind == 61 { return "!=" }
    if kind == 62 { return "<=" }
    if kind == 63 { return ">=" }
    if kind == 64 { return "=>" }
    if kind == 65 { return ".." }
    if kind == 66 { return "::" }
    if kind == 67 { return "%" }
    return "???"
}
