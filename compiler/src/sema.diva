// Semantic checks for the native pipeline.
// Issue #53: scoped name resolution + call arity (MVP type checker).
// Full assign/return/binop type matching and span diagnostics are follow-ups (#54).

import "std/io.diva"
import "std/conv.diva"
import "std/vec.diva"
import "tokens.diva"
import "ast.diva"
import "std/host.diva"
import "cell.diva"
import "diag.diva"
import "ir.diva"

func sema_err(msg: str): int {
    stderr("sema: ")
    stderr(msg)
    stderr(char_to_str(10))
    return 1
}

func sema_err_at(src: str, byte_off: int, msg: str): int {
    diag_emit_loc(src, byte_off)
    stderr("sema: ")
    stderr(msg)
    stderr(char_to_str(10))
    return 1
}

func sema_top_level_func_hashes(file_node: int): int {
    var children = ast_child(file_node, 0)
    var n = int_vec_len(children)
    var seen = int_vec_new()
    var i = 0
    while (i < n) {
        var ch = int_vec_get(children, i)
        if ast_kind(ch) == nd_func() {
            var ht = ast_child(ch, 0)
            var j = 0
            var nc = int_vec_len(seen)
            while (j < nc) {
                if (int_vec_get(seen, j) == ht) {
                    return sema_err("duplicate top-level function name")
                }
                j = j + 1
            }
            int_vec_push(seen, ht)
        }
        i = i + 1
    }
    int_vec_free(seen)
    return 0
}

// Same-block `let` duplicates (flat list of stmts in one nd_block); matches seed wording for tests.
func sema_dup_let_flat_block(block: int, src: str, toks: int): int {
    if (block < 0) {
        return 0
    }
    if ast_kind(block) != nd_block() {
        return 0
    }
    var stmts = ast_child(block, 0)
    var ns = int_vec_len(stmts)
    var names = int_vec_new()
    var si = 0
    while (si < ns) {
        var st = int_vec_get(stmts, si)
        if ast_kind(st) == nd_var_decl() {
            var nt = ast_child(st, 0)
            var nm = tok_text(src, toks, nt)
            var j = 0
            var nn = int_vec_len(names)
            while (j < nn) {
                var pt = int_vec_get(names, j)
                if str_eq(tok_text(src, toks, pt), nm) == 1 {
                    int_vec_free(names)
                    diag_emit_loc(src, tok_start(toks, nt))
                    stderr("sema: duplicate declaration of '")
                    stderr(nm)
                    stderr("' in the same scope")
                    stderr(char_to_str(10))
                    return 1
                }
                j = j + 1
            }
            int_vec_push(names, nt)
        }
        si = si + 1
    }
    int_vec_free(names)
    return 0
}

func sema_check_func_body_dup_lets(file_node: int, src: str, toks: int): int {
    var children = ast_child(file_node, 0)
    var n = int_vec_len(children)
    var i = 0
    while (i < n) {
        var ch = int_vec_get(children, i)
        if ast_kind(ch) == nd_func() {
            var body = ast_child(ch, 3)
            if sema_dup_let_flat_block(body, src, toks) != 0 {
                return 1
            }
        }
        if ast_kind(ch) == nd_impl() {
            var methods = ast_child(ch, 2)
            var mi = 0
            while (mi < int_vec_len(methods)) {
                var m = int_vec_get(methods, mi)
                if ast_kind(m) == nd_func() {
                    if sema_dup_let_flat_block(ast_child(m, 3), src, toks) != 0 {
                        return 1
                    }
                }
                mi = mi + 1
            }
        }
        if ast_kind(ch) == nd_class() {
            var members = ast_child(ch, 1)
            var cj = 0
            while (cj < int_vec_len(members)) {
                var cm = int_vec_get(members, cj)
                if ast_kind(cm) == nd_func() {
                    if sema_dup_let_flat_block(ast_child(cm, 3), src, toks) != 0 {
                        return 1
                    }
                }
                cj = cj + 1
            }
        }
        i = i + 1
    }
    return 0
}

func sema_find_trait(file_node: int, src: str, toks: int, trait_tok: int): int {
    var children = ast_child(file_node, 0)
    var n = int_vec_len(children)
    var want = tok_text(src, toks, trait_tok)
    var i = 0
    while (i < n) {
        var ch = int_vec_get(children, i)
        if ast_kind(ch) == nd_trait() {
            var nm = tok_text(src, toks, ast_child(ch, 0))
            if str_eq(nm, want) == 1 {
                return ch
            }
        }
        i = i + 1
    }
    return 0 - 1
}

func sema_method_name_in_list(methods: int, src: str, toks: int, want: str): int {
    var n = int_vec_len(methods)
    var i = 0
    while (i < n) {
        var m = int_vec_get(methods, i)
        if ast_kind(m) == nd_func() {
            var nm = tok_text(src, toks, ast_child(m, 0))
            if str_eq(nm, want) == 1 {
                return 1
            }
        }
        i = i + 1
    }
    return 0
}

// Static-dispatch MVP: every trait method name must appear on the impl.
func sema_check_impls(file_node: int, src: str, toks: int): int {
    var children = ast_child(file_node, 0)
    var n = int_vec_len(children)
    var i = 0
    while (i < n) {
        var ch = int_vec_get(children, i)
        if ast_kind(ch) == nd_impl() {
            var trait_tok = ast_child(ch, 0)
            var type_tok = ast_child(ch, 1)
            var impl_methods = ast_child(ch, 2)
            var trait_node = sema_find_trait(file_node, src, toks, trait_tok)
            if (trait_node < 0) {
                diag_emit_loc(src, tok_start(toks, trait_tok))
                stderr("sema: unknown trait '")
                stderr(tok_text(src, toks, trait_tok))
                stderr("' in impl")
                stderr(char_to_str(10))
                return 1
            }
            var trait_methods = ast_child(trait_node, 1)
            var ti = 0
            while (ti < int_vec_len(trait_methods)) {
                var tm = int_vec_get(trait_methods, ti)
                if ast_kind(tm) == nd_func() {
                    var mname = tok_text(src, toks, ast_child(tm, 0))
                    if sema_method_name_in_list(impl_methods, src, toks, mname) == 0 {
                        diag_emit_loc(src, tok_start(toks, ast_child(tm, 0)))
                        stderr("sema: missing trait method '")
                        stderr(mname)
                        stderr("' in impl of '")
                        stderr(tok_text(src, toks, trait_tok))
                        stderr("' for '")
                        stderr(tok_text(src, toks, type_tok))
                        stderr("'")
                        stderr(char_to_str(10))
                        return 1
                    }
                }
                ti = ti + 1
            }
        }
        i = i + 1
    }
    return 0
}

// Returns 0 if ok, 1 on error (messages on stderr).
func sema_check_file(src: str, toks: int, file_node: int): int {
    if sema_top_level_func_hashes(file_node) != 0 {
        return 1
    }
    if sema_check_func_body_dup_lets(file_node, src, toks) != 0 {
        return 1
    }
    if sema_check_impls(file_node, src, toks) != 0 {
        return 1
    }
    if sema_check_names(file_node, src, toks) != 0 {
        return 1
    }
    return 0
}

// --- Production name / arity + basic type checker (Issue #53) ---

func sctx_new(): int {
    var c = int_vec_new()
    int_vec_push(c, mut_new(int_vec_new()))
    int_vec_push(c, mut_new(int_vec_new()))
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    int_vec_push(c, mut_new(0))
    int_vec_push(c, mut_new(int_vec_new()))
    int_vec_push(c, mut_new(0))
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    return c
}

func sctx_names(c: int): int { return mut_get(int_vec_get(c, 0)) }
func sctx_marks(c: int): int { return mut_get(int_vec_get(c, 1)) }
func sctx_globals(c: int): int { return int_vec_get(c, 2) }
func sctx_fn_names(c: int): int { return int_vec_get(c, 3) }
func sctx_fn_arities(c: int): int { return int_vec_get(c, 4) }
func sctx_types(c: int): int { return int_vec_get(c, 5) }
func sctx_methods(c: int): int { return int_vec_get(c, 6) }
func sctx_self_ok(c: int): int { return mut_get(int_vec_get(c, 7)) }
func sctx_local_types(c: int): int { return mut_get(int_vec_get(c, 8)) }
func sctx_cur_ret_ty(c: int): int { return mut_get(int_vec_get(c, 9)) }
func sctx_global_types(c: int): int { return int_vec_get(c, 10) }
func sctx_fn_ret_types(c: int): int { return int_vec_get(c, 11) }
func sctx_set_self_ok(c: int, v: int): int { return mut_set(int_vec_get(c, 7), v) }
func sctx_set_names(c: int, v: int): int { return mut_set(int_vec_get(c, 0), v) }
func sctx_set_marks(c: int, v: int): int { return mut_set(int_vec_get(c, 1), v) }
func sctx_set_local_types(c: int, v: int): int { return mut_set(int_vec_get(c, 8), v) }
func sctx_set_cur_ret_ty(c: int, v: int): int { return mut_set(int_vec_get(c, 9), v) }
func sctx_enum_type_toks(c: int): int { return int_vec_get(c, 12) }
func sctx_variant_toks(c: int): int { return int_vec_get(c, 13) }
func sctx_variant_enum_ids(c: int): int { return int_vec_get(c, 14) }
func sctx_variant_payloads(c: int): int { return int_vec_get(c, 15) }
func sctx_match_nodes(c: int): int { return int_vec_get(c, 16) }
func sctx_match_types(c: int): int { return int_vec_get(c, 17) }

// Remember the result type of a checked match expression.
func sema_cache_match_type(c: int, node: int, ty: int): int {
    int_vec_push(sctx_match_nodes(c), node)
    int_vec_push(sctx_match_types(c), ty)
    return 0
}

// The result type of a checked match expression, or -1 when not checked yet.
func sema_cached_match_type(c: int, node: int): int {
    var ns = sctx_match_nodes(c)
    var ts = sctx_match_types(c)
    var found = 0 - 1
    var i = 0
    while (i < int_vec_len(ns)) {
        if int_vec_get(ns, i) == node {
            found = int_vec_get(ts, i)
        }
        i = i + 1
    }
    return found
}

// Index of a registered variant name, or -1. Variants share one namespace.
func sctx_variant_index(c: int, src: str, toks: int, want: str): int {
    var vts = sctx_variant_toks(c)
    var i = 0
    while (i < int_vec_len(vts)) {
        if str_eq(tok_text(src, toks, int_vec_get(vts, i)), want) == 1 {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// Index of a registered enum type name, or -1.
func sctx_enum_index(c: int, src: str, toks: int, want: str): int {
    var ets = sctx_enum_type_toks(c)
    var i = 0
    while (i < int_vec_len(ets)) {
        if str_eq(tok_text(src, toks, int_vec_get(ets, i)), want) == 1 {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// Index of a variant declared by |enum_id|, or -1. Qualified construction
// (`Enum::Variant`) resolves through the owning enum, not the shared
// variant namespace.
func sctx_variant_index_in_enum(c: int, src: str, toks: int, enum_id: int, want: str): int {
    var vts = sctx_variant_toks(c)
    var eids = sctx_variant_enum_ids(c)
    var i = 0
    while (i < int_vec_len(vts)) {
        if int_vec_get(eids, i) == enum_id {
            if str_eq(tok_text(src, toks, int_vec_get(vts, i)), want) == 1 {
                return i
            }
        }
        i = i + 1
    }
    return 0 - 1
}

func sctx_free(c: int): int {
    int_vec_free(sctx_names(c))
    int_vec_free(sctx_marks(c))
    int_vec_free(sctx_globals(c))
    int_vec_free(sctx_fn_names(c))
    int_vec_free(sctx_fn_arities(c))
    int_vec_free(sctx_fn_ret_types(c))
    int_vec_free(sctx_types(c))
    int_vec_free(sctx_methods(c))
    int_vec_free(sctx_local_types(c))
    int_vec_free(sctx_global_types(c))
    int_vec_free(sctx_enum_type_toks(c))
    int_vec_free(sctx_variant_toks(c))
    int_vec_free(sctx_variant_enum_ids(c))
    int_vec_free(sctx_variant_payloads(c))
    int_vec_free(sctx_match_nodes(c))
    int_vec_free(sctx_match_types(c))
    int_vec_free(c)
    return 0
}

func sctx_scope_push(c: int): int {
    int_vec_push(sctx_marks(c), int_vec_len(sctx_names(c)))
    return 0
}

func sctx_truncate_vec(old: int, mark: int): int {
    var fresh = int_vec_new()
    var i = 0
    while (i < mark) {
        int_vec_push(fresh, int_vec_get(old, i))
        i = i + 1
    }
    int_vec_free(old)
    return fresh
}

func sctx_scope_pop(c: int): int {
    var marks = sctx_marks(c)
    var n = int_vec_len(marks)
    if n == 0 { return 0 }
    var mark = int_vec_get(marks, n - 1)
    sctx_set_marks(c, sctx_truncate_vec(marks, n - 1))
    var names = sctx_names(c)
    if int_vec_len(names) > mark {
        sctx_set_names(c, sctx_truncate_vec(names, mark))
    }
    var lty = sctx_local_types(c)
    if int_vec_len(lty) > mark {
        sctx_set_local_types(c, sctx_truncate_vec(lty, mark))
    }
    return 0
}

func sctx_tok_list_has(list: int, src: str, toks: int, want: str): int {
    var i = 0
    var n = int_vec_len(list)
    while (i < n) {
        if str_eq(tok_text(src, toks, int_vec_get(list, i)), want) == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

func sctx_define(c: int, name_tok: int): int {
    return sctx_define_typed(c, name_tok, ir_ty_int())
}

func sctx_define_typed(c: int, name_tok: int, ty: int): int {
    int_vec_push(sctx_names(c), name_tok)
    int_vec_push(sctx_local_types(c), ty)
    return 0
}

func sctx_ty_name(ty: int): str {
    if ty == ir_ty_void() { return "void" }
    if ty == ir_ty_int() { return "int" }
    if ty == ir_ty_bool() { return "bool" }
    if ty == ir_ty_str() { return "str" }
    if ty == ir_ty_text() { return "text" }
    if ty > ir_ty_text() { return "enum" }
    return "?"
}

func sema_type_from_node(c: int, type_node: int, src: str, toks: int): int {
    if (type_node < 0) {
        return ir_ty_int()
    }
    if ast_kind(type_node) != nd_type_name() {
        return ir_ty_int()
    }
    var tn = tok_text(src, toks, ast_child(type_node, 0))
    if str_eq(tn, "int") == 1 { return ir_ty_int() }
    if str_eq(tn, "bool") == 1 { return ir_ty_bool() }
    if str_eq(tn, "str") == 1 { return ir_ty_str() }
    if str_eq(tn, "text") == 1 { return ir_ty_text() }
    if str_eq(tn, "void") == 1 { return ir_ty_void() }
    var ei = 0
    var en = int_vec_len(sctx_enum_type_toks(c))
    while (ei < en) {
        if str_eq(tok_text(src, toks, int_vec_get(sctx_enum_type_toks(c), ei)), tn) == 1 {
            return ir_ty_text() + 1 + ei
        }
        ei = ei + 1
    }
    return ir_ty_int()
}

func sctx_lookup_var_type(c: int, src: str, toks: int, want: str): int {
    var names = sctx_names(c)
    var lty = sctx_local_types(c)
    var i = 0
    while (i < int_vec_len(names)) {
        if str_eq(tok_text(src, toks, int_vec_get(names, i)), want) == 1 {
            return int_vec_get(lty, i)
        }
        i = i + 1
    }
    var g = sctx_globals(c)
    var gt = sctx_global_types(c)
    i = 0
    while (i < int_vec_len(g)) {
        if str_eq(tok_text(src, toks, int_vec_get(g, i)), want) == 1 {
            return int_vec_get(gt, i)
        }
        i = i + 1
    }
    return ir_ty_int()
}

func sema_type_mismatch_at(src: str, toks: int, at_tok: int, want: int, got: int): int {
    diag_emit_loc(src, tok_start(toks, at_tok))
    stderr("sema: type mismatch: expected ")
    stderr(sctx_ty_name(want))
    stderr(", got ")
    stderr(sctx_ty_name(got))
    stderr(char_to_str(10))
    return 1
}

func sema_binop_is_arith(op: int): int {
    if op == binop_add() { return 1 }
    if op == binop_sub() { return 1 }
    if op == binop_mul() { return 1 }
    if op == binop_div() { return 1 }
    if op == binop_mod() { return 1 }
    return 0
}

func sema_binop_is_compare(op: int): int {
    if op == binop_eq() { return 1 }
    if op == binop_ne() { return 1 }
    if op == binop_lt() { return 1 }
    if op == binop_le() { return 1 }
    if op == binop_gt() { return 1 }
    if op == binop_ge() { return 1 }
    return 0
}

func sema_binop_is_logic(op: int): int {
    if op == binop_and() { return 1 }
    if op == binop_or() { return 1 }
    return 0
}

func sema_expr_type(c: int, src: str, toks: int, node: int): int {
    if (node < 0) { return ir_ty_void() }
    var kind = ast_kind(node)
    if kind == nd_int_lit() { return ir_ty_int() }
    if kind == nd_bool_lit() { return ir_ty_bool() }
    if kind == nd_str_lit() { return ir_ty_str() }
    if kind == nd_text_lit() { return ir_ty_text() }
    if kind == nd_text_slice() { return ir_ty_text() }
    if kind == nd_ident() {
        var itok = ast_child(node, 0)
        var inm = tok_text(src, toks, itok)
        var ivi = sctx_variant_index(c, src, toks, inm)
        if ivi >= 0 {
            return int_vec_get(sctx_variant_enum_ids(c), ivi)
        }
        return sctx_lookup_var_type(c, src, toks, inm)
    }
    if kind == nd_qualified_variant() {
        // `Enum::Variant` has the type of its enum.
        var qenm = tok_text(src, toks, ast_child(node, 0))
        var qei = sctx_enum_index(c, src, toks, qenm)
        if qei < 0 { return ir_ty_int() }
        return ir_ty_text() + 1 + qei
    }
    if kind == nd_binop() {
        var op = ast_child(node, 0)
        var lt = sema_expr_type(c, src, toks, ast_child(node, 1))
        var rt = sema_expr_type(c, src, toks, ast_child(node, 2))
        if (op == binop_add()) & (lt == ir_ty_text()) & (rt == ir_ty_text()) { return ir_ty_text() }
        if sema_binop_is_arith(op) == 1 { return ir_ty_int() }
        if sema_binop_is_compare(op) == 1 { return ir_ty_bool() }
        if sema_binop_is_logic(op) == 1 {
            if lt == ir_ty_int() {
                if rt == ir_ty_int() {
                    return ir_ty_int()
                }
            }
            return ir_ty_bool()
        }
        return ir_ty_int()
    }
    if kind == nd_unary() {
        return sema_expr_type(c, src, toks, ast_child(node, 1))
    }
    if kind == nd_call() {
        var callee = ast_child(node, 0)
        if ast_kind(callee) == nd_ident() {
            var ctok = ast_child(callee, 0)
            var rty = sctx_fn_ret_type(c, src, toks, tok_text(src, toks, ctok))
            if rty >= 0 {
                return rty
            }
        }
        return ir_ty_int()
    }
    if kind == nd_generic_call() {
        var gcallee = ast_child(node, 0)
        if ast_kind(gcallee) == nd_ident() {
            var gt = tok_text(src, toks, ast_child(gcallee, 0))
            var gvi = sctx_variant_index(c, src, toks, gt)
            if gvi >= 0 {
                return int_vec_get(sctx_variant_enum_ids(c), gvi)
            }
        }
        return ir_ty_int()
    }
    if kind == nd_method_call() {
        return ir_ty_int()
    }
    if kind == nd_field() {
        return ir_ty_int()
    }
    if kind == nd_index() {
        return ir_ty_int()
    }
    if kind == nd_match() {
        var cached = sema_cached_match_type(c, node)
        if cached >= 0 { return cached }
        var marms = ast_child(node, 1)
        if int_vec_len(marms) > 0 {
            var arm0 = int_vec_get(marms, 0)
            return sema_expr_type(c, src, toks, ast_child(arm0, 2))
        }
        return ir_ty_int()
    }
    return ir_ty_int()
}

func sema_compare_operand_ok(lt: int, rt: int): int {
    if lt == rt {
        return 1
    }
    if lt == ir_ty_bool() {
        if rt == ir_ty_int() {
            return 1
        }
    }
    if rt == ir_ty_bool() {
        if lt == ir_ty_int() {
            return 1
        }
    }
    return 0
}

func sema_check_binop_types(c: int, src: str, toks: int, node: int): int {
    var op = ast_child(node, 0)
    var left = ast_child(node, 1)
    var right = ast_child(node, 2)
    if sema_check_expr(c, src, toks, left) != 0 { return 1 }
    if sema_check_expr(c, src, toks, right) != 0 { return 1 }
    var lt = sema_expr_type(c, src, toks, left)
    var rt = sema_expr_type(c, src, toks, right)
    if (op == binop_add()) & (lt == ir_ty_text()) & (rt == ir_ty_text()) { return 0 }
    var want = ir_ty_int()
    if sema_binop_is_logic(op) == 1 {
        if lt == ir_ty_int() {
            if rt == ir_ty_int() {
                want = ir_ty_int()
            } else {
                want = ir_ty_bool()
            }
        } else {
            want = ir_ty_bool()
        }
    }
    if sema_binop_is_arith(op) == 1 {
        want = ir_ty_int()
    }
    if sema_binop_is_compare(op) == 1 {
        if sema_compare_operand_ok(lt, rt) == 1 {
            return 0
        }
        want = ir_ty_int()
    }
    if lt != want {
        if ast_kind(left) == nd_ident() {
            return sema_type_mismatch_at(src, toks, ast_child(left, 0), want, lt)
        }
        return sema_err("type mismatch in binary expression (left operand)")
    }
    if rt != want {
        if ast_kind(right) == nd_ident() {
            return sema_type_mismatch_at(src, toks, ast_child(right, 0), want, rt)
        }
        return sema_err("type mismatch in binary expression (right operand)")
    }
    return 0
}

func sctx_name_known(c: int, src: str, toks: int, want: str): int {
    if sctx_tok_list_has(sctx_names(c), src, toks, want) == 1 { return 1 }
    if sctx_tok_list_has(sctx_globals(c), src, toks, want) == 1 { return 1 }
    if sctx_tok_list_has(sctx_fn_names(c), src, toks, want) == 1 { return 1 }
    if (sctx_self_ok(c) == 1) & (str_eq(want, "self") == 1) { return 1 }
    return 0
}

func sctx_fn_arity(c: int, src: str, toks: int, want: str): int {
    var names = sctx_fn_names(c)
    var ars = sctx_fn_arities(c)
    var i = 0
    var n = int_vec_len(names)
    while (i < n) {
        if str_eq(tok_text(src, toks, int_vec_get(names, i)), want) == 1 {
            return int_vec_get(ars, i)
        }
        i = i + 1
    }
    return 0 - 1
}

func sctx_fn_ret_type(c: int, src: str, toks: int, want: str): int {
    var names = sctx_fn_names(c)
    var rts = sctx_fn_ret_types(c)
    var i = 0
    var n = int_vec_len(names)
    while (i < n) {
        if str_eq(tok_text(src, toks, int_vec_get(names, i)), want) == 1 {
            return int_vec_get(rts, i)
        }
        i = i + 1
    }
    return 0 - 1
}

func sctx_add_fn(c: int, src: str, toks: int, name_tok: int, arity: int, ret_ty: int): int {
    var nm = tok_text(src, toks, name_tok)
    if sctx_tok_list_has(sctx_fn_names(c), src, toks, nm) == 1 {
        diag_emit_loc(src, tok_start(toks, name_tok))
        stderr("sema: duplicate function '")
        stderr(nm)
        stderr("'")
        stderr(char_to_str(10))
        return 1
    }
    int_vec_push(sctx_fn_names(c), name_tok)
    int_vec_push(sctx_fn_arities(c), arity)
    int_vec_push(sctx_fn_ret_types(c), ret_ty)
    return 0
}

func sctx_add_global(c: int, src: str, toks: int, name_tok: int, ty: int): int {
    var nm = tok_text(src, toks, name_tok)
    if sctx_tok_list_has(sctx_globals(c), src, toks, nm) == 1 {
        diag_emit_loc(src, tok_start(toks, name_tok))
        stderr("sema: duplicate global '")
        stderr(nm)
        stderr("'")
        stderr(char_to_str(10))
        return 1
    }
    if sctx_tok_list_has(sctx_fn_names(c), src, toks, nm) == 1 {
        diag_emit_loc(src, tok_start(toks, name_tok))
        stderr("sema: global '")
        stderr(nm)
        stderr("' conflicts with function")
        stderr(char_to_str(10))
        return 1
    }
    int_vec_push(sctx_globals(c), name_tok)
    int_vec_push(sctx_global_types(c), ty)
    return 0
}

func sema_unknown_at(src: str, toks: int, name_tok: int): int {
    diag_emit_loc(src, tok_start(toks, name_tok))
    stderr("sema: unknown identifier '")
    stderr(tok_text(src, toks, name_tok))
    stderr("'")
    stderr(char_to_str(10))
    return 1
}

func sema_check_expr(c: int, src: str, toks: int, node: int): int {
    if (node < 0) { return 0 }
    var kind = ast_kind(node)
    if kind == nd_int_lit() { return 0 }
    if kind == nd_bool_lit() { return 0 }
    if kind == nd_str_lit() { return 0 }
    if kind == nd_text_lit() { return 0 }
    if kind == nd_ident() {
        var itok = ast_child(node, 0)
        var nm = tok_text(src, toks, itok)
        var vi = sctx_variant_index(c, src, toks, nm)
        if (vi >= 0) & (int_vec_get(sctx_variant_payloads(c), vi) != 0 - 1) {
            diag_emit_loc(src, tok_start(toks, itok))
            stderr("sema: variant '")
            stderr(nm)
            stderr("' must be called")
            stderr(char_to_str(10))
            return 1
        }
        if sctx_name_known(c, src, toks, nm) == 0 {
            return sema_unknown_at(src, toks, itok)
        }
        return 0
    }
    if kind == nd_binop() {
        return sema_check_binop_types(c, src, toks, node)
    }
    if kind == nd_unary() {
        return sema_check_expr(c, src, toks, ast_child(node, 1))
    }
    if kind == nd_call() {
        return sema_check_call(c, src, toks, node)
    }
    if kind == nd_qualified_variant() {
        return sema_check_qualified_variant(c, src, toks, node)
    }
    if kind == nd_generic_call() {
        return sema_check_generic_call(c, src, toks, node)
    }
    if kind == nd_method_call() {
        return sema_check_method_call(c, src, toks, node)
    }
    if kind == nd_field() {
        return sema_check_expr(c, src, toks, ast_child(node, 0))
    }
    if kind == nd_index() {
        if sema_check_expr(c, src, toks, ast_child(node, 0)) != 0 { return 1 }
        return sema_check_expr(c, src, toks, ast_child(node, 1))
    }
    if kind == nd_text_slice() {
        if sema_check_expr(c, src, toks, ast_child(node, 0)) != 0 { return 1 }
        if sema_check_expr(c, src, toks, ast_child(node, 1)) != 0 { return 1 }
        return sema_check_expr(c, src, toks, ast_child(node, 2))
    }
    if kind == nd_obj_lit() {
        return sema_check_obj_lit(c, src, toks, node)
    }
    if kind == nd_array_lit() {
        var elems = ast_child(node, 0)
        var i = 0
        while (i < int_vec_len(elems)) {
            if sema_check_expr(c, src, toks, int_vec_get(elems, i)) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    if kind == nd_range() {
        if sema_check_expr(c, src, toks, ast_child(node, 0)) != 0 { return 1 }
        return sema_check_expr(c, src, toks, ast_child(node, 1))
    }
    if kind == nd_match() {
        return sema_check_match(c, src, toks, node)
    }
    return 0
}

// Check a qualified enum variant construction `Enum::Variant` /
// `Enum::Variant(payload)`: the enum must exist, the variant must belong to
// it, and the payload arity/type must match the declaration.
func sema_check_qualified_variant(c: int, src: str, toks: int, node: int): int {
    var enum_tok = ast_child(node, 0)
    var variant_tok = ast_child(node, 1)
    var args = ast_child(node, 2)
    var enum_nm = tok_text(src, toks, enum_tok)
    var variant_nm = tok_text(src, toks, variant_tok)
    var ei = sctx_enum_index(c, src, toks, enum_nm)
    if ei < 0 {
        diag_emit_loc(src, tok_start(toks, enum_tok))
        stderr("sema: unknown enum '")
        stderr(enum_nm)
        stderr("'")
        stderr(char_to_str(10))
        return 1
    }
    var enum_id = ir_ty_text() + 1 + ei
    var vi = sctx_variant_index_in_enum(c, src, toks, enum_id, variant_nm)
    if vi < 0 {
        diag_emit_loc(src, tok_start(toks, variant_tok))
        stderr("sema: unknown variant '")
        stderr(variant_nm)
        stderr("' in enum '")
        stderr(enum_nm)
        stderr("'")
        stderr(char_to_str(10))
        return 1
    }
    var pty = int_vec_get(sctx_variant_payloads(c), vi)
    var argc = int_vec_len(args)
    if pty == 0 - 1 {
        if argc != 0 {
            diag_emit_loc(src, tok_start(toks, variant_tok))
            stderr("sema: unit variant '")
            stderr(variant_nm)
            stderr("' of enum '")
            stderr(enum_nm)
            stderr("' takes no payload")
            stderr(char_to_str(10))
            return 1
        }
    } else {
        if argc != 1 {
            diag_emit_loc(src, tok_start(toks, variant_tok))
            stderr("sema: variant '")
            stderr(variant_nm)
            stderr("' expects 1 payload argument, got ")
            stderr(int_to_str(argc))
            stderr(char_to_str(10))
            return 1
        }
    }
    var ai = 0
    while (ai < argc) {
        if sema_check_expr(c, src, toks, int_vec_get(args, ai)) != 0 { return 1 }
        ai = ai + 1
    }
    if (pty >= 0) & (argc == 1) {
        var got = sema_expr_type(c, src, toks, int_vec_get(args, 0))
        if got != pty {
            return sema_type_mismatch_at(src, toks, variant_tok, pty, got)
        }
    }
    return 0
}

func sema_check_variant_ctor(c: int, src: str, toks: int, node: int, callee: int, args: int): int {
    var ctok = ast_child(callee, 0)
    var vi = sctx_variant_index(c, src, toks, tok_text(src, toks, ctok))
    if vi < 0 {
        return sema_unknown_at(src, toks, ctok)
    }
    var argc = int_vec_len(args)
    var pty = int_vec_get(sctx_variant_payloads(c), vi)
    if pty == 0 - 1 {
        diag_emit_loc(src, tok_start(toks, ctok))
        stderr("sema: unit variant '")
        stderr(tok_text(src, toks, ctok))
        stderr("' takes no payload")
        stderr(char_to_str(10))
        return 1
    }
    if argc != 1 {
        diag_emit_loc(src, tok_start(toks, ctok))
        stderr("sema: variant '")
        stderr(tok_text(src, toks, ctok))
        stderr("' expects 1 payload argument, got ")
        stderr(int_to_str(argc))
        stderr(char_to_str(10))
        return 1
    }
    var ai = 0
    while (ai < argc) {
        if sema_check_expr(c, src, toks, int_vec_get(args, ai)) != 0 { return 1 }
        ai = ai + 1
    }
    if pty >= 0 {
        var got = sema_expr_type(c, src, toks, int_vec_get(args, 0))
        if got != pty {
            return sema_type_mismatch_at(src, toks, ctok, pty, got)
        }
    }
    return 0
}

func sema_check_call(c: int, src: str, toks: int, node: int): int {
    var callee = ast_child(node, 0)
    var args = ast_child(node, 1)
    if ast_kind(callee) == nd_ident() {
        if sctx_variant_index(c, src, toks, tok_text(src, toks, ast_child(callee, 0))) >= 0 {
            return sema_check_variant_ctor(c, src, toks, node, callee, args)
        }
    }
    var ai = 0
    while (ai < int_vec_len(args)) {
        if sema_check_expr(c, src, toks, int_vec_get(args, ai)) != 0 { return 1 }
        ai = ai + 1
    }
    if ast_kind(callee) != nd_ident() {
        return sema_check_expr(c, src, toks, callee)
    }
    var ctok = ast_child(callee, 0)
    var nm = tok_text(src, toks, ctok)
    var arity = sctx_fn_arity(c, src, toks, nm)
    if (arity < 0) {
        return sema_unknown_at(src, toks, ctok)
    }
    if (int_vec_len(args) != arity) {
        diag_emit_loc(src, tok_start(toks, ctok))
        stderr("sema: wrong number of arguments for '")
        stderr(nm)
        stderr("': expected ")
        stderr(int_to_str(arity))
        stderr(", got ")
        stderr(int_to_str(int_vec_len(args)))
        stderr(char_to_str(10))
        return 1
    }
    return 0
}

func sema_check_generic_call(c: int, src: str, toks: int, node: int): int {
    var callee = ast_child(node, 0)
    var args = ast_child(node, 2)
    var ai = 0
    while (ai < int_vec_len(args)) {
        if sema_check_expr(c, src, toks, int_vec_get(args, ai)) != 0 { return 1 }
        ai = ai + 1
    }
    if ast_kind(callee) != nd_ident() {
        return sema_check_expr(c, src, toks, callee)
    }
    var ctok = ast_child(callee, 0)
    var nm = tok_text(src, toks, ctok)
    var arity = sctx_fn_arity(c, src, toks, nm)
    if (arity < 0) {
        return sema_unknown_at(src, toks, ctok)
    }
    if (int_vec_len(args) != arity) {
        diag_emit_loc(src, tok_start(toks, ctok))
        stderr("sema: wrong number of arguments for '")
        stderr(nm)
        stderr("': expected ")
        stderr(int_to_str(arity))
        stderr(", got ")
        stderr(int_to_str(int_vec_len(args)))
        stderr(char_to_str(10))
        return 1
    }
    return 0
}

func sema_check_method_call(c: int, src: str, toks: int, node: int): int {
    if sema_check_expr(c, src, toks, ast_child(node, 0)) != 0 { return 1 }
    var args = ast_child(node, 2)
    var ai = 0
    while (ai < int_vec_len(args)) {
        if sema_check_expr(c, src, toks, int_vec_get(args, ai)) != 0 { return 1 }
        ai = ai + 1
    }
    var mtok = ast_child(node, 1)
    var mname = tok_text(src, toks, mtok)
    if sctx_tok_list_has(sctx_fn_names(c), src, toks, mname) == 1 { return 0 }
    if sctx_tok_list_has(sctx_methods(c), src, toks, mname) == 1 { return 0 }
    diag_emit_loc(src, tok_start(toks, mtok))
    stderr("sema: unknown method '")
    stderr(mname)
    stderr("'")
    stderr(char_to_str(10))
    return 1
}

func sema_check_obj_lit(c: int, src: str, toks: int, node: int): int {
    // Obj lit: [kind, type_tok_or_-1, field_inits]
    var type_tok = ast_child(node, 0)
    if (type_tok < 0) == 0 {
        var tnm = tok_text(src, toks, type_tok)
        if sctx_tok_list_has(sctx_types(c), src, toks, tnm) == 0 {
            diag_emit_loc(src, tok_start(toks, type_tok))
            stderr("sema: unknown type '")
            stderr(tnm)
            stderr("' in object literal")
            stderr(char_to_str(10))
            return 1
        }
    }
    var inits = ast_child(node, 1)
    var i = 0
    while (i < int_vec_len(inits)) {
        var fi = int_vec_get(inits, i)
        // field_init: [kind, field_tok, value]
        if sema_check_expr(c, src, toks, ast_child(fi, 1)) != 0 { return 1 }
        i = i + 1
    }
    return 0
}

func sema_check_stmt(c: int, src: str, toks: int, node: int): int {
    if (node < 0) { return 0 }
    var kind = ast_kind(node)
    if kind == nd_var_decl() {
        var name_tok = ast_child(node, 0)
        var type_node = ast_child(node, 1)
        var init = ast_child(node, 2)
        var vty = sema_type_from_node(c, type_node, src, toks)
        if (init < 0) == 0 {
            if sema_check_expr(c, src, toks, init) != 0 { return 1 }
            if (type_node < 0) {
                vty = sema_expr_type(c, src, toks, init)
            } else {
                var got = sema_expr_type(c, src, toks, init)
                if got != vty {
                    return sema_type_mismatch_at(src, toks, name_tok, vty, got)
                }
            }
        }
        sctx_define_typed(c, name_tok, vty)
        return 0
    }
    if kind == nd_assign() {
        var target = ast_child(node, 0)
        var value = ast_child(node, 1)
        if sema_check_expr(c, src, toks, value) != 0 { return 1 }
        if ast_kind(target) == nd_ident() {
            var ttok = ast_child(target, 0)
            var nm = tok_text(src, toks, ttok)
            if sctx_variant_index(c, src, toks, nm) >= 0 {
                diag_emit_loc(src, tok_start(toks, ttok))
                stderr("sema: cannot assign to enum variant '")
                stderr(nm)
                stderr("'")
                stderr(char_to_str(10))
                return 1
            }
            if sctx_name_known(c, src, toks, nm) == 0 {
                return sema_unknown_at(src, toks, ttok)
            }
            var want = sctx_lookup_var_type(c, src, toks, nm)
            var got = sema_expr_type(c, src, toks, value)
            if got != want {
                return sema_type_mismatch_at(src, toks, ttok, want, got)
            }
        } else {
            if sema_check_expr(c, src, toks, target) != 0 { return 1 }
        }
        return 0
    }
    if kind == nd_return() {
        var e = ast_child(node, 0)
        var ret_ty = sctx_cur_ret_ty(c)
        if (e < 0) == 0 {
            if sema_check_expr(c, src, toks, e) != 0 { return 1 }
            var got = sema_expr_type(c, src, toks, e)
            if ret_ty != got {
                return sema_err("return type mismatch")
            }
        } else {
            if ret_ty != ir_ty_void() {
                return sema_err("return type mismatch")
            }
        }
        return 0
    }
    if kind == nd_expr_stmt() {
        return sema_check_expr(c, src, toks, ast_child(node, 0))
    }
    if kind == nd_if() {
        if sema_check_expr(c, src, toks, ast_child(node, 0)) != 0 { return 1 }
        if sema_check_block_or_stmt(c, src, toks, ast_child(node, 1)) != 0 { return 1 }
        var els = ast_child(node, 2)
        if (els < 0) == 0 {
            if (els == 2147483647) == 0 {
                return sema_check_block_or_stmt(c, src, toks, els)
            }
        }
        return 0
    }
    if kind == nd_while() {
        if sema_check_expr(c, src, toks, ast_child(node, 0)) != 0 { return 1 }
        if sema_check_block_or_stmt(c, src, toks, ast_child(node, 1)) != 0 { return 1 }
        var upd = ast_child(node, 2)
        if (upd < 0) == 0 {
            if (upd == 2147483647) == 0 {
                return sema_check_expr(c, src, toks, upd)
            }
        }
        return 0
    }
    if kind == nd_flux() {
        if sema_check_expr(c, src, toks, ast_child(node, 1)) != 0 { return 1 }
        sctx_scope_push(c)
        sctx_define(c, ast_child(node, 0))
        var rc = sema_check_block_or_stmt(c, src, toks, ast_child(node, 2))
        sctx_scope_pop(c)
        return rc
    }
    if kind == nd_block() {
        return sema_check_block_or_stmt(c, src, toks, node)
    }
    return 0
}

func sema_check_block_or_stmt(c: int, src: str, toks: int, node: int): int {
    if (node < 0) { return 0 }
    if ast_kind(node) == nd_block() {
        sctx_scope_push(c)
        var stmts = ast_child(node, 0)
        var i = 0
        while (i < int_vec_len(stmts)) {
            if sema_check_stmt(c, src, toks, int_vec_get(stmts, i)) != 0 {
                sctx_scope_pop(c)
                return 1
            }
            i = i + 1
        }
        sctx_scope_pop(c)
        return 0
    }
    return sema_check_stmt(c, src, toks, node)
}

func sema_check_func_node(c: int, src: str, toks: int, fn: int): int {
    sctx_scope_push(c)
    var ret_node = ast_child(fn, 2)
    sctx_set_cur_ret_ty(c, sema_type_from_node(c, ret_node, src, toks))
    var params = ast_child(fn, 1)
    var pi = 0
    while (pi < int_vec_len(params)) {
        var p = int_vec_get(params, pi)
        var pty = sema_type_from_node(c, ast_child(p, 1), src, toks)
        sctx_define_typed(c, ast_child(p, 0), pty)
        pi = pi + 1
    }
    var body = ast_child(fn, 3)
    var rc = 0
    if (body < 0) == 0 {
        rc = sema_check_block_or_stmt(c, src, toks, body)
    }
    sctx_scope_pop(c)
    return rc
}

// --- Enum declarations as nominal Option/Result-style types (Issue #93) ---
//
// Enum types get nominal ids (ir_ty_text() + 1 + index) so `var o: Option`
// rejects `0` while `o == None` type-checks. Unit variants register as enum-
// typed globals whose value is the variant tag; payload variants register as
// one-argument functions returning the enum type.
//
// Payload check policy: primitive payload types (int/bool/str/text) are
// checked against the constructor argument; anything else (type parameters
// such as T/E, arrays, other named types) is opaque and unchecked.

func sema_variant_payload_type(type_node: int, src: str, toks: int): int {
    if type_node < 0 {
        return 0 - 1
    }
    if ast_kind(type_node) != nd_type_name() {
        return 0 - 2
    }
    var tn = tok_text(src, toks, ast_child(type_node, 0))
    if str_eq(tn, "int") == 1 { return ir_ty_int() }
    if str_eq(tn, "bool") == 1 { return ir_ty_bool() }
    if str_eq(tn, "str") == 1 { return ir_ty_str() }
    if str_eq(tn, "text") == 1 { return ir_ty_text() }
    return 0 - 2
}

func sema_collect_enums(c: int, src: str, toks: int, file_node: int): int {
    var children = ast_child(file_node, 0)
    var n = int_vec_len(children)
    var i = 0
    while (i < n) {
        var ch = int_vec_get(children, i)
        if ast_kind(ch) == nd_enum() {
            var name_tok = ast_child(ch, 0)
            var nm = tok_text(src, toks, name_tok)
            if sctx_tok_list_has(sctx_enum_type_toks(c), src, toks, nm) == 1 {
                diag_emit_loc(src, tok_start(toks, name_tok))
                stderr("sema: duplicate enum '")
                stderr(nm)
                stderr("'")
                stderr(char_to_str(10))
                return 1
            }
            var enum_id = ir_ty_text() + 1 + int_vec_len(sctx_enum_type_toks(c))
            int_vec_push(sctx_enum_type_toks(c), name_tok)
            var variants = ast_child(ch, 1)
            var vseen = int_vec_new()
            var vi = 0
            var vn = int_vec_len(variants)
            while (vi < vn) {
                var v = int_vec_get(variants, vi)
                var vtok = ast_child(v, 0)
                var vnm = tok_text(src, toks, vtok)
                if sctx_tok_list_has(vseen, src, toks, vnm) == 1 {
                    int_vec_free(vseen)
                    diag_emit_loc(src, tok_start(toks, vtok))
                    stderr("sema: duplicate variant '")
                    stderr(vnm)
                    stderr("' in enum '")
                    stderr(nm)
                    stderr("'")
                    stderr(char_to_str(10))
                    return 1
                }
                int_vec_push(vseen, vtok)
                var pty = 0 - 1
                if ast_child(v, 1) >= 0 {
                    pty = sema_variant_payload_type(ast_child(v, 1), src, toks)
                }
                // Variants join the global/function namespaces directly (no
                // duplicate check against their own registration). A later
                // namespace collision pass catches clashes with real decls.
                if pty == 0 - 1 {
                    int_vec_push(sctx_globals(c), vtok)
                    int_vec_push(sctx_global_types(c), enum_id)
                } else {
                    int_vec_push(sctx_fn_names(c), vtok)
                    int_vec_push(sctx_fn_arities(c), 1)
                    int_vec_push(sctx_fn_ret_types(c), enum_id)
                }
                int_vec_push(sctx_variant_toks(c), vtok)
                int_vec_push(sctx_variant_enum_ids(c), enum_id)
                int_vec_push(sctx_variant_payloads(c), pty)
                vi = vi + 1
            }
            int_vec_free(vseen)
        }
        i = i + 1
    }
    return 0
}

// Variant names share the global namespace with functions: reject a function
// declared with the same name as a payload variant (or any function that
// shadows a unit variant), which pass ordering would otherwise let slip by.
func sema_check_variant_collisions(c: int, src: str, toks: int, file_node: int): int {
    var vts = sctx_variant_toks(c)
    var children = ast_child(file_node, 0)
    var fn_toks = int_vec_new()
    var i = 0
    while (i < int_vec_len(children)) {
        var ch = int_vec_get(children, i)
        var k = ast_kind(ch)
        if k == nd_func() | k == nd_extern_func() {
            int_vec_push(fn_toks, ast_child(ch, 0))
        }
        if k == nd_class() {
            var mem = ast_child(ch, 1)
            var mi = 0
            while (mi < int_vec_len(mem)) {
                if ast_kind(int_vec_get(mem, mi)) == nd_func() {
                    int_vec_push(fn_toks, ast_child(int_vec_get(mem, mi), 0))
                }
                mi = mi + 1
            }
        }
        if k == nd_impl() {
            var mem2 = ast_child(ch, 2)
            var mi2 = 0
            while (mi2 < int_vec_len(mem2)) {
                if ast_kind(int_vec_get(mem2, mi2)) == nd_func() {
                    int_vec_push(fn_toks, ast_child(int_vec_get(mem2, mi2), 0))
                }
                mi2 = mi2 + 1
            }
        }
        i = i + 1
    }
    var vni = 0
    var vn = int_vec_len(vts)
    while (vni < vn) {
        var vnm = tok_text(src, toks, int_vec_get(vts, vni))
        var fi = 0
        while (fi < int_vec_len(fn_toks)) {
            if str_eq(tok_text(src, toks, int_vec_get(fn_toks, fi)), vnm) == 1 {
                int_vec_free(fn_toks)
                diag_emit_loc(src, tok_start(toks, int_vec_get(vts, vni)))
                stderr("sema: function '")
                stderr(vnm)
                stderr("' conflicts with enum variant")
                stderr(char_to_str(10))
                return 1
            }
            fi = fi + 1
        }
        vni = vni + 1
    }
    int_vec_free(fn_toks)
    return 0
}

func sema_collect_toplevel(c: int, src: str, toks: int, file_node: int): int {
    // Pass 1: register every enum type and variant first so any later
    // annotation or initializer can resolve them regardless of source order.
    if sema_collect_enums(c, src, toks, file_node) != 0 {
        return 1
    }
    var children = ast_child(file_node, 0)
    var n = int_vec_len(children)
    var i = 0
    while (i < n) {
        var ch = int_vec_get(children, i)
        var k = ast_kind(ch)
        if k == nd_func() {
            var f_ret = sema_type_from_node(c, ast_child(ch, 2), src, toks)
            if sctx_add_fn(c, src, toks, ast_child(ch, 0), int_vec_len(ast_child(ch, 1)), f_ret) != 0 {
                return 1
            }
        }
        if k == nd_extern_func() {
            var e_ret = sema_type_from_node(c, ast_child(ch, 2), src, toks)
            if sctx_add_fn(c, src, toks, ast_child(ch, 0), int_vec_len(ast_child(ch, 1)), e_ret) != 0 {
                return 1
            }
        }
        if k == nd_var_decl() {
            var g_type_node = ast_child(ch, 1)
            var gty = sema_type_from_node(c, g_type_node, src, toks)
            // Untyped globals: infer from initializer (same as local var decls).
            if (g_type_node < 0) {
                var g_init = ast_child(ch, 2)
                if (g_init < 0) == 0 {
                    gty = sema_expr_type(c, src, toks, g_init)
                }
            }
            if sctx_add_global(c, src, toks, ast_child(ch, 0), gty) != 0 {
                return 1
            }
        }
        if k == nd_class() {
            int_vec_push(sctx_types(c), ast_child(ch, 0))
            var members = ast_child(ch, 1)
            var mi = 0
            while (mi < int_vec_len(members)) {
                var m = int_vec_get(members, mi)
                if ast_kind(m) == nd_func() {
                    var mtok = ast_child(m, 0)
                    int_vec_push(sctx_methods(c), mtok)
                    // Class methods lower with implicit self as first arg (+1 arity).
                    var arity = int_vec_len(ast_child(m, 1)) + 1
                    if (sctx_fn_arity(c, src, toks, tok_text(src, toks, mtok)) < 0) {
                        var m_ret = sema_type_from_node(c, ast_child(m, 2), src, toks)
                        if sctx_add_fn(c, src, toks, mtok, arity, m_ret) != 0 {
                            return 1
                        }
                    }
                }
                mi = mi + 1
            }
        }
        if k == nd_impl() {
            var methods = ast_child(ch, 2)
            var mi = 0
            while (mi < int_vec_len(methods)) {
                var m = int_vec_get(methods, mi)
                if ast_kind(m) == nd_func() {
                    var mtok = ast_child(m, 0)
                    int_vec_push(sctx_methods(c), mtok)
                    var mnm = tok_text(src, toks, mtok)
                    // Impl methods lower as free funcs; register arity unless a free
                    // func with the same name already exists (receiver-first demos).
                    if (sctx_fn_arity(c, src, toks, mnm) < 0) {
                        var im_ret = sema_type_from_node(c, ast_child(m, 2), src, toks)
                        if sctx_add_fn(c, src, toks, mtok, int_vec_len(ast_child(m, 1)), im_ret) != 0 {
                            return 1
                        }
                    }
                }
                mi = mi + 1
            }
        }
        i = i + 1
    }
    if sema_check_variant_collisions(c, src, toks, file_node) != 0 {
        return 1
    }
    return 0
}

func sema_check_names(file_node: int, src: str, toks: int): int {
    var c = sctx_new()
    if sema_collect_toplevel(c, src, toks, file_node) != 0 {
        sctx_free(c)
        return 1
    }
    // Global inits may reference other globals / funcs.
    var children = ast_child(file_node, 0)
    var i = 0
    while (i < int_vec_len(children)) {
        var ch = int_vec_get(children, i)
        if ast_kind(ch) == nd_var_decl() {
            var init = ast_child(ch, 2)
            if (init < 0) == 0 {
                if sema_check_expr(c, src, toks, init) != 0 {
                    sctx_free(c)
                    return 1
                }
            }
        }
        i = i + 1
    }
    i = 0
    while (i < int_vec_len(children)) {
        var ch2 = int_vec_get(children, i)
        var k2 = ast_kind(ch2)
        if k2 == nd_func() {
            if sema_check_func_node(c, src, toks, ch2) != 0 {
                sctx_free(c)
                return 1
            }
        }
        if k2 == nd_impl() {
            var methods = ast_child(ch2, 2)
            var mi = 0
            while (mi < int_vec_len(methods)) {
                var m = int_vec_get(methods, mi)
                if ast_kind(m) == nd_func() {
                    if sema_check_func_node(c, src, toks, m) != 0 {
                        sctx_free(c)
                        return 1
                    }
                }
                mi = mi + 1
            }
        }
        if k2 == nd_class() {
            var members2 = ast_child(ch2, 1)
            var mj = 0
            while (mj < int_vec_len(members2)) {
                var mm = int_vec_get(members2, mj)
                if ast_kind(mm) == nd_func() {
                    sctx_set_self_ok(c, 1)
                    if sema_check_func_node(c, src, toks, mm) != 0 {
                        sctx_set_self_ok(c, 0)
                        sctx_free(c)
                        return 1
                    }
                    sctx_set_self_ok(c, 0)
                }
                mj = mj + 1
            }
        }
        i = i + 1
    }
    sctx_free(c)
    return 0
}

// 1 = native may lower: package/import/funcs/extern; struct/class with fields and
// class-body methods (receiver-first / `self`); traits + impls.
func sema_class_members_ok(members: int): int {
    var n = int_vec_len(members)
    var j = 0
    while (j < n) {
        var mk = ast_kind(int_vec_get(members, j))
        if (mk == nd_class_field()) == 0 {
            if (mk == nd_func()) == 0 {
                return 0
            }
        }
        j = j + 1
    }
    return 1
}

// --- Match expressions (Issue #91) ---
//
// A match has a scrutinee and a list of arms. Each arm is
// `pattern [if guard] => body`. Patterns are integer literals, boolean
// literals, string literals, the wildcard `_`, a binding name, or an enum
// variant (`Enum::Variant`, `Variant`, `Variant(binding)`).
//
// Phase 1 runtime model: enum values are int tags, and payloads live in the
// payload slot of a local enum binding only. A payload binding therefore
// requires a local enum scrutinee; binding a payload of a value that crossed
// a call boundary is a compile error (see docs/language-spec.md).

// Runtime tag of a variant: its 0-based index inside its own enum.
func sema_variant_tag(c: int, vi: int): int {
    var eids = sctx_variant_enum_ids(c)
    var want = int_vec_get(eids, vi)
    var tag = 0
    var i = 0
    while (i < vi) {
        if int_vec_get(eids, i) == want {
            tag = tag + 1
        }
        i = i + 1
    }
    return tag
}

// Is |name| a local variable (not a global, not a function)?
func sema_local_known(c: int, src: str, toks: int, want: str): int {
    var names = sctx_names(c)
    var i = 0
    while (i < int_vec_len(names)) {
        if str_eq(tok_text(src, toks, int_vec_get(names, i)), want) == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

// Does the enum type |ety| declare a payload variant?
func sema_enum_has_payload(c: int, ety: int): int {
    var eids = sctx_variant_enum_ids(c)
    var i = 0
    while (i < int_vec_len(eids)) {
        if int_vec_get(eids, i) == ety {
            if int_vec_get(sctx_variant_payloads(c), i) != 0 - 1 {
                return 1
            }
        }
        i = i + 1
    }
    return 0
}

// Pattern analysis result layout (int_vec):
//   [0] resolved kind (pat_int_lit / pat_bool_lit / pat_str_lit /
//       pat_wildcard / pat_variant / pat_binding)
//   [1] key (int literal value, bool literal value, or variant index)
//   [2] variant tag (-1 when not a variant)
//   [3] binding token (-1 when no binding)
//   [4] binding type (-1 when no binding)
//   [5] irrefutable (1 = wildcard or whole-value binding)
func sema_pat_kind(o: int): int    { return int_vec_get(o, 0) }
func sema_pat_key(o: int): int     { return int_vec_get(o, 1) }
func sema_pat_bind(o: int): int    { return int_vec_get(o, 3) }
func sema_pat_bind_ty(o: int): int { return int_vec_get(o, 4) }

func sema_pat_type_mismatch(src: str, toks: int, pat: int, pat_ty: int, scr_ty: int): int {
    diag_emit_loc(src, tok_start(toks, ast_child(pat, 5)))
    stderr("sema: type mismatch: pattern of type ")
    stderr(sctx_ty_name(pat_ty))
    stderr(" does not match scrutinee of type ")
    stderr(sctx_ty_name(scr_ty))
    stderr(char_to_str(10))
    return 1
}

// Resolve and type-check one pattern against the scrutinee type |sty|.
// Returns the analysis vector, or -1 on error.
func sema_check_pattern(c: int, src: str, toks: int, pat: int, sty: int): int {
    var pkind = ast_child(pat, 0)
    var value = ast_child(pat, 1)
    var bind_tok = ast_child(pat, 2)
    var enum_tok = ast_child(pat, 3)
    var out = int_vec_new()
    if pkind == pat_int_lit() {
        if sty != ir_ty_int() {
            sema_pat_type_mismatch(src, toks, pat, ir_ty_int(), sty)
            return 0 - 1
        }
        int_vec_push(out, pat_int_lit())
        int_vec_push(out, value)
        int_vec_push(out, 0 - 1)
        int_vec_push(out, 0 - 1)
        int_vec_push(out, 0 - 1)
        int_vec_push(out, 0)
        return out
    }
    if pkind == pat_bool_lit() {
        if sty != ir_ty_bool() {
            sema_pat_type_mismatch(src, toks, pat, ir_ty_bool(), sty)
            return 0 - 1
        }
        int_vec_push(out, pat_bool_lit())
        int_vec_push(out, value)
        int_vec_push(out, 0 - 1)
        int_vec_push(out, 0 - 1)
        int_vec_push(out, 0 - 1)
        int_vec_push(out, 0)
        return out
    }
    if pkind == pat_str_lit() {
        if sty != ir_ty_str() {
            sema_pat_type_mismatch(src, toks, pat, ir_ty_str(), sty)
            return 0 - 1
        }
        int_vec_push(out, pat_str_lit())
        int_vec_push(out, value)
        int_vec_push(out, 0 - 1)
        int_vec_push(out, 0 - 1)
        int_vec_push(out, 0 - 1)
        int_vec_push(out, 0)
        return out
    }
    if pkind == pat_wildcard() {
        int_vec_push(out, pat_wildcard())
        int_vec_push(out, 0 - 1)
        int_vec_push(out, 0 - 1)
        int_vec_push(out, 0 - 1)
        int_vec_push(out, 0 - 1)
        int_vec_push(out, 1)
        return out
    }
    // Variant or binding.
    var vi = 0 - 1
    var vname = tok_text(src, toks, value)
    if pkind == pat_ident() {
        vi = sctx_variant_index(c, src, toks, vname)
        if vi >= 0 {
            if int_vec_get(sctx_variant_enum_ids(c), vi) != sty {
                // The name names a variant of another enum: it cannot match here.
                diag_emit_loc(src, tok_start(toks, value))
                stderr("sema: unknown pattern '")
                stderr(vname)
                stderr("'")
                stderr(char_to_str(10))
                return 0 - 1
            }
        } else {
            if sty > ir_ty_text() {
                // An enum scrutinee needs a variant pattern.
                diag_emit_loc(src, tok_start(toks, value))
                stderr("sema: unknown pattern '")
                stderr(vname)
                stderr("'")
                stderr(char_to_str(10))
                return 0 - 1
            }
            // A plain name binds the whole scrutinee value.
            int_vec_push(out, pat_binding())
            int_vec_push(out, 0 - 1)
            int_vec_push(out, 0 - 1)
            int_vec_push(out, value)
            int_vec_push(out, sty)
            int_vec_push(out, 1)
            return out
        }
    } else {
        if enum_tok >= 0 {
            var ename = tok_text(src, toks, enum_tok)
            var ei = sctx_enum_index(c, src, toks, ename)
            if ei < 0 {
                diag_emit_loc(src, tok_start(toks, enum_tok))
                stderr("sema: unknown enum '")
                stderr(ename)
                stderr("'")
                stderr(char_to_str(10))
                return 0 - 1
            }
            vi = sctx_variant_index_in_enum(c, src, toks, ir_ty_text() + 1 + ei, vname)
            if vi < 0 {
                diag_emit_loc(src, tok_start(toks, value))
                stderr("sema: unknown variant '")
                stderr(vname)
                stderr("' in enum '")
                stderr(ename)
                stderr("'")
                stderr(char_to_str(10))
                return 0 - 1
            }
        } else {
            vi = sctx_variant_index(c, src, toks, vname)
            if vi < 0 {
                diag_emit_loc(src, tok_start(toks, value))
                stderr("sema: unknown pattern '")
                stderr(vname)
                stderr("'")
                stderr(char_to_str(10))
                return 0 - 1
            }
        }
    }
    // Variant pattern: the variant must belong to the scrutinee's enum.
    var venum = int_vec_get(sctx_variant_enum_ids(c), vi)
    if venum != sty {
        sema_pat_type_mismatch(src, toks, pat, venum, sty)
        return 0 - 1
    }
    var pty = int_vec_get(sctx_variant_payloads(c), vi)
    if pty == 0 - 1 {
        if bind_tok >= 0 {
            diag_emit_loc(src, tok_start(toks, bind_tok))
            stderr("sema: unit variant '")
            stderr(vname)
            stderr("' takes no payload")
            stderr(char_to_str(10))
            return 0 - 1
        }
    } else {
        if bind_tok < 0 {
            diag_emit_loc(src, tok_start(toks, value))
            stderr("sema: variant '")
            stderr(vname)
            stderr("' expects a payload binding")
            stderr(char_to_str(10))
            return 0 - 1
        }
    }
    var bty = pty
    if bty == 0 - 2 { bty = ir_ty_int() }
    int_vec_push(out, pat_variant())
    int_vec_push(out, vi)
    int_vec_push(out, sema_variant_tag(c, vi))
    int_vec_push(out, bind_tok)
    int_vec_push(out, bty)
    int_vec_push(out, 0)
    return out
}

// Match context: [variants, int literals, bool literals, str literals,
// irrefutable (mut), arm type (mut), scrutinee type]
func sema_mctx_new(sty: int): int {
    var m = int_vec_new()
    int_vec_push(m, int_vec_new())
    int_vec_push(m, int_vec_new())
    int_vec_push(m, int_vec_new())
    int_vec_push(m, int_vec_new())
    int_vec_push(m, mut_new(0))
    int_vec_push(m, mut_new(0 - 1))
    int_vec_push(m, sty)
    return m
}
func sema_mctx_variants(m: int): int { return int_vec_get(m, 0) }
func sema_mctx_lits(m: int): int { return int_vec_get(m, 1) }
func sema_mctx_bools(m: int): int { return int_vec_get(m, 2) }
func sema_mctx_strs(m: int): int { return int_vec_get(m, 3) }
func sema_mctx_irrefutable(m: int): int { return mut_get(int_vec_get(m, 4)) }
func sema_mctx_arm_ty(m: int): int { return mut_get(int_vec_get(m, 5)) }
func sema_mctx_sty(m: int): int { return int_vec_get(m, 6) }
func sema_mctx_set_irrefutable(m: int, v: int): int { return mut_set(int_vec_get(m, 4), v) }
func sema_mctx_set_arm_ty(m: int, v: int): int { return mut_set(int_vec_get(m, 5), v) }

// Is |vi| covered by an earlier unguarded arm?
func sema_mctx_covers_variant(m: int, vi: int): int {
    var v = sema_mctx_variants(m)
    var i = 0
    while (i < int_vec_len(v)) {
        if int_vec_get(v, i) == vi { return 1 }
        i = i + 1
    }
    return 0
}

// Is the literal |key| covered by an earlier unguarded arm?
func sema_mctx_covers_lit(m: int, key: int): int {
    var v = sema_mctx_lits(m)
    var i = 0
    while (i < int_vec_len(v)) {
        if int_vec_get(v, i) == key { return 1 }
        i = i + 1
    }
    return 0
}

// Is the boolean literal |key| covered by an earlier unguarded arm?
func sema_mctx_covers_bool(m: int, key: int): int {
    var v = sema_mctx_bools(m)
    var i = 0
    while (i < int_vec_len(v)) {
        if int_vec_get(v, i) == key { return 1 }
        i = i + 1
    }
    return 0
}

// Is the string literal token |tok| covered by an earlier unguarded arm?
func sema_mctx_covers_str(m: int, src: str, toks: int, tok: int): int {
    var v = sema_mctx_strs(m)
    var i = 0
    while (i < int_vec_len(v)) {
        if tok_spelling_eq(src, toks, int_vec_get(v, i), tok) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Is the pattern described by |info| already covered by an earlier arm?
func sema_mctx_covers(m: int, src: str, toks: int, info: int): int {
    if sema_mctx_irrefutable(m) == 1 { return 1 }
    var kind = sema_pat_kind(info)
    if kind == pat_variant() { return sema_mctx_covers_variant(m, sema_pat_key(info)) }
    if kind == pat_int_lit() { return sema_mctx_covers_lit(m, sema_pat_key(info)) }
    if kind == pat_bool_lit() { return sema_mctx_covers_bool(m, sema_pat_key(info)) }
    if kind == pat_str_lit() { return sema_mctx_covers_str(m, src, toks, sema_pat_key(info)) }
    return 0
}

// Record that an unguarded arm covers the pattern described by |info|.
func sema_mctx_cover(m: int, info: int): int {
    var kind = sema_pat_kind(info)
    if kind == pat_variant() {
        int_vec_push(sema_mctx_variants(m), sema_pat_key(info))
        return 0
    }
    if kind == pat_int_lit() {
        int_vec_push(sema_mctx_lits(m), sema_pat_key(info))
        return 0
    }
    if kind == pat_bool_lit() {
        int_vec_push(sema_mctx_bools(m), sema_pat_key(info))
        return 0
    }
    if kind == pat_str_lit() {
        int_vec_push(sema_mctx_strs(m), sema_pat_key(info))
        return 0
    }
    sema_mctx_set_irrefutable(m, 1)
    return 0
}

// A payload binding needs the payload slot of a local enum binding: Phase 1
// does not carry payloads across call boundaries.
func sema_scrutinee_payload_ok(c: int, src: str, toks: int, scrutinee: int, sty: int): int {
    if sty <= ir_ty_text() { return 0 }
    if ast_kind(scrutinee) != nd_ident() { return 0 }
    var nm = tok_text(src, toks, ast_child(scrutinee, 0))
    if sema_local_known(c, src, toks, nm) == 0 { return 0 }
    if sctx_lookup_var_type(c, src, toks, nm) != sty { return 0 }
    if sema_enum_has_payload(c, sty) == 0 { return 0 }
    return 1
}

// Every value of the scrutinee type must be covered by an unguarded arm.
func sema_match_exhaustive(c: int, src: str, toks: int, m: int, node: int): int {
    if sema_mctx_irrefutable(m) == 1 { return 0 }
    var sty = sema_mctx_sty(m)
    if sty > ir_ty_text() {
        var eids = sctx_variant_enum_ids(c)
        var missing = int_vec_new()
        var i = 0
        while (i < int_vec_len(eids)) {
            if int_vec_get(eids, i) == sty {
                if sema_mctx_covers_variant(m, i) == 0 {
                    int_vec_push(missing, i)
                }
            }
            i = i + 1
        }
        if int_vec_len(missing) > 0 {
            diag_emit_loc(src, tok_start(toks, ast_child(node, 0)))
            stderr("sema: non-exhaustive match: missing variants ")
            var j = 0
            while (j < int_vec_len(missing)) {
                if j > 0 { stderr(", ") }
                stderr("'")
                stderr(tok_text(src, toks, int_vec_get(sctx_variant_toks(c), int_vec_get(missing, j))))
                stderr("'")
                j = j + 1
            }
            stderr(char_to_str(10))
            return 1
        }
        return 0
    }
    if sty == ir_ty_bool() {
        var cov_t = sema_mctx_covers_bool(m, 1)
        var cov_f = sema_mctx_covers_bool(m, 0)
        if (cov_t == 0) | (cov_f == 0) {
            diag_emit_loc(src, tok_start(toks, ast_child(node, 0)))
            stderr("sema: non-exhaustive match: missing pattern")
            if (cov_t == 0) & (cov_f == 0) { stderr("s 'true', 'false'") }
            if (cov_t == 0) & (cov_f == 1) { stderr(" 'true'") }
            if (cov_t == 1) & (cov_f == 0) { stderr(" 'false'") }
            stderr(char_to_str(10))
            return 1
        }
        return 0
    }
    diag_emit_loc(src, tok_start(toks, ast_child(node, 0)))
    stderr("sema: non-exhaustive match: add a wildcard arm")
    stderr(char_to_str(10))
    return 1
}

// Check a match expression: arm types, reachability, exhaustiveness.
func sema_check_match(c: int, src: str, toks: int, node: int): int {
    var scrutinee = ast_child(node, 0)
    var arms = ast_child(node, 1)
    if sema_check_expr(c, src, toks, scrutinee) != 0 { return 1 }
    var sty = sema_expr_type(c, src, toks, scrutinee)
    var n = int_vec_len(arms)
    if n == 0 {
        return sema_err("non-exhaustive match: no arms")
    }
    var m = sema_mctx_new(sty)
    var i = 0
    while (i < n) {
        var arm = int_vec_get(arms, i)
        var pat = ast_child(arm, 0)
        var guard = ast_child(arm, 1)
        var body = ast_child(arm, 2)
        var has_guard = 0
        if guard >= 0 { has_guard = 1 }
        sctx_scope_push(c)
        var info = sema_check_pattern(c, src, toks, pat, sty)
        if info < 0 {
            sctx_scope_pop(c)
            return 1
        }
        if sema_mctx_covers(m, src, toks, info) == 1 {
            diag_emit_loc(src, tok_start(toks, ast_child(pat, 5)))
            stderr("sema: unreachable pattern")
            stderr(char_to_str(10))
            sctx_scope_pop(c)
            return 1
        }
        var bt = sema_pat_bind(info)
        if bt >= 0 {
            var bname = tok_text(src, toks, bt)
            if sema_pat_kind(info) == pat_binding() {
                sctx_define_typed(c, bt, sema_pat_bind_ty(info))
            }
            if (str_eq(bname, "_") == 0) & (sema_pat_kind(info) == pat_variant()) {
                if sema_scrutinee_payload_ok(c, src, toks, scrutinee, sty) == 0 {
                    diag_emit_loc(src, tok_start(toks, bt))
                    stderr("sema: cannot bind payload '")
                    stderr(bname)
                    stderr("': Phase 1 carries enum payloads only in local enum bindings")
                    stderr(char_to_str(10))
                    sctx_scope_pop(c)
                    return 1
                }
                sctx_define_typed(c, bt, sema_pat_bind_ty(info))
            }
        }
        if has_guard == 1 {
            if sema_check_expr(c, src, toks, guard) != 0 {
                sctx_scope_pop(c)
                return 1
            }
        }
        if sema_check_expr(c, src, toks, body) != 0 {
            sctx_scope_pop(c)
            return 1
        }
        var bty = sema_expr_type(c, src, toks, body)
        var aty = sema_mctx_arm_ty(m)
        if aty < 0 {
            sema_mctx_set_arm_ty(m, bty)
        } else {
            if bty != aty {
                sctx_scope_pop(c)
                return sema_err("match arms have inconsistent types")
            }
        }
        sctx_scope_pop(c)
        if has_guard == 0 {
            sema_mctx_cover(m, info)
        }
        i = i + 1
    }
    if sema_match_exhaustive(c, src, toks, m, node) != 0 { return 1 }
    sema_cache_match_type(c, node, sema_mctx_arm_ty(m))
    return 0
}

func sema_file_only_native_subset(file_node: int): int {
    var children = ast_child(file_node, 0)
    var n = int_vec_len(children)
    var i = 0
    while (i < n) {
        var ch = int_vec_get(children, i)
        var k = ast_kind(ch)
        if k == nd_class() {
            var mem = ast_child(ch, 1)
            if sema_class_members_ok(mem) == 0 {
                return 0
            }
        }
        i = i + 1
    }
    return 1
}
