// Recursive descent parser for the Diva language.
// Consumes a token stream (from lexer.diva) and produces an AST (from ast.diva).
// All mutable state (pos, err) uses the cell pattern (cell.diva) to avoid module-level var.
import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "tokens.diva"
import "ast.diva"
import "cell.diva"

// --- Parser context ---
// ps = int_vec: [pos_cell, tlen, err_cell, toks_handle, quiet (0=loud, 1=no stderr on error)]

func ps_new(toks: int, quiet: int): int {
    var ps = int_vec_new()
    int_vec_push(ps, mut_new(0))
    int_vec_push(ps, tok_count(toks))
    int_vec_push(ps, mut_new(0))
    int_vec_push(ps, toks)
    int_vec_push(ps, quiet)
    return ps
}

func ps_pos(ps: int): int  { return mut_get(int_vec_get(ps, 0)) }
func ps_tlen(ps: int): int { return int_vec_get(ps, 1) }
func ps_err(ps: int): int  { return mut_get(int_vec_get(ps, 2)) }
func ps_toks(ps: int): int { return int_vec_get(ps, 3) }
func ps_quiet(ps: int): int { return int_vec_get(ps, 4) }

func ps_set_pos(ps: int, v: int): int { return mut_set(int_vec_get(ps, 0), v) }
func ps_set_err(ps: int): int         { return mut_set(int_vec_get(ps, 2), 1) }

// --- Core helpers ---

func p_cur(ps: int): int {
    if ps_pos(ps) >= ps_tlen(ps) {
        return tk_eof()
    }
    return tok_kind(ps_toks(ps), ps_pos(ps))
}

func p_advance(ps: int): int {
    var old = ps_pos(ps)
    if old < ps_tlen(ps) {
        ps_set_pos(ps, old + 1)
    }
    return old
}

func p_text(ps: int, src: str, idx: int): str {
    return tok_text(src, ps_toks(ps), idx)
}

func p_expect(ps: int, src: str, kind: int): int {
    if p_cur(ps) != kind {
        if ps_quiet(ps) == 0 {
            stderr("parse error: expected ")
            stderr(tk_name(kind))
            stderr(", got ")
            stderr(tk_name(p_cur(ps)))
            if ps_pos(ps) < ps_tlen(ps) {
                stderr(" '")
                stderr(p_text(ps, src, ps_pos(ps)))
                stderr("'")
            }
            stderr("\n")
        }
        ps_set_err(ps)
        return ps_pos(ps)
    }
    return p_advance(ps)
}

func p_match(ps: int, kind: int): int {
    if p_cur(ps) == kind {
        p_advance(ps)
        return 1
    }
    return 0
}

func p_skip_semi(ps: int): int {
    if p_cur(ps) == tk_semi() {
        p_advance(ps)
        return 1
    }
    return 0
}

// --- Type parsing ---

func parse_type(ps: int, src: str): int {
    var kind = p_cur(ps)
    var tok = ps_pos(ps)
    if kind == tk_int_kw() {
        p_advance(ps)
        var t = ast_type_name(tok)
        if p_cur(ps) == tk_lbrack() {
            p_advance(ps) p_expect(ps, src, tk_rbrack()) return ast_type_array(t)
        }
        return t
    }
    if kind == tk_str_kw() {
        p_advance(ps) return ast_type_name(tok)
    }
    if kind == tk_bool_kw() {
        p_advance(ps) return ast_type_name(tok)
    }
    if kind == tk_void() {
        p_advance(ps) return ast_type_name(tok)
    }
    if kind == tk_ident() {
        p_advance(ps)
        var t = ast_type_name(tok)
        if p_cur(ps) == tk_lbrack() {
            p_advance(ps) p_expect(ps, src, tk_rbrack()) return ast_type_array(t)
        }
        return t
    }
    if ps_quiet(ps) == 0 {
        stderr("parse error: expected type\n")
    }
    ps_set_err(ps)
    return 0 - 1
}

// --- Expression parsing (precedence climbing) ---
// parse_primary calls parse_expr (defined later) — seed supports forward refs.

func parse_primary(ps: int, src: str): int {
    var kind = p_cur(ps)
    var tok = ps_pos(ps)

    if kind == tk_int_lit() {
        p_advance(ps)
        return ast_int_lit(tok_int_value(src, ps_toks(ps), tok))
    }

    if kind == tk_str_lit() {
        p_advance(ps)
        return ast_str_lit(tok)
    }

    if kind == tk_true() {
        p_advance(ps)
        return ast_bool_lit(1)
    }

    if kind == tk_false() {
        p_advance(ps)
        return ast_bool_lit(0)
    }

    if kind == tk_ident() | kind == tk_self() {
        var ident_tok = tok
        p_advance(ps)
        // 'if cond {' with 'cond' an ident must not be parsed as 'Type { ... }' struct literal.
        // Struct types in-tree use PascalCase; only treat 'Ident {' as struct lit when Ident starts with A-Z.
        if p_cur(ps) == tk_lbrace() {
            var iname = p_text(ps, src, ident_tok)
            if str_len(iname) > 0 {
                var fb = str_byte(iname, 0)
                if fb >= 65 & fb <= 90 {
                    return parse_struct_lit(ps, src, ident_tok)
                }
            }
        }
        return ast_ident(ident_tok)
    }

    if kind == tk_lparen() {
        p_advance(ps)
        var inner = parse_expr(ps, src)
        p_expect(ps, src, tk_rparen())
        return inner
    }

    if kind == tk_lbrack() {
        p_advance(ps)
        var elems = int_vec_new()
        if p_cur(ps) != tk_rbrack() {
            int_vec_push(elems, parse_expr(ps, src))
            while p_cur(ps) == tk_comma() {
                p_advance(ps)
                if p_cur(ps) != tk_rbrack() {
                    int_vec_push(elems, parse_expr(ps, src))
                }
            }
        }
        p_expect(ps, src, tk_rbrack())
        return ast_array_lit(elems)
    }

    if kind == tk_bang() {
        p_advance(ps)
        return ast_unary(unop_not(), parse_primary(ps, src))
    }

    if kind == tk_minus() {
        p_advance(ps)
        return ast_unary(unop_neg(), parse_primary(ps, src))
    }

    if ps_quiet(ps) == 0 {
        stderr("parse error: unexpected token in expression: ")
        stderr(tk_name(kind))
        stderr("\n")
    }
    ps_set_err(ps)
    return 0 - 1
}

func parse_args(ps: int, src: str): int {
    var args = int_vec_new()
    p_expect(ps, src, tk_lparen())
    if p_cur(ps) != tk_rparen() {
        int_vec_push(args, parse_expr(ps, src))
        while p_cur(ps) == tk_comma() {
            p_advance(ps)
            int_vec_push(args, parse_expr(ps, src))
        }
    }
    p_expect(ps, src, tk_rparen())
    return args
}

func parse_postfix(ps: int, src: str, left: int): int {
    var node = left
    var more = 1
    while more == 1 {
        if p_cur(ps) == tk_lparen() {
            var args = parse_args(ps, src)
            node = ast_call(node, args)
        } else {
        if p_cur(ps) == tk_dot() {
            p_advance(ps)
            var ftok = p_expect(ps, src, tk_ident())
            if p_cur(ps) == tk_lparen() {
                var args = parse_args(ps, src)
                node = ast_method_call(node, ftok, args)
            } else {
                node = ast_field(node, ftok)
            }
        } else {
        if p_cur(ps) == tk_lbrack() {
            p_advance(ps)
            if p_cur(ps) == tk_int_kw() | p_cur(ps) == tk_str_kw() | p_cur(ps) == tk_bool_kw() | p_cur(ps) == tk_ident() {
                var save = ps_pos(ps)
                p_advance(ps)
                if p_cur(ps) == tk_rbrack() {
                    p_advance(ps)
                    if p_cur(ps) == tk_lparen() {
                        var args = parse_args(ps, src)
                        node = ast_call(node, args)
                    } else {
                        ps_set_pos(ps, save)
                        var idx = parse_expr(ps, src)
                        p_expect(ps, src, tk_rbrack())
                        node = ast_index(node, idx)
                    }
                } else {
                    ps_set_pos(ps, save)
                    var idx = parse_expr(ps, src)
                    p_expect(ps, src, tk_rbrack())
                    node = ast_index(node, idx)
                }
            } else {
                var idx = parse_expr(ps, src)
                p_expect(ps, src, tk_rbrack())
                node = ast_index(node, idx)
            }
        } else {
        if p_cur(ps) == tk_dotdot() {
            p_advance(ps)
            var rhs = parse_expr(ps, src)
            node = ast_range(node, rhs)
            more = 0
        } else {
            more = 0
        } } } }
    }
    return node
}

func parse_unary(ps: int, src: str): int {
    if p_cur(ps) == tk_bang() {
        p_advance(ps)
        return ast_unary(unop_not(), parse_unary(ps, src))
    }
    if p_cur(ps) == tk_minus() {
        p_advance(ps)
        return ast_unary(unop_neg(), parse_unary(ps, src))
    }
    var prim = parse_primary(ps, src)
    return parse_postfix(ps, src, prim)
}

func parse_mul(ps: int, src: str): int {
    var left = parse_unary(ps, src)
    while p_cur(ps) == tk_star() | p_cur(ps) == tk_slash() | p_cur(ps) == tk_percent() {
        var op = p_cur(ps)
        p_advance(ps)
        var right = parse_unary(ps, src)
        if op == tk_star() {
            left = ast_binop(binop_mul(), left, right)
        }
        if op == tk_slash() {
            left = ast_binop(binop_div(), left, right)
        }
        if op == tk_percent() {
            left = ast_binop(binop_mod(), left, right)
        }
    }
    return left
}

func parse_add(ps: int, src: str): int {
    var left = parse_shift(ps, src)
    while p_cur(ps) == tk_plus() | p_cur(ps) == tk_minus() {
        var op = p_cur(ps)
        p_advance(ps)
        var right = parse_shift(ps, src)
        if op == tk_plus() {
            left = ast_binop(binop_add(), left, right)
        }
        if op == tk_minus() {
            left = ast_binop(binop_sub(), left, right)
        }
    }
    return left
}

func parse_shift(ps: int, src: str): int {
    var left = parse_mul(ps, src)
    while p_cur(ps) == tk_shl() | p_cur(ps) == tk_shr() {
        var op = p_cur(ps)
        p_advance(ps)
        var right = parse_mul(ps, src)
        if op == tk_shl() {
            left = ast_binop(binop_shl(), left, right)
        }
        if op == tk_shr() {
            left = ast_binop(binop_shr(), left, right)
        }
    }
    return left
}

func parse_cmp(ps: int, src: str): int {
    var left = parse_add(ps, src)
    while p_cur(ps) == tk_lt() | p_cur(ps) == tk_gt() | p_cur(ps) == tk_le() | p_cur(ps) == tk_ge() {
        var op = p_cur(ps)
        p_advance(ps)
        var right = parse_add(ps, src)
        if op == tk_lt() {
            left = ast_binop(binop_lt(), left, right)
        }
        if op == tk_gt() {
            left = ast_binop(binop_gt(), left, right)
        }
        if op == tk_le() {
            left = ast_binop(binop_le(), left, right)
        }
        if op == tk_ge() {
            left = ast_binop(binop_ge(), left, right)
        }
    }
    return left
}

func parse_eq(ps: int, src: str): int {
    var left = parse_cmp(ps, src)
    while p_cur(ps) == tk_eqeq() | p_cur(ps) == tk_ne() {
        var op = p_cur(ps)
        p_advance(ps)
        var right = parse_cmp(ps, src)
        if op == tk_eqeq() {
            left = ast_binop(binop_eq(), left, right)
        }
        if op == tk_ne() {
            left = ast_binop(binop_ne(), left, right)
        }
    }
    return left
}

func parse_and(ps: int, src: str): int {
    var left = parse_eq(ps, src)
    while p_cur(ps) == tk_amp() {
        p_advance(ps)
        var right = parse_eq(ps, src)
        left = ast_binop(binop_and(), left, right)
    }
    return left
}

func parse_or(ps: int, src: str): int {
    var left = parse_and(ps, src)
    while p_cur(ps) == tk_pipe() {
        p_advance(ps)
        var right = parse_and(ps, src)
        left = ast_binop(binop_or(), left, right)
    }
    return left
}

func parse_expr(ps: int, src: str): int {
    return parse_or(ps, src)
}

// --- Statement parsing ---
// parse_block calls parse_stmt (defined later) — seed supports forward refs.

// add_implicit_void_ret: only for top-level void function bodies — not if/while/else blocks.
func parse_block(ps: int, src: str, add_implicit_void_ret: int): int {
    p_expect(ps, src, tk_lbrace())
    var stmts = int_vec_new()
    while p_cur(ps) != tk_rbrace() & p_cur(ps) != tk_eof() {
        if ps_err(ps) != 0 {
            return ast_block(stmts)
        }
        int_vec_push(stmts, parse_stmt(ps, src))
        p_skip_semi(ps)
    }
    p_expect(ps, src, tk_rbrace())
    var n = int_vec_len(stmts)
    if n > 0 & add_implicit_void_ret == 1 {
        var last = int_vec_get(stmts, n - 1)
        var last_kind = int_vec_get(last, 0)
        if last_kind != nd_return() {
            var ret = int_vec_new()
            int_vec_push(ret, nd_return())
            int_vec_push(ret, 0 - 1)
            int_vec_push(stmts, ret)
        }
    }
    return ast_block(stmts)
}

func parse_var_decl(ps: int, src: str): int {
    p_advance(ps)
    var name = p_expect(ps, src, tk_ident())
    var ty = 0 - 1
    if p_cur(ps) == tk_coloncolon() {
        p_advance(ps)
        ty = parse_type(ps, src)
    } else {
        if p_cur(ps) == tk_colon() {
            p_advance(ps)
            ty = parse_type(ps, src)
        }
    }
    var init = 0 - 1
    if p_cur(ps) == tk_eq() {
        p_advance(ps)
        init = parse_expr(ps, src)
    }
    return ast_var_decl(name, ty, init)
}

func parse_if_stmt(ps: int, src: str): int {
    p_advance(ps)
    var cond = parse_expr(ps, src)
    var then_body = parse_block(ps, src, 0)
    var else_body = 0 - 1
    if p_cur(ps) == tk_else() {
        p_advance(ps)
        if p_cur(ps) == tk_if() {
            else_body = parse_if_stmt(ps, src)
        } else {
            else_body = parse_block(ps, src, 0)
        }
    }
    return ast_if(cond, then_body, else_body)
}

func parse_while_stmt(ps: int, src: str): int {
    p_advance(ps)
    var cond = parse_expr(ps, src)
    var update = 0 - 1
    if p_cur(ps) == tk_fatarrow() {
        p_advance(ps)
        update = parse_expr(ps, src)
    }
    var body = parse_block(ps, src, 0)
    return ast_while(cond, body, update)
}

func parse_flux_stmt(ps: int, src: str): int {
    p_advance(ps)
    var vtok = p_expect(ps, src, tk_ident())
    p_expect(ps, src, tk_in())
    var iterable = parse_expr(ps, src)
    var body = parse_block(ps, src, 0)
    return ast_flux(vtok, iterable, body)
}

func parse_return_stmt(ps: int, src: str): int {
    p_advance(ps)
    if p_cur(ps) == tk_rbrace() | p_cur(ps) == tk_semi() | p_cur(ps) == tk_eof() {
        return ast_return(0 - 1)
    }
    return ast_return(parse_expr(ps, src))
}

func parse_stmt(ps: int, src: str): int {
    var kind = p_cur(ps)
    if kind == tk_var() | kind == tk_let() {
        return parse_var_decl(ps, src)
    }
    if kind == tk_if() {
        return parse_if_stmt(ps, src)
    }
    if kind == tk_while() {
        return parse_while_stmt(ps, src)
    }
    if kind == tk_flux() {
        return parse_flux_stmt(ps, src)
    }
    if kind == tk_return() {
        return parse_return_stmt(ps, src)
    }

    var expr = parse_expr(ps, src)
    if p_cur(ps) == tk_eq() {
        p_advance(ps)
        var rhs = parse_expr(ps, src)
        return ast_assign(expr, rhs)
    }
    return ast_expr_stmt(expr)
}

// --- Top-level parsing ---

func parse_params(ps: int, src: str): int {
    var params = int_vec_new()
    p_expect(ps, src, tk_lparen())
    if p_cur(ps) != tk_rparen() {
        var name = p_expect(ps, src, tk_ident())
        p_expect(ps, src, tk_colon())
        var ty = parse_type(ps, src)
        int_vec_push(params, ast_param(name, ty))
        while p_cur(ps) == tk_comma() {
            p_advance(ps)
            name = p_expect(ps, src, tk_ident())
            p_expect(ps, src, tk_colon())
            ty = parse_type(ps, src)
            int_vec_push(params, ast_param(name, ty))
        }
    }
    p_expect(ps, src, tk_rparen())
    return params
}

func parse_func_decl(ps: int, src: str): int {
    p_advance(ps)
    var name = p_expect(ps, src, tk_ident())
    var params = parse_params(ps, src)
    var ret = 0
    if p_cur(ps) == tk_colon() {
        p_advance(ps)
        ret = parse_type(ps, src)
    } else {
        ret = ast_type_name(0)
    }
    var void_body = 0
    if ret >= 0 {
        if ast_kind(ret) == nd_type_name() {
            var rn = p_text(ps, src, ast_child(ret, 0))
            if str_eq(rn, "void") == 1 {
                void_body = 1
            }
        }
    }
    var body = parse_block(ps, src, void_body)
    return ast_func(name, params, ret, body)
}

func parse_extern_decl(ps: int, src: str): int {
    p_advance(ps)
    p_expect(ps, src, tk_func())
    var name = p_expect(ps, src, tk_ident())
    var params = parse_params(ps, src)
    p_expect(ps, src, tk_colon())
    var ret = parse_type(ps, src)
    return ast_extern_func(name, params, ret)
}

func parse_class_decl(ps: int, src: str): int {
    p_advance(ps)
    var name = p_expect(ps, src, tk_ident())
    p_expect(ps, src, tk_lbrace())
    var members = int_vec_new()
    while p_cur(ps) != tk_rbrace() & p_cur(ps) != tk_eof() {
        if ps_err(ps) != 0 {
            return ast_class(name, members)
        }
        if p_cur(ps) == tk_var() {
            p_advance(ps)
            var fname = p_expect(ps, src, tk_ident())
            p_expect(ps, src, tk_colon())
            var ftype = parse_type(ps, src)
            int_vec_push(members, ast_class_field(fname, ftype))
            p_skip_semi(ps)
        } else {
            if p_cur(ps) == tk_func() {
                int_vec_push(members, parse_func_decl(ps, src))
            } else {
                if p_cur(ps) == tk_ident() {
                    var fname = p_cur(ps)
                    p_advance(ps)
                    if p_cur(ps) == tk_colon() {
                        p_advance(ps)
                        var ftype = parse_type(ps, src)
                        int_vec_push(members, ast_class_field(fname, ftype))
                        p_skip_semi(ps)
                    } else { p_skip_semi(ps) }
                } else { p_skip_semi(ps) }
            }
        }
    }
    p_expect(ps, src, tk_rbrace())
    return ast_class(name, members)
}

func parse_struct_lit(ps: int, src: str, type_tok: int): int {
    p_advance(ps)
    var fields = int_vec_new()
    if p_cur(ps) != tk_rbrace() {
        var done = 0
        while done == 0 {
            if p_cur(ps) == tk_ident() {
                var fname = p_expect(ps, src, tk_ident())
                p_expect(ps, src, tk_colon())
                var fvalue = parse_expr(ps, src)
                int_vec_push(fields, ast_field_init(fname, fvalue))
                if p_cur(ps) == tk_comma() {
                    p_advance(ps)
                    if p_cur(ps) == tk_rbrace() {
                        done = 1
                    }
                } else {
                    done = 1
                }
            } else {
                done = 1
            }
        }
    }
    p_expect(ps, src, tk_rbrace())
    return ast_obj_lit(type_tok, fields)
}

func parse_top_level(ps: int, src: str): int {
    var children = int_vec_new()
    while p_cur(ps) != tk_eof() {
        if ps_err(ps) != 0 {
            return ast_file(children)
        }
        p_skip_semi(ps)
        var kind = p_cur(ps)

        if kind == tk_import() {
            p_advance(ps)
            var stok = p_expect(ps, src, tk_str_lit())
            int_vec_push(children, ast_import(stok))
        } else {
        if kind == tk_package() {
            p_advance(ps)
            var ntok = p_expect(ps, src, tk_ident())
            int_vec_push(children, ast_package(ntok))
        } else {
        if kind == tk_func() {
            int_vec_push(children, parse_func_decl(ps, src))
        } else {
        if kind == tk_extern() {
            int_vec_push(children, parse_extern_decl(ps, src))
        } else {
        if kind == tk_class() | kind == tk_struct() {
            int_vec_push(children, parse_class_decl(ps, src))
        } else {
        if kind == tk_trait() {
            int_vec_push(children, parse_class_decl(ps, src))
        } else {
        if kind == tk_impl() {
            p_advance(ps)
            p_expect(ps, src, tk_ident())
            p_expect(ps, src, tk_ident())
            p_expect(ps, src, tk_ident())
            p_expect(ps, src, tk_lbrace())
            while p_cur(ps) != tk_rbrace() & p_cur(ps) != tk_eof() {
                if p_cur(ps) == tk_func() {
                    parse_func_decl(ps, src)
                } else {
                    p_advance(ps)
                }
            }
            p_expect(ps, src, tk_rbrace())
        } else {
        if kind == tk_var() | kind == tk_let() | kind == tk_const() {
            int_vec_push(children, parse_var_decl(ps, src))
        } else {
        if kind == tk_eof() {
            return ast_file(children)
        } else {
            if ps_quiet(ps) == 0 {
                stderr("parse error: unexpected top-level token: ")
                stderr(tk_name(kind))
                stderr("\n")
            }
            ps_set_err(ps)
        } } } } } } } } }
        p_skip_semi(ps)
    }
    return ast_file(children)
}

// --- Public entry point ---
// Returns int_vec: [ast_node, err_flag]

func parse_source(src: str, stream: int, quiet: int): int {
    var ps = ps_new(stream, quiet)
    var ast = parse_top_level(ps, src)
    var result = int_vec_new()
    int_vec_push(result, ast)
    int_vec_push(result, ps_err(ps))
    return result
}
