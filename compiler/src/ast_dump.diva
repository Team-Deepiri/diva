// Minimal AST text dump. Keeps stable strings used by tests:
// Program, Var(name: type), Ident(symbol).

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "ast.diva"
import "tokens.diva"

func dump_pad(depth: int): int {
    var i = 0
    while (i < depth) {
        print_str("  ")
        i = i + 1
    }
    return 0
}

func dump_line(depth: int, s: str, nl: str): int {
    dump_pad(depth)
    print_str(s)
    print_str(nl)
    return 0
}

func type_str(node: int, src: str, toks: int): str {
    if (node < 0) {
        return "?"
    }
    if (ast_kind(node) == nd_type_name()) {
        return tok_text(src, toks, ast_child(node, 0))
    }
    if (ast_kind(node) == nd_type_array()) {
        var b = str_builder_new()
        str_builder_append(b, type_str(ast_child(node, 0), src, toks))
        str_builder_append(b, "[]")
        var s = str_builder_to_str(b)
        str_builder_free(b)
        return s
    }
    return "?"
}

func dump_expr(node: int, depth: int, src: str, toks: int, nl: str): int {
    if (node < 0) {
        return 0
    }
    var k = ast_kind(node)
    if (k == nd_ident()) {
        var b = str_builder_new()
        str_builder_append(b, "Ident(")
        str_builder_append(b, tok_text(src, toks, ast_child(node, 0)))
        str_builder_append(b, ")")
        dump_line(depth, str_builder_to_str(b), nl)
        str_builder_free(b)
        return 0
    }
    if (k == nd_call()) {
        dump_line(depth, "Call", nl)
        dump_expr(ast_child(node, 0), depth + 1, src, toks, nl)
        var args = ast_child(node, 1)
        var i = 0
        while (i < int_vec_len(args)) {
            dump_expr(int_vec_get(args, i), depth + 1, src, toks, nl)
            i = i + 1
        }
        return 0
    }
    if (k == nd_generic_call()) {
        dump_line(depth, "GenericCall", nl)
        dump_expr(ast_child(node, 0), depth + 1, src, toks, nl)
        var targs = ast_child(node, 1)
        var ti = 0
        while (ti < int_vec_len(targs)) {
            dump_line(depth + 1, tok_text(src, toks, int_vec_get(targs, ti)), nl)
            ti = ti + 1
        }
        var args2 = ast_child(node, 2)
        var i2 = 0
        while (i2 < int_vec_len(args2)) {
            dump_expr(int_vec_get(args2, i2), depth + 1, src, toks, nl)
            i2 = i2 + 1
        }
        return 0
    }
    return 0
}

func dump_stmt(node: int, depth: int, src: str, toks: int, nl: str): int {
    if (node < 0) {
        return 0
    }
    var k = ast_kind(node)
    if (k == nd_var_decl()) {
        var name = tok_text(src, toks, ast_child(node, 0))
        var ty = type_str(ast_child(node, 1), src, toks)
        var b = str_builder_new()
        str_builder_append(b, "Var(")
        str_builder_append(b, name)
        str_builder_append(b, ": ")
        str_builder_append(b, ty)
        str_builder_append(b, ")")
        dump_line(depth, str_builder_to_str(b), nl)
        str_builder_free(b)
        dump_expr(ast_child(node, 2), depth + 1, src, toks, nl)
        return 0
    }
    if (k == nd_expr_stmt()) {
        dump_expr(ast_child(node, 0), depth, src, toks, nl)
        return 0
    }
    if (k == nd_return()) {
        dump_expr(ast_child(node, 0), depth, src, toks, nl)
        return 0
    }
    if (k == nd_block()) {
        var stmts = ast_child(node, 0)
        var i = 0
        while (i < int_vec_len(stmts)) {
            dump_stmt(int_vec_get(stmts, i), depth, src, toks, nl)
            i = i + 1
        }
        return 0
    }
    return 0
}

func dump_top(node: int, src: str, toks: int, nl: str): int {
    if (ast_kind(node) == nd_func()) {
        dump_stmt(ast_child(node, 3), 1, src, toks, nl)
    }
    return 0
}

func ast_dump_program(path: str, src: str, toks: int, file_node: int, nl: str): int {
    var b = str_builder_new()
    str_builder_append(b, "Program source=")
    str_builder_append(b, path)
    print_str(str_builder_to_str(b))
    str_builder_free(b)
    print_str(nl)

    var ch = ast_child(file_node, 0)
    var i = 0
    while (i < int_vec_len(ch)) {
        dump_top(int_vec_get(ch, i), src, toks, nl)
        i = i + 1
    }
    return 0
}
