// AST → Diva IR lowering.
// Walks the AST produced by the parser and emits Diva IR instructions.

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "tokens.diva"
import "ast.diva"
import "ir.diva"

// --- Builder state ---

var ib_src     = ""
var ib_toks    = 0
var ib_mod     = 0
var ib_func    = 0
var ib_blk     = 0
var ib_vreg    = 0
var ib_label   = 0
var ib_names   = 0
var ib_slots   = 0
var ib_str_vec = 0

func ib_init(src: str, toks: int): int {
    ib_src     = src
    ib_toks    = toks
    ib_mod     = ir_module_new()
    ib_vreg    = 0
    ib_label   = 0
    ib_names   = int_vec_new()
    ib_slots   = int_vec_new()
    ib_str_vec = int_vec_new()
    return 0
}

func ib_fresh_vreg(): int {
    var r = ib_vreg
    ib_vreg = ib_vreg + 1
    return r
}

func ib_fresh_label(): int {
    var l = ib_label
    ib_label = ib_label + 1
    return l
}

func ib_emit(inst: int): int {
    block_append(ib_blk, inst)
    return 0
}

func ib_new_block(): int {
    var l = ib_fresh_label()
    var blk = ir_block_new(l)
    func_add_block(ib_func, blk)
    ib_blk = blk
    return blk
}

func ib_tok_text(tok_idx: int): str {
    return tok_text(ib_src, ib_toks, tok_idx)
}

// --- Local variable name → slot mapping ---
// Parallel int_vecs: ib_names stores string hashes, ib_slots stores vreg/slot ids.

func ib_name_hash(name: str): int {
    var h = 5381
    var n = str_len(name)
    var i = 0
    while i < n {
        h = h * 33 + str_byte(name, i)
        i = i + 1
    }
    if h < 0 { h = 0 - h }
    return h
}

func ib_scope_push(): int { return int_vec_len(ib_names) }

func ib_scope_pop(mark: int): int {
    while int_vec_len(ib_names) > mark {
        var fresh_n = int_vec_new()
        var fresh_s = int_vec_new()
        var i = 0
        while i < mark {
            int_vec_push(fresh_n, int_vec_get(ib_names, i))
            int_vec_push(fresh_s, int_vec_get(ib_slots, i))
            i = i + 1
        }
        int_vec_free(ib_names)
        int_vec_free(ib_slots)
        ib_names = fresh_n
        ib_slots = fresh_s
        return 0
    }
    return 0
}

func ib_define_local(name: str): int {
    var slot = ib_fresh_vreg()
    int_vec_push(ib_names, ib_name_hash(name))
    int_vec_push(ib_slots, slot)
    return slot
}

func ib_lookup_local(name: str): int {
    var h = ib_name_hash(name)
    var n = int_vec_len(ib_names)
    var i = n - 1
    while i >= 0 {
        if int_vec_get(ib_names, i) == h {
            return int_vec_get(ib_slots, i)
        }
        i = i - 1
    }
    return 0 - 1
}

// --- Expression lowering ---

func lower_expr(node: int): int {
    var kind = ast_kind(node)

    if kind == nd_int_lit() {
        var val = ast_child(node, 0)
        var r = ib_fresh_vreg()
        ib_emit(ir_inst(ir_const(), r, val, 0, 0))
        return r
    }

    if kind == nd_bool_lit() {
        var val = ast_child(node, 0)
        var r = ib_fresh_vreg()
        ib_emit(ir_inst(ir_const(), r, val, 0, 0))
        return r
    }

    if kind == nd_str_lit() {
        var tok_idx = ast_child(node, 0)
        var s = ib_tok_text(tok_idx)
        var str_id = int_vec_len(ib_str_vec)
        int_vec_push(ib_str_vec, tok_idx)
        var r = ib_fresh_vreg()
        ib_emit(ir_inst(ir_const_str(), r, str_id, 0, 0))
        return r
    }

    if kind == nd_ident() {
        var tok_idx = ast_child(node, 0)
        var name = ib_tok_text(tok_idx)
        var slot = ib_lookup_local(name)
        if slot < 0 {
            var r = ib_fresh_vreg()
            ib_emit(ir_inst(ir_const(), r, 0, 0, 0))
            return r
        }
        var r = ib_fresh_vreg()
        ib_emit(ir_inst(ir_load(), r, slot, 0, 0))
        return r
    }

    if kind == nd_binop() {
        var op = ast_child(node, 0)
        var left = lower_expr(ast_child(node, 1))
        var right = lower_expr(ast_child(node, 2))
        var r = ib_fresh_vreg()
        var irop = ir_nop()
        if op == binop_add() { irop = ir_add() }
        if op == binop_sub() { irop = ir_sub() }
        if op == binop_mul() { irop = ir_mul() }
        if op == binop_div() { irop = ir_div() }
        if op == binop_mod() { irop = ir_mod() }
        if op == binop_eq()  { irop = ir_eq() }
        if op == binop_ne()  { irop = ir_ne() }
        if op == binop_lt()  { irop = ir_lt() }
        if op == binop_le()  { irop = ir_le() }
        if op == binop_gt()  { irop = ir_gt() }
        if op == binop_ge()  { irop = ir_ge() }
        if op == binop_and() { irop = ir_and() }
        if op == binop_or()  { irop = ir_or() }
        ib_emit(ir_inst(irop, r, left, right, 0))
        return r
    }

    if kind == nd_unary() {
        var op = ast_child(node, 0)
        var operand = lower_expr(ast_child(node, 1))
        var r = ib_fresh_vreg()
        if op == unop_neg() {
            ib_emit(ir_inst(ir_neg(), r, operand, 0, 0))
        } else {
            ib_emit(ir_inst(ir_not(), r, operand, 0, 0))
        }
        return r
    }

    if kind == nd_call() {
        var callee = ast_child(node, 0)
        var args_h = ast_child(node, 1)
        var argc = int_vec_len(args_h)
        var arg_regs = int_vec_new()
        var i = 0
        while i < argc {
            int_vec_push(arg_regs, lower_expr(int_vec_get(args_h, i)))
            i = i + 1
        }
        var callee_kind = ast_kind(callee)
        var fname_idx = 0
        if callee_kind == nd_ident() {
            fname_idx = ast_child(callee, 0)
        }
        var r = ib_fresh_vreg()
        ib_emit(ir_inst(ir_call(), r, fname_idx, argc, arg_regs))
        int_vec_free(arg_regs)
        return r
    }

    if kind == nd_method_call() {
        var obj_reg = lower_expr(ast_child(node, 0))
        var method_tok = ast_child(node, 1)
        var args_h = ast_child(node, 2)
        var argc = int_vec_len(args_h)
        var r = ib_fresh_vreg()
        ib_emit(ir_inst(ir_call(), r, method_tok, argc + 1, obj_reg))
        return r
    }

    // Fallback: return 0
    var r = ib_fresh_vreg()
    ib_emit(ir_inst(ir_const(), r, 0, 0, 0))
    return r
}

// --- Statement lowering ---

func lower_stmt(node: int): int {
    var kind = ast_kind(node)

    if kind == nd_var_decl() {
        var name_tok = ast_child(node, 0)
        var init = ast_child(node, 2)
        var name = ib_tok_text(name_tok)
        var slot = ib_define_local(name)
        ib_emit(ir_inst(ir_alloca(), slot, 0, 0, 0))
        if init >= 0 {
            var val = lower_expr(init)
            ib_emit(ir_inst(ir_store(), slot, val, 0, 0))
        }
        return 0
    }

    if kind == nd_assign() {
        var target = ast_child(node, 0)
        var value = ast_child(node, 1)
        var val = lower_expr(value)
        var tk = ast_kind(target)
        if tk == nd_ident() {
            var name = ib_tok_text(ast_child(target, 0))
            var slot = ib_lookup_local(name)
            if slot >= 0 {
                ib_emit(ir_inst(ir_store(), slot, val, 0, 0))
            }
        }
        return 0
    }

    if kind == nd_return() {
        var expr = ast_child(node, 0)
        if expr < 0 {
            ib_emit(ir_inst(ir_ret_void(), 0, 0, 0, 0))
        } else {
            var val = lower_expr(expr)
            ib_emit(ir_inst(ir_ret(), 0, val, 0, 0))
        }
        return 0
    }

    if kind == nd_if() {
        var cond_reg = lower_expr(ast_child(node, 0))
        var then_lbl = ib_fresh_label()
        var else_lbl = ib_fresh_label()
        var end_lbl  = ib_fresh_label()
        var has_else = ast_child(node, 2)

        if has_else < 0 {
            ib_emit(ir_inst(ir_br_cond(), cond_reg, then_lbl, end_lbl, 0))
        } else {
            ib_emit(ir_inst(ir_br_cond(), cond_reg, then_lbl, else_lbl, 0))
        }

        // Then block
        var then_blk = ir_block_new(then_lbl)
        func_add_block(ib_func, then_blk)
        ib_blk = then_blk
        lower_block(ast_child(node, 1))
        ib_emit(ir_inst(ir_br(), 0, end_lbl, 0, 0))

        // Else block
        if has_else >= 0 {
            var else_blk = ir_block_new(else_lbl)
            func_add_block(ib_func, else_blk)
            ib_blk = else_blk
            lower_block(has_else)
            ib_emit(ir_inst(ir_br(), 0, end_lbl, 0, 0))
        }

        // End block
        var end_blk = ir_block_new(end_lbl)
        func_add_block(ib_func, end_blk)
        ib_blk = end_blk
        return 0
    }

    if kind == nd_while() {
        var cond_lbl = ib_fresh_label()
        var body_lbl = ib_fresh_label()
        var end_lbl  = ib_fresh_label()

        ib_emit(ir_inst(ir_br(), 0, cond_lbl, 0, 0))

        // Condition block
        var cond_blk = ir_block_new(cond_lbl)
        func_add_block(ib_func, cond_blk)
        ib_blk = cond_blk
        var cond_reg = lower_expr(ast_child(node, 0))
        ib_emit(ir_inst(ir_br_cond(), cond_reg, body_lbl, end_lbl, 0))

        // Body block
        var body_blk_node = ir_block_new(body_lbl)
        func_add_block(ib_func, body_blk_node)
        ib_blk = body_blk_node
        lower_block(ast_child(node, 1))
        // Update expression if present
        var update = ast_child(node, 2)
        if update >= 0 {
            lower_expr(update)
        }
        ib_emit(ir_inst(ir_br(), 0, cond_lbl, 0, 0))

        // End block
        var end_blk = ir_block_new(end_lbl)
        func_add_block(ib_func, end_blk)
        ib_blk = end_blk
        return 0
    }

    if kind == nd_expr_stmt() {
        lower_expr(ast_child(node, 0))
        return 0
    }

    if kind == nd_block() {
        lower_block(node)
        return 0
    }

    return 0
}

func lower_block(node: int): int {
    if node < 0 { return 0 }
    var kind = ast_kind(node)
    if kind == nd_block() {
        var stmts = ast_child(node, 0)
        var n = int_vec_len(stmts)
        var scope = ib_scope_push()
        var i = 0
        while i < n {
            lower_stmt(int_vec_get(stmts, i))
            i = i + 1
        }
        ib_scope_pop(scope)
    } else {
        lower_stmt(node)
    }
    return 0
}

// --- Function lowering ---

func lower_func(node: int): int {
    var name_tok = ast_child(node, 0)
    var params_h = ast_child(node, 1)
    var ret_type = ast_child(node, 2)
    var body     = ast_child(node, 3)

    var fname = ib_tok_text(name_tok)
    var name_idx = strtab_add(fname)
    var pcount = int_vec_len(params_h)

    var ret_ty = ir_ty_int()
    if ret_type >= 0 {
        var rtk = ast_kind(ret_type)
        if rtk == nd_type_name() {
            var tname = ib_tok_text(ast_child(ret_type, 0))
            if str_eq(tname, "void") == 1 { ret_ty = ir_ty_void() }
            if str_eq(tname, "str") == 1  { ret_ty = ir_ty_str() }
            if str_eq(tname, "bool") == 1 { ret_ty = ir_ty_bool() }
        }
    }

    ib_func = ir_func_new(name_idx, pcount, ret_ty)
    ib_vreg = 0
    ib_label = 0

    var scope = ib_scope_push()

    // Entry block
    ib_blk = ir_block_new(ib_fresh_label())
    func_add_block(ib_func, ib_blk)

    // Parameters
    var i = 0
    while i < pcount {
        var p = int_vec_get(params_h, i)
        var pname = ib_tok_text(ast_child(p, 0))
        var slot = ib_define_local(pname)
        ib_emit(ir_inst(ir_param(), slot, i, 0, 0))
        i = i + 1
    }

    // Body
    lower_block(body)

    ib_scope_pop(scope)
    mod_add_func(ib_mod, ib_func)
    return 0
}

func lower_extern(node: int): int {
    var name_tok = ast_child(node, 0)
    var fname = ib_tok_text(name_tok)
    var name_idx = strtab_add(fname)
    mod_add_extern(ib_mod, name_idx)
    return 0
}

// --- File lowering ---

func lower_file(file_node: int): int {
    var children = ast_child(file_node, 0)
    var n = int_vec_len(children)
    var i = 0
    while i < n {
        var child = int_vec_get(children, i)
        var kind = ast_kind(child)
        if kind == nd_func() {
            lower_func(child)
        }
        if kind == nd_extern_func() {
            lower_extern(child)
        }
        i = i + 1
    }
    return ib_mod
}

// --- Public entry point ---

func build_ir(src: str, toks: int, file_node: int): int {
    strtab_init()
    ib_init(src, toks)
    return lower_file(file_node)
}
