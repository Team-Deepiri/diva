// AST -> Diva IR lowering.
// Walks the AST produced by the parser and emits Diva IR instructions.
// All mutable state uses the cell pattern (cell.diva) to avoid module-level var.

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "std/str.diva"
import "tokens.diva"
import "ast.diva"
import "ir.diva"
import "cell.diva"
import "name_pool.diva"

func ib_trace_on(): int {
    var v = host_getenv("DIVA_IR_TRACE")
    var v_hold = v
    if str_eq(v_hold, "1") == 1 { return 1 }
    return 0
}

func ib_trace(ctx: int, msg: str): int {
    if (ib_trace_on() == 0) { return 0 }
    var b = str_builder_new()
    str_builder_append(b, "[ir-trace] ")
    str_builder_append(b, msg)
    str_builder_append(b, " blk=")
    str_builder_append(b, int_to_str(bctx_blk(ctx)))
    str_builder_append(b, " lbl_next=")
    str_builder_append(b, int_to_str(bctx_label(ctx)))
    stderr(str_builder_to_str(b))
    stderr(char_to_str(10))
    str_builder_free(b)
    return 0
}

func ib_set_blk(ctx: int, blk: int): int {
    if (ib_trace_on() == 1) {
        stderr("[ir-trace] set-blk -> ")
        stderr(int_to_str(blk))
        stderr(char_to_str(10))
    }
    if (blk < 0) {
        stderr("ir-builder error: invalid block handle in set-blk")
        stderr(" blk=")
        stderr(int_to_str(blk))
        stderr(char_to_str(10))
    }
    return bctx_set_blk(ctx, blk)
}

func ib_add_blk(ctx: int, blk: int): int {
    if (ib_trace_on() == 1) {
        stderr("[ir-trace] add-blk handle=")
        stderr(int_to_str(blk))
        stderr(" label=")
        if blk < 0 {
            stderr("-1")
        } else {
            stderr(int_to_str(block_label(blk)))
        }
        stderr(char_to_str(10))
    }
    if (blk < 0) {
        stderr("ir-builder error: invalid block handle in add-blk")
        stderr(char_to_str(10))
        return 1
    }
    func_add_block(bctx_func(ctx), blk)
    return 0
}

func ib_find_blk_by_label(ctx: int, label: int): int {
    var f = bctx_func(ctx)
    var bc = func_block_count(f)
    var bi = 0
    while (bi < bc) {
        var blk = func_get_block(f, bi)
        if (block_label(blk) == label) {
            return blk
        }
        bi = bi + 1
    }
    return 0 - 1
}

// --- Builder context ---
// ctx = int_vec:
//   [0] = mod handle (direct)
//   [1] = func_cell (current function)
//   [2] = blk_cell  (current basic block)
//   [3] = vreg_cell (virtual register counter)
//   [4] = label_cell (label counter)
//   [5] = names_cell (def-site lexer token index per binding; parallel to slots)
//   [6] = slots_cell (local slot ids vec handle)
//   [7] = array_lens_cell (parallel: 1 = scalar, N = int[] length)
//   [8] = str_vec (int_vec of string literal token indices)
//   [9] = toks handle (direct)
//   [10] = strtab_cell (string table counter)
//   [11] = global_names_cell (global var name hashes)
//   [12] = global_vals_cell (global var init values)
//   [13] = file_ast_cell (root AST handle for struct layout lookup)
//   [14] = struct_ty_cell (int_vec parallel to names: type_name_tok or -1)
//   [15] = array_strides_cell (0 = not an array; 1 = scalar elems; W = struct-elem stride)
//   [16] = text_vregs_cell (vregs known to hold text)
//   [17] = enum_ty_cell (int_vec parallel to names: enum name tok or -1)

func bctx_new(src: str, toks: int): int {
    var ctx = int_vec_new()
    var mod = ir_module_new()
    mod_set_name_pool(mod, name_pool_new())
    int_vec_push(ctx, mod)                   // [0] mod
    int_vec_push(ctx, mut_new(0))            // [1] func_cell
    int_vec_push(ctx, mut_new(0))            // [2] blk_cell
    int_vec_push(ctx, mut_new(0))            // [3] vreg_cell
    int_vec_push(ctx, mut_new(0))            // [4] label_cell
    int_vec_push(ctx, mut_new(int_vec_new())) // [5] names_cell
    int_vec_push(ctx, mut_new(int_vec_new())) // [6] slots_cell
    int_vec_push(ctx, mut_new(int_vec_new())) // [7] array_lens_cell (parallel to names/slots; 1 = scalar)
    int_vec_push(ctx, int_vec_new())          // [8] str_vec
    int_vec_push(ctx, toks)                   // [9] toks
    int_vec_push(ctx, mut_new(0))            // [10] strtab_cell
    int_vec_push(ctx, mut_new(int_vec_new())) // [11] global_names_cell
    int_vec_push(ctx, mut_new(int_vec_new())) // [12] global_vals_cell
    int_vec_push(ctx, mut_new(0))            // [13] file_ast handle
    int_vec_push(ctx, mut_new(int_vec_new())) // [14] struct type name tok per local (-1 = not struct)
    int_vec_push(ctx, mut_new(int_vec_new())) // [15] array strides (0 = non-array)
    int_vec_push(ctx, mut_new(int_vec_new())) // [16] text_vregs (vregs known to hold text)
    int_vec_push(ctx, mut_new(int_vec_new())) // [17] enum type name tok per local (-1 = not an enum)
    return ctx
}

func bctx_mod(ctx: int): int     { return int_vec_get(ctx, 0) }
func bctx_func(ctx: int): int    { return mut_get(int_vec_get(ctx, 1)) }
func bctx_blk(ctx: int): int     { return mut_get(int_vec_get(ctx, 2)) }
func bctx_vreg(ctx: int): int    { return mut_get(int_vec_get(ctx, 3)) }
func bctx_label(ctx: int): int   { return mut_get(int_vec_get(ctx, 4)) }
func bctx_names(ctx: int): int   { return mut_get(int_vec_get(ctx, 5)) }
func bctx_slots(ctx: int): int   { return mut_get(int_vec_get(ctx, 6)) }
func bctx_array_lens(ctx: int): int { return mut_get(int_vec_get(ctx, 7)) }
func bctx_str_vec(ctx: int): int { return int_vec_get(ctx, 8) }
func bctx_toks(ctx: int): int    { return int_vec_get(ctx, 9) }
func bctx_strtab(ctx: int): int  { return mut_get(int_vec_get(ctx, 10)) }

func bctx_set_func(ctx: int, v: int): int  { return mut_set(int_vec_get(ctx, 1), v) }
func bctx_set_blk(ctx: int, v: int): int   { return mut_set(int_vec_get(ctx, 2), v) }
func bctx_set_vreg(ctx: int, v: int): int  { return mut_set(int_vec_get(ctx, 3), v) }
func bctx_set_label(ctx: int, v: int): int { return mut_set(int_vec_get(ctx, 4), v) }
func bctx_set_names(ctx: int, v: int): int { return mut_set(int_vec_get(ctx, 5), v) }
func bctx_set_slots(ctx: int, v: int): int { return mut_set(int_vec_get(ctx, 6), v) }
func bctx_set_array_lens(ctx: int, v: int): int { return mut_set(int_vec_get(ctx, 7), v) }
func bctx_global_names(ctx: int): int { return mut_get(int_vec_get(ctx, 11)) }
func bctx_global_vals(ctx: int): int  { return mut_get(int_vec_get(ctx, 12)) }
func bctx_set_global_vals(ctx: int, v: int): int { return mut_set(int_vec_get(ctx, 12), v) }

func bctx_struct_ty(ctx: int): int {
    return mut_get(int_vec_get(ctx, 14))
}
func bctx_array_strides(ctx: int): int {
    return mut_get(int_vec_get(ctx, 15))
}
func bctx_set_array_strides(ctx: int, v: int): int {
    return mut_set(int_vec_get(ctx, 15), v)
}

func bctx_text_vregs(ctx: int): int {
    return mut_get(int_vec_get(ctx, 16))
}

func bctx_set_text_vregs(ctx: int, v: int): int {
    return mut_set(int_vec_get(ctx, 16), v)
}

// Enum type name token per local binding (-1 = not an enum local).
func bctx_enum_ty(ctx: int): int {
    return mut_get(int_vec_get(ctx, 17))
}

func bctx_set_enum_ty(ctx: int, v: int): int {
    return mut_set(int_vec_get(ctx, 17), v)
}

// Mark a vreg as holding a `text` value (for type-directed operator lowering).
func ib_mark_text(ctx: int, vreg: int): int {
    int_vec_push(bctx_text_vregs(ctx), vreg)
    return 0
}

func ib_vreg_is_text(ctx: int, vreg: int): int {
    var v = bctx_text_vregs(ctx)
    var i = 0
    while (i < int_vec_len(v)) {
        if int_vec_get(v, i) == vreg { return 1 }
        i = i + 1
    }
    return 0
}

func ib_strtab_add(ctx: int, s: str): int {
    var idx = bctx_strtab(ctx)
    mut_set(int_vec_get(ctx, 10), idx + 1)
    return idx
}

// --- Helper functions ---

func ib_fresh_vreg(ctx: int): int {
    var r = bctx_vreg(ctx)
    bctx_set_vreg(ctx, r + 1)
    return r
}

func ib_fresh_label(ctx: int): int {
    var l = bctx_label(ctx)
    bctx_set_label(ctx, l + 1)
    return l
}

func ib_emit(ctx: int, inst: int): int {
    if (bctx_blk(ctx) < 0) {
        stderr("ir-builder error: emit into invalid current block\n")
        return 1
    }
    block_append(bctx_blk(ctx), inst)
    return 0
}

func ib_new_block(ctx: int): int {
    var l = ib_fresh_label(ctx)
    var blk = ir_block_new(l)
    ib_add_blk(ctx, blk)
    ib_set_blk(ctx, blk)
    return blk
}

func ib_tok_text(ctx: int, src: str, tok_idx: int): str {
    return tok_text(src, bctx_toks(ctx), tok_idx)
}

// --- Enum helpers (Issue #93) ---
//
// Phase 1 `Option`/`Result` values are lowered as int tags: unit variants map
// to their declaration index (None/Ok = 0, Some/Err = 1), so `.tag`,
// `is_none`/`is_some`, and `o == None` all work through plain int compares.
// Payloads are not carried at runtime yet (see docs/language-spec.md).

// Look up a variant by name across all enum decls in the merged AST.
// Returns the nd_variant node, or -1 when the name is not an enum variant.
func ib_enum_variant(ctx: int, src: str, name: str): int {
    var root = mut_get(int_vec_get(ctx, 13))
    if root == 0 { return 0 - 1 }
    var kids = ast_child(root, 0)
    var i = 0
    while (i < int_vec_len(kids)) {
        var decl = int_vec_get(kids, i)
        if ast_kind(decl) == nd_enum() {
            var variants = ast_child(decl, 1)
            var vi = 0
            while (vi < int_vec_len(variants)) {
                var v = int_vec_get(variants, vi)
                if str_eq(ib_tok_text(ctx, src, ast_child(v, 0)), name) == 1 {
                    return v
                }
                vi = vi + 1
            }
        }
        i = i + 1
    }
    return 0 - 1
}

// Raw token index of an identifier spelling, or -1.
func ib_ident_token(ctx: int, src: str, name: str): int {
    var toks = bctx_toks(ctx)
    var i = 0
    var n = tok_count(toks)
    while (i < n) {
        if tok_kind(toks, i) == tk_ident() {
            if str_eq(tok_text(src, toks, i), name) == 1 {
                return i
            }
        }
        i = i + 1
    }
    return 0 - 1
}

func ib_enum_decl_for_type(ctx: int, src: str, name: str): int {
    var root = mut_get(int_vec_get(ctx, 13))
    if root == 0 { return 0 - 1 }
    var kids = ast_child(root, 0)
    var i = 0
    while (i < int_vec_len(kids)) {
        var decl = int_vec_get(kids, i)
        if ast_kind(decl) == nd_enum() {
            if str_eq(ib_tok_text(ctx, src, ast_child(decl, 0)), name) == 1 {
                return decl
            }
        }
        i = i + 1
    }
    return 0 - 1
}

// Mint a synthetic token that spells `name` (enum constructors reuse the
// callee spelling as a func-name token for the IR call instruction).
func ib_name_token(ctx: int, name: str): int {
    var pool = mod_name_pool(bctx_mod(ctx))
    return name_pool_intern(pool, name)
}

// Lower an enum constructor `Some(9)` / `None`: Phase 1 materializes the tag
// only, so this evaluates to the variant's declaration index (an int vreg).
func ib_lower_variant_ctor(ctx: int, src: str, name: str): int {
    var v = ib_enum_variant(ctx, src, name)
    if v < 0 {
        var rz = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_const(), rz, 0, 0, 0))
        return rz
    }
    var tag = ast_child(v, 2)
    var rt = ib_fresh_vreg(ctx)
    ib_emit(ctx, ir_inst(ir_const(), rt, tag, 0, 0))
    return rt
}

// Slot count of an enum value: 1 for unit-only enums, 2 when the enum
// declares a payload variant (tag slot + payload slot).
func ib_enum_width(ctx: int, src: str, enum_name: str): int {
    var decl = ib_enum_decl_for_type(ctx, src, enum_name)
    if decl < 0 { return 1 }
    var variants = ast_child(decl, 1)
    var i = 0
    while (i < int_vec_len(variants)) {
        if ast_child(int_vec_get(variants, i), 1) >= 0 { return 2 }
        i = i + 1
    }
    return 1
}

// The nd_variant node named |vname| inside |decl|, or -1.
func ib_enum_variant_in_decl(ctx: int, src: str, decl: int, vname: str): int {
    if decl < 0 { return 0 - 1 }
    var variants = ast_child(decl, 1)
    var i = 0
    while (i < int_vec_len(variants)) {
        var v = int_vec_get(variants, i)
        if str_eq(ib_tok_text(ctx, src, ast_child(v, 0)), vname) == 1 {
            return v
        }
        i = i + 1
    }
    return 0 - 1
}

// The enum declaration owning variant node |vnode|, or -1.
func ib_enum_decl_for_variant(ctx: int, src: str, vnode: int): int {
    if vnode < 0 { return 0 - 1 }
    var root = mut_get(int_vec_get(ctx, 13))
    if root == 0 { return 0 - 1 }
    var kids = ast_child(root, 0)
    var i = 0
    while (i < int_vec_len(kids)) {
        var decl = int_vec_get(kids, i)
        if ast_kind(decl) == nd_enum() {
            var variants = ast_child(decl, 1)
            var vi = 0
            while (vi < int_vec_len(variants)) {
                if int_vec_get(variants, vi) == vnode { return decl }
                vi = vi + 1
            }
        }
        i = i + 1
    }
    return 0 - 1
}

// Variant name constructed by a bare variant expression (`None`, `Some(9)`),
// or "" when the expression is not a bare variant construction. Locals and
// globals shadow variant names, so they are not variant constructions.
func ib_bare_variant_name(ctx: int, src: str, node: int): str {
    if node < 0 { return "" }
    var kind = ast_kind(node)
    if kind == nd_ident() {
        var itok = ast_child(node, 0)
        if ib_lookup_by_name_tok(ctx, src, itok) >= 0 { return "" }
        if ib_find_global_index(ctx, src, itok) >= 0 { return "" }
        return ib_tok_text(ctx, src, itok)
    }
    if kind == nd_call() {
        var callee = ast_child(node, 0)
        if ast_kind(callee) != nd_ident() { return "" }
        var ctok = ast_child(callee, 0)
        if ib_lookup_by_name_tok(ctx, src, ctok) >= 0 { return "" }
        if ib_find_global_index(ctx, src, ctok) >= 0 { return "" }
        return ib_tok_text(ctx, src, ctok)
    }
    return ""
}

// The name spelled by an identifier expression (`x`, `f(x)`), or "" when the
// expression is not an identifier.
func ib_expr_ident_name(ctx: int, src: str, node: int): str {
    if node < 0 { return "" }
    var kind = ast_kind(node)
    if kind == nd_ident() {
        return ib_tok_text(ctx, src, ast_child(node, 0))
    }
    if kind == nd_call() {
        var callee = ast_child(node, 0)
        if ast_kind(callee) != nd_ident() { return "" }
        return ib_tok_text(ctx, src, ast_child(callee, 0))
    }
    return ""
}

// The nd_variant node constructed by |node| (`Enum::Variant`, `Variant` or
// `Variant(payload)`), or -1 when the expression is not a variant
// construction.
func ib_variant_ctor_node(ctx: int, src: str, node: int): int {
    if node < 0 { return 0 - 1 }
    if ast_kind(node) == nd_qualified_variant() {
        var ename = ib_tok_text(ctx, src, ast_child(node, 0))
        var vname = ib_tok_text(ctx, src, ast_child(node, 1))
        var decl = ib_enum_decl_for_type(ctx, src, ename)
        if decl < 0 { return 0 - 1 }
        return ib_enum_variant_in_decl(ctx, src, decl, vname)
    }
    var bname = ib_bare_variant_name(ctx, src, node)
    if bname == "" { return 0 - 1 }
    return ib_enum_variant(ctx, src, bname)
}

// The payload expression of a variant construction, or -1 when the variant
// is written without a payload.
func ib_variant_ctor_payload(ctx: int, src: str, node: int): int {
    if node < 0 { return 0 - 1 }
    var kind = ast_kind(node)
    if kind == nd_qualified_variant() {
        var args = ast_child(node, 2)
        if int_vec_len(args) > 0 { return int_vec_get(args, 0) }
        return 0 - 1
    }
    if kind == nd_call() {
        var cargs = ast_child(node, 1)
        if int_vec_len(cargs) > 0 { return int_vec_get(cargs, 0) }
        return 0 - 1
    }
    return 0 - 1
}

// --- Local variable name -> slot mapping ---

func ib_name_hash(name: str): int {
    var h = 5381
    var n = str_len(name)
    var i = 0
    while (i < n) {
        h = h * 33 + str_byte(name, i)
        i = i + 1
    }
    if (h < 0) { h = 0 - h }
    return h
}

func ib_scope_push(ctx: int): int { return int_vec_len(bctx_names(ctx)) }

func ib_scope_pop(ctx: int, mark: int): int {
    var names = bctx_names(ctx)
    var slots = bctx_slots(ctx)
    var lens = bctx_array_lens(ctx)
    var sty = bctx_struct_ty(ctx)
    var strides = bctx_array_strides(ctx)
    var ety = bctx_enum_ty(ctx)
    if (int_vec_len(names) > mark) {
        var fresh_n = int_vec_new()
        var fresh_s = int_vec_new()
        var fresh_l = int_vec_new()
        var fresh_sty = int_vec_new()
        var fresh_st = int_vec_new()
        var fresh_ety = int_vec_new()
        var i = 0
        while (i < mark) {
            int_vec_push(fresh_n, int_vec_get(names, i))
            int_vec_push(fresh_s, int_vec_get(slots, i))
            int_vec_push(fresh_l, int_vec_get(lens, i))
            int_vec_push(fresh_sty, int_vec_get(sty, i))
            int_vec_push(fresh_st, int_vec_get(strides, i))
            int_vec_push(fresh_ety, int_vec_get(ety, i))
            i = i + 1
        }
        int_vec_free(names)
        int_vec_free(slots)
        int_vec_free(lens)
        int_vec_free(sty)
        int_vec_free(strides)
        int_vec_free(ety)
        bctx_set_names(ctx, fresh_n)
        bctx_set_slots(ctx, fresh_s)
        bctx_set_array_lens(ctx, fresh_l)
        mut_set(int_vec_get(ctx, 14), fresh_sty)
        bctx_set_array_strides(ctx, fresh_st)
        bctx_set_enum_ty(ctx, fresh_ety)
    }
    return 0
}

func ib_struct_ty_none(): int {
    return 0 - 1
}

func ib_enum_ty_none(): int {
    return 0 - 1
}

func ib_define_local(ctx: int, def_name_tok: int): int {
    var slot = ib_fresh_vreg(ctx)
    int_vec_push(bctx_names(ctx), def_name_tok)
    int_vec_push(bctx_slots(ctx), slot)
    int_vec_push(bctx_array_lens(ctx), 1)
    int_vec_push(bctx_struct_ty(ctx), ib_struct_ty_none())
    int_vec_push(bctx_array_strides(ctx), 0)
    int_vec_push(bctx_enum_ty(ctx), ib_enum_ty_none())
    return slot
}

// Enum local: tag slot at |base| and payload slot at |base+1| (payload enums
// only). |width| is 1 for unit-only enums, 2 when the enum declares a
// payload variant.
func ib_define_enum_local(ctx: int, def_name_tok: int, enum_name_tok: int, width: int): int {
    var base = ib_fresh_vreg(ctx)
    var j = 1
    while (j < width) {
        ib_fresh_vreg(ctx)
        j = j + 1
    }
    int_vec_push(bctx_names(ctx), def_name_tok)
    int_vec_push(bctx_slots(ctx), base)
    int_vec_push(bctx_array_lens(ctx), width)
    int_vec_push(bctx_struct_ty(ctx), ib_struct_ty_none())
    int_vec_push(bctx_array_strides(ctx), 0)
    int_vec_push(bctx_enum_ty(ctx), enum_name_tok)
    return base
}

// Reserve n*stride consecutive vregs. |n| = element count; |stride| slots per element
// (1 for int/bool/str; struct width for Point[]). |elem_sty| is element struct type or none.
func ib_define_array_local(ctx: int, def_name_tok: int, n: int, stride: int, elem_sty: int): int {
    var total = n * stride
    if (total < 1) { total = 1 }
    var base = ib_fresh_vreg(ctx)
    var j = 1
    while (j < total) {
        ib_fresh_vreg(ctx)
        j = j + 1
    }
    int_vec_push(bctx_names(ctx), def_name_tok)
    int_vec_push(bctx_slots(ctx), base)
    int_vec_push(bctx_array_lens(ctx), n)
    int_vec_push(bctx_struct_ty(ctx), elem_sty)
    int_vec_push(bctx_array_strides(ctx), stride)
    int_vec_push(bctx_enum_ty(ctx), ib_enum_ty_none())
    return base
}

// Struct-as-consecutive-slots (POD int fields only); parallel struct_ty records type name tok.
func ib_define_struct_local(ctx: int, def_name_tok: int, n: int, type_name_tok: int): int {
    var base = ib_fresh_vreg(ctx)
    var j = 1
    while (j < n) {
        ib_fresh_vreg(ctx)
        j = j + 1
    }
    int_vec_push(bctx_names(ctx), def_name_tok)
    int_vec_push(bctx_slots(ctx), base)
    int_vec_push(bctx_array_lens(ctx), n)
    int_vec_push(bctx_struct_ty(ctx), type_name_tok)
    int_vec_push(bctx_array_strides(ctx), 0)
    int_vec_push(bctx_enum_ty(ctx), ib_enum_ty_none())
    return base
}

func ib_lookup_local(ctx: int, src: str, name: str): int {
    var toks = bctx_toks(ctx)
    var names = bctx_names(ctx)
    var n = int_vec_len(names)
    var found = 0 - 1
    var i = 0
    while (i < n) {
        if str_eq_tok_spelling(name, src, toks, int_vec_get(names, i)) == 1 {
            found = int_vec_get(bctx_slots(ctx), i)
        }
        i = i + 1
    }
    return found
}

func ib_lookup_by_name_tok(ctx: int, src: str, use_tok: int): int {
    var toks = bctx_toks(ctx)
    var names = bctx_names(ctx)
    var n = int_vec_len(names)
    var found = 0 - 1
    var i = 0
    while (i < n) {
        if tok_spelling_eq(src, toks, int_vec_get(names, i), use_tok) == 1 {
            found = int_vec_get(bctx_slots(ctx), i)
        }
        i = i + 1
    }
    return found
}

func ib_lookup_array_len(ctx: int, src: str, name: str): int {
    var toks = bctx_toks(ctx)
    var names = bctx_names(ctx)
    var lens = bctx_array_lens(ctx)
    var n2 = int_vec_len(names)
    var found = 1
    var j = 0
    while (j < n2) {
        if str_eq_tok_spelling(name, src, toks, int_vec_get(names, j)) == 1 {
            found = int_vec_get(lens, j)
        }
        j = j + 1
    }
    return found
}

func ib_lookup_array_stride(ctx: int, src: str, name: str): int {
    var toks = bctx_toks(ctx)
    var names = bctx_names(ctx)
    var strides = bctx_array_strides(ctx)
    var n2 = int_vec_len(names)
    var found = 0
    var j = 0
    while (j < n2) {
        if str_eq_tok_spelling(name, src, toks, int_vec_get(names, j)) == 1 {
            found = int_vec_get(strides, j)
        }
        j = j + 1
    }
    return found
}

func ib_lookup_struct_ty(ctx: int, src: str, name: str): int {
    var toks = bctx_toks(ctx)
    var names = bctx_names(ctx)
    var sty = bctx_struct_ty(ctx)
    var n2 = int_vec_len(names)
    var found = ib_struct_ty_none()
    var j = 0
    while (j < n2) {
        if str_eq_tok_spelling(name, src, toks, int_vec_get(names, j)) == 1 {
            found = int_vec_get(sty, j)
        }
        j = j + 1
    }
    return found
}

// Enum type name token bound to |name|, or -1 when the name is not an enum
// local.
func ib_lookup_enum_ty(ctx: int, src: str, name: str): int {
    var toks = bctx_toks(ctx)
    var names = bctx_names(ctx)
    var ety = bctx_enum_ty(ctx)
    var n2 = int_vec_len(names)
    var found = ib_enum_ty_none()
    var j = 0
    while (j < n2) {
        if str_eq_tok_spelling(name, src, toks, int_vec_get(names, j)) == 1 {
            found = int_vec_get(ety, j)
        }
        j = j + 1
    }
    return found
}

func ib_type_struct_width(ctx: int, src: str, typename_tok: int): int {
    var tnm = ib_tok_text(ctx, src, typename_tok)
    var root = mut_get(int_vec_get(ctx, 13))
    if root == 0 {
        return 0
    }
    var kids = ast_child(root, 0)
    var n = int_vec_len(kids)
    var i = 0
    while (i < n) {
        var decl = int_vec_get(kids, i)
        if ast_kind(decl) == nd_class() {
            var cname = ib_tok_text(ctx, src, ast_child(decl, 0))
            if str_eq(cname, tnm) == 1 {
                var members = ast_child(decl, 1)
                var mc = int_vec_len(members)
                var j = 0
                var fc = 0
                while (j < mc) {
                    var m = int_vec_get(members, j)
                    if ast_kind(m) == nd_class_field() {
                        fc = fc + 1
                    }
                    j = j + 1
                }
                return fc
            }
        }
        i = i + 1
    }
    return 0
}

func ib_struct_field_index(ctx: int, src: str, typename_tok: int, field_tok: int): int {
    var tnm = ib_tok_text(ctx, src, typename_tok)
    var fnm = ib_tok_text(ctx, src, field_tok)
    var root = mut_get(int_vec_get(ctx, 13))
    if root == 0 {
        return 0 - 1
    }
    var kids = ast_child(root, 0)
    var n = int_vec_len(kids)
    var i = 0
    while (i < n) {
        var decl = int_vec_get(kids, i)
        if ast_kind(decl) == nd_class() {
            var cname = ib_tok_text(ctx, src, ast_child(decl, 0))
            if str_eq(cname, tnm) == 1 {
                var members = ast_child(decl, 1)
                var mc = int_vec_len(members)
                var j = 0
                var idx = 0
                while (j < mc) {
                    var m = int_vec_get(members, j)
                    if ast_kind(m) == nd_class_field() {
                        var mname = ib_tok_text(ctx, src, ast_child(m, 0))
                        if str_eq(mname, fnm) == 1 {
                            return idx
                        }
                        idx = idx + 1
                    }
                    j = j + 1
                }
                return 0 - 1
            }
        }
        i = i + 1
    }
    return 0 - 1
}

// --- Expression lowering ---

// Find the module-level global index for an identifier token, or -1 if not a global.
func ib_find_global_index(ctx: int, src: str, name_tok: int): int {
    var h = ib_name_hash(ib_tok_text(ctx, src, name_tok))
    var gnames = bctx_global_names(ctx)
    var gcount = int_vec_len(gnames)
    var i = 0
    while (i < gcount) {
        if (int_vec_get(gnames, i) == h) { return i }
        i = i + 1
    }
    return 0 - 1
}

// Lower nd_ident node. Handles global lookup fallback.
func lower_expr_ident(ctx: int, src: str, node: int): int {
    var tok_idx = ast_child(node, 0)
    var slot = ib_lookup_by_name_tok(ctx, src, tok_idx)
    if (slot < 0) {
        var gi = ib_find_global_index(ctx, src, tok_idx)
        if (gi < 0) == 0 {
            var r = ib_fresh_vreg(ctx)
            ib_emit(ctx, ir_inst(ir_global_load(), r, gi, 0, 0))
            return r
        }
        // Bare enum variant: Phase 1 has no pattern syntax, so `None`, `Ok`
        // and friends are resolved to their declaration tag.
        if ib_enum_variant(ctx, src, ib_tok_text(ctx, src, tok_idx)) >= 0 {
            return ib_lower_variant_ctor(ctx, src, ib_tok_text(ctx, src, tok_idx))
        }
        var r = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_const(), r, 0, 0, 0))
        return r
    }
    var r = ib_fresh_vreg(ctx)
    ib_emit(ctx, ir_inst(ir_load(), r, slot, 0, 0))
    return r
}

// Lower nd_binop node.
func ib_binop_is_cmp(op: int): int {
    if op == binop_eq() { return 1 }
    if op == binop_ne() { return 1 }
    if op == binop_lt() { return 1 }
    if op == binop_le() { return 1 }
    if op == binop_gt() { return 1 }
    if op == binop_ge() { return 1 }
    return 0
}

func ib_type_node_is_text(ctx: int, src: str, type_node: int): int {
    if type_node < 0 { return 0 }
    if ast_kind(type_node) != nd_type_name() { return 0 }
    if str_eq(ib_tok_text(ctx, src, ast_child(type_node, 0)), "text") == 1 { return 1 }
    return 0
}

func ib_call_ret_is_text(ctx: int, src: str, node: int): int {
    var callee = ast_child(node, 0)
    if ast_kind(callee) != nd_ident() { return 0 }
    var ctok = ast_child(callee, 0)
    var nm = ib_tok_text(ctx, src, ctok)
    if str_eq(nm, "text_from_str") == 1 { return 1 }
    if str_eq(nm, "text_concat") == 1 { return 1 }
    if str_eq(nm, "text_slice") == 1 { return 1 }
    if str_eq(nm, "text_from_int") == 1 { return 1 }
    var idx = ib_find_func_by_name(ctx, src, nm)
    if idx >= 0 {
        if func_ret_type(mod_get_func(bctx_mod(ctx), idx)) == ir_ty_text() { return 1 }
    }
    return 0
}

// Best-effort static test: does this AST expression produce a `text` value?
func ib_expr_is_text(ctx: int, src: str, node: int): int {
    if node < 0 { return 0 }
    var kind = ast_kind(node)
    if kind == nd_text_lit() { return 1 }
    if kind == nd_text_slice() { return 1 }
    if kind == nd_ident() {
        var nt = ast_child(node, 0)
        var s = ib_lookup_by_name_tok(ctx, src, nt)
        if s >= 0 {
            if ib_vreg_is_text(ctx, s) == 1 { return 1 }
        }
        var gi = ib_find_global_index(ctx, src, nt)
        if gi >= 0 {
            if global_type(mod_get_global(bctx_mod(ctx), gi)) == ir_ty_text() { return 1 }
        }
        return 0
    }
    if kind == nd_call() { return ib_call_ret_is_text(ctx, src, node) }
    if kind == nd_binop() {
        if ast_child(node, 0) == binop_add() {
            if (ib_expr_is_text(ctx, src, ast_child(node, 1)) == 1) & (ib_expr_is_text(ctx, src, ast_child(node, 2)) == 1) {
                return 1
            }
        }
        return 0
    }
    return 0
}

func lower_expr_binop(ctx: int, src: str, node: int): int {
    var op = ast_child(node, 0)
    var lnode = ast_child(node, 1)
    var rnode = ast_child(node, 2)
    if (ib_expr_is_text(ctx, src, lnode) == 1) & (ib_expr_is_text(ctx, src, rnode) == 1) {
        var tleft = lower_expr(ctx, src, lnode)
        var tright = lower_expr(ctx, src, rnode)
        if op == binop_add() {
            var rt = ib_fresh_vreg(ctx)
            ib_emit(ctx, ir_inst(ir_text_concat(), rt, tleft, tright, 0))
            ib_mark_text(ctx, rt)
            return rt
        }
        if ib_binop_is_cmp(op) == 1 {
            var cv = ib_fresh_vreg(ctx)
            ib_emit(ctx, ir_inst(ir_text_cmp(), cv, tleft, tright, 0))
            var zv = ib_fresh_vreg(ctx)
            ib_emit(ctx, ir_inst(ir_const(), zv, 0, 0, 0))
            var cr = ib_fresh_vreg(ctx)
            var crop = ir_eq()
            if op == binop_ne() { crop = ir_ne() }
            if op == binop_lt() { crop = ir_lt() }
            if op == binop_le() { crop = ir_le() }
            if op == binop_gt() { crop = ir_gt() }
            if op == binop_ge() { crop = ir_ge() }
            ib_emit(ctx, ir_inst(crop, cr, cv, zv, 0))
            return cr
        }
    }
    var left = lower_expr(ctx, src, lnode)
    var right = lower_expr(ctx, src, rnode)
    var r = ib_fresh_vreg(ctx)
    var irop = ir_nop()
    if op == binop_add() { irop = ir_add() }
    if op == binop_sub() { irop = ir_sub() }
    if op == binop_mul() { irop = ir_mul() }
    if op == binop_div() { irop = ir_div() }
    if op == binop_mod() { irop = ir_mod() }
    if op == binop_eq()  { irop = ir_eq() }
    if op == binop_ne()  { irop = ir_ne() }
    if op == binop_lt()  { irop = ir_lt() }
    if op == binop_le()  { irop = ir_le() }
    if op == binop_gt()  { irop = ir_gt() }
    if op == binop_ge()  { irop = ir_ge() }
    if op == binop_and() { irop = ir_and() }
    if op == binop_or()  { irop = ir_or() }
    if op == binop_shl() { irop = ir_shl() }
    if op == binop_shr() { irop = ir_shr() }
    ib_emit(ctx, ir_inst(irop, r, left, right, 0))
    return r
}

// Lower nd_call node. Handles single-arg and multi-arg calls.
func lower_expr_call(ctx: int, src: str, node: int): int {
    var callee = ast_child(node, 0)
    var args_h = ast_child(node, 1)
    var argc = int_vec_len(args_h)
    var ckind = ast_kind(callee)
    // Enum constructor `Some(x)` / unit `None()`: lower to the variant tag.
    if ckind == nd_ident() {
        var cnm = ib_tok_text(ctx, src, ast_child(callee, 0))
        if ib_enum_variant(ctx, src, cnm) >= 0 {
            if argc > 0 {
                lower_expr(ctx, src, int_vec_get(args_h, 0))
            }
            return ib_lower_variant_ctor(ctx, src, cnm)
        }
    }
    var fname_idx = 0 - 1
    if ckind == nd_ident() { fname_idx = ast_child(callee, 0) }
    if ckind == nd_field() { fname_idx = ast_child(callee, 1) }
    if (fname_idx < 0) {
        var r_bad = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_const(), r_bad, 0, 0, 0))
        return r_bad
    }
    var r = ib_fresh_vreg(ctx)
    if argc == 1 {
        var only_node = int_vec_get(args_h, 0)
        var only_av = lower_expr(ctx, src, only_node)
        var c1 = int_vec_new()
        int_vec_push(c1, ir_call())
        int_vec_push(c1, r)
        int_vec_push(c1, fname_idx)
        int_vec_push(c1, 1)
        int_vec_push(c1, only_av)
        ib_emit(ctx, c1)
        return r
    }
    var arg_regs = int_vec_new()
    var i = 0
    while (i < argc) {
        var av = lower_expr(ctx, src, int_vec_get(args_h, i))
        int_vec_push(arg_regs, av)
        i = i + 1
    }
    var cinst = int_vec_new()
    int_vec_push(cinst, ir_call())
    int_vec_push(cinst, r)
    int_vec_push(cinst, fname_idx)
    int_vec_push(cinst, argc)
    int_vec_push(cinst, arg_regs)
    ib_emit(ctx, cinst)
    return r
}

// Lower nd_generic_call: monomorphize callee name (Issue #26) and emit call.
func ib_mangle_generic(ctx: int, src: str, base_tok: int, targs: int): str {
    var b = str_builder_new()
    str_builder_append(b, ib_tok_text(ctx, src, base_tok))
    var i = 0
    while (i < int_vec_len(targs)) {
        str_builder_append(b, "_")
        str_builder_append(b, ib_tok_text(ctx, src, int_vec_get(targs, i)))
        i = i + 1
    }
    var r = str_builder_to_str(b)
    str_builder_free(b)
    return r
}

func ib_func_name_str(ctx: int, src: str, name_tok: int): str {
    if name_pool_is_synthetic(name_tok) == 1 {
        var pool = mod_name_pool(bctx_mod(ctx))
        return name_pool_text(pool, name_tok)
    }
    return ib_tok_text(ctx, src, name_tok)
}

func ib_find_func_by_name(ctx: int, src: str, want: str): int {
    var m = bctx_mod(ctx)
    var fc = mod_func_count(m)
    var i = 0
    while (i < fc) {
        var f = mod_get_func(m, i)
        if str_eq(ib_func_name_str(ctx, src, func_name_tok(f)), want) == 1 {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

func ib_ensure_specialized(ctx: int, src: str, base_tok: int, mangled: str, syn_tok: int): int {
    if mod_alias_lookup(bctx_mod(ctx), syn_tok) >= 0 {
        return 0
    }
    var base_name = ib_tok_text(ctx, src, base_tok)
    var bi = ib_find_func_by_name(ctx, src, base_name)
    if bi < 0 {
        return 1
    }
    mod_add_alias(bctx_mod(ctx), syn_tok, bi)
    return 0
}

// Lower nd_generic_call: emit plain call (type erasure). Codegen synthetic-name
// paths remain for future monomorphization once alias lookup is seed-stable.
func lower_expr_generic_call(ctx: int, src: str, node: int): int {
    var callee = ast_child(node, 0)
    var args = ast_child(node, 2)
    var cnode = ast_call(callee, args)
    var r = lower_expr_call(ctx, src, cnode)
    int_vec_free(cnode)
    return r
}

// Lower nd_field node.
func lower_expr_field(ctx: int, src: str, node: int): int {
    var obj_node = ast_child(node, 0)
    var field_tok = ast_child(node, 1)

    // pts[i].x — struct-element array (Issue #64)
    if ast_kind(obj_node) == nd_index() {
        var arr_node = ast_child(obj_node, 0)
        var idx_node = ast_child(obj_node, 1)
        if ast_kind(arr_node) == nd_ident() {
            var arr_name = ib_tok_text(ctx, src, ast_child(arr_node, 0))
            var base = ib_lookup_local(ctx, src, arr_name)
            var nelem = ib_lookup_array_len(ctx, src, arr_name)
            var stride = ib_lookup_array_stride(ctx, src, arr_name)
            var sty = ib_lookup_struct_ty(ctx, src, arr_name)
            if ((base < 0) == 0) & (stride > 1) & (sty != ib_struct_ty_none()) & (nelem > 0) {
                var fidx = ib_struct_field_index(ctx, src, sty, field_tok)
                if ((fidx < 0) == 0) & (fidx < stride) {
                    var total = nelem * stride
                    if ast_kind(idx_node) == nd_int_lit() {
                        var off_e = ast_child(idx_node, 0)
                        if ((off_e < 0) == 0) & (off_e < nelem) {
                            var r = ib_fresh_vreg(ctx)
                            ib_emit(ctx, ir_inst(ir_load(), r, base + off_e * stride + fidx, 0, 0))
                            return r
                        }
                    } else {
                        var idx = lower_expr(ctx, src, idx_node)
                        var sr = ib_fresh_vreg(ctx)
                        ib_emit(ctx, ir_inst(ir_const(), sr, stride, 0, 0))
                        var scaled = ib_fresh_vreg(ctx)
                        ib_emit(ctx, ir_inst(ir_mul(), scaled, idx, sr, 0))
                        var fr = ib_fresh_vreg(ctx)
                        ib_emit(ctx, ir_inst(ir_const(), fr, fidx, 0, 0))
                        var off = ib_fresh_vreg(ctx)
                        ib_emit(ctx, ir_inst(ir_add(), off, scaled, fr, 0))
                        var r2 = ib_fresh_vreg(ctx)
                        ib_emit(ctx, ir_inst(ir_array_load(), r2, base, off, total))
                        return r2
                    }
                }
            }
        }
    }

    if ast_kind(obj_node) == nd_ident() {
        var obj_name = ib_tok_text(ctx, src, ast_child(obj_node, 0))
        var base = ib_lookup_local(ctx, src, obj_name)
        var alen = ib_lookup_array_len(ctx, src, obj_name)
        var stride = ib_lookup_array_stride(ctx, src, obj_name)
        var sty = ib_lookup_struct_ty(ctx, src, obj_name)
        // Enum locals: `.tag` reads the tag slot, `.data` the payload slot
        // (0 for unit-only enums, which carry no payload slot).
        var ety = ib_lookup_enum_ty(ctx, src, obj_name)
        if ((base < 0) == 0) & (ety != ib_enum_ty_none()) {
            var efield = ib_tok_text(ctx, src, field_tok)
            if str_eq(efield, "tag") == 1 {
                var ert = ib_fresh_vreg(ctx)
                ib_emit(ctx, ir_inst(ir_load(), ert, base, 0, 0))
                return ert
            }
            if str_eq(efield, "data") == 1 {
                if ib_enum_width(ctx, src, ib_tok_text(ctx, src, ety)) > 1 {
                    var erd = ib_fresh_vreg(ctx)
                    ib_emit(ctx, ir_inst(ir_load(), erd, base + 1, 0, 0))
                    return erd
                }
                var erz = ib_fresh_vreg(ctx)
                ib_emit(ctx, ir_inst(ir_const(), erz, 0, 0, 0))
                return erz
            }
        }
        // Scalar struct only (stride 0). Struct arrays use index+field above.
        if ((base < 0) == 0) & (stride == 0) & (sty != ib_struct_ty_none()) {
            var fidx = ib_struct_field_index(ctx, src, sty, field_tok)
            if ((fidx < 0) == 0 & fidx < alen) {
                var r3 = ib_fresh_vreg(ctx)
                ib_emit(ctx, ir_inst(ir_load(), r3, base + fidx, 0, 0))
                return r3
            }
        }
        if ((base < 0) == 0) & (stride == 0) & (alen == 1) {
            // Enum values carried as plain ints (parameters, globals) and
            // plain scalars share one slot: read it.
            var r = ib_fresh_vreg(ctx)
            ib_emit(ctx, ir_inst(ir_load(), r, base, 0, 0))
            return r
        }
    }
    var r2 = ib_fresh_vreg(ctx)
    ib_emit(ctx, ir_inst(ir_const(), r2, 0, 0, 0))
    return r2
}

// Lower obj.method(args) as method(obj, args...) — free-function receiver convention.
// ir_call layout matches lower_expr_call: [op, res, fname_tok, argc, arg|args_vec].
func lower_expr_method_call(ctx: int, src: str, node: int): int {
    var obj_reg = lower_expr(ctx, src, ast_child(node, 0))
    var method_tok = ast_child(node, 1)
    var args_h = ast_child(node, 2)
    var argc = int_vec_len(args_h)
    var total = argc + 1
    var r = ib_fresh_vreg(ctx)
    if total == 1 {
        var c1 = int_vec_new()
        int_vec_push(c1, ir_call())
        int_vec_push(c1, r)
        int_vec_push(c1, method_tok)
        int_vec_push(c1, 1)
        int_vec_push(c1, obj_reg)
        ib_emit(ctx, c1)
        return r
    }
    var arg_regs = int_vec_new()
    int_vec_push(arg_regs, obj_reg)
    var i = 0
    while (i < argc) {
        var av = lower_expr(ctx, src, int_vec_get(args_h, i))
        int_vec_push(arg_regs, av)
        i = i + 1
    }
    var minst = int_vec_new()
    int_vec_push(minst, ir_call())
    int_vec_push(minst, r)
    int_vec_push(minst, method_tok)
    int_vec_push(minst, total)
    int_vec_push(minst, arg_regs)
    ib_emit(ctx, minst)
    return r
}

func lower_expr_index(ctx: int, src: str, node: int): int {
    var obj = ast_child(node, 0)
    var idx_node = ast_child(node, 1)
    if ast_kind(obj) == nd_ident() {
        var name = ib_tok_text(ctx, src, ast_child(obj, 0))
        var base = ib_lookup_local(ctx, src, name)
        var alen = ib_lookup_array_len(ctx, src, name)
        var stride = ib_lookup_array_stride(ctx, src, name)
        // Scalar-element arrays only (int[]/bool[]/str[]). Struct arrays use arr[i].field.
        if ((base < 0) == 0) & (stride == 1) & (alen > 1) {
            if ast_kind(idx_node) == nd_int_lit() {
                var off = ast_child(idx_node, 0)
                if ((off < 0) == 0 & off < alen) {
                    var r = ib_fresh_vreg(ctx)
                    ib_emit(ctx, ir_inst(ir_load(), r, base + off, 0, 0))
                    return r
                }
            } else {
                var idx = lower_expr(ctx, src, idx_node)
                var r = ib_fresh_vreg(ctx)
                ib_emit(ctx, ir_inst(ir_array_load(), r, base, idx, alen))
                return r
            }
        }
    }
    var r2 = ib_fresh_vreg(ctx)
    ib_emit(ctx, ir_inst(ir_const(), r2, 0, 0, 0))
    return r2
}

func lower_expr(ctx: int, src: str, node: int): int {
    var kind = ast_kind(node)

    if kind == nd_int_lit() {
        var val = ast_child(node, 0)
        var r = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_const(), r, val, 0, 0))
        return r
    }

    if kind == nd_bool_lit() {
        var val = ast_child(node, 0)
        var r = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_const(), r, val, 0, 0))
        return r
    }

    if kind == nd_str_lit() {
        var tok_idx = ast_child(node, 0)
        var str_id = int_vec_len(bctx_str_vec(ctx))
        int_vec_push(bctx_str_vec(ctx), tok_idx)
        var r = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_const_str(), r, str_id, 0, 0))
        return r
    }

    if kind == nd_text_lit() {
        var tok_idx2 = ast_child(node, 0)
        var str_id2 = int_vec_len(bctx_str_vec(ctx))
        int_vec_push(bctx_str_vec(ctx), tok_idx2)
        var r2 = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_const_text(), r2, str_id2, 0, 0))
        ib_mark_text(ctx, r2)
        return r2
    }

    if kind == nd_text_slice() {
        var sobj = lower_expr(ctx, src, ast_child(node, 0))
        var sstart = lower_expr(ctx, src, ast_child(node, 1))
        var send = lower_expr(ctx, src, ast_child(node, 2))
        var slen = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_sub(), slen, send, sstart, 0))
        var sr = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_text_slice(), sr, sobj, sstart, slen))
        ib_mark_text(ctx, sr)
        return sr
    }

    if kind == nd_ident() { return lower_expr_ident(ctx, src, node) }
    if kind == nd_binop() { return lower_expr_binop(ctx, src, node) }

    if kind == nd_unary() {
        var op = ast_child(node, 0)
        var operand = lower_expr(ctx, src, ast_child(node, 1))
        var r = ib_fresh_vreg(ctx)
        if op == unop_neg() {
            ib_emit(ctx, ir_inst(ir_neg(), r, operand, 0, 0))
        } else {
            ib_emit(ctx, ir_inst(ir_not(), r, operand, 0, 0))
        }
        return r
    }

    if kind == nd_call() { return lower_expr_call(ctx, src, node) }
    if kind == nd_generic_call() { return lower_expr_generic_call(ctx, src, node) }
    if kind == nd_method_call() { return lower_expr_method_call(ctx, src, node) }
    if kind == nd_index() { return lower_expr_index(ctx, src, node) }
    if kind == nd_field() { return lower_expr_field(ctx, src, node) }

    // Qualified variant in expression position (`Enum::Variant`) lowers to
    // its tag; the payload is evaluated for its side effects only. Payload
    // values are materialized when the variant is stored into an enum local.
    if kind == nd_qualified_variant() {
        var vnode = ib_variant_ctor_node(ctx, src, node)
        var qtag = 0
        if vnode >= 0 { qtag = ast_child(vnode, 2) }
        var pnode = ib_variant_ctor_payload(ctx, src, node)
        if pnode >= 0 { lower_expr(ctx, src, pnode) }
        var qrt = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_const(), qrt, qtag, 0, 0))
        return qrt
    }

    var r = ib_fresh_vreg(ctx)
    ib_emit(ctx, ir_inst(ir_const(), r, 0, 0, 0))
    return r
}

func lower_while_stmt(ctx: int, src: str, node: int): int {
    var cond_lbl = ib_fresh_label(ctx)
    var body_lbl = ib_fresh_label(ctx)
    var end_lbl  = ib_fresh_label(ctx)
    var no_update = 2147483647
    var cond_blk = ir_block_new(cond_lbl)
    var body_blk = ir_block_new(body_lbl)
    var end_blk = ir_block_new(end_lbl)
    var blk_bad = 0
    if (block_label(cond_blk) != cond_lbl) { blk_bad = 1 }
    if (block_label(body_blk) != body_lbl) { blk_bad = 1 }
    if (block_label(end_blk) != end_lbl) { blk_bad = 1 }
    if (blk_bad == 1) {
        stderr("ir-builder error: while block label corruption cond=")
        stderr(int_to_str(cond_lbl))
        stderr("/")
        stderr(int_to_str(block_label(cond_blk)))
        stderr(" body=")
        stderr(int_to_str(body_lbl))
        stderr("/")
        stderr(int_to_str(block_label(body_blk)))
        stderr(" end=")
        stderr(int_to_str(end_lbl))
        stderr("/")
        stderr(int_to_str(block_label(end_blk)))
        stderr(char_to_str(10))
        return 1
    }
    var cond_target = block_label(cond_blk)
    var body_target = block_label(body_blk)
    var end_target = block_label(end_blk)

    if (ib_trace_on() == 1) {
        stderr("[ir-trace] while-labels cond=")
        stderr(int_to_str(cond_target))
        stderr(" body=")
        stderr(int_to_str(body_target))
        stderr(" end=")
        stderr(int_to_str(end_target))
        stderr(char_to_str(10))
    }
    ib_add_blk(ctx, cond_blk)
    ib_add_blk(ctx, body_blk)
    ib_add_blk(ctx, end_blk)
    ib_emit(ctx, ir_inst(ir_br(), 0, cond_target, 0, 0))
    var cond_handle = ib_find_blk_by_label(ctx, cond_target)
    if (cond_handle < 0) {
        stderr("ir-builder error: missing while-cond block handle\n")
        return 1
    }
    ib_set_blk(ctx, cond_handle)
    var cond_reg = lower_expr(ctx, src, ast_child(node, 0))
    ib_emit(ctx, ir_inst(ir_br_cond(), cond_reg, body_target, end_target, 0))

    var body_handle = ib_find_blk_by_label(ctx, body_target)
    if (body_handle < 0) {
        stderr("ir-builder error: missing while-body block handle\n")
        return 1
    }
    ib_set_blk(ctx, body_handle)
    lower_block(ctx, src, ast_child(node, 1))
    var update = ast_child(node, 2)
    if (update != no_update) {
        lower_expr(ctx, src, update)
    }
    ib_emit(ctx, ir_inst(ir_br(), 0, cond_target, 0, 0))

    var end_handle = ib_find_blk_by_label(ctx, end_target)
    if (end_handle < 0) {
        stderr("ir-builder error: missing while-end block handle\n")
        return 1
    }
    ib_set_blk(ctx, end_handle)
    return 0
}

// Lower nd_flux. Supported iterables:
// - `start..end` → half-open range [start, end) (Issue #20)
// - local `int[]` ident → index loop i in 0..len; v = arr[i] (Issue #56)
func lower_stmt_flux(ctx: int, src: str, node: int): int {
    var vtok = ast_child(node, 0)
    var iterable = ast_child(node, 1)
    var body = ast_child(node, 2)
    var scope = ib_scope_push(ctx)
    if ast_kind(iterable) == nd_range() {
        var start_node = ast_child(iterable, 0)
        var end_node = ast_child(iterable, 1)

        var slot = ib_define_local(ctx, vtok)
        ib_emit(ctx, ir_inst(ir_alloca(), slot, 0, 0, 0))

        var start = lower_expr(ctx, src, start_node)
        var end = lower_expr(ctx, src, end_node)
        ib_emit(ctx, ir_inst(ir_store(), slot, start, 0, 0))

        var one = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_const(), one, 1, 0, 0))

        var cond_lbl = ib_fresh_label(ctx)
        var body_lbl = ib_fresh_label(ctx)
        var end_lbl = ib_fresh_label(ctx)

        ib_add_blk(ctx, ir_block_new(cond_lbl))
        ib_add_blk(ctx, ir_block_new(body_lbl))
        ib_add_blk(ctx, ir_block_new(end_lbl))

        ib_emit(ctx, ir_inst(ir_br(), 0, cond_lbl, 0, 0))

        var cond_handle = ib_find_blk_by_label(ctx, cond_lbl)
        if (cond_handle < 0) {
            stderr("ir-builder error: missing flux-cond block handle\n")
            return 1
        }
        ib_set_blk(ctx, cond_handle)
        var cur = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_load(), cur, slot, 0, 0))
        var cmp = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_lt(), cmp, cur, end, 0))
        ib_emit(ctx, ir_inst(ir_br_cond(), cmp, body_lbl, end_lbl, 0))

        var body_handle = ib_find_blk_by_label(ctx, body_lbl)
        if (body_handle < 0) {
            stderr("ir-builder error: missing flux-body block handle\n")
            return 1
        }
        ib_set_blk(ctx, body_handle)
        lower_block(ctx, src, body)
        var v2 = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_load(), v2, slot, 0, 0))
        var v3 = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_add(), v3, v2, one, 0))
        ib_emit(ctx, ir_inst(ir_store(), slot, v3, 0, 0))
        ib_emit(ctx, ir_inst(ir_br(), 0, cond_lbl, 0, 0))

        var end_handle = ib_find_blk_by_label(ctx, end_lbl)
        if (end_handle < 0) {
            stderr("ir-builder error: missing flux-end block handle\n")
            return 1
        }
        ib_set_blk(ctx, end_handle)
    } else {
        if ast_kind(iterable) == nd_ident() {
            var aname = ib_tok_text(ctx, src, ast_child(iterable, 0))
            var base = ib_lookup_local(ctx, src, aname)
            var alen = ib_lookup_array_len(ctx, src, aname)
            var stride = ib_lookup_array_stride(ctx, src, aname)
            // Fixed scalar-element arrays (int[]/bool[]/str[]); alen==1 is scalar marker.
            if ((base < 0) == 0) & (stride == 1) & (alen > 1) {
                var idx_tok = vtok
                // Index temp (anonymous): reuse vreg without name for loop counter;
                // bind loop variable `v` to element value each iteration.
                var idx_slot = ib_fresh_vreg(ctx)
                ib_emit(ctx, ir_inst(ir_alloca(), idx_slot, 0, 0, 0))
                var zero = ib_fresh_vreg(ctx)
                ib_emit(ctx, ir_inst(ir_const(), zero, 0, 0, 0))
                ib_emit(ctx, ir_inst(ir_store(), idx_slot, zero, 0, 0))

                var lenr = ib_fresh_vreg(ctx)
                ib_emit(ctx, ir_inst(ir_const(), lenr, alen, 0, 0))
                var one2 = ib_fresh_vreg(ctx)
                ib_emit(ctx, ir_inst(ir_const(), one2, 1, 0, 0))

                var val_slot = ib_define_local(ctx, idx_tok)
                ib_emit(ctx, ir_inst(ir_alloca(), val_slot, 0, 0, 0))

                var cond_lbl2 = ib_fresh_label(ctx)
                var body_lbl2 = ib_fresh_label(ctx)
                var end_lbl2 = ib_fresh_label(ctx)
                ib_add_blk(ctx, ir_block_new(cond_lbl2))
                ib_add_blk(ctx, ir_block_new(body_lbl2))
                ib_add_blk(ctx, ir_block_new(end_lbl2))
                ib_emit(ctx, ir_inst(ir_br(), 0, cond_lbl2, 0, 0))

                var ch2 = ib_find_blk_by_label(ctx, cond_lbl2)
                if (ch2 < 0) {
                    stderr("ir-builder error: missing array-flux-cond block handle\n")
                    return 1
                }
                ib_set_blk(ctx, ch2)
                var icur = ib_fresh_vreg(ctx)
                ib_emit(ctx, ir_inst(ir_load(), icur, idx_slot, 0, 0))
                var icmp = ib_fresh_vreg(ctx)
                ib_emit(ctx, ir_inst(ir_lt(), icmp, icur, lenr, 0))
                ib_emit(ctx, ir_inst(ir_br_cond(), icmp, body_lbl2, end_lbl2, 0))

                var bh2 = ib_find_blk_by_label(ctx, body_lbl2)
                if (bh2 < 0) {
                    stderr("ir-builder error: missing array-flux-body block handle\n")
                    return 1
                }
                ib_set_blk(ctx, bh2)
                var icur2 = ib_fresh_vreg(ctx)
                ib_emit(ctx, ir_inst(ir_load(), icur2, idx_slot, 0, 0))
                var elem = ib_fresh_vreg(ctx)
                ib_emit(ctx, ir_inst(ir_array_load(), elem, base, icur2, alen))
                ib_emit(ctx, ir_inst(ir_store(), val_slot, elem, 0, 0))
                lower_block(ctx, src, body)
                var icur3 = ib_fresh_vreg(ctx)
                ib_emit(ctx, ir_inst(ir_load(), icur3, idx_slot, 0, 0))
                var inext = ib_fresh_vreg(ctx)
                ib_emit(ctx, ir_inst(ir_add(), inext, icur3, one2, 0))
                ib_emit(ctx, ir_inst(ir_store(), idx_slot, inext, 0, 0))
                ib_emit(ctx, ir_inst(ir_br(), 0, cond_lbl2, 0, 0))

                var eh2 = ib_find_blk_by_label(ctx, end_lbl2)
                if (eh2 < 0) {
                    stderr("ir-builder error: missing array-flux-end block handle\n")
                    return 1
                }
                ib_set_blk(ctx, eh2)
            }
        }
    }
    ib_scope_pop(ctx, scope)
    return 0
}

// Lower nd_var_decl for array types (int[]/bool[]/str[] or struct-element arrays).
func lower_stmt_var_array(ctx: int, src: str, name_tok: int, type_node: int, init: int): int {
    var elems = ast_child(init, 0)
    var ne = int_vec_len(elems)
    if (ne > 0) == 0 { return 0 }

    var stride = 1
    var elem_sty = ib_struct_ty_none()
    var elem_ty = ast_child(type_node, 0)
    if (elem_ty < 0) == 0 {
        if ast_kind(elem_ty) == nd_type_name() {
            var etok = ast_child(elem_ty, 0)
            var sw = ib_type_struct_width(ctx, src, etok)
            if (sw > 0) {
                stride = sw
                elem_sty = etok
            }
        }
    }

    var base = ib_define_array_local(ctx, name_tok, ne, stride, elem_sty)
    var total = ne * stride
    var si = 0
    while (si < total) {
        ib_emit(ctx, ir_inst(ir_alloca(), base + si, 0, 0, 0))
        si = si + 1
    }

    if (stride == 1) {
        var j = 0
        while (j < ne) {
            var ev = lower_expr(ctx, src, int_vec_get(elems, j))
            ib_emit(ctx, ir_inst(ir_store(), base + j, ev, 0, 0))
            j = j + 1
        }
        return 1
    }

    // Struct-element array: each elem is an obj lit; store fields into stride slots.
    var k = 0
    while (k < ne) {
        var elem = int_vec_get(elems, k)
        if ast_kind(elem) == nd_obj_lit() {
            var fields_vec = ast_child(elem, 1)
            var nf = int_vec_len(fields_vec)
            var kf = 0
            while (kf < nf) {
                var finit = int_vec_get(fields_vec, kf)
                var fexpr = ast_child(finit, 1)
                var fname_tok = ast_child(finit, 0)
                var idx2 = ib_struct_field_index(ctx, src, elem_sty, fname_tok)
                if ((idx2 < 0) == 0) & (idx2 < stride) {
                    var ev2 = lower_expr(ctx, src, fexpr)
                    ib_emit(ctx, ir_inst(ir_store(), base + k * stride + idx2, ev2, 0, 0))
                }
                kf = kf + 1
            }
        }
        k = k + 1
    }
    return 1
}

// Enum type token for a local declaration: from the type annotation when it
// names an enum, else from the variant construction in the initializer.
// Returns -1 when the declaration is not enum-typed.
func ib_enum_local_type_tok(ctx: int, src: str, type_node: int, init: int): int {
    if (type_node < 0) == 0 {
        if ast_kind(type_node) == nd_type_name() {
            var tnm = ib_tok_text(ctx, src, ast_child(type_node, 0))
            if ib_enum_decl_for_type(ctx, src, tnm) >= 0 {
                return ast_child(type_node, 0)
            }
        }
    }
    if (init < 0) == 0 {
        if ast_kind(init) == nd_qualified_variant() {
            var qnm = ib_tok_text(ctx, src, ast_child(init, 0))
            if ib_enum_decl_for_type(ctx, src, qnm) >= 0 {
                return ast_child(init, 0)
            }
        }
        var bname = ib_bare_variant_name(ctx, src, init)
        if bname != "" {
            var bv = ib_enum_variant(ctx, src, bname)
            if bv >= 0 {
                var bdecl = ib_enum_decl_for_variant(ctx, src, bv)
                if bdecl >= 0 { return ast_child(bdecl, 0) }
            }
        }
    }
    return 0 - 1
}

// Lower nd_var_decl for enum-typed locals. An enum value lives in
// consecutive slots: the tag slot and, for enums with a payload variant, the
// payload slot. Returns 1 when handled, 0 to fall back to the generic path.
func lower_stmt_var_enum(ctx: int, src: str, name_tok: int, type_node: int, init: int): int {
    var enum_tok = ib_enum_local_type_tok(ctx, src, type_node, init)
    if enum_tok < 0 { return 0 }
    var enum_name = ib_tok_text(ctx, src, enum_tok)
    var width = ib_enum_width(ctx, src, enum_name)
    var base = ib_define_enum_local(ctx, name_tok, enum_tok, width)
    var si = 0
    while (si < width) {
        ib_emit(ctx, ir_inst(ir_alloca(), base + si, 0, 0, 0))
        si = si + 1
    }
    var vnode = ib_variant_ctor_node(ctx, src, init)
    var tv = 0 - 1
    var pv = 0 - 1
    if vnode >= 0 {
        tv = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_const(), tv, ast_child(vnode, 2), 0, 0))
        var pnode = ib_variant_ctor_payload(ctx, src, init)
        if (ast_child(vnode, 1) >= 0) & (pnode >= 0) {
            pv = lower_expr(ctx, src, pnode)
        }
    } else {
        // Copy from another enum local: keep its payload.
        var iname = ib_expr_ident_name(ctx, src, init)
        var src_payload = ib_enum_payload_slot(ctx, src, iname)
        if src_payload >= 0 {
            var src_base = ib_lookup_local(ctx, src, iname)
            var sv = ib_fresh_vreg(ctx)
            ib_emit(ctx, ir_inst(ir_load(), sv, src_base, 0, 0))
            tv = sv
            var sp = ib_fresh_vreg(ctx)
            ib_emit(ctx, ir_inst(ir_load(), sp, src_payload, 0, 0))
            pv = sp
        } else {
            if (init < 0) == 0 {
                tv = lower_expr(ctx, src, init)
            } else {
                tv = ib_fresh_vreg(ctx)
                ib_emit(ctx, ir_inst(ir_const(), tv, 0, 0, 0))
            }
        }
    }
    ib_emit(ctx, ir_inst(ir_store(), base, tv, 0, 0))
    if width > 1 {
        if pv < 0 {
            pv = ib_fresh_vreg(ctx)
            ib_emit(ctx, ir_inst(ir_const(), pv, 0, 0, 0))
        }
        ib_emit(ctx, ir_inst(ir_store(), base + 1, pv, 0, 0))
    }
    return 1
}

// Slot of the payload of the enum local named |name|, or -1 when the name is
// not an enum local with a payload slot.
func ib_enum_payload_slot(ctx: int, src: str, name: str): int {
    var ety = ib_lookup_enum_ty(ctx, src, name)
    if ety == ib_enum_ty_none() { return 0 - 1 }
    if ib_enum_width(ctx, src, ib_tok_text(ctx, src, ety)) < 2 { return 0 - 1 }
    var base = ib_lookup_local(ctx, src, name)
    if base < 0 { return 0 - 1 }
    return base + 1
}

// Store a variant construction into an enum local: the tag slot at |base| and
// the payload slot at |base+1| (unit variants reset the payload to 0).
// Returns 1 when handled, 0 to fall back to the generic path.
func lower_assign_enum(ctx: int, src: str, base: int, enum_tok: int, value: int): int {
    var vnode = ib_variant_ctor_node(ctx, src, value)
    var tv = 0 - 1
    var pv = 0 - 1
    if vnode >= 0 {
        tv = ib_fresh_vreg(ctx)
        ib_emit(ctx, ir_inst(ir_const(), tv, ast_child(vnode, 2), 0, 0))
        var pnode = ib_variant_ctor_payload(ctx, src, value)
        if (ast_child(vnode, 1) >= 0) & (pnode >= 0) {
            pv = lower_expr(ctx, src, pnode)
        }
    } else {
        // Copy from another enum local: keep its payload.
        var vname = ib_expr_ident_name(ctx, src, value)
        var src_payload = ib_enum_payload_slot(ctx, src, vname)
        if src_payload >= 0 {
            var src_base = ib_lookup_local(ctx, src, vname)
            var sv = ib_fresh_vreg(ctx)
            ib_emit(ctx, ir_inst(ir_load(), sv, src_base, 0, 0))
            tv = sv
            var sp = ib_fresh_vreg(ctx)
            ib_emit(ctx, ir_inst(ir_load(), sp, src_payload, 0, 0))
            pv = sp
        }
        if tv < 0 {
            tv = lower_expr(ctx, src, value)
        }
    }
    ib_emit(ctx, ir_inst(ir_store(), base, tv, 0, 0))
    if ib_enum_width(ctx, src, ib_tok_text(ctx, src, enum_tok)) > 1 {
        if pv < 0 {
            pv = ib_fresh_vreg(ctx)
            ib_emit(ctx, ir_inst(ir_const(), pv, 0, 0, 0))
        }
        ib_emit(ctx, ir_inst(ir_store(), base + 1, pv, 0, 0))
    }
    return 1
}

// Lower nd_var_decl for struct types.
func lower_stmt_var_struct(ctx: int, src: str, name_tok: int, type_name_tok: int, init: int): int {
    var sw = ib_type_struct_width(ctx, src, type_name_tok)
    if (sw > 0) {
        var fields_vec = ast_child(init, 1)
        var nf = int_vec_len(fields_vec)
        var base2 = ib_define_struct_local(ctx, name_tok, sw, type_name_tok)
        var si = 0
        while (si < sw) {
            ib_emit(ctx, ir_inst(ir_alloca(), base2 + si, 0, 0, 0))
            si = si + 1
        }
        var kf = 0
        while (kf < nf) {
            var finit = int_vec_get(fields_vec, kf)
            var fexpr = ast_child(finit, 1)
            var fname_tok = ast_child(finit, 0)
            var idx2 = ib_struct_field_index(ctx, src, type_name_tok, fname_tok)
            if ((idx2 < 0) == 0 & idx2 < sw) {
                var ev2 = lower_expr(ctx, src, fexpr)
                ib_emit(ctx, ir_inst(ir_store(), base2 + idx2, ev2, 0, 0))
            }
            kf = kf + 1
        }
        return 1
    }
    return 0
}

// Lower nd_if statement.
func lower_stmt_if(ctx: int, src: str, node: int): int {
    var cond_reg = lower_expr(ctx, src, ast_child(node, 0))
    var then_lbl = ib_fresh_label(ctx)
    var end_lbl = ib_fresh_label(ctx)
    var has_else = ast_child(node, 2)
    var else_lbl = end_lbl
    var no_else = 2147483647
    var need_else = 0
    if (has_else != no_else) { need_else = 1 }
    if (need_else == 1) { else_lbl = ib_fresh_label(ctx) }
    if (ib_trace_on() == 1) {
        stderr("[ir-trace] if-branch cond=") stderr(int_to_str(cond_reg))
        stderr(" then=") stderr(int_to_str(then_lbl))
        stderr(" else=") stderr(int_to_str(else_lbl))
        stderr(" end=") stderr(int_to_str(end_lbl)) stderr(char_to_str(10))
    }
    ib_emit(ctx, ir_inst(ir_br_cond(), cond_reg, then_lbl, else_lbl, 0))
    var then_blk = ir_block_new(then_lbl)
    if (block_label(then_blk) != then_lbl) { stderr("ir-builder error: if-then label corruption\n") return 1 }
    ib_add_blk(ctx, then_blk)
    var then_handle = ib_find_blk_by_label(ctx, then_lbl)
    if (then_handle < 0) { stderr("ir-builder error: missing if-then block handle\n") return 1 }
    ib_set_blk(ctx, then_handle)
    lower_block(ctx, src, ast_child(node, 1))
    ib_emit(ctx, ir_inst(ir_br(), 0, end_lbl, 0, 0))
    if (need_else == 1) {
        var else_blk = ir_block_new(else_lbl)
        if (block_label(else_blk) != else_lbl) { stderr("ir-builder error: if-else label corruption\n") return 1 }
        ib_add_blk(ctx, else_blk)
        var else_handle = ib_find_blk_by_label(ctx, else_lbl)
        if (else_handle < 0) { stderr("ir-builder error: missing if-else block handle\n") return 1 }
        ib_set_blk(ctx, else_handle)
        lower_block(ctx, src, has_else)
        ib_emit(ctx, ir_inst(ir_br(), 0, end_lbl, 0, 0))
    }
    var end_blk = ir_block_new(end_lbl)
    if (block_label(end_blk) != end_lbl) { stderr("ir-builder error: if-end label corruption\n") return 1 }
    ib_add_blk(ctx, end_blk)
    var end_handle2 = ib_find_blk_by_label(ctx, end_lbl)
    if (end_handle2 < 0) { stderr("ir-builder error: missing if-end block handle\n") return 1 }
    ib_set_blk(ctx, end_handle2)
    return 0
}

func lower_stmt_assign(ctx: int, src: str, node: int): int {
    var target = ast_child(node, 0)
    var value = ast_child(node, 1)
    if ast_kind(target) == nd_ident() {
        var name_tok = ast_child(target, 0)
        var slot = ib_lookup_by_name_tok(ctx, src, name_tok)
        if (slot < 0) == 0 {
            // Enum local: `e = Opt::Some(7)` writes the tag and payload slots.
            var enum_tok = ib_lookup_enum_ty(ctx, src, ib_tok_text(ctx, src, name_tok))
            if enum_tok != ib_enum_ty_none() {
                if lower_assign_enum(ctx, src, slot, enum_tok, value) == 1 { return 0 }
            }
            var val = lower_expr(ctx, src, value)
            ib_emit(ctx, ir_inst(ir_store(), slot, val, 0, 0))
            if ib_expr_is_text(ctx, src, value) == 1 {
                ib_mark_text(ctx, slot)
            }
        } else {
            var gi = ib_find_global_index(ctx, src, name_tok)
            if (gi < 0) == 0 {
                var gval = lower_expr(ctx, src, value)
                ib_emit(ctx, ir_inst(ir_global_store(), gi, gval, 0, 0))
            }
        }
        return 0
    }
    if ast_kind(target) == nd_field() {
        var obj_node = ast_child(target, 0)
        var field_tok = ast_child(target, 1)
        if ast_kind(obj_node) == nd_index() {
            var arr_node = ast_child(obj_node, 0)
            var idx_node = ast_child(obj_node, 1)
            if ast_kind(arr_node) == nd_ident() {
                var arr_name = ib_tok_text(ctx, src, ast_child(arr_node, 0))
                var base = ib_lookup_local(ctx, src, arr_name)
                var nelem = ib_lookup_array_len(ctx, src, arr_name)
                var stride = ib_lookup_array_stride(ctx, src, arr_name)
                var sty = ib_lookup_struct_ty(ctx, src, arr_name)
                if ((base < 0) == 0) & (stride > 1) & (sty != ib_struct_ty_none()) & (nelem > 0) {
                    var fidx = ib_struct_field_index(ctx, src, sty, field_tok)
                    if ((fidx < 0) == 0) & (fidx < stride) {
                        var total = nelem * stride
                        var val = lower_expr(ctx, src, value)
                        if ast_kind(idx_node) == nd_int_lit() {
                            var off_e = ast_child(idx_node, 0)
                            if ((off_e < 0) == 0) & (off_e < nelem) {
                                ib_emit(ctx, ir_inst(ir_store(), base + off_e * stride + fidx, val, 0, 0))
                            }
                        } else {
                            var idx = lower_expr(ctx, src, idx_node)
                            var sr = ib_fresh_vreg(ctx)
                            ib_emit(ctx, ir_inst(ir_const(), sr, stride, 0, 0))
                            var scaled = ib_fresh_vreg(ctx)
                            ib_emit(ctx, ir_inst(ir_mul(), scaled, idx, sr, 0))
                            var fr = ib_fresh_vreg(ctx)
                            ib_emit(ctx, ir_inst(ir_const(), fr, fidx, 0, 0))
                            var off = ib_fresh_vreg(ctx)
                            ib_emit(ctx, ir_inst(ir_add(), off, scaled, fr, 0))
                            ib_emit(ctx, ir_inst(ir_array_store(), base, off, val, total))
                        }
                    }
                }
            }
            return 0
        }
        if ast_kind(obj_node) == nd_ident() {
            var obj_name = ib_tok_text(ctx, src, ast_child(obj_node, 0))
            var base = ib_lookup_local(ctx, src, obj_name)
            var alen = ib_lookup_array_len(ctx, src, obj_name)
            var stride = ib_lookup_array_stride(ctx, src, obj_name)
            var sty = ib_lookup_struct_ty(ctx, src, obj_name)
            if ((base < 0) == 0) & (stride == 0) & (sty != ib_struct_ty_none()) {
                var fidx = ib_struct_field_index(ctx, src, sty, field_tok)
                if ((fidx < 0) == 0 & fidx < alen) {
                    var val = lower_expr(ctx, src, value)
                    ib_emit(ctx, ir_inst(ir_store(), base + fidx, val, 0, 0))
                }
            }
        }
        return 0
    }
    if ast_kind(target) == nd_index() {
        var obj = ast_child(target, 0)
        var idx_node = ast_child(target, 1)
        if ast_kind(obj) == nd_ident() {
            var name = ib_tok_text(ctx, src, ast_child(obj, 0))
            var base = ib_lookup_local(ctx, src, name)
            var alen = ib_lookup_array_len(ctx, src, name)
            var stride = ib_lookup_array_stride(ctx, src, name)
            if ((base < 0) == 0) & (stride == 1) & (alen > 1) {
                if ast_kind(idx_node) == nd_int_lit() {
                    var off = ast_child(idx_node, 0)
                    if ((off < 0) == 0 & off < alen) {
                        var val = lower_expr(ctx, src, value)
                        ib_emit(ctx, ir_inst(ir_store(), base + off, val, 0, 0))
                    }
                } else {
                    var idx = lower_expr(ctx, src, idx_node)
                    var val = lower_expr(ctx, src, value)
                    ib_emit(ctx, ir_inst(ir_array_store(), base, idx, val, alen))
                }
            }
        }
        return 0
    }
    return 0
}

// --- Statement lowering ---
// lower_stmt calls lower_block (defined later); seed supports forward refs.

func lower_stmt(ctx: int, src: str, node: int): int {
    var kind = ast_kind(node)

    if kind == nd_var_decl() {
        var name_tok = ast_child(node, 0)
        var type_node = ast_child(node, 1)
        var init = ast_child(node, 2)

        if (type_node < 0) == 0 {
            if ast_kind(type_node) == nd_type_array() {
                if (init < 0) == 0 {
                    if ast_kind(init) == nd_array_lit() {
                        if lower_stmt_var_array(ctx, src, name_tok, type_node, init) == 1 { return 0 }
                    }
                }
            }
        }

        if (type_node < 0) == 0 {
            if ast_kind(type_node) == nd_type_name() {
                if (init < 0) == 0 {
                    if ast_kind(init) == nd_obj_lit() {
                        var type_name_tok = ast_child(type_node, 0)
                        if lower_stmt_var_struct(ctx, src, name_tok, type_name_tok, init) == 1 { return 0 }
                    }
                }
            }
        }

        // Infer struct type from `var p = Point { ... }` when no `::` annotation.
        if (init < 0) == 0 {
            if ast_kind(init) == nd_obj_lit() {
                var lit_ty = ast_child(init, 0)
                if lower_stmt_var_struct(ctx, src, name_tok, lit_ty, init) == 1 { return 0 }
            }
        }

        // Enum local: `var e = Color::Red` / `var o: Option = None` /
        // `var e = Opt::Some(5)`.
        if lower_stmt_var_enum(ctx, src, name_tok, type_node, init) == 1 { return 0 }

        var slot = ib_define_local(ctx, name_tok)
        ib_emit(ctx, ir_inst(ir_alloca(), slot, 0, 0, 0))
        if (init < 0) == 0 {
            var val = lower_expr(ctx, src, init)
            ib_emit(ctx, ir_inst(ir_store(), slot, val, 0, 0))
            if (ib_expr_is_text(ctx, src, init) == 1) | (ib_type_node_is_text(ctx, src, type_node) == 1) {
                ib_mark_text(ctx, slot)
            }
        }
        return 0
    }

    if kind == nd_assign() { return lower_stmt_assign(ctx, src, node) }

    if kind == nd_return() {
        var expr = ast_child(node, 0)
        if (expr < 0) {
            ib_emit(ctx, ir_inst(ir_ret_void(), 0, 0, 0, 0))
        } else {
            var val = lower_expr(ctx, src, expr)
            ib_emit(ctx, ir_inst(ir_ret(), 0, val, 0, 0))
        }
        return 0
    }

    if kind == nd_if() { return lower_stmt_if(ctx, src, node) }

    if kind == nd_while() { return lower_while_stmt(ctx, src, node) }

    if kind == nd_flux() { return lower_stmt_flux(ctx, src, node) }

    if kind == nd_expr_stmt() {
        lower_expr(ctx, src, ast_child(node, 0))
        return 0
    }

    if kind == nd_block() {
        lower_block(ctx, src, node)
        return 0
    }

    return 0
}

func lower_block(ctx: int, src: str, node: int): int {
    if (node < 0) { return 0 }
    var kind = ast_kind(node)
    if kind == nd_block() {
        var stmts = ast_child(node, 0)
        var n = int_vec_len(stmts)
        var scope = ib_scope_push(ctx)
        var i = 0
        while (i < n) {
            lower_stmt(ctx, src, int_vec_get(stmts, i))
            i = i + 1
        }
        ib_scope_pop(ctx, scope)
    } else {
        lower_stmt(ctx, src, node)
    }
    return 0
}

// --- Function lowering ---

func lower_func(ctx: int, src: str, node: int): int {
    return lower_func_opts(ctx, src, node, 0 - 1, 0)
}

// Lower a function. If |class_type_tok| >= 0, inject implicit `self` as param 0
// (struct receiver for class-body methods, Issue #57).
func lower_func_opts(ctx: int, src: str, node: int, class_type_tok: int, inject_self: int): int {
    var name_tok = ast_child(node, 0)
    var params_h = ast_child(node, 1)
    var ret_type = ast_child(node, 2)
    var body     = ast_child(node, 3)

    var pcount = int_vec_len(params_h)
    var total_params = pcount
    if inject_self == 1 {
        total_params = pcount + 1
    }

    var ret_ty = ir_ty_int()
    if (ret_type < 0) == 0 {
        if ast_kind(ret_type) == nd_type_name() {
            var tname = ib_tok_text(ctx, src, ast_child(ret_type, 0))
            if str_eq(tname, "void") == 1 { ret_ty = ir_ty_void() }
            if str_eq(tname, "str") == 1  { ret_ty = ir_ty_str() }
            if str_eq(tname, "text") == 1 { ret_ty = ir_ty_text() }
            if str_eq(tname, "bool") == 1 { ret_ty = ir_ty_bool() }
        }
    }

    var f = ir_func_new(name_tok, total_params, ret_ty)
    bctx_set_func(ctx, f)
    bctx_set_vreg(ctx, 0)
    bctx_set_label(ctx, 0)
    bctx_set_text_vregs(ctx, int_vec_new())

    var scope = ib_scope_push(ctx)

    var entry = ir_block_new(ib_fresh_label(ctx))
    ib_add_blk(ctx, entry)
    ib_set_blk(ctx, entry)

    var pi = 0
    if inject_self == 1 {
        var self_tok = ib_find_self_tok(body, bctx_toks(ctx))
        if (self_tok < 0) {
            self_tok = name_tok
        }
        var sw = ib_type_struct_width(ctx, src, class_type_tok)
        if (sw > 0) {
            var base = ib_define_struct_local(ctx, self_tok, sw, class_type_tok)
            ib_emit(ctx, ir_inst(ir_param(), base, 0, 0, 0))
        } else {
            var slot0 = ib_define_local(ctx, self_tok)
            ib_emit(ctx, ir_inst(ir_param(), slot0, 0, 0, 0))
        }
        pi = 1
    }

    var i = 0
    while (i < pcount) {
        var p = int_vec_get(params_h, i)
        var slot = ib_define_local(ctx, ast_child(p, 0))
        ib_emit(ctx, ir_inst(ir_param(), slot, pi, 0, 0))
        if ib_type_node_is_text(ctx, src, ast_child(p, 1)) == 1 {
            ib_mark_text(ctx, slot)
        }
        pi = pi + 1
        i = i + 1
    }

    lower_block(ctx, src, body)

    ib_scope_pop(ctx, scope)
    mod_add_func(bctx_mod(ctx), f)
    return 0
}

// Find first `self` identifier token under |node|, or -1.
func ib_find_self_tok(node: int, toks: int): int {
    if (node < 0) { return 0 - 1 }
    var kind = ast_kind(node)
    if kind == nd_ident() {
        var t = ast_child(node, 0)
        if tok_kind(toks, t) == tk_self() {
            return t
        }
        return 0 - 1
    }
    if kind == nd_field() {
        return ib_find_self_tok(ast_child(node, 0), toks)
    }
    if kind == nd_assign() {
        var a = ib_find_self_tok(ast_child(node, 0), toks)
        if (a < 0) == 0 { return a }
        return ib_find_self_tok(ast_child(node, 1), toks)
    }
    if kind == nd_binop() {
        var a = ib_find_self_tok(ast_child(node, 1), toks)
        if (a < 0) == 0 { return a }
        return ib_find_self_tok(ast_child(node, 2), toks)
    }
    if kind == nd_return() {
        var e = ast_child(node, 0)
        if (e < 0) == 0 { return ib_find_self_tok(e, toks) }
        return 0 - 1
    }
    if kind == nd_block() {
        var stmts = ast_child(node, 0)
        var i = 0
        while (i < int_vec_len(stmts)) {
            var f = ib_find_self_tok(int_vec_get(stmts, i), toks)
            if (f < 0) == 0 { return f }
            i = i + 1
        }
        return 0 - 1
    }
    if kind == nd_var_decl() {
        var init = ast_child(node, 2)
        if (init < 0) == 0 { return ib_find_self_tok(init, toks) }
        return 0 - 1
    }
    if kind == nd_if() {
        var a = ib_find_self_tok(ast_child(node, 0), toks)
        if (a < 0) == 0 { return a }
        a = ib_find_self_tok(ast_child(node, 1), toks)
        if (a < 0) == 0 { return a }
        var els = ast_child(node, 2)
        if (els < 0) == 0 {
            if (els == 2147483647) == 0 {
                return ib_find_self_tok(els, toks)
            }
        }
        return 0 - 1
    }
    if kind == nd_expr_stmt() {
        return ib_find_self_tok(ast_child(node, 0), toks)
    }
    if kind == nd_call() {
        var a = ib_find_self_tok(ast_child(node, 0), toks)
        if (a < 0) == 0 { return a }
        var args = ast_child(node, 1)
        var ai = 0
        while (ai < int_vec_len(args)) {
            var f = ib_find_self_tok(int_vec_get(args, ai), toks)
            if (f < 0) == 0 { return f }
            ai = ai + 1
        }
        return 0 - 1
    }
    return 0 - 1
}

func lower_extern(ctx: int, src: str, node: int): int {
    var name_tok = ast_child(node, 0)
    var m = bctx_mod(ctx)
    var nm = ib_tok_text(ctx, src, name_tok)
    var ec = mod_extern_count(m)
    var ei = 0
    while (ei < ec) {
        var prev = int_vec_get(mod_externs(m), ei)
        if str_eq(ib_tok_text(ctx, src, prev), nm) == 1 {
            return 0
        }
        ei = ei + 1
    }
    mod_add_extern(m, name_tok)
    return 0
}

func lower_global(ctx: int, src: str, node: int): int {
    var name_tok = ast_child(node, 0)
    var name = ib_tok_text(ctx, src, name_tok)
    var init = ast_child(node, 2)
    var gtype = ir_ty_int()
    var init_val = 0
    if (init < 0) == 0 {
        var ik = ast_kind(init)
        // Enum variant init: the global holds the variant tag.
        var gv = ib_variant_ctor_node(ctx, src, init)
        if gv >= 0 {
            init_val = ast_child(gv, 2)
        } else {
        if ik == nd_int_lit() {
            init_val = ast_child(init, 0)
        } else {
            if ik == nd_bool_lit() {
                init_val = ast_child(init, 0)
            } else {
                if ik == nd_str_lit() {
                    var tok_idx = ast_child(init, 0)
                    init_val = int_vec_len(bctx_str_vec(ctx))
                    int_vec_push(bctx_str_vec(ctx), tok_idx)
                    gtype = ir_ty_str()
                } else {
                if ik == nd_text_lit() {
                    var tok_idx_t = ast_child(init, 0)
                    init_val = int_vec_len(bctx_str_vec(ctx))
                    int_vec_push(bctx_str_vec(ctx), tok_idx_t)
                    gtype = ir_ty_text()
                } else {
                    if ik == nd_unary() {
                        var uo = ast_child(init, 0)
                        var uoperand = ast_child(init, 1)
                        if (uo == unop_neg()) & (ast_kind(uoperand) == nd_int_lit()) {
                            init_val = 0 - ast_child(uoperand, 0)
                        }
                    }
                    if ik == nd_unary() {
                    } else {
                        var r = lower_expr(ctx, src, init)
                        init_val = 0
                    }
                }
                }
            }
        }
        }
    }
    var g = ir_global_new(name_tok, gtype, init_val)
    mod_add_global(bctx_mod(ctx), g)
    int_vec_push(bctx_global_names(ctx), ib_name_hash(name))
    int_vec_push(bctx_global_vals(ctx), init_val)
    return 0
}

// --- File lowering ---

func lower_file(ctx: int, src: str, file_node: int): int {
    var children = ast_child(file_node, 0)
    var n = int_vec_len(children)
    var i = 0
    while (i < n) {
        var child = int_vec_get(children, i)
        var kind = ast_kind(child)
        if kind == nd_import() {
            // Native pipeline always builds IR from merge_file_sources / merge_package_sources:
            // one lex stream and one AST for the whole translation unit. Do not re-parse imports
            // here — per-file AST nodes use token indices into that file's lexer, which would not
            // match bctx_toks (merged). Skipping avoids missing user helpers (e.g. stderr) and
            // bogus di_runtime_* calls at codegen.
        }
        if kind == nd_func() {
            lower_func(ctx, src, child)
        }
        if kind == nd_impl() {
            var methods = ast_child(child, 2)
            var mi = 0
            while (mi < int_vec_len(methods)) {
                var m = int_vec_get(methods, mi)
                if ast_kind(m) == nd_func() {
                    lower_func(ctx, src, m)
                }
                mi = mi + 1
            }
        }
        if kind == nd_class() {
            var class_tok = ast_child(child, 0)
            var members = ast_child(child, 1)
            var mj = 0
            while (mj < int_vec_len(members)) {
                var mem = int_vec_get(members, mj)
                if ast_kind(mem) == nd_func() {
                    lower_func_opts(ctx, src, mem, class_tok, 1)
                }
                mj = mj + 1
            }
        }
        if kind == nd_extern_func() {
            lower_extern(ctx, src, child)
        }
        if kind == nd_var_decl() {
            lower_global(ctx, src, child)
        }
        i = i + 1
    }
    return bctx_mod(ctx)
}

// --- Public entry point ---
// Returns int_vec: [module_handle, str_vec_handle]

func build_ir(src: str, toks: int, file_node: int): int {
    var ctx = bctx_new(src, toks)
    mut_set(int_vec_get(ctx, 13), file_node)
    var m = lower_file(ctx, src, file_node)
    var result = int_vec_new()
    int_vec_push(result, m)
    int_vec_push(result, bctx_str_vec(ctx))
    return result
}
