// IR dump utilities — for debugging and IR inspection.

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "tokens.diva"
import "ir.diva"

func dump_vreg_str(n: int): str {
    return int_to_str(n)
}

func dump_block(blk: int, src: str, toks: int): int {
    print_str("  bb")
    print_str(int_to_str(block_label(blk)))
    print_str(":")
    print_str("")
    var insts = block_insts(blk)
    var ic = int_vec_len(insts)
    var i = 0
    while i < ic {
        dump_inst(int_vec_get(insts, i), src, toks)
        i = i + 1
    }
    return 0
}

func dump_inst(inst: int, src: str, toks: int): int {
    var op = inst_op(inst)
    var res = inst_result(inst)
    var a = inst_a(inst)
    var bv = inst_b(inst)
    var b = str_builder_new()
    str_builder_append(b, "    v")
    str_builder_append(b, dump_vreg_str(res))
    str_builder_append(b, " = ")
    if op == ir_const() {
        str_builder_append(b, "const ")
        str_builder_append(b, int_to_str(a))
    } else {
    if op == ir_const_str() {
        str_builder_append(b, "const.str str[")
        str_builder_append(b, int_to_str(a))
        str_builder_append(b, "]")
    } else {
    if op == ir_add() { str_builder_append(b, "add ") }
    if op == ir_sub() { str_builder_append(b, "sub ") }
    if op == ir_mul() { str_builder_append(b, "mul ") }
    if op == ir_div() { str_builder_append(b, "div ") }
    if op == ir_mod() { str_builder_append(b, "mod ") }
    if op == ir_eq()  { str_builder_append(b, "eq ") }
    if op == ir_ne()  { str_builder_append(b, "ne ") }
    if op == ir_lt()  { str_builder_append(b, "lt ") }
    if op == ir_le()  { str_builder_append(b, "le ") }
    if op == ir_gt()  { str_builder_append(b, "gt ") }
    if op == ir_ge()  { str_builder_append(b, "ge ") }
    if op == ir_and() { str_builder_append(b, "and ") }
    if op == ir_or()  { str_builder_append(b, "or ") }
    if op == ir_not() { str_builder_append(b, "not ") }
    if op == ir_neg() { str_builder_append(b, "neg ") }
    if op == ir_load() { str_builder_append(b, "load ") }
    if op == ir_store() { str_builder_append(b, "store ") }
    if op == ir_alloca() { str_builder_append(b, "alloca") }
    if op == ir_param() {
        str_builder_append(b, "param ")
        str_builder_append(b, int_to_str(a))
    }
    if op == ir_call() {
        str_builder_append(b, "call ")
        str_builder_append(b, tok_text(src, toks, a))
        str_builder_append(b, " argc=")
        str_builder_append(b, int_to_str(bv))
    }
    if op == ir_ret() { str_builder_append(b, "ret ") }
    if op == ir_ret_void() { str_builder_append(b, "ret.void") }
    if op == ir_br() {
        str_builder_append(b, "br bb")
        str_builder_append(b, int_to_str(a))
    }
    if op == ir_br_cond() {
        str_builder_append(b, "br.cond bb")
        str_builder_append(b, int_to_str(a))
        str_builder_append(b, ", bb")
        str_builder_append(b, int_to_str(bv))
    }
    if a >= 0 {
        str_builder_append(b, "v")
        str_builder_append(b, dump_vreg_str(a))
    }
    if bv >= 0 {
        str_builder_append(b, ", v")
        str_builder_append(b, dump_vreg_str(bv))
    }
    }
    }
    print_str(str_builder_to_str(b))
    str_builder_free(b)
    print_str("")
    return 0
}

func dump_func(f: int, src: str, toks: int): int {
    var b = str_builder_new()
    str_builder_append(b, "func ")
    str_builder_append(b, tok_text(src, toks, func_name_tok(f)))
    str_builder_append(b, "(")
    var pc = func_param_count(f)
    var i = 0
    while i < pc {
        if i > 0 { str_builder_append(b, ", ") }
        str_builder_append(b, dump_vreg_str(i))
        i = i + 1
    }
    str_builder_append(b, ")")
    var rt = func_ret_type(f)
    if rt == ir_ty_void() { str_builder_append(b, " -> void") }
    if rt == ir_ty_int()  { str_builder_append(b, " -> int") }
    if rt == ir_ty_str()  { str_builder_append(b, " -> str") }
    if rt == ir_ty_bool() { str_builder_append(b, " -> bool") }
    str_builder_append(b, " {")
    print_str(str_builder_to_str(b))
    str_builder_free(b)

    var bc = func_block_count(f)
    i = 0
    while i < bc {
        dump_block(func_get_block(f, i), src, toks)
        i = i + 1
    }
    print_str("}")
    print_str("")
    return 0
}

func dump_module(m: int, src: str, toks: int): int {
    print_str("; Diva IR dump")
    print_str("")
    
    var total_funcs = mod_func_count(m)
    print_str("; Module has ")
    print_str(int_to_str(total_funcs))
    print_str(" functions")
    print_str("")
    
    print_str("; externs:")
    var ec = mod_extern_count(m)
    var j = 0
    while j < ec {
        var b = str_builder_new()
        str_builder_append(b, ";   ")
        str_builder_append(b, tok_text(src, toks, int_vec_get(mod_externs(m), j)))
        print_str(str_builder_to_str(b))
        str_builder_free(b)
        j = j + 1
    }
    print_str("")
    
    print_str("; funcs:")
    var fi = 0
    while fi < total_funcs {
        var f = mod_get_func(m, fi)
        var fname = tok_text(src, toks, func_name_tok(f))
        print_str(";   ")
        print_str(fname)
        print_str("")
        fi = fi + 1
    }
    print_str("")
    
    var fc = mod_func_count(m)
    var k = 0
    while k < fc {
        dump_func(mod_get_func(m, k), src, toks)
        k = k + 1
    }
    return 0
}