// Diva IR text dump — human-readable representation for debugging.
// Output format mirrors common SSA IR textual forms:
//   func @name(v0, v1) -> int {
//     bb0:
//       v2 = const 42
//       v3 = add v0, v2
//       ret v3
//   }

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "ir.diva"

func dump_vreg(r: int): int {
    var b = str_builder_new()
    str_builder_append(b, "v")
    str_builder_append(b, int_to_str(r))
    stdout(str_builder_to_str(b))
    str_builder_free(b)
    return 0
}

func dump_inst(inst: int): int {
    var op = inst_op(inst)
    stdout("    ")

    if op == ir_const() | op == ir_const_str() | op == ir_add() | op == ir_sub() |
       op == ir_mul() | op == ir_div() | op == ir_mod() | op == ir_neg() |
       op == ir_eq() | op == ir_ne() | op == ir_lt() | op == ir_le() |
       op == ir_gt() | op == ir_ge() | op == ir_and() | op == ir_or() |
       op == ir_not() | op == ir_load() | op == ir_call() | op == ir_param() |
       op == ir_copy() | op == ir_alloca() {
        dump_vreg(inst_result(inst))
        stdout(" = ")
    }

    stdout(ir_op_name(op))

    if op == ir_const() {
        stdout(" ")
        stdout(int_to_str(inst_a(inst)))
    }

    if op == ir_const_str() {
        stdout(" str[")
        stdout(int_to_str(inst_a(inst)))
        stdout("]")
    }

    if op == ir_add() | op == ir_sub() | op == ir_mul() | op == ir_div() | op == ir_mod() |
       op == ir_eq() | op == ir_ne() | op == ir_lt() | op == ir_le() |
       op == ir_gt() | op == ir_ge() | op == ir_and() | op == ir_or() {
        stdout(" ")
        dump_vreg(inst_a(inst))
        stdout(", ")
        dump_vreg(inst_b(inst))
    }

    if op == ir_neg() | op == ir_not() {
        stdout(" ")
        dump_vreg(inst_a(inst))
    }

    if op == ir_load() {
        stdout(" ")
        dump_vreg(inst_a(inst))
    }

    if op == ir_store() {
        stdout(" ")
        dump_vreg(inst_result(inst))
        stdout(", ")
        dump_vreg(inst_a(inst))
    }

    if op == ir_call() {
        stdout(" @fn")
        stdout(int_to_str(inst_a(inst)))
        stdout(" argc=")
        stdout(int_to_str(inst_b(inst)))
    }

    if op == ir_ret() {
        stdout(" ")
        dump_vreg(inst_a(inst))
    }

    if op == ir_br() {
        stdout(" bb")
        stdout(int_to_str(inst_a(inst)))
    }

    if op == ir_br_cond() {
        stdout(" ")
        dump_vreg(inst_result(inst))
        stdout(", bb")
        stdout(int_to_str(inst_a(inst)))
        stdout(", bb")
        stdout(int_to_str(inst_b(inst)))
    }

    if op == ir_param() {
        stdout(" [")
        stdout(int_to_str(inst_a(inst)))
        stdout("]")
    }

    stdout("\n")
    return 0
}

func dump_block(blk: int): int {
    stdout("  bb")
    stdout(int_to_str(block_label(blk)))
    stdout(":\n")
    var insts = block_insts(blk)
    var n = int_vec_len(insts)
    var i = 0
    while i < n {
        dump_inst(int_vec_get(insts, i))
        i = i + 1
    }
    return 0
}

func dump_func(f: int): int {
    stdout("func @fn")
    stdout(int_to_str(func_name_idx(f)))
    stdout("(")
    var pc = func_param_count(f)
    var i = 0
    while i < pc {
        if i > 0 { stdout(", ") }
        dump_vreg(i)
        i = i + 1
    }
    stdout(")")
    var rt = func_ret_type(f)
    if rt == ir_ty_void() { stdout(" -> void") }
    if rt == ir_ty_int()  { stdout(" -> int") }
    if rt == ir_ty_str()  { stdout(" -> str") }
    if rt == ir_ty_bool() { stdout(" -> bool") }
    stdout(" {\n")

    var bc = func_block_count(f)
    i = 0
    while i < bc {
        dump_block(func_get_block(f, i))
        i = i + 1
    }
    stdout("}\n\n")
    return 0
}

func dump_module(m: int): int {
    stdout("; Diva IR dump\n\n")

    var ec = mod_extern_count(m)
    if ec > 0 {
        var i = 0
        while i < ec {
            stdout("extern @fn")
            stdout(int_to_str(int_vec_get(mod_externs(m), i)))
            stdout("\n")
            i = i + 1
        }
        stdout("\n")
    }

    var fc = mod_func_count(m)
    var i = 0
    while i < fc {
        dump_func(mod_get_func(m, i))
        i = i + 1
    }
    return 0
}
