    int_vec_push(n, nd_range())
    int_vec_push(n, start)
    int_vec_push(n, end)
    return n
}

// Text slice: [kind, obj_expr, start_expr, end_expr]
func ast_text_slice(obj: int, start: int, end: int): int {
