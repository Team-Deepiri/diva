func emit_pure_int_vec_push(out: int): int {
    // compiler/res/pure_int_vec_push.s - arena-slot promote to 4KiB mmap + mremap grow
    int_vec_push(out, 83) int_vec_push(out, 65) int_vec_push(out, 84) int_vec_push(out, 65) int_vec_push(out, 85) int_vec_push(out, 65) int_vec_push(out, 86) int_vec_push(out, 73) int_vec_push(out, 137) int_vec_push(out, 252)
