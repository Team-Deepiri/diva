    var v = pure_builtin_extern_id_hi_vec(nm)
    if (v != 0) {
        return v
    }
    v = pure_builtin_extern_id_hi_io(nm)
    if (v != 0) {
        return v
    }
    v = pure_builtin_extern_id_hi_host(nm)
    if (v != 0) {
        return v
    }
    v = pure_builtin_extern_id_hi_mem(nm)
    if (v != 0) {
        return v
    }
    return pure_builtin_extern_id_hi_text(nm)
}

// Dispatch high builtin ids — see docs/seed-codegen-workarounds.md §2.
func emit_pure_builtin_high_vec(out: int, id: int): int {
    if id == 9 { return emit_pure_int_vec_new(out) }
    if id == 10 { return emit_pure_int_vec_push(out) }
    if id == 11 { return emit_pure_int_vec_len(out) }
    if id == 12 { return emit_pure_int_vec_get(out) }
    if id == 13 { return emit_pure_int_vec_free(out) }
    if id == 14 { return emit_pure_str_builder_new(out) }
    if id == 15 { return emit_pure_str_builder_append(out) }
    if id == 16 { return emit_pure_str_builder_len(out) }
    if id == 17 { return emit_pure_str_builder_to_str(out) }
    if id == 18 { return emit_pure_str_builder_free(out) }
    return 0
}

func emit_pure_builtin_high_misc(out: int, id: int): int {
    if id == 19 { return emit_pure_print_hex(out) }
    if id == 20 { return emit_pure_int_to_str(out) }
    if id == 21 { return emit_pure_str_slice(out) }
    if id == 22 { return emit_pure_file_size(out) }
    if id == 23 { return emit_pure_read_file(out) }
    if id == 24 { return emit_pure_host_argc(out) }
    if id == 25 { return emit_pure_host_argv(out) }
    if id == 26 { return emit_pure_host_getenv(out) }
    if id == 27 { return emit_pure_host_system(out) }
    if id == 28 { return emit_pure_mkdir(out) }
    if id == 29 { return emit_pure_write_text_file(out) }
    if id == 30 { return emit_pure_unlink(out) }
    if id == 31 { return emit_pure_chmod_executable(out) }
    if id == 32 { return emit_pure_write_elf_chunk(out) }
    if id == 33 { return emit_pure_mem_alloc(out) }
    if id == 34 { return emit_pure_mem_free(out) }
    if id == 35 { return emit_pure_mem_get(out) }
    if id == 36 { return emit_pure_mem_set(out) }
    if id == 37 { return emit_pure_str_from_text(out) }
    if id == 38 { return emit_pure_text_len(out) }
    if id == 39 { return emit_pure_text_from_str(out) }
    if id == 40 { return emit_pure_text_byte(out) }
    if id == 41 { return emit_pure_text_cmp(out) }
    if id == 42 { return emit_pure_text_concat(out) }
    if id == 43 { return emit_pure_text_slice(out) }
    return 0
}

func emit_pure_builtin_high(out: int, id: int): int {
    if (id < 19) {
        return emit_pure_builtin_high_vec(out, id)
    }
    return emit_pure_builtin_high_misc(out, id)
}

//@diva-file:/home/joeblack/Documents/diva/compiler/src/codegen_x86.diva
// x86_64 assembly codegen from Diva IR (AT&T / gas).
// Labels: user main() -> main (CRT entry); other user funcs -> _diva_<name>;
// extern calls -> di_runtime_<name> (matches runtime .o symbols).

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "pure_elf_builtins.diva"
import "ir.diva"
import "tokens.diva"
import "cell.diva"
import "name_pool.diva"

func lp_new(): int { return mut_new(str_builder_new()) }

func lp_add(lp: int, s: str): int {
    str_builder_append(mut_get(lp), s)
    return 0
}

func lp_add_int(lp: int, n: int): int {
    str_builder_append(mut_get(lp), int_to_str(n))
    return 0
}

// Append completed line to sb followed by nl (real newline str).
func lp_flush_sb(lp: int, sb: int, nl: str): int {
    var cur = mut_get(lp)
    str_builder_append(sb, str_builder_to_str(cur))
    str_builder_append(sb, nl)
    str_builder_free(cur)
    mut_set(lp, str_builder_new())
    return 0
}

func lp_flush_print(lp: int): int {
    var old = mut_get(lp)
    print_str(str_builder_to_str(old))
    str_builder_free(old)
    mut_set(lp, str_builder_new())
    return 0
}

func stack_offset(slot: int): str {
    var b = str_builder_new()
    str_builder_append(b, "-")
    str_builder_append(b, int_to_str((slot + 1) * 8))
    str_builder_append(b, "(%rbp)")
    var r = str_builder_to_str(b)
    str_builder_free(b)
    return r
}

func cg_func_name(m: int, src: str, toks: int, name_tok: int): str {
    if name_pool_is_synthetic(name_tok) == 1 {
        var pool = mod_name_pool(m)
        if pool >= 0 {
            var nm = name_pool_text(pool, name_tok)
            if str_len(nm) > 0 {
                return nm
            }
        }
        return "_syn"
    }
    return tok_text(src, toks, name_tok)
}

func asm_user_label_m(m: int, src: str, toks: int, name_tok: int): str {
    var nm = cg_func_name(m, src, toks, name_tok)
    if str_eq(nm, "main") == 1 {
        return "main"
    }
    var b = str_builder_new()
    str_builder_append(b, "_diva_")
    str_builder_append(b, nm)
    var r = str_builder_to_str(b)
    str_builder_free(b)
    return r
}

func asm_user_label(src: str, toks: int, name_tok: int): str {
    var nm = tok_text(src, toks, name_tok)
    if str_eq(nm, "main") == 1 {
        return "main"
    }
    var b = str_builder_new()
    str_builder_append(b, "_diva_")
    str_builder_append(b, nm)
    var r = str_builder_to_str(b)
    str_builder_free(b)
    return r
}

func asm_runtime_label(src: str, toks: int, name_tok: int): str {
    var nm = tok_text(src, toks, name_tok)
    if str_eq(nm, "set_argv") == 1 { return "di_runtime_set_argv" }
    if str_eq(nm, "argc") == 1 { return "di_runtime_argc" }
    if str_eq(nm, "argv") == 1 { return "di_runtime_argv" }
    if str_eq(nm, "host_argc") == 1 { return "di_runtime_argc" }
    if str_eq(nm, "host_argv") == 1 { return "di_runtime_argv" }
    if str_eq(nm, "getenv") == 1 { return "di_runtime_getenv" }
    if str_eq(nm, "host_getenv") == 1 { return "di_runtime_getenv" }
    if str_eq(nm, "system") == 1 { return "di_runtime_system" }
    if str_eq(nm, "host_system") == 1 { return "di_runtime_system" }
    if str_eq(nm, "file_size") == 1 { return "di_runtime_file_size" }
    if str_eq(nm, "read_file") == 1 { return "di_runtime_read_file" }
    if str_eq(nm, "str_len") == 1 { return "di_runtime_str_len" }
    if str_eq(nm, "str_byte") == 1 { return "di_runtime_str_byte" }
    if str_eq(nm, "str_slice") == 1 { return "di_runtime_str_slice" }
    if str_eq(nm, "str_eq") == 1 { return "di_runtime_str_eq" }
    if str_eq(nm, "int_to_str") == 1 { return "di_runtime_int_to_str" }
    if str_eq(nm, "int_vec_new") == 1 { return "di_runtime_int_vec_new" }
    if str_eq(nm, "int_vec_push") == 1 { return "di_runtime_int_vec_push" }
    if str_eq(nm, "int_vec_len") == 1 { return "di_runtime_int_vec_len" }
    if str_eq(nm, "int_vec_get") == 1 { return "di_runtime_int_vec_get" }
    if str_eq(nm, "int_vec_free") == 1 { return "di_runtime_int_vec_free" }
    if str_eq(nm, "str_builder_new") == 1 { return "di_runtime_str_builder_new" }
    if str_eq(nm, "str_builder_append") == 1 { return "di_runtime_str_builder_append" }
    if str_eq(nm, "str_builder_len") == 1 { return "di_runtime_str_builder_len" }
    if str_eq(nm, "str_builder_to_str") == 1 { return "di_runtime_str_builder_to_str" }
    if str_eq(nm, "str_builder_free") == 1 { return "di_runtime_str_builder_free" }
    if str_eq(nm, "print_int") == 1 { return "di_runtime_print_int" }
    if str_eq(nm, "print_str") == 1 { return "di_runtime_print_str" }
    if str_eq(nm, "print_hex") == 1 { return "di_runtime_print_hex" }
    if str_eq(nm, "write") == 1 { return "di_runtime_write" }
    if str_eq(nm, "exit") == 1 { return "di_runtime_exit" }
    if str_eq(nm, "abort") == 1 { return "di_runtime_abort" }
    if str_eq(nm, "mkdir") == 1 { return "di_runtime_mkdir" }
    if str_eq(nm, "write_text_file") == 1 { return "di_runtime_write_text_file" }
    if str_eq(nm, "unlink") == 1 { return "di_runtime_unlink" }
    if str_eq(nm, "chmod_executable") == 1 { return "di_runtime_chmod_executable" }
    if str_eq(nm, "write_elf_chunk") == 1 { return "di_runtime_write_elf_chunk" }
    return nm
}

func call_is_extern(m: int, src: str, toks: int, call_tok: int): int {
    if name_pool_is_synthetic(call_tok) == 1 {
        return 0
    }
    var cname = cg_func_name(m, src, toks, call_tok)
    var fc = mod_func_count(m)
    var i = 0
    while (i < fc) {
        var ftok = func_name_tok(mod_get_func(m, i))
        if str_eq(cg_func_name(m, src, toks, ftok), cname) == 1 {
            return 0
        }
        i = i + 1
    }
    return 1
}

func abi_reg_name(i: int): str {
    if i == 0 { return "%rdi" }
    if i == 1 { return "%rsi" }
    if i == 2 { return "%rdx" }
    if i == 3 { return "%rcx" }
    if i == 4 { return "%r8" }
    if i == 5 { return "%r9" }
    return "%rdi"
}

func bb_label(func_idx: int, lbl: int): str {
    var b = str_builder_new()
    str_builder_append(b, ".L")
    str_builder_append(b, int_to_str(func_idx))
    str_builder_append(b, "_")
    str_builder_append(b, int_to_str(lbl))
    var r = str_builder_to_str(b)
    str_builder_free(b)
    return r
}

// Pack int-only codegen context to avoid >6 arg call sites in self-hosted codegen.
// [0]=lp [1]=sb [2]=m [3]=toks [4]=fi
func cg_ctx_new(lp: int, sb: int, m: int, toks: int, fi: int): int {
    var c = int_vec_new()
    int_vec_push(c, lp)
    int_vec_push(c, sb)
    int_vec_push(c, m)
    int_vec_push(c, toks)
    int_vec_push(c, fi)
    return c
}

func cg_ctx_lp(c: int): int { return int_vec_get(c, 0) }
func cg_ctx_sb(c: int): int { return int_vec_get(c, 1) }
func cg_ctx_m(c: int): int { return int_vec_get(c, 2) }
func cg_ctx_toks(c: int): int { return int_vec_get(c, 3) }
func cg_ctx_fi(c: int): int { return int_vec_get(c, 4) }
// Per-function context for pass-1 / pass-2 binary codegen.
// [0]=m [1]=toks [2]=main_fi [3]=fi
func cg_p2fctx_new(m: int, toks: int, main_fi: int, fi: int): int {
    var c = int_vec_new()
    int_vec_push(c, m)
    int_vec_push(c, toks)
    int_vec_push(c, main_fi)
    int_vec_push(c, fi)
    return c
}
func cg_p2fctx_m(c: int): int { return int_vec_get(c, 0) }
func cg_p2fctx_toks(c: int): int { return int_vec_get(c, 1) }
func cg_p2fctx_main_fi(c: int): int { return int_vec_get(c, 2) }
func cg_p2fctx_fi(c: int): int { return int_vec_get(c, 3) }

// Branch-table context. [0]=fi_vec [1]=lb_vec [2]=off_vec
func brtab_new(): int {
    var c = int_vec_new()
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    return c
}
func brtab_fi(t: int): int { return int_vec_get(t, 0) }
func brtab_lb(t: int): int { return int_vec_get(t, 1) }
func brtab_off(t: int): int { return int_vec_get(t, 2) }
func brtab_free(t: int): int {
    int_vec_free(int_vec_get(t, 0))
    int_vec_free(int_vec_get(t, 1))
    int_vec_free(int_vec_get(t, 2))
    int_vec_free(t)
    return 0
}

// Pass-2 output context. [0]=out [1]=func_offsets [2]=str_cum [3]=instr_total
func p2out_new(out: int, func_offsets: int, str_cum: int, instr_total: int): int {
    var c = int_vec_new()
    int_vec_push(c, out)
    int_vec_push(c, func_offsets)
    int_vec_push(c, str_cum)
    int_vec_push(c, instr_total)
    return c
}
func p2out_out(c: int): int { return int_vec_get(c, 0) }
func p2out_func_offsets(c: int): int { return int_vec_get(c, 1) }
func p2out_str_cum(c: int): int { return int_vec_get(c, 2) }
func p2out_instr_total(c: int): int { return int_vec_get(c, 3) }


func cg_inst_mem(ctx: int, src: str, nl: str, inst: int): int {
    var lp = cg_ctx_lp(ctx)
    var sb = cg_ctx_sb(ctx)
    var op = inst_op(inst)
    var res = inst_result(inst)
    var a = inst_a(inst)
    var bv = inst_b(inst)
    if op == ir_const() {
        lp_add(lp, "    movq $") lp_add_int(lp, a) lp_add(lp, ", ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 1
    }
    if op == ir_const_str() | op == ir_const_text() {
        lp_add(lp, "    leaq .Lstr") lp_add_int(lp, a) lp_add(lp, "(%rip), %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 1
    }
    if op == ir_load() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 1
    }
    if op == ir_store() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 1
    }
    if op == ir_array_load() {
        var alen = inst_extra(inst)
        if (alen > 0) & (alen < 128) {
            lp_add(lp, "    movq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "    cmpq $0, %rax") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "    jl 1f") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "    cmpq $") lp_add_int(lp, alen) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "    jge 1f") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "    jmp 2f") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "1:") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "    movl $1, %edi") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "    movl $60, %eax") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "    syscall") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "2:") lp_flush_sb(lp, sb, nl)
        }
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rdx") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    negq %rdx") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    leaq -") lp_add_int(lp, (a + 1) * 8) lp_add(lp, "(%rbp,%rdx,8), %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq (%rax), %rdx") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rdx, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 1
    }
    if op == ir_array_store() {
        var alen2 = inst_extra(inst)
        if (alen2 > 0) & (alen2 < 128) {
            lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "    cmpq $0, %rax") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "    jl 1f") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "    cmpq $") lp_add_int(lp, alen2) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "    jge 1f") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "    jmp 2f") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "1:") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "    movl $1, %edi") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "    movl $60, %eax") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "    syscall") lp_flush_sb(lp, sb, nl)
            lp_add(lp, "2:") lp_flush_sb(lp, sb, nl)
        }
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rdx") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    negq %rdx") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    leaq -") lp_add_int(lp, (res + 1) * 8) lp_add(lp, "(%rbp,%rdx,8), %rcx") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, (%rcx)") lp_flush_sb(lp, sb, nl)
        return 1
    }
    if op == ir_global_load() {
        var gl = mod_get_global(cg_ctx_m(ctx), a)
        var gln = tok_text(src, cg_ctx_toks(ctx), global_name_tok(gl))
        lp_add(lp, "    movq ") lp_add(lp, gln) lp_add(lp, "(%rip), %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 1
    }
    if op == ir_global_store() {
        var gs = mod_get_global(cg_ctx_m(ctx), res)
        var gsn = tok_text(src, cg_ctx_toks(ctx), global_name_tok(gs))
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, gsn) lp_add(lp, "(%rip)") lp_flush_sb(lp, sb, nl)
        return 1
    }
    if op == ir_alloca() {
        lp_add(lp, "    movq $0, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 1
    }
    if op == ir_param() {
        if a == 0 { lp_add(lp, "    movq %rdi, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl) }
        if a == 1 { lp_add(lp, "    movq %rsi, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl) }
        if a == 2 { lp_add(lp, "    movq %rdx, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl) }
        if a == 3 { lp_add(lp, "    movq %rcx, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl) }
        if a == 4 { lp_add(lp, "    movq %r8, ")  lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl) }
        if a == 5 { lp_add(lp, "    movq %r9, ")  lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl) }
        return 1
    }
    return 0
}

func cg_inst_arith(ctx: int, nl: str, inst: int): int {
    var lp = cg_ctx_lp(ctx)
    var sb = cg_ctx_sb(ctx)
    var op = inst_op(inst)
    var res = inst_result(inst)
    var a = inst_a(inst)
    var bv = inst_b(inst)
    if op_is3(op, ir_add(), ir_sub(), ir_mul()) == 1 {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        if op == ir_add() { lp_add(lp, "    addq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl) }
        if op == ir_sub() { lp_add(lp, "    subq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl) }
        if op == ir_mul() { lp_add(lp, "    imulq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl) }
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 1
    }
    if op_is2(op, ir_div(), ir_mod()) == 1 {
        lp_add(lp, "    movq $0, %rdx") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    cqto") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    idivq ") lp_add(lp, stack_offset(bv)) lp_flush_sb(lp, sb, nl)
        if op == ir_div() { lp_add(lp, "    movq %rax, ") } else { lp_add(lp, "    movq %rdx, ") }
        lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 1
    }
    if op == ir_neg() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    negq %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 1
    }
    return 0
}

func cg_inst_compare(ctx: int, nl: str, inst: int): int {
    var op = inst_op(inst)
    var is_cmp = 0
    if (op_is3(op, ir_eq(), ir_ne(), ir_lt()) == 1) { is_cmp = 1 }
    if (op_is3(op, ir_le(), ir_gt(), ir_ge()) == 1) { is_cmp = 1 }
    if (is_cmp == 1) {
        var lp = cg_ctx_lp(ctx)
        var sb = cg_ctx_sb(ctx)
        var res = inst_result(inst)
        var a = inst_a(inst)
        var bv = inst_b(inst)
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    cmpq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        if op == ir_eq() { lp_add(lp, "    sete %al") lp_flush_sb(lp, sb, nl) }
        if op == ir_ne() { lp_add(lp, "    setne %al") lp_flush_sb(lp, sb, nl) }
        if op == ir_lt() { lp_add(lp, "    setl %al") lp_flush_sb(lp, sb, nl) }
        if op == ir_le() { lp_add(lp, "    setle %al") lp_flush_sb(lp, sb, nl) }
        if op == ir_gt() { lp_add(lp, "    setg %al") lp_flush_sb(lp, sb, nl) }
        if op == ir_ge() { lp_add(lp, "    setge %al") lp_flush_sb(lp, sb, nl) }
        lp_add(lp, "    movzbq %al, %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 1
    }
    return 0
}

func cg_inst_shift_not(ctx: int, nl: str, inst: int): int {
    var lp = cg_ctx_lp(ctx)
    var sb = cg_ctx_sb(ctx)
    var op = inst_op(inst)
    var res = inst_result(inst)
    var a = inst_a(inst)
    var bv = inst_b(inst)
    if op == ir_shl() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rcx") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    salq %cl, %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 1
    }
    if op == ir_shr() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rcx") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    sarq %cl, %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 1
    }
    if op == ir_not() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    testq %rax, %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    sete %al") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movzbq %al, %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 1
    }
    return 0
}

func cg_inst_cmp(ctx: int, nl: str, inst: int): int {
    if (cg_inst_compare(ctx, nl, inst) == 1) { return 1 }
    var lp = cg_ctx_lp(ctx)
    var sb = cg_ctx_sb(ctx)
    var op = inst_op(inst)
    var res = inst_result(inst)
    var a = inst_a(inst)
    var bv = inst_b(inst)
    if op == ir_and() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    andq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 1
    }
    if op == ir_or() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    orq ") lp_add(lp, stack_offset(bv)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    movq %rax, ") lp_add(lp, stack_offset(res)) lp_flush_sb(lp, sb, nl)
        return 1
    }
    return cg_inst_shift_not(ctx, nl, inst)
}

func cg_inst_call_op(ctx: int, nl: str, src: str, inst: int): int {
    var lp = cg_ctx_lp(ctx)
    var sb = cg_ctx_sb(ctx)
    var m = cg_ctx_m(ctx)
    var toks = cg_ctx_toks(ctx)
    var res = inst_result(inst)
    var argc = inst_b(inst)
    if argc == 1 {
        var only_vr = inst_extra(inst)
        lp_add(lp, "    movq ")
        lp_add(lp, stack_offset(only_vr))
        lp_add(lp, ", %rdi")
        lp_flush_sb(lp, sb, nl)
    } else {
        var args = inst_extra(inst)
        var ci = 0
        while (ci < argc) {
            var vr = int_vec_get(args, ci)
            lp_add(lp, "    movq ")
            lp_add(lp, stack_offset(vr))
            lp_add(lp, ", ")
            lp_add(lp, abi_reg_name(ci))
            lp_flush_sb(lp, sb, nl)
            ci = ci + 1
        }
    }
    var ctok = inst_a(inst)
    var lab = ""
    if call_is_extern(m, src, toks, ctok) == 1 {
        lab = asm_runtime_label(src, toks, ctok)
    } else {
        lab = asm_user_label_m(m, src, toks, ctok)
    }
    lp_add(lp, "    call ")
    lp_add(lp, lab)
    lp_flush_sb(lp, sb, nl)
    lp_add(lp, "    movq %rax, ")
    lp_add(lp, stack_offset(res))
    lp_flush_sb(lp, sb, nl)
    return 0
}

func cg_inst_flow(ctx: int, nl: str, inst: int): int {
    var lp = cg_ctx_lp(ctx)
    var sb = cg_ctx_sb(ctx)
    var fi = cg_ctx_fi(ctx)
    var op = inst_op(inst)
    var res = inst_result(inst)
    var a = inst_a(inst)
    var bv = inst_b(inst)
    if op == ir_ret() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(a)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    leaq -8(%rbp), %rsp") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    popq %r15") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    popq %rbp") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    ret") lp_flush_sb(lp, sb, nl)
        return 0
    }
    if op == ir_ret_void() {
        lp_add(lp, "    leaq -8(%rbp), %rsp") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    popq %r15") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    popq %rbp") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    ret") lp_flush_sb(lp, sb, nl)
        return 0
    }
    if op == ir_br() {
        lp_add(lp, "    jmp ") lp_add(lp, bb_label(fi, a)) lp_flush_sb(lp, sb, nl)
        return 0
    }
    if op == ir_br_cond() {
        lp_add(lp, "    movq ") lp_add(lp, stack_offset(res)) lp_add(lp, ", %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    testq %rax, %rax") lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    jne ") lp_add(lp, bb_label(fi, a)) lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    jmp ") lp_add(lp, bb_label(fi, bv)) lp_flush_sb(lp, sb, nl)
        return 0
    }
    return 0
}

func cg_inst(ctx: int, src: str, nl: str, inst: int): int {
    var op = inst_op(inst)
    if (cg_inst_mem(ctx, src, nl, inst) == 1) { return 0 }
    if (cg_inst_arith(ctx, nl, inst) == 1) { return 0 }
    if (cg_inst_cmp(ctx, nl, inst) == 1) { return 0 }
    if op == ir_call() { cg_inst_call_op(ctx, nl, src, inst) return 0 }
    cg_inst_flow(ctx, nl, inst)
    return 0
}

func cg_func(ctx: int, src: str, nl: str, f: int, fi: int): int {
    var lp = cg_ctx_lp(ctx)
    var sb = cg_ctx_sb(ctx)
    var m = cg_ctx_m(ctx)
    var toks = cg_ctx_toks(ctx)
    var fctx = cg_ctx_new(lp, sb, m, toks, fi)
    var flabel = asm_user_label_m(m, src, toks, func_name_tok(f))
    lp_add(lp, "    .globl ") lp_add(lp, flabel) lp_flush_sb(lp, sb, nl)
    lp_add(lp, flabel) lp_add(lp, ":") lp_flush_sb(lp, sb, nl)

    if str_eq(flabel, "main") == 1 {
        lp_add(lp, "    call di_runtime_set_argv") lp_flush_sb(lp, sb, nl)
    }

    var frame_b = func_prologue_frame_bytes(f)
    lp_add(lp, "    pushq %rbp") lp_flush_sb(lp, sb, nl)
    lp_add(lp, "    movq %rsp, %rbp") lp_flush_sb(lp, sb, nl)
    lp_add(lp, "    pushq %r15") lp_flush_sb(lp, sb, nl)
    lp_add(lp, "    subq $")
    lp_add_int(lp, frame_b)
    lp_add(lp, ", %rsp")
    lp_flush_sb(lp, sb, nl)

    var bc = func_block_count(f)
    var bi = 0
    while (bi < bc) {
        var blk = func_get_block(f, bi)
        if (bi > 0) {
            lp_add(lp, bb_label(fi, block_label(blk))) lp_add(lp, ":") lp_flush_sb(lp, sb, nl)
        }
        var insts = block_insts(blk)
        var ic = int_vec_len(insts)
        var ii = 0
        while (ii < ic) {
            cg_inst(fctx, src, nl, int_vec_get(insts, ii))
            ii = ii + 1
        }
        bi = bi + 1
    }
    int_vec_free(fctx)
    lp_flush_sb(lp, sb, nl)
    return 0
}

// Full assembly text (caller frees builder if needed — str is a copy).
func cg_module_to_str(m: int, src: str, toks: int, str_toks: int, nl: str): str {
    var sb = str_builder_new()
    var lp = lp_new()

    lp_add(lp, "    .text") lp_flush_sb(lp, sb, nl)
    lp_flush_sb(lp, sb, nl)

    var fc = mod_func_count(m)
    var fi = 0
    while (fi < fc) {
        // Build per-function ctx so helpers never use >6 args.
        var ctx = cg_ctx_new(lp, sb, m, toks, fi)
        cg_func(ctx, src, nl, mod_get_func(m, fi), fi)
        int_vec_free(ctx)
        fi = fi + 1
    }

    var gc = mod_global_count(m)
    if (gc > 0) {
        lp_flush_sb(lp, sb, nl)
        lp_add(lp, "    .data") lp_flush_sb(lp, sb, nl)
        var gi = 0
        while (gi < gc) {
            var g = mod_get_global(m, gi)
            var gname = tok_text(src, toks, global_name_tok(g))
            lp_add(lp, "    .globl ") lp_add(lp, gname) lp_flush_sb(lp, sb, nl)
            lp_add(lp, gname) lp_add(lp, ":") lp_flush_sb(lp, sb, nl)
            var ginit = global_init(g)
            lp_add(lp, "    .quad ")
            if global_type(g) == ir_ty_str() | global_type(g) == ir_ty_text() {
                lp_add(lp, ".Lstr")
                lp_add_int(lp, ginit)
            } else {
                lp_add_int(lp, ginit)
            }
            lp_flush_sb(lp, sb, nl)
            gi = gi + 1
        }
    }

    if (int_vec_len(str_toks) > 0) {
        lp_add(lp, "    .section .rodata") lp_flush_sb(lp, sb, nl)
        var si = 0
        while (si < int_vec_len(str_toks)) {
            var tok_idx = int_vec_get(str_toks, si)
            var is_text = 0
            if tok_kind(toks, tok_idx) == tk_text_lit() { is_text = 1 }
            var s = ""
            if is_text == 1 {
                s = tok_text_value(src, toks, tok_idx)
            } else {
                s = tok_str_value(src, toks, tok_idx)
            }
            var slen = str_len(s)
            lp_add(lp, ".Lstr") lp_add_int(lp, si) lp_add(lp, ":") lp_flush_sb(lp, sb, nl)
            if is_text == 1 {
                lp_add(lp, "    .quad .Lstrd") lp_add_int(lp, si) lp_flush_sb(lp, sb, nl)
                lp_add(lp, "    .quad ") lp_add_int(lp, slen) lp_flush_sb(lp, sb, nl)
                lp_add(lp, "    .quad ") lp_add_int(lp, slen) lp_flush_sb(lp, sb, nl)
                lp_add(lp, ".Lstrd") lp_add_int(lp, si) lp_add(lp, ":") lp_flush_sb(lp, sb, nl)
            }
            var bi = 0
            while (bi < slen) {
                lp_add(lp, "    .byte ")
                lp_add_int(lp, str_byte(s, bi))
                lp_flush_sb(lp, sb, nl)
                bi = bi + 1
            }
            lp_add(lp, "    .byte 0")
            lp_flush_sb(lp, sb, nl)
            si = si + 1
        }
    }

    var out = str_builder_to_str(sb)
    str_builder_free(sb)
    return out
}

func emit_i32(out: int, val: int): void {
    // Signed int32 little-endian. Do not use (val/256)&255 on negatives — truncating / breaks rel32.
    var i = 0
    var v = val
    while (i < 4) {
        var lo = v - (v / 256) * 256
        if lo < 0 {
            lo = lo + 256
        }
        int_vec_push(out, lo)
        v = (v - lo) / 256
        i = i + 1
    }
}

// Load vaddr of the pure-ELF RX segment (out[0]); fixed at 0x1000 by native_emit_pure_elf.
func native_code_vaddr(): int { return 4096 }

// Little-endian 64-bit append (text literal descriptors' data pointer).
func emit_qword(out: int, val: int): int {
    var i = 0
    var v = val
    while (i < 8) {
        var lo = v - (v / 256) * 256
        if lo < 0 {
            lo = lo + 256
        }
        int_vec_push(out, lo)
        v = (v - lo) / 256
        i = i + 1
    }
    return 0
}

func find_func_index_by_tok(m: int, src: str, toks: int, call_tok: int): int {
    if name_pool_is_synthetic(call_tok) == 1 {
        var ali = mod_alias_lookup(m, call_tok)
        if ali >= 0 {
            return ali
        }
        var pool = mod_name_pool(m)
        if pool >= 0 {
            var cname = name_pool_text(pool, call_tok)
            var fc = mod_func_count(m)
            var best = 0 - 1
            var best_len = 0
            var i = 0
            while (i < fc) {
                var ftok = func_name_tok(mod_get_func(m, i))
                if name_pool_is_synthetic(ftok) == 0 {
                    var fn = tok_text(src, toks, ftok)
                    var fl = str_len(fn)
                    if fl > best_len {
                        if fl <= str_len(cname) {
                        if str_eq(str_slice(cname, 0, fl), fn) == 1 {
                            if fl < str_len(cname) {
                                if str_byte(cname, fl) == 95 {
                                    best = i
                                    best_len = fl
                                }
                            }
                        }
                    }
                    }
                }
                i = i + 1
            }
            if best >= 0 {
                return best
            }
        }
        return 0 - 1
    }
    var cname = cg_func_name(m, src, toks, call_tok)
    var fc = mod_func_count(m)
    var i = 0
    while (i < fc) {
        var ftok = func_name_tok(mod_get_func(m, i))
        if str_eq(cg_func_name(m, src, toks, ftok), cname) == 1 {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

func pure_builtin_extern_id(src: str, toks: int, call_tok: int): int {
    if name_pool_is_synthetic(call_tok) == 1 {
        return 0
    }
    var nm = tok_text(src, toks, call_tok)
    if str_eq(nm, "write") == 1 { return 1 }
    if str_eq(nm, "exit") == 1 { return 2 }
    if str_eq(nm, "abort") == 1 { return 3 }
    if str_eq(nm, "print_str") == 1 { return 4 }
    if str_eq(nm, "print_int") == 1 { return 5 }
    if str_eq(nm, "str_len") == 1 { return 6 }
    if str_eq(nm, "str_byte") == 1 { return 7 }
    if str_eq(nm, "str_eq") == 1 { return 8 }
    return pure_builtin_extern_id_hi(nm)
}

func pure_builtin_call_size_lo(id: int): int {
    if id == 1 { return 26 }
    if id == 2 { return 7 }
    if id == 3 { return 12 }
    if id == 4 { return 28 }
    if id == 5 { return 91 }
    if id == 6 { return 20 }
    if id == 7 { return 9 }
    if id == 8 { return 30 }
    return 5
}

func pure_builtin_call_size_hi_vec(id: int): int {
    if id == 9 { return 348 }
    if id == 10 { return 304 }
    if id == 11 { return 46 }
    if id == 12 { return 56 }
    if id == 13 { return 61 }
    if id == 14 { return 198 }
    if id == 15 { return 227 }
    if id == 16 { return 46 }
    if id == 17 { return 223 }
    if id == 18 { return 56 }
    return 5
}

func pure_builtin_call_size_hi_misc(id: int): int {
    if id == 19 { return 108 }
    if id == 20 { return 268 }
    if id == 21 { return 215 }
    if id == 22 { return 108 }
    if id == 23 { return 165 }
    if id == 24 { return 3 }
    if id == 25 { return 16 }
    if id == 26 { return 136 }
    if id == 27 { return 216 }
    if id == 28 { return 40 }
    if id == 29 { return 129 }
    if id == 30 { return 30 }
    if id == 31 { return 31 }
    if id == 32 { return 276 }
    if id == 33 { return 88 }
    if id == 34 { return 21 }
    if id == 35 { return 4 }
    if id == 36 { return 6 }
    if id == 37 { return 6 }
    if id == 38 { return 4 }
    if id == 39 { return 126 }
    if id == 40 { return 10 }
    if id == 41 { return 96 }
    if id == 42 { return 187 }
    if id == 43 { return 102 }
    return 5
}

func pure_builtin_call_size(id: int): int {
    if (id < 9) {
        return pure_builtin_call_size_lo(id)
    }
    if (id < 19) {
        return pure_builtin_call_size_hi_vec(id)
    }
    return pure_builtin_call_size_hi_misc(id)
}

// Helpers split from emit_pure_builtin_call_lo to keep vreg count below 256.
func emit_pure_builtin_call_1_3(out: int, id: int): int {
    if id == 1 {
        // write(fd, buf): rdi=fd, rsi=str ptr; strlen via (rsi+rdx), then syscall write (nr=1).
        int_vec_push(out, 73) int_vec_push(out, 137) int_vec_push(out, 248)
        int_vec_push(out, 49) int_vec_push(out, 210)
        int_vec_push(out, 128) int_vec_push(out, 60) int_vec_push(out, 22) int_vec_push(out, 0)
        int_vec_push(out, 116) int_vec_push(out, 5)
        int_vec_push(out, 72) int_vec_push(out, 255) int_vec_push(out, 194)
        int_vec_push(out, 235) int_vec_push(out, 245)
        int_vec_push(out, 76) int_vec_push(out, 137) int_vec_push(out, 199)
        int_vec_push(out, 184) int_vec_push(out, 1) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
        int_vec_push(out, 15) int_vec_push(out, 5)
        return 26
    }
    if id == 2 {
        int_vec_push(out, 184) int_vec_push(out, 60) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
        int_vec_push(out, 15) int_vec_push(out, 5)
        return 7
    }
    // id == 3
    int_vec_push(out, 191) int_vec_push(out, 1) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, 184) int_vec_push(out, 60) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, 15) int_vec_push(out, 5)
    return 12
}

func emit_pure_builtin_call_4(out: int): int {
    // print_str(s): rdi=input str; computes length in rdx and writes to stdout.
    int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 254)
    int_vec_push(out, 49) int_vec_push(out, 210)
    int_vec_push(out, 128) int_vec_push(out, 60) int_vec_push(out, 22) int_vec_push(out, 0)
    int_vec_push(out, 116) int_vec_push(out, 5)
    int_vec_push(out, 72) int_vec_push(out, 255) int_vec_push(out, 194)
    int_vec_push(out, 235) int_vec_push(out, 245)
    int_vec_push(out, 191) int_vec_push(out, 1) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, 184) int_vec_push(out, 1) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, 15) int_vec_push(out, 5)
    return 28
}

func emit_pure_builtin_call_5(out: int): int {
    // print_int(n): n >= 0; digits + newline (compiler/res/pure_print_int.s, matches hosted runtime).
    int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 248) int_vec_push(out, 76) int_vec_push(out, 141) int_vec_push(out, 68) int_vec_push(out, 36) int_vec_push(out, 248) int_vec_push(out, 77) int_vec_push(out, 49)
    int_vec_push(out, 201) int_vec_push(out, 73) int_vec_push(out, 187) int_vec_push(out, 10) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, 0) int_vec_push(out, 49) int_vec_push(out, 210) int_vec_push(out, 73) int_vec_push(out, 247) int_vec_push(out, 243) int_vec_push(out, 128) int_vec_push(out, 194) int_vec_push(out, 48) int_vec_push(out, 65)
    int_vec_push(out, 136) int_vec_push(out, 16) int_vec_push(out, 73) int_vec_push(out, 255) int_vec_push(out, 200) int_vec_push(out, 73) int_vec_push(out, 255) int_vec_push(out, 193) int_vec_push(out, 72) int_vec_push(out, 133)
    int_vec_push(out, 192) int_vec_push(out, 117) int_vec_push(out, 234) int_vec_push(out, 73) int_vec_push(out, 255) int_vec_push(out, 192) int_vec_push(out, 76) int_vec_push(out, 137) int_vec_push(out, 198) int_vec_push(out, 76)
    int_vec_push(out, 137) int_vec_push(out, 202) int_vec_push(out, 191) int_vec_push(out, 1) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 184) int_vec_push(out, 1) int_vec_push(out, 0)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 15) int_vec_push(out, 5) int_vec_push(out, 198) int_vec_push(out, 68) int_vec_push(out, 36) int_vec_push(out, 255) int_vec_push(out, 10) int_vec_push(out, 72)
    int_vec_push(out, 141) int_vec_push(out, 116) int_vec_push(out, 36) int_vec_push(out, 255) int_vec_push(out, 186) int_vec_push(out, 1) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 191)
    int_vec_push(out, 1) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 184) int_vec_push(out, 1) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 15)
    int_vec_push(out, 5)
    return 91
}

func emit_pure_builtin_call_6_8(out: int, id: int): int {
    if id == 6 {
        // str_len(s): rdi=str ptr -> rax=len (strlen loop, 20 bytes)
        int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 248)
        int_vec_push(out, 72) int_vec_push(out, 49) int_vec_push(out, 201)
        int_vec_push(out, 128) int_vec_push(out, 60) int_vec_push(out, 8) int_vec_push(out, 0)
        int_vec_push(out, 116) int_vec_push(out, 5)
        int_vec_push(out, 72) int_vec_push(out, 255) int_vec_push(out, 193)
        int_vec_push(out, 235) int_vec_push(out, 245)
        int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 200)
        return 20
    }
    if id == 7 {
        // str_byte(s, idx): rdi=str ptr, rsi=index -> rax=byte (0..255)
        int_vec_push(out, 72) int_vec_push(out, 49) int_vec_push(out, 192)
        int_vec_push(out, 138) int_vec_push(out, 4) int_vec_push(out, 55)
        int_vec_push(out, 15) int_vec_push(out, 182) int_vec_push(out, 192)
        return 9
    }
    // id == 8: str_eq(a,b): rdi=a, rsi=b -> rax=(a==b ? 1 : 0)
    int_vec_push(out, 49) int_vec_push(out, 201)
    int_vec_push(out, 138) int_vec_push(out, 4) int_vec_push(out, 15)
    int_vec_push(out, 138) int_vec_push(out, 20) int_vec_push(out, 14)
    int_vec_push(out, 56) int_vec_push(out, 208)
    int_vec_push(out, 117) int_vec_push(out, 9)
    int_vec_push(out, 132) int_vec_push(out, 192)
    int_vec_push(out, 116) int_vec_push(out, 9)
    int_vec_push(out, 72) int_vec_push(out, 255) int_vec_push(out, 193)
    int_vec_push(out, 235) int_vec_push(out, 237)
    int_vec_push(out, 49) int_vec_push(out, 192)
    int_vec_push(out, 235) int_vec_push(out, 5)
    int_vec_push(out, 184) int_vec_push(out, 1) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    return 30
}

// Builtin ids 1..8 only — see docs/seed-codegen-workarounds.md §2.
func emit_pure_builtin_call_lo(out: int, id: int): int {
    if id < 4 { return emit_pure_builtin_call_1_3(out, id) }
    if id == 4 { return emit_pure_builtin_call_4(out) }
    if id == 5 { return emit_pure_builtin_call_5(out) }
    return emit_pure_builtin_call_6_8(out, id)
}

func emit_pure_builtin_call(out: int, id: int): int {
    if (!(id < 1)) {
        if (!(id > 8)) {
            return emit_pure_builtin_call_lo(out, id)
        }
    }
    if (!(id < 9)) {
        if (!(id > 43)) {
            return emit_pure_builtin_high(out, id)
        }
    }
    int_vec_push(out, 49) int_vec_push(out, 192)
    int_vec_push(out, 144) int_vec_push(out, 144) int_vec_push(out, 144)
    return 5
}

// Basic-block start offsets for native bin: IR branch ops carry a *label id* per function,
// not the flat block index in pass-1 order. Indexing block_offsets[label] was wrong whenever
// label != block index (common); resolve by (func_idx, label) triples recorded during pass-1.
func br_tab_lookup(tab_fi: int, tab_lb: int, tab_off: int, fi: int, lb: int): int {
    var j = 0
    var n = int_vec_len(tab_fi)
    while (j < n) {
        var tf = int_vec_get(tab_fi, j)
        var tl = int_vec_get(tab_lb, j)
        if ((tf == fi) & (tl == lb)) == 1 {
            return int_vec_get(tab_off, j)
        }
        j = j + 1
    }
    return 0 - 1
}

func func_has_block_label(f: int, lb: int): int {
    var bc = func_block_count(f)
    var bi = 0
    while (bi < bc) {
        if (block_label(func_get_block(f, bi)) == lb) {
            return 1
        }
        bi = bi + 1
    }
    return 0
}

func report_bad_branch_label(src: str, toks: int, m: int, fi: int, op_name: str, lb: int): int {
    stderr("codegen error: malformed branch label in func ")
    stderr(tok_text(src, toks, func_name_tok(mod_get_func(m, fi))))
    stderr(" fi=")
    stderr(int_to_str(fi))
    stderr(" op=")
    stderr(op_name)
    stderr(" target=")
    stderr(int_to_str(lb))
    stderr(" blocks=")
    var f = mod_get_func(m, fi)
    var bc = func_block_count(f)
    var bi = 0
    while (bi < bc) {
        if (bi > 0) {
            stderr(",")
        }
        stderr(int_to_str(block_label(func_get_block(f, bi))))
        bi = bi + 1
    }
    stderr(char_to_str(10))
    return 0
}

func op_is2(op: int, a: int, b: int): int {
    if (op == a) { return 1 }
    if (op == b) { return 1 }
    return 0
}

func op_is3(op: int, a: int, b: int, c: int): int {
    if (op == a) { return 1 }
    if (op == b) { return 1 }
    if (op == c) { return 1 }
    return 0
}

func stack_disp32(slot: int): int {
    // Slot i at rbp-8*(i+2): [rbp-8] holds saved r15 (push r15 after mov rbp,rsp).
    return 0 - (slot + 2) * 8
}

// Largest vreg index referenced in |f| (stack slots are vreg indices 0..max).
// Update maxv with the max vreg referenced by a single instruction.
// Splits call-arg loop into a helper to keep vreg count low.
func func_max_vreg_inst(inst: int, maxv: int): int {
    var ik = inst_op(inst)
    var res = inst_result(inst)
    var ia = inst_a(inst)
    var ibk = inst_b(inst)
    // Opcodes where res is a vreg (all except ir_br).
    var has_res = 0
    if (ik == ir_const()) { has_res = 1 }
    if (ik == ir_const_str()) { has_res = 1 }
    if (ik == ir_const_text()) { has_res = 1 }
    if (op_is3(ik, ir_text_cmp(), ir_text_concat(), ir_text_slice()) == 1) { has_res = 1 }
    if (ik == ir_br_cond()) { has_res = 1 }
    if (ik == ir_alloca()) { has_res = 1 }
    if (ik == ir_param()) { has_res = 1 }
    if (op_is3(ik, ir_add(), ir_sub(), ir_mul()) == 1) { has_res = 1 }
    if (op_is3(ik, ir_div(), ir_mod(), ir_eq()) == 1) { has_res = 1 }
    if (op_is3(ik, ir_ne(), ir_lt(), ir_le()) == 1) { has_res = 1 }
    if (op_is3(ik, ir_gt(), ir_ge(), ir_and()) == 1) { has_res = 1 }
    if (op_is3(ik, ir_or(), ir_shl(), ir_shr()) == 1) { has_res = 1 }
    if (op_is3(ik, ir_load(), ir_store(), ir_copy()) == 1) { has_res = 1 }
    if (ik == ir_global_load()) { has_res = 1 }
    if (op_is2(ik, ir_array_load(), ir_array_store()) == 1) { has_res = 1 }
    if (op_is2(ik, ir_neg(), ir_not()) == 1) { has_res = 1 }
    if (ik == ir_call()) { has_res = 1 }
    if (has_res == 1) {
        if (res > maxv) { maxv = res }
    }
    // Opcodes with ia as a vreg operand.
    var has_ia = 0
    if (op_is3(ik, ir_add(), ir_sub(), ir_mul()) == 1) { has_ia = 1 }
    if (op_is3(ik, ir_div(), ir_mod(), ir_eq()) == 1) { has_ia = 1 }
    if (op_is3(ik, ir_ne(), ir_lt(), ir_le()) == 1) { has_ia = 1 }
    if (op_is3(ik, ir_gt(), ir_ge(), ir_and()) == 1) { has_ia = 1 }
    if (op_is3(ik, ir_or(), ir_shl(), ir_shr()) == 1) { has_ia = 1 }
    if (op_is3(ik, ir_load(), ir_store(), ir_copy()) == 1) { has_ia = 1 }
    if (op_is3(ik, ir_text_cmp(), ir_text_concat(), ir_text_slice()) == 1) { has_ia = 1 }
    if (ik == ir_global_store()) { has_ia = 1 }
    if (op_is2(ik, ir_array_load(), ir_array_store()) == 1) { has_ia = 1 }
    if (op_is2(ik, ir_neg(), ir_not()) == 1) { has_ia = 1 }
    if (ik == ir_ret()) { has_ia = 1 }
    if (has_ia == 1) {
        if (ia > maxv) { maxv = ia }
    }
    // Opcodes with ibk as a vreg operand.
    var has_ibk = 0
    if (op_is3(ik, ir_add(), ir_sub(), ir_mul()) == 1) { has_ibk = 1 }
    if (op_is3(ik, ir_div(), ir_mod(), ir_eq()) == 1) { has_ibk = 1 }
    if (op_is3(ik, ir_ne(), ir_lt(), ir_le()) == 1) { has_ibk = 1 }
    if (op_is3(ik, ir_gt(), ir_ge(), ir_and()) == 1) { has_ibk = 1 }
    if (op_is3(ik, ir_or(), ir_shl(), ir_shr()) == 1) { has_ibk = 1 }
    if (op_is2(ik, ir_array_load(), ir_array_store()) == 1) { has_ibk = 1 }
    if (op_is3(ik, ir_text_cmp(), ir_text_concat(), ir_text_slice()) == 1) { has_ibk = 1 }
    if (has_ibk == 1) {
        if (ibk > maxv) { maxv = ibk }
    }
    // ir_text_slice: extra holds the length vreg.
    if (ik == ir_text_slice()) {
        var exts = inst_extra(inst)
        if (exts > maxv) { maxv = exts }
    }
    // ir_call: scan args vector.
    if (ik == ir_call()) {
        var ac = ibk
        var exv = inst_extra(inst)
        if (ac == 1) {
            if (exv > maxv) { maxv = exv }
        } else {
            var aj = 0
            while (aj < ac) {
                var vr = int_vec_get(exv, aj)
                if (vr > maxv) { maxv = vr }
                aj = aj + 1
            }
        }
    }
    return maxv
}

func func_max_vreg_used(f: int): int {
    var maxv = 0
    var bc = func_block_count(f)
    if (bc > 50000) { bc = 0 }
    var bi = 0
    while (bi < bc) {
        var blk = func_get_block(f, bi)
        var insts = block_insts(blk)
        var ic = int_vec_len(insts)
        if (ic > 10000) { ic = 0 }
        var ii = 0
        while (ii < ic) {
            var inst = int_vec_get(insts, ii)
            maxv = func_max_vreg_inst(inst, maxv)
            ii = ii + 1
        }
        bi = bi + 1
    }
    return maxv
}

// Returns 1 if the function has at least one ret/ret_void instruction, 0 otherwise.
func func_has_terminator(f: int): int {
    var bc = func_block_count(f)
    if (bc > 50000) { bc = 0 }
    var bi = 0
    while (bi < bc) {
        var blk = func_get_block(f, bi)
        var insts = block_insts(blk)
        var ic = int_vec_len(insts)
        if (ic > 10000) { ic = 0 }
        var ii = 0
        while (ii < ic) {
            var inst = int_vec_get(insts, ii)
            var op = inst_op(inst)
            if (op == ir_ret()) | (op == ir_ret_void()) { return 1 }
            ii = ii + 1
        }
        bi = bi + 1
    }
    return 0
}

// Bytes to subtract in the function prologue: (max_vreg+1) slots, 16-byte aligned, min 16.
func func_prologue_frame_bytes(f: int): int {
    var mx = func_max_vreg_used(f)
    var need = (mx + 1) * 8
    if need < 16 {
        need = 16
    }
    var al = (need + 15) / 16 * 16
    return al
}

func emit_mov_stack_to_rax(out: int, slot: int): int {
    int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 133)
    emit_i32(out, stack_disp32(slot))
    return 7
}

func emit_mov_rax_to_stack(out: int, slot: int): int {
    int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 133)
    emit_i32(out, stack_disp32(slot))
    return 7
}

func emit_mov_imm32_to_stack(out: int, slot: int, v: int): int {
    int_vec_push(out, 72) int_vec_push(out, 199) int_vec_push(out, 133)
    emit_i32(out, stack_disp32(slot))
    emit_i32(out, v)
    return 11
}

// Global slot gi lives at r15-8*(gi+1) (below the initial stack pointer; the entry stub
// reserves the region with sub rsp before calling main). r15 stays = initial rsp so the
// pure host_argc/host_argv/host_getenv builtins keep working.
func global_slot_disp(gi: int): int {
    return 0 - (gi + 1) * 8
}

func emit_mov_gslot_to_rax(out: int, gi: int): int {
    int_vec_push(out, 73) int_vec_push(out, 139) int_vec_push(out, 135)
    emit_i32(out, global_slot_disp(gi))
    return 7
}

func emit_mov_rax_to_gslot(out: int, gi: int): int {
    int_vec_push(out, 73) int_vec_push(out, 137) int_vec_push(out, 135)
    emit_i32(out, global_slot_disp(gi))
    return 7
}

func emit_arg_move_to_abi_reg(out: int, arg_idx: int, src_slot: int): int {
    if arg_idx == 0 {
        int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 189) // rdi
        emit_i32(out, stack_disp32(src_slot))
        return 7
    }
    if arg_idx == 1 {
        int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 181) // rsi
        emit_i32(out, stack_disp32(src_slot))
        return 7
    }
    if arg_idx == 2 {
        int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 149) // rdx
        emit_i32(out, stack_disp32(src_slot))
        return 7
    }
    if arg_idx == 3 {
        int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 141) // rcx
        emit_i32(out, stack_disp32(src_slot))
        return 7
    }
    if arg_idx == 4 {
        int_vec_push(out, 76) int_vec_push(out, 139) int_vec_push(out, 133) // r8
        emit_i32(out, stack_disp32(src_slot))
        return 7
    }
    if arg_idx == 5 {
        int_vec_push(out, 76) int_vec_push(out, 139) int_vec_push(out, 141) // r9
        emit_i32(out, stack_disp32(src_slot))
        return 7
    }
    return 0
}

// Pass-1 per-function: count bytes and fill branch tables.
// Returns new current_offset, or -1 on a bad branch label.
// Byte size contributed by one instruction in pass1. Returns size, or -1 on bad branch.
func cg_p1_inst_sz(p2fctx: int, src: str, f: int, inst: int): int {
    var m = cg_p2fctx_m(p2fctx)
    var toks = cg_p2fctx_toks(p2fctx)
    var fi = cg_p2fctx_fi(p2fctx)
    var main_fi = cg_p2fctx_main_fi(p2fctx)
    var op = inst_op(inst)
    var a = inst_a(inst)
    var bv = inst_b(inst)
    if op == ir_const() { return 11 }
    if op == ir_const_str() { return 14 }
    if op == ir_const_text() { return 14 }
    if op == ir_text_cmp() { return 117 }
    if op == ir_text_concat() { return 208 }
    if op == ir_text_slice() { return 130 }
    if op_is2(op, ir_add(), ir_sub()) == 1 { return 21 }
    if op == ir_mul() { return 22 }
    if op_is2(op, ir_div(), ir_mod()) == 1 { return 23 }
    var is_cmp = 0
    if (op_is3(op, ir_eq(), ir_ne(), ir_lt()) == 1) { is_cmp = 1 }
    if (op_is3(op, ir_le(), ir_gt(), ir_ge()) == 1) { is_cmp = 1 }
    if (is_cmp == 1) { return 28 }
    if op_is2(op, ir_and(), ir_or()) == 1 { return 21 }
    if op == ir_not() { return 24 }
    if op == ir_neg() { return 17 }
    if op_is2(op, ir_shl(), ir_shr()) == 1 { return 24 }
    if op_is3(op, ir_load(), ir_store(), ir_copy()) == 1 { return 14 }
    if op_is2(op, ir_global_load(), ir_global_store()) == 1 { return 14 }
    if op_is2(op, ir_array_load(), ir_array_store()) == 1 { return 61 }
    if op == ir_alloca() { return 11 }
    if op == ir_param() { return 7 }
    if (op == ir_ret()) & ((fi == main_fi) == 1) { return 24 }
    if (op == ir_ret()) & ((fi == main_fi) == 0) { return 15 }
    if (op == ir_ret_void()) & ((fi == main_fi) == 1) { return 17 }
    if (op == ir_ret_void()) & ((fi == main_fi) == 0) { return 8 }
    if op == ir_br() {
        if func_has_block_label(f, a) == 0 {
            report_bad_branch_label(src, toks, m, fi, "br", a)
            return 0 - 1
        }
        return 5
    }
    if op == ir_br_cond() {
        if func_has_block_label(f, a) == 0 {
            report_bad_branch_label(src, toks, m, fi, "br_cond_then", a)
            return 0 - 1
        }
        if func_has_block_label(f, bv) == 0 {
            report_bad_branch_label(src, toks, m, fi, "br_cond_else", bv)
            return 0 - 1
        }
        return 21
    }
    if op == ir_call() {
        var argc = bv
        var ctok = a
        return cg_p1_call_sz(m, src, toks, ctok, argc)
    }
    return 0
}

// Compute byte size of an ir_call site in pass1. Returns the byte count.
func cg_p1_call_sz(m: int, src: str, toks: int, a: int, argc: int): int {
    var usec = argc
    if usec > 6 { usec = 6 }
    var call_sz = 5
    var tfi = find_func_index_by_tok(m, src, toks, a)
    if tfi < 0 {
        var bid = pure_builtin_extern_id(src, toks, a)
        call_sz = pure_builtin_call_size(bid)
    }
    if argc == 1 {
        return 7 + call_sz + 7
    } else {
        return usec * 7 + call_sz + 7
    }
}

func cg_p1_func(p2fctx: int, src: str, f: int, brtab: int, offset: int): int {
    var fi = cg_p2fctx_fi(p2fctx)
    var main_fi = cg_p2fctx_main_fi(p2fctx)
    var br_fi = brtab_fi(brtab)
    var br_lb = brtab_lb(brtab)
    var br_off = brtab_off(brtab)
    var result = offset + 13
    var bc = func_block_count(f)
    if (bc > 50000) { bc = 0 }
    var bi = 0
    while (bi < bc) {
        var blk = func_get_block(f, bi)
        int_vec_push(br_fi, fi)
        int_vec_push(br_lb, block_label(blk))
        int_vec_push(br_off, result)
        var insts = block_insts(blk)
        var ic = int_vec_len(insts)
        if (ic > 10000) { ic = 0 }
        var ii = 0
        while (ii < ic) {
            var ii_cur = ii
            var inst = int_vec_get(insts, ii_cur)
            var op = inst_op(inst)
            if (op < 1) | (op > 60) {
                ii = ic
            } else {
            var sz = cg_p1_inst_sz(p2fctx, src, f, inst)
            if (sz < 0) { return 0 - 1 }
            result = result + sz
            ii = ii_cur + 1
            }
        }
        bi = bi + 1
    }
    if func_has_terminator(f) == 0 {
        if (fi == main_fi) == 1 {
            result = result + 17
        } else {
            result = result + 8
        }
    }
    return result
}

// Emit ir_param register saves. Returns 0.
func cg_p2_param(out: int, a: int, res: int): int {
    if a == 0 { int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 189) emit_i32(out, stack_disp32(res)) }
    if a == 1 { int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 181) emit_i32(out, stack_disp32(res)) }
    if a == 2 { int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 149) emit_i32(out, stack_disp32(res)) }
    if a == 3 { int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 141) emit_i32(out, stack_disp32(res)) }
    if a == 4 { int_vec_push(out, 76) int_vec_push(out, 137) int_vec_push(out, 133) emit_i32(out, stack_disp32(res)) }
    if a == 5 { int_vec_push(out, 76) int_vec_push(out, 137) int_vec_push(out, 141) emit_i32(out, stack_disp32(res)) }
    return 0
}

// Emit bounds check for dynamic index: if idx < 0 or idx >= alen, exit(1).
// Prefixed before array.load/store body. |alen| must be 1..127 (imm8). Returns 33.
func emit_array_bounds_check(out: int, idx_slot: int, alen: int): int {
    // jmp over trap stub
    int_vec_push(out, 235) int_vec_push(out, 12)
    // trap: mov $1,%edi ; mov $60,%eax ; syscall  (exit 1)
    int_vec_push(out, 191) int_vec_push(out, 1) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, 184) int_vec_push(out, 60) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, 15) int_vec_push(out, 5)
    // movq idx(%rbp), %rax
    int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 133) emit_i32(out, stack_disp32(idx_slot))
    // cmpq $0, %rax
    int_vec_push(out, 72) int_vec_push(out, 131) int_vec_push(out, 248) int_vec_push(out, 0)
    // jl trap (rel8 backward to trap at +2 from start; here pos after jl = 2+12+7+4+2 = 27, trap at 2)
    // distance = 2 - 27 = -25 = 0xE7
    int_vec_push(out, 124) int_vec_push(out, 231)
    // cmpq $alen, %rax
    int_vec_push(out, 72) int_vec_push(out, 131) int_vec_push(out, 248) int_vec_push(out, alen)
    // jge trap: after this insn at 2+12+7+4+2+4+2=33, trap at 2 → 2-33=-31=0xE1
    int_vec_push(out, 125) int_vec_push(out, 225)
    return 33
}

// Emit bitwise / shift / unary / memory / alloca instructions. Returns 0.
// |extra| is array length for ir_array_load/store (0 = skip bounds check).
func cg_p2_bitops(out: int, op: int, res: int, a: int, bv: int, extra: int): int {
    if op_is2(op, ir_and(), ir_or()) == 1 {
        emit_mov_stack_to_rax(out, a)
        if op == ir_and() { int_vec_push(out, 72) int_vec_push(out, 35) int_vec_push(out, 133) emit_i32(out, stack_disp32(bv)) }
        if op == ir_or() { int_vec_push(out, 72) int_vec_push(out, 11) int_vec_push(out, 133) emit_i32(out, stack_disp32(bv)) }
        emit_mov_rax_to_stack(out, res)
    }
    if op_is2(op, ir_shl(), ir_shr()) == 1 {
        int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 141) emit_i32(out, stack_disp32(bv))
        emit_mov_stack_to_rax(out, a)
        if op == ir_shl() { int_vec_push(out, 72) int_vec_push(out, 211) int_vec_push(out, 224) }
        if op == ir_shr() { int_vec_push(out, 72) int_vec_push(out, 211) int_vec_push(out, 248) }
        emit_mov_rax_to_stack(out, res)
    }
    if op_is2(op, ir_not(), ir_neg()) == 1 {
        emit_mov_stack_to_rax(out, a)
        if op == ir_neg() { int_vec_push(out, 72) int_vec_push(out, 247) int_vec_push(out, 216) }
        if op == ir_not() { int_vec_push(out, 72) int_vec_push(out, 133) int_vec_push(out, 192) int_vec_push(out, 15) int_vec_push(out, 148) int_vec_push(out, 192) int_vec_push(out, 72) int_vec_push(out, 15) int_vec_push(out, 182) int_vec_push(out, 192) }
        emit_mov_rax_to_stack(out, res)
    }
    if op_is3(op, ir_load(), ir_store(), ir_copy()) == 1 {
        emit_mov_stack_to_rax(out, a)
        emit_mov_rax_to_stack(out, res)
    }
    if op == ir_array_load() {
        if (extra > 0) & (extra < 128) {
            emit_array_bounds_check(out, bv, extra)
        }
        // movq idx(%rbp), %rdx
        int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 149) emit_i32(out, stack_disp32(bv))
        // negq %rdx
        int_vec_push(out, 72) int_vec_push(out, 247) int_vec_push(out, 218)
        // leaq disp32(base)(%rbp,%rdx,8), %rax
        int_vec_push(out, 72) int_vec_push(out, 141) int_vec_push(out, 132) int_vec_push(out, 213) emit_i32(out, stack_disp32(a))
        // movq (%rax), %rdx
        int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 16)
        // movq %rdx, res(%rbp)
        int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 149) emit_i32(out, stack_disp32(res))
    }
    if op == ir_array_store() {
        if (extra > 0) & (extra < 128) {
            emit_array_bounds_check(out, a, extra)
        }
        // movq val(%rbp), %rax
        int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 133) emit_i32(out, stack_disp32(bv))
        // movq idx(%rbp), %rdx
        int_vec_push(out, 72) int_vec_push(out, 139) int_vec_push(out, 149) emit_i32(out, stack_disp32(a))
        // negq %rdx
        int_vec_push(out, 72) int_vec_push(out, 247) int_vec_push(out, 218)
        // leaq disp32(base)(%rbp,%rdx,8), %rcx
        int_vec_push(out, 72) int_vec_push(out, 141) int_vec_push(out, 140) int_vec_push(out, 213) emit_i32(out, stack_disp32(res))
        // movq %rax, (%rcx)
        int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 1)
    }
    if op == ir_alloca() { emit_mov_imm32_to_stack(out, res, 0) }
    if op == ir_param() { cg_p2_param(out, a, res) }
    return 0
}

// Emit arithmetic / memory instructions (not param). Returns 0.
func cg_p2_arith(out: int, op: int, res: int, a: int, bv: int, extra: int): int {
    if op == ir_const() { emit_mov_imm32_to_stack(out, res, a) }
    if op == ir_global_load() {
        emit_mov_gslot_to_rax(out, a)
        emit_mov_rax_to_stack(out, res)
    }
    if op == ir_global_store() {
        emit_mov_stack_to_rax(out, a)
        emit_mov_rax_to_gslot(out, res)
    }
    if op_is3(op, ir_add(), ir_sub(), ir_mul()) == 1 {
        emit_mov_stack_to_rax(out, a)
        if op == ir_add() { int_vec_push(out, 72) int_vec_push(out, 3) int_vec_push(out, 133) emit_i32(out, stack_disp32(bv)) }
        if op == ir_sub() { int_vec_push(out, 72) int_vec_push(out, 43) int_vec_push(out, 133) emit_i32(out, stack_disp32(bv)) }
        if op == ir_mul() { int_vec_push(out, 72) int_vec_push(out, 15) int_vec_push(out, 175) int_vec_push(out, 133) emit_i32(out, stack_disp32(bv)) }
        emit_mov_rax_to_stack(out, res)
    }
    if op_is2(op, ir_div(), ir_mod()) == 1 {
        emit_mov_stack_to_rax(out, a)
        int_vec_push(out, 72) int_vec_push(out, 153)
        int_vec_push(out, 72) int_vec_push(out, 247) int_vec_push(out, 189) emit_i32(out, stack_disp32(bv))
        if op == ir_div() {
            emit_mov_rax_to_stack(out, res)
        } else {
            int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 149) emit_i32(out, stack_disp32(res))
        }
    }
    cg_p2_bitops(out, op, res, a, bv, extra)
    return 0
}

// Emit comparison instructions (eq/ne/lt/le/gt/ge). Returns 0.
func cg_p2_cmp(out: int, op: int, res: int, a: int, bv: int): int {
    var is_cmp = 0
    if (op_is3(op, ir_eq(), ir_ne(), ir_lt()) == 1) { is_cmp = 1 }
    if (op_is3(op, ir_le(), ir_gt(), ir_ge()) == 1) { is_cmp = 1 }
    if (is_cmp == 1) {
        emit_mov_stack_to_rax(out, a)
        int_vec_push(out, 72) int_vec_push(out, 59) int_vec_push(out, 133) emit_i32(out, stack_disp32(bv))
        if op == ir_eq() { int_vec_push(out, 15) int_vec_push(out, 148) int_vec_push(out, 192) }
        if op == ir_ne() { int_vec_push(out, 15) int_vec_push(out, 149) int_vec_push(out, 192) }
        if op == ir_lt() { int_vec_push(out, 15) int_vec_push(out, 156) int_vec_push(out, 192) }
        if op == ir_le() { int_vec_push(out, 15) int_vec_push(out, 158) int_vec_push(out, 192) }
        if op == ir_gt() { int_vec_push(out, 15) int_vec_push(out, 159) int_vec_push(out, 192) }
        if op == ir_ge() { int_vec_push(out, 15) int_vec_push(out, 157) int_vec_push(out, 192) }
        int_vec_push(out, 72) int_vec_push(out, 15) int_vec_push(out, 182) int_vec_push(out, 192)
        emit_mov_rax_to_stack(out, res)
    }
    return 0
}

// Emit ir_const_str. Returns 0.
func cg_p2_cstr(out: int, res: int, a: int, str_cum: int, instr_total: int): int {
    var lea_off = int_vec_len(out)
    var rel = instr_total + int_vec_get(str_cum, a) - (lea_off + 7)
    int_vec_push(out, 72) int_vec_push(out, 141) int_vec_push(out, 5)
    emit_i32(out, rel)
    emit_mov_rax_to_stack(out, res)
    return 0
}

// Emit ir_call. Returns 0.
func cg_p2_call(p2fctx: int, src: str, p2out_ctx: int, inst: int): int {
    var m = cg_p2fctx_m(p2fctx)
    var toks = cg_p2fctx_toks(p2fctx)
    var out = p2out_out(p2out_ctx)
    var func_offsets = p2out_func_offsets(p2out_ctx)
    var a = inst_a(inst)
    var argc = inst_b(inst)
    var res = inst_result(inst)
    if argc == 1 {
        var only_vr = inst_extra(inst)
        emit_arg_move_to_abi_reg(out, 0, only_vr)
    } else {
        var args_h = inst_extra(inst)
        var usec = argc
        if usec > 6 { usec = 6 }
        var ai = 0
        while (ai < usec) {
            var vr = int_vec_get(args_h, ai)
            emit_arg_move_to_abi_reg(out, ai, vr)
            ai = ai + 1
        }
    }
    var target_fi = find_func_index_by_tok(m, src, toks, a)
    var code_ptr2 = int_vec_len(out)
    if (target_fi < 0) == 0 {
        var target_off = int_vec_get(func_offsets, target_fi)
        var rel = target_off - (code_ptr2 + 5)
        int_vec_push(out, 232)
        emit_i32(out, rel)
    } else {
        var bid2 = pure_builtin_extern_id(src, toks, a)
        emit_pure_builtin_call(out, bid2)
    }
    emit_mov_rax_to_stack(out, res)
    return 0
}

// Emit ir_br. Returns 0 on success, -1 on error.
func cg_p2_br(p2fctx: int, brtab: int, out: int, inst: int, code_ptr: int): int {
    var fi = cg_p2fctx_fi(p2fctx)
    var br_fi = brtab_fi(brtab)
    var br_lb = brtab_lb(brtab)
    var br_off = brtab_off(brtab)
    var a = inst_a(inst)
    var br_start = int_vec_len(out)
    var target_off = br_tab_lookup(br_fi, br_lb, br_off, fi, a)
    if (target_off < 0) {
        stderr("codegen error: unresolved br target fi=")
        stderr(int_to_str(fi))
        stderr(" label=")
        stderr(int_to_str(a))
        stderr(char_to_str(10))
        return 0 - 1
    }
    var rel = target_off - (code_ptr + 5)
    int_vec_push(out, 233)
    emit_i32(out, rel)
    var br_size = int_vec_len(out) - br_start
    if (br_size != 5) {
        stderr("codegen error: ir_br size mismatch expected=5 got=")
        stderr(int_to_str(br_size))
        stderr(char_to_str(10))
        return 0 - 1
    }
    return 0
}

// Emit ir_br_cond. Returns 0 on success, -1 on error.
func cg_p2_brc(p2fctx: int, brtab: int, out: int, inst: int): int {
    var fi = cg_p2fctx_fi(p2fctx)
    var br_fi = brtab_fi(brtab)
    var br_lb = brtab_lb(brtab)
    var br_off = brtab_off(brtab)
    var res = inst_result(inst)
    var a = inst_a(inst)
    var bv = inst_b(inst)
    var brc_start = int_vec_len(out)
    emit_mov_stack_to_rax(out, res)
    int_vec_push(out, 72) int_vec_push(out, 133) int_vec_push(out, 192)
    var then_off = br_tab_lookup(br_fi, br_lb, br_off, fi, a)
    var else_off = br_tab_lookup(br_fi, br_lb, br_off, fi, bv)
    var brc_bad = 0
    if (then_off < 0) { brc_bad = 1 }
    if (else_off < 0) { brc_bad = 1 }
    if (brc_bad == 1) {
        stderr("codegen error: unresolved br_cond target fi=")
        stderr(int_to_str(fi))
        stderr(" then=")
        stderr(int_to_str(a))
        stderr(" else=")
        stderr(int_to_str(bv))
        stderr(char_to_str(10))
        return 0 - 1
    }
    var l_after_test = int_vec_len(out)
    var rel_then = then_off - (l_after_test + 6)
    int_vec_push(out, 15) int_vec_push(out, 133)
    emit_i32(out, rel_then)
    var l_after_jcc = int_vec_len(out)
    var rel_else = else_off - (l_after_jcc + 5)
    int_vec_push(out, 233)
    emit_i32(out, rel_else)
    var brc_size = int_vec_len(out) - brc_start
    if (brc_size != 21) {
        stderr("codegen error: ir_br_cond size mismatch expected=21 got=")
        stderr(int_to_str(brc_size))
        stderr(char_to_str(10))
        return 0 - 1
    }
    return 0
}

// Emit ret / ret_void. Returns 0.
func cg_p2_ret(p2fctx: int, out: int, inst: int): int {
    var fi = cg_p2fctx_fi(p2fctx)
    var main_fi = cg_p2fctx_main_fi(p2fctx)
    var op = inst_op(inst)
    var a = inst_a(inst)
    if op == ir_ret() {
        emit_mov_stack_to_rax(out, a)
        int_vec_push(out, 72) int_vec_push(out, 141) int_vec_push(out, 101) int_vec_push(out, 248)
        int_vec_push(out, 65) int_vec_push(out, 95)
        int_vec_push(out, 93)
        if (fi == main_fi) == 1 {
            int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 199)
            int_vec_push(out, 184) int_vec_push(out, 60) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
            int_vec_push(out, 15) int_vec_push(out, 5)
        } else {
            int_vec_push(out, 195)
        }
    }
    if op == ir_ret_void() {
        int_vec_push(out, 72) int_vec_push(out, 141) int_vec_push(out, 101) int_vec_push(out, 248)
        int_vec_push(out, 65) int_vec_push(out, 95)
        int_vec_push(out, 93)
        if (fi == main_fi) == 1 {
            int_vec_push(out, 72) int_vec_push(out, 49) int_vec_push(out, 255)
            int_vec_push(out, 184) int_vec_push(out, 60) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
            int_vec_push(out, 15) int_vec_push(out, 5)
        } else {
            int_vec_push(out, 195)
        }
    }
    return 0
}

// Emit one instruction. Returns 0 on success, -1 on bad branch.
func cg_p2_inst(p2fctx: int, src: str, brtab: int, p2out_ctx: int, inst: int): int {
    var out = p2out_out(p2out_ctx)
    var str_cum = p2out_str_cum(p2out_ctx)
    var instr_total = p2out_instr_total(p2out_ctx)
    var op = inst_op(inst)
    var res = inst_result(inst)
    var a = inst_a(inst)
    var bv = inst_b(inst)
    var extra = inst_extra(inst)
    var code_ptr = int_vec_len(out)
    if op == ir_const_str() { cg_p2_cstr(out, res, a, str_cum, instr_total) }
    if op == ir_const_text() { cg_p2_cstr(out, res, a, str_cum, instr_total) }
    if op == ir_text_cmp() {
        emit_arg_move_to_abi_reg(out, 0, a)
        emit_arg_move_to_abi_reg(out, 1, bv)
        emit_pure_builtin_call(out, 41)
        emit_mov_rax_to_stack(out, res)
    }
    if op == ir_text_concat() {
        emit_arg_move_to_abi_reg(out, 0, a)
        emit_arg_move_to_abi_reg(out, 1, bv)
        emit_pure_builtin_call(out, 42)
        emit_mov_rax_to_stack(out, res)
    }
    if op == ir_text_slice() {
        emit_arg_move_to_abi_reg(out, 0, a)
        emit_arg_move_to_abi_reg(out, 1, bv)
        emit_arg_move_to_abi_reg(out, 2, extra)
        emit_pure_builtin_call(out, 43)
        emit_mov_rax_to_stack(out, res)
    }
    cg_p2_arith(out, op, res, a, bv, extra)
    cg_p2_cmp(out, op, res, a, bv)
    if op == ir_br() {
        var br_rc = cg_p2_br(p2fctx, brtab, out, inst, code_ptr)
        if (br_rc < 0) { return 0 - 1 }
    }
    if op == ir_br_cond() {
        var brc_rc = cg_p2_brc(p2fctx, brtab, out, inst)
        if (brc_rc < 0) { return 0 - 1 }
    }
    if op == ir_call() {
        cg_p2_call(p2fctx, src, p2out_ctx, inst)
    }
    cg_p2_ret(p2fctx, out, inst)
    return 0
}

// Emit default terminator if no ret found. Returns 0.
func cg_p2_term(p2fctx: int, f: int, out: int): int {
    var fi = cg_p2fctx_fi(p2fctx)
    var main_fi = cg_p2fctx_main_fi(p2fctx)
    if func_has_terminator(f) == 0 {
        int_vec_push(out, 72) int_vec_push(out, 141) int_vec_push(out, 101) int_vec_push(out, 248)
        int_vec_push(out, 65) int_vec_push(out, 95)
        int_vec_push(out, 93)
        if (fi == main_fi) == 1 {
            int_vec_push(out, 72) int_vec_push(out, 49) int_vec_push(out, 255)
            int_vec_push(out, 184) int_vec_push(out, 60) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
            int_vec_push(out, 15) int_vec_push(out, 5)
        } else {
            int_vec_push(out, 195)
        }
    }
    return 0
}

// Pass-2 per-function: emit machine code bytes.
// Returns 0 on success, -1 on bad branch/size mismatch.
func cg_p2_func(p2fctx: int, src: str, f: int, brtab: int, p2out_ctx: int): int {
    var out = p2out_out(p2out_ctx)
    var frame_b2 = func_prologue_frame_bytes(f)
    int_vec_push(out, 85)
    int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 229)
    int_vec_push(out, 65) int_vec_push(out, 87)
    int_vec_push(out, 72) int_vec_push(out, 129) int_vec_push(out, 236)
    emit_i32(out, frame_b2)
    var bc = func_block_count(f)
    if (bc > 50000) { bc = 0 }
    var bi = 0
    while (bi < bc) {
        var blk = func_get_block(f, bi)
        var insts = block_insts(blk)
        var ic = int_vec_len(insts)
        if (ic > 10000) { ic = 0 }
        var ii = 0
        while (ii < ic) {
            var ii_cur = ii
            var inst = int_vec_get(insts, ii_cur)
            var op = inst_op(inst)
            if (op < 1) | (op > 60) {
                ii = ic
            } else {
            var rc = cg_p2_inst(p2fctx, src, brtab, p2out_ctx, inst)
            if (rc < 0) { return 0 - 1 }
            ii = ii_cur + 1
            }
        }
        bi = bi + 1
    }
    cg_p2_term(p2fctx, f, out)
    return 0
}

// Bytes for one global init in the entry stub: int/bool use movq $imm (11); str uses
// lea pool(%rip),%rax + movq %rax,disp(%r15) (14).
func native_global_init_bytes(m: int, gi: int): int {
    if global_type(mod_get_global(m, gi)) == ir_ty_str() { return 14 }
    if global_type(mod_get_global(m, gi)) == ir_ty_text() { return 14 }
    return 11
}

// Entry stub bytes: fixed tail (mov r15,rsp; call; mov rdi; mov eax; syscall) is 18 bytes;
// with globals also sub rsp (7) + per-global init (11 or 14).
func native_entry_stub_size(m: int): int {
    var gc = mod_global_count(m)
    if gc == 0 { return 18 }
    var sum = 0
    var gi = 0
    while (gi < gc) {
        sum = sum + native_global_init_bytes(m, gi)
        gi = gi + 1
    }
    return 25 + sum
}

// Emit lea of string pool entry |str_id| into %rax (same RIP math as cg_p2_cstr).
func emit_lea_str_to_rax(out: int, str_id: int, str_cum: int, instr_total: int): int {
    var lea_off = int_vec_len(out)
    var rel = instr_total + int_vec_get(str_cum, str_id) - (lea_off + 7)
    int_vec_push(out, 72) int_vec_push(out, 141) int_vec_push(out, 5)
    emit_i32(out, rel)
    return 7
}

// Stack bytes reserved below the initial rsp for globals, rounded to 16 (ABI alignment for the
// call into main). Global slots sit at r15-8*(gi+1) inside this region.
func native_globals_reserve(gc: int): int {
    return 16 * ((gc + 1) / 2)
}

func cg_module_to_bin(m: int, src: str, toks: int, str_toks: int, out: int): int {
    var fc = mod_func_count(m)
    if fc == 0 { return 0 }
    var main_off = 0
    // Byte offset in the RX segment where the inline string pool starts (after all insns).
    var str_cum = int_vec_new()
    var str_si = 0
    var str_acc = 0
    while (str_si < int_vec_len(str_toks)) {
        int_vec_push(str_cum, str_acc)
        var stok = int_vec_get(str_toks, str_si)
        if tok_kind(toks, stok) == tk_text_lit() {
            var st = tok_text_value(src, toks, stok)
            str_acc = str_acc + 24 + str_len(st) + 1
        } else {
            var s = tok_str_value(src, toks, stok)
            str_acc = str_acc + str_len(s) + 1
        }
        str_si = str_si + 1
    }
    var instr_total = 0
    var main_fi = 0 - 1
    var fmj = 0
    while (fmj < fc) {
        var ffn = mod_get_func(m, fmj)
        var fnm = tok_text(src, toks, func_name_tok(ffn))
        if str_eq(fnm, "main") == 1 {
            main_fi = fmj
        }
        fmj = fmj + 1
    }
    // Kernel packages use kmain as the freestanding entry (Issue #59).
    if main_fi < 0 {
        fmj = 0
        while (fmj < fc) {
            var ffn2 = mod_get_func(m, fmj)
            if str_eq(tok_text(src, toks, func_name_tok(ffn2)), "kmain") == 1 {
                main_fi = fmj
            }
            fmj = fmj + 1
        }
    }
    if main_fi < 0 {
        stderr("codegen error: no main or kmain entry function")
        stderr(char_to_str(10))
        int_vec_free(str_cum)
        return 0 - 1
    }
    var glob_count = mod_global_count(m)
    // Pass 1: Label resolution
    var brtab = brtab_new()
    var func_offsets = int_vec_new()
    // Entry stub: mov r15,rsp ; [sub rsp, globals ; init slots] ; call main ;
    // mov rdi,rax ; mov eax,60 ; syscall.
    // — call pushes a return address to the exit trampoline so a mistaken `ret` from main
    // (jmp entry had none) cannot pop garbage → RIP 0. Pure host_* builtins still use r15.
    var current_offset = native_entry_stub_size(m)

    var fi = 0
    while (fi < fc) {
        var f = mod_get_func(m, fi)
        int_vec_push(func_offsets, current_offset)
        var p1fctx = cg_p2fctx_new(m, toks, main_fi, fi)
        var new_off = cg_p1_func(p1fctx, src, f, brtab, current_offset)
        int_vec_free(p1fctx)
        if (new_off < 0) {
            brtab_free(brtab)
            int_vec_free(func_offsets)
            int_vec_free(str_cum)
            return 0 - 1
        }
        current_offset = new_off
        fi = fi + 1
    }
    var fk = 0
    while (fk < fc) {
        if fk == main_fi {
            main_off = int_vec_get(func_offsets, fk)
        }
        fk = fk + 1
    }
    instr_total = current_offset

    // Pass 2: Code emission
    var p2out_ctx = p2out_new(out, func_offsets, str_cum, instr_total)
    // Emit entry stub before all functions.
    // 49 89 E7                mov r15, rsp
    // 48 81 EC imm32          sub rsp, globals_reserve   (only when globals exist)
    // int: 49 C7 87 disp32 imm32   movq $init, disp(%r15)
    // str: lea pool(%rip),%rax ; movq %rax, disp(%r15)
    // E8 rel32               call main
    // 48 89 C7               mov rdi, rax
    // B8 3C 00 00 00         mov eax, 60
    // 0F 05                  syscall
    int_vec_push(out, 73) int_vec_push(out, 137) int_vec_push(out, 231)
    if glob_count > 0 {
        var gres = native_globals_reserve(glob_count)
        int_vec_push(out, 72) int_vec_push(out, 129) int_vec_push(out, 236)
        emit_i32(out, gres)
        var gii = 0
        while (gii < glob_count) {
            var gg = mod_get_global(m, gii)
            var ginit = global_init(gg)
            if global_type(gg) == ir_ty_str() | global_type(gg) == ir_ty_text() {
                emit_lea_str_to_rax(out, ginit, str_cum, instr_total)
                emit_mov_rax_to_gslot(out, gii)
            } else {
                int_vec_push(out, 73) int_vec_push(out, 199) int_vec_push(out, 135)
                emit_i32(out, global_slot_disp(gii))
                emit_i32(out, ginit)
            }
            gii = gii + 1
        }
    }
    int_vec_push(out, 232)
    emit_i32(out, main_off - (native_entry_stub_size(m) - 10))
    int_vec_push(out, 72) int_vec_push(out, 137) int_vec_push(out, 199)
    int_vec_push(out, 184) int_vec_push(out, 60) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, 15) int_vec_push(out, 5)
    fi = 0
    while (fi < fc) {
        var f = mod_get_func(m, fi)
        if (fi == main_fi) == 1 {
            main_off = int_vec_len(out)
        }
        var p2fctx = cg_p2fctx_new(m, toks, main_fi, fi)
        var p2_rc = cg_p2_func(p2fctx, src, f, brtab, p2out_ctx)
        int_vec_free(p2fctx)
        if (p2_rc < 0) {
            int_vec_free(p2out_ctx)
            brtab_free(brtab)
            int_vec_free(func_offsets)
            int_vec_free(str_cum)
            return 0 - 1
        }
        fi = fi + 1
    }
    var code_len = int_vec_len(out)
    if code_len != instr_total {
        stderr("codegen internal error: pass1/pass2 code size mismatch p1=")
        stderr(int_to_str(instr_total))
        stderr(" p2=")
        stderr(int_to_str(code_len))
        stderr(char_to_str(10))
        int_vec_free(p2out_ctx)
        brtab_free(brtab)
        int_vec_free(func_offsets)
        int_vec_free(str_cum)
        return 0 - 1
    }
    int_vec_free(p2out_ctx)
    var ap = 0
    while (ap < int_vec_len(str_toks)) {
        var atok = int_vec_get(str_toks, ap)
        if tok_kind(toks, atok) == tk_text_lit() {
            var stx = tok_text_value(src, toks, atok)
            var tlen = str_len(stx)
            // PIE-safe descriptors: field 0 is the byte offset from the descriptor
            // to its data (24); accessors compute data = desc + data_off.
            emit_qword(out, 24)
            emit_qword(out, tlen)
            emit_qword(out, tlen)
            var tbi = 0
            while (tbi < tlen) {
                int_vec_push(out, str_byte(stx, tbi))
                tbi = tbi + 1
            }
            int_vec_push(out, 0)
        } else {
            var s2 = tok_str_value(src, toks, atok)
            var bi2 = 0
            var bn2 = str_len(s2)
            while (bi2 < bn2) {
                int_vec_push(out, str_byte(s2, bi2))
                bi2 = bi2 + 1
            }
            int_vec_push(out, 0)
        }
        ap = ap + 1
    }
    brtab_free(brtab)
    int_vec_free(func_offsets)
    int_vec_free(str_cum)
    return 0
}

func cg_module_print(m: int, src: str, toks: int, str_toks: int, nl: str): int {
    var s = cg_module_to_str(m, src, toks, str_toks, nl)
    stdout(s)
    return 0
}

//@diva-file:/home/joeblack/Documents/diva/compiler/src/ast_dump.diva
// Minimal AST text dump. Keeps stable strings used by tests:
// Program, Var(name: type), Ident(symbol).

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "ast.diva"
import "tokens.diva"

func dump_pad(depth: int): int {
    var i = 0
    while (i < depth) {
        print_str("  ")
        i = i + 1
    }
    return 0
}

func dump_line(depth: int, s: str, nl: str): int {
    dump_pad(depth)
    print_str(s)
    print_str(nl)
    return 0
}

func type_str(node: int, src: str, toks: int): str {
    if (node < 0) {
        return "?"
    }
    if (ast_kind(node) == nd_type_name()) {
        return tok_text(src, toks, ast_child(node, 0))
    }
    if (ast_kind(node) == nd_type_array()) {
        var b = str_builder_new()
        str_builder_append(b, type_str(ast_child(node, 0), src, toks))
        str_builder_append(b, "[]")
        var s = str_builder_to_str(b)
        str_builder_free(b)
        return s
    }
    return "?"
}

func dump_expr(node: int, depth: int, src: str, toks: int, nl: str): int {
    if (node < 0) {
        return 0
    }
    var k = ast_kind(node)
    if (k == nd_ident()) {
        var b = str_builder_new()
        str_builder_append(b, "Ident(")
        str_builder_append(b, tok_text(src, toks, ast_child(node, 0)))
        str_builder_append(b, ")")
        dump_line(depth, str_builder_to_str(b), nl)
        str_builder_free(b)
        return 0
    }
    if (k == nd_call()) {
        dump_line(depth, "Call", nl)
        dump_expr(ast_child(node, 0), depth + 1, src, toks, nl)
        var args = ast_child(node, 1)
        var i = 0
        while (i < int_vec_len(args)) {
            dump_expr(int_vec_get(args, i), depth + 1, src, toks, nl)
            i = i + 1
        }
        return 0
    }
    if (k == nd_generic_call()) {
        dump_line(depth, "GenericCall", nl)
        dump_expr(ast_child(node, 0), depth + 1, src, toks, nl)
        var targs = ast_child(node, 1)
        var ti = 0
        while (ti < int_vec_len(targs)) {
            dump_line(depth + 1, tok_text(src, toks, int_vec_get(targs, ti)), nl)
            ti = ti + 1
        }
        var args2 = ast_child(node, 2)
        var i2 = 0
        while (i2 < int_vec_len(args2)) {
            dump_expr(int_vec_get(args2, i2), depth + 1, src, toks, nl)
            i2 = i2 + 1
        }
        return 0
    }
    return 0
}

func dump_stmt(node: int, depth: int, src: str, toks: int, nl: str): int {
    if (node < 0) {
        return 0
    }
    var k = ast_kind(node)
    if (k == nd_var_decl()) {
        var name = tok_text(src, toks, ast_child(node, 0))
        var ty = type_str(ast_child(node, 1), src, toks)
        var b = str_builder_new()
        str_builder_append(b, "Var(")
        str_builder_append(b, name)
        str_builder_append(b, ": ")
        str_builder_append(b, ty)
        str_builder_append(b, ")")
        dump_line(depth, str_builder_to_str(b), nl)
        str_builder_free(b)
        dump_expr(ast_child(node, 2), depth + 1, src, toks, nl)
        return 0
    }
    if (k == nd_expr_stmt()) {
        dump_expr(ast_child(node, 0), depth, src, toks, nl)
        return 0
    }
    if (k == nd_return()) {
        dump_expr(ast_child(node, 0), depth, src, toks, nl)
        return 0
    }
    if (k == nd_block()) {
        var stmts = ast_child(node, 0)
        var i = 0
        while (i < int_vec_len(stmts)) {
            dump_stmt(int_vec_get(stmts, i), depth, src, toks, nl)
            i = i + 1
        }
        return 0
    }
    return 0
}

func dump_top(node: int, src: str, toks: int, nl: str): int {
    if (ast_kind(node) == nd_func()) {
        dump_stmt(ast_child(node, 3), 1, src, toks, nl)
    }
    return 0
}

func ast_dump_program(path: str, src: str, toks: int, file_node: int, nl: str): int {
    var b = str_builder_new()
    str_builder_append(b, "Program source=")
    str_builder_append(b, path)
    print_str(str_builder_to_str(b))
    str_builder_free(b)
    print_str(nl)

    var ch = ast_child(file_node, 0)
    var i = 0
    while (i < int_vec_len(ch)) {
        dump_top(int_vec_get(ch, i), src, toks, nl)
        i = i + 1
    }
    return 0
}

//@diva-file:/home/joeblack/Documents/diva/compiler/src/sema.diva
// Semantic checks for the native pipeline.
// Issue #53: scoped name resolution + call arity (MVP type checker).
// Full assign/return/binop type matching and span diagnostics are follow-ups (#54).

import "std/io.diva"
import "std/conv.diva"
import "std/vec.diva"
import "tokens.diva"
import "ast.diva"
import "std/host.diva"
import "cell.diva"
import "diag.diva"
import "ir.diva"

func sema_err(msg: str): int {
    stderr("sema: ")
    stderr(msg)
    stderr(char_to_str(10))
    return 1
}

func sema_err_at(src: str, byte_off: int, msg: str): int {
    diag_emit_loc(src, byte_off)
    stderr("sema: ")
    stderr(msg)
    stderr(char_to_str(10))
    return 1
}

func sema_top_level_func_hashes(file_node: int): int {
    var children = ast_child(file_node, 0)
    var n = int_vec_len(children)
    var seen = int_vec_new()
    var i = 0
    while (i < n) {
        var ch = int_vec_get(children, i)
        if ast_kind(ch) == nd_func() {
            var ht = ast_child(ch, 0)
            var j = 0
            var nc = int_vec_len(seen)
            while (j < nc) {
                if (int_vec_get(seen, j) == ht) {
                    return sema_err("duplicate top-level function name")
                }
                j = j + 1
            }
            int_vec_push(seen, ht)
        }
        i = i + 1
    }
    int_vec_free(seen)
    return 0
}

// Same-block `let` duplicates (flat list of stmts in one nd_block); matches seed wording for tests.
func sema_dup_let_flat_block(block: int, src: str, toks: int): int {
    if (block < 0) {
        return 0
    }
    if ast_kind(block) != nd_block() {
        return 0
    }
    var stmts = ast_child(block, 0)
    var ns = int_vec_len(stmts)
    var names = int_vec_new()
    var si = 0
    while (si < ns) {
        var st = int_vec_get(stmts, si)
        if ast_kind(st) == nd_var_decl() {
            var nt = ast_child(st, 0)
            var nm = tok_text(src, toks, nt)
            var j = 0
            var nn = int_vec_len(names)
            while (j < nn) {
                var pt = int_vec_get(names, j)
                if str_eq(tok_text(src, toks, pt), nm) == 1 {
                    int_vec_free(names)
                    diag_emit_loc(src, tok_start(toks, nt))
                    stderr("sema: duplicate declaration of '")
                    stderr(nm)
                    stderr("' in the same scope")
                    stderr(char_to_str(10))
                    return 1
                }
                j = j + 1
            }
            int_vec_push(names, nt)
        }
        si = si + 1
    }
    int_vec_free(names)
    return 0
}

func sema_check_func_body_dup_lets(file_node: int, src: str, toks: int): int {
    var children = ast_child(file_node, 0)
    var n = int_vec_len(children)
    var i = 0
    while (i < n) {
        var ch = int_vec_get(children, i)
        if ast_kind(ch) == nd_func() {
            var body = ast_child(ch, 3)
            if sema_dup_let_flat_block(body, src, toks) != 0 {
                return 1
            }
        }
        if ast_kind(ch) == nd_impl() {
            var methods = ast_child(ch, 2)
            var mi = 0
            while (mi < int_vec_len(methods)) {
                var m = int_vec_get(methods, mi)
                if ast_kind(m) == nd_func() {
                    if sema_dup_let_flat_block(ast_child(m, 3), src, toks) != 0 {
                        return 1
                    }
                }
                mi = mi + 1
            }
        }
        if ast_kind(ch) == nd_class() {
            var members = ast_child(ch, 1)
            var cj = 0
            while (cj < int_vec_len(members)) {
                var cm = int_vec_get(members, cj)
                if ast_kind(cm) == nd_func() {
                    if sema_dup_let_flat_block(ast_child(cm, 3), src, toks) != 0 {
                        return 1
                    }
                }
                cj = cj + 1
            }
        }
        i = i + 1
    }
    return 0
}

func sema_find_trait(file_node: int, src: str, toks: int, trait_tok: int): int {
    var children = ast_child(file_node, 0)
    var n = int_vec_len(children)
    var want = tok_text(src, toks, trait_tok)
    var i = 0
    while (i < n) {
        var ch = int_vec_get(children, i)
        if ast_kind(ch) == nd_trait() {
            var nm = tok_text(src, toks, ast_child(ch, 0))
            if str_eq(nm, want) == 1 {
                return ch
            }
        }
        i = i + 1
    }
    return 0 - 1
}

func sema_method_name_in_list(methods: int, src: str, toks: int, want: str): int {
    var n = int_vec_len(methods)
    var i = 0
    while (i < n) {
        var m = int_vec_get(methods, i)
        if ast_kind(m) == nd_func() {
            var nm = tok_text(src, toks, ast_child(m, 0))
            if str_eq(nm, want) == 1 {
                return 1
            }
        }
        i = i + 1
    }
    return 0
}

// Static-dispatch MVP: every trait method name must appear on the impl.
func sema_check_impls(file_node: int, src: str, toks: int): int {
    var children = ast_child(file_node, 0)
    var n = int_vec_len(children)
    var i = 0
    while (i < n) {
        var ch = int_vec_get(children, i)
        if ast_kind(ch) == nd_impl() {
            var trait_tok = ast_child(ch, 0)
            var type_tok = ast_child(ch, 1)
            var impl_methods = ast_child(ch, 2)
            var trait_node = sema_find_trait(file_node, src, toks, trait_tok)
            if (trait_node < 0) {
                diag_emit_loc(src, tok_start(toks, trait_tok))
                stderr("sema: unknown trait '")
                stderr(tok_text(src, toks, trait_tok))
                stderr("' in impl")
                stderr(char_to_str(10))
                return 1
            }
            var trait_methods = ast_child(trait_node, 1)
            var ti = 0
            while (ti < int_vec_len(trait_methods)) {
                var tm = int_vec_get(trait_methods, ti)
                if ast_kind(tm) == nd_func() {
                    var mname = tok_text(src, toks, ast_child(tm, 0))
                    if sema_method_name_in_list(impl_methods, src, toks, mname) == 0 {
                        diag_emit_loc(src, tok_start(toks, ast_child(tm, 0)))
                        stderr("sema: missing trait method '")
                        stderr(mname)
                        stderr("' in impl of '")
                        stderr(tok_text(src, toks, trait_tok))
                        stderr("' for '")
                        stderr(tok_text(src, toks, type_tok))
                        stderr("'")
                        stderr(char_to_str(10))
                        return 1
                    }
                }
                ti = ti + 1
            }
        }
        i = i + 1
    }
    return 0
}

// Returns 0 if ok, 1 on error (messages on stderr).
func sema_check_file(src: str, toks: int, file_node: int): int {
    if sema_top_level_func_hashes(file_node) != 0 {
        return 1
    }
    if sema_check_func_body_dup_lets(file_node, src, toks) != 0 {
        return 1
    }
    if sema_check_impls(file_node, src, toks) != 0 {
        return 1
    }
    if sema_check_names(file_node, src, toks) != 0 {
        return 1
    }
    return 0
}

// --- Production name / arity + basic type checker (Issue #53) ---

func sctx_new(): int {
    var c = int_vec_new()
    int_vec_push(c, mut_new(int_vec_new()))
    int_vec_push(c, mut_new(int_vec_new()))
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    int_vec_push(c, mut_new(0))
    int_vec_push(c, mut_new(int_vec_new()))
    int_vec_push(c, mut_new(0))
    int_vec_push(c, int_vec_new())
    int_vec_push(c, int_vec_new())
    return c
}

func sctx_names(c: int): int { return mut_get(int_vec_get(c, 0)) }
func sctx_marks(c: int): int { return mut_get(int_vec_get(c, 1)) }
func sctx_globals(c: int): int { return int_vec_get(c, 2) }
func sctx_fn_names(c: int): int { return int_vec_get(c, 3) }
func sctx_fn_arities(c: int): int { return int_vec_get(c, 4) }
func sctx_types(c: int): int { return int_vec_get(c, 5) }
func sctx_methods(c: int): int { return int_vec_get(c, 6) }
func sctx_self_ok(c: int): int { return mut_get(int_vec_get(c, 7)) }
func sctx_local_types(c: int): int { return mut_get(int_vec_get(c, 8)) }
func sctx_cur_ret_ty(c: int): int { return mut_get(int_vec_get(c, 9)) }
func sctx_global_types(c: int): int { return int_vec_get(c, 10) }
func sctx_fn_ret_types(c: int): int { return int_vec_get(c, 11) }
func sctx_set_self_ok(c: int, v: int): int { return mut_set(int_vec_get(c, 7), v) }
func sctx_set_names(c: int, v: int): int { return mut_set(int_vec_get(c, 0), v) }
func sctx_set_marks(c: int, v: int): int { return mut_set(int_vec_get(c, 1), v) }
func sctx_set_local_types(c: int, v: int): int { return mut_set(int_vec_get(c, 8), v) }
func sctx_set_cur_ret_ty(c: int, v: int): int { return mut_set(int_vec_get(c, 9), v) }

func sctx_free(c: int): int {
    int_vec_free(sctx_names(c))
    int_vec_free(sctx_marks(c))
    int_vec_free(sctx_globals(c))
    int_vec_free(sctx_fn_names(c))
    int_vec_free(sctx_fn_arities(c))
    int_vec_free(sctx_fn_ret_types(c))
    int_vec_free(sctx_types(c))
    int_vec_free(sctx_methods(c))
    int_vec_free(sctx_local_types(c))
    int_vec_free(sctx_global_types(c))
    int_vec_free(c)
    return 0
}

func sctx_scope_push(c: int): int {
    int_vec_push(sctx_marks(c), int_vec_len(sctx_names(c)))
    return 0
}

func sctx_truncate_vec(old: int, mark: int): int {
    var fresh = int_vec_new()
    var i = 0
    while (i < mark) {
        int_vec_push(fresh, int_vec_get(old, i))
        i = i + 1
    }
    int_vec_free(old)
    return fresh
}

func sctx_scope_pop(c: int): int {
    var marks = sctx_marks(c)
    var n = int_vec_len(marks)
    if n == 0 { return 0 }
    var mark = int_vec_get(marks, n - 1)
    sctx_set_marks(c, sctx_truncate_vec(marks, n - 1))
    var names = sctx_names(c)
    if int_vec_len(names) > mark {
        sctx_set_names(c, sctx_truncate_vec(names, mark))
    }
    var lty = sctx_local_types(c)
    if int_vec_len(lty) > mark {
        sctx_set_local_types(c, sctx_truncate_vec(lty, mark))
    }
    return 0
}

func sctx_tok_list_has(list: int, src: str, toks: int, want: str): int {
    var i = 0
    var n = int_vec_len(list)
    while (i < n) {
        if str_eq(tok_text(src, toks, int_vec_get(list, i)), want) == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

func sctx_define(c: int, name_tok: int): int {
    return sctx_define_typed(c, name_tok, ir_ty_int())
}

func sctx_define_typed(c: int, name_tok: int, ty: int): int {
    int_vec_push(sctx_names(c), name_tok)
    int_vec_push(sctx_local_types(c), ty)
    return 0
}

func sctx_ty_name(ty: int): str {
    if ty == ir_ty_void() { return "void" }
    if ty == ir_ty_int() { return "int" }
    if ty == ir_ty_bool() { return "bool" }
    if ty == ir_ty_str() { return "str" }
    if ty == ir_ty_text() { return "text" }
    return "?"
}

func sema_type_from_node(type_node: int, src: str, toks: int): int {
    if (type_node < 0) {
        return ir_ty_int()
    }
    if ast_kind(type_node) != nd_type_name() {
        return ir_ty_int()
    }
    var tn = tok_text(src, toks, ast_child(type_node, 0))
    if str_eq(tn, "int") == 1 { return ir_ty_int() }
    if str_eq(tn, "bool") == 1 { return ir_ty_bool() }
    if str_eq(tn, "str") == 1 { return ir_ty_str() }
    if str_eq(tn, "text") == 1 { return ir_ty_text() }
    if str_eq(tn, "void") == 1 { return ir_ty_void() }
    return ir_ty_int()
}

func sctx_lookup_var_type(c: int, src: str, toks: int, want: str): int {
    var names = sctx_names(c)
    var lty = sctx_local_types(c)
    var i = 0
    while (i < int_vec_len(names)) {
        if str_eq(tok_text(src, toks, int_vec_get(names, i)), want) == 1 {
            return int_vec_get(lty, i)
        }
        i = i + 1
    }
    var g = sctx_globals(c)
    var gt = sctx_global_types(c)
    i = 0
    while (i < int_vec_len(g)) {
        if str_eq(tok_text(src, toks, int_vec_get(g, i)), want) == 1 {
            return int_vec_get(gt, i)
        }
        i = i + 1
    }
    return ir_ty_int()
}

func sema_type_mismatch_at(src: str, toks: int, at_tok: int, want: int, got: int): int {
    diag_emit_loc(src, tok_start(toks, at_tok))
    stderr("sema: type mismatch: expected ")
    stderr(sctx_ty_name(want))
    stderr(", got ")
    stderr(sctx_ty_name(got))
    stderr(char_to_str(10))
    return 1
}

func sema_binop_is_arith(op: int): int {
    if op == binop_add() { return 1 }
    if op == binop_sub() { return 1 }
    if op == binop_mul() { return 1 }
    if op == binop_div() { return 1 }
    if op == binop_mod() { return 1 }
    return 0
}

func sema_binop_is_compare(op: int): int {
    if op == binop_eq() { return 1 }
    if op == binop_ne() { return 1 }
    if op == binop_lt() { return 1 }
    if op == binop_le() { return 1 }
    if op == binop_gt() { return 1 }
    if op == binop_ge() { return 1 }
    return 0
}

func sema_binop_is_logic(op: int): int {
    if op == binop_and() { return 1 }
    if op == binop_or() { return 1 }
    return 0
}

func sema_expr_type(c: int, src: str, toks: int, node: int): int {
    if (node < 0) { return ir_ty_void() }
    var kind = ast_kind(node)
    if kind == nd_int_lit() { return ir_ty_int() }
    if kind == nd_bool_lit() { return ir_ty_bool() }
    if kind == nd_str_lit() { return ir_ty_str() }
    if kind == nd_text_lit() { return ir_ty_text() }
    if kind == nd_text_slice() { return ir_ty_text() }
    if kind == nd_ident() {
        var itok = ast_child(node, 0)
        return sctx_lookup_var_type(c, src, toks, tok_text(src, toks, itok))
    }
    if kind == nd_binop() {
        var op = ast_child(node, 0)
        var lt = sema_expr_type(c, src, toks, ast_child(node, 1))
        var rt = sema_expr_type(c, src, toks, ast_child(node, 2))
        if (op == binop_add()) & (lt == ir_ty_text()) & (rt == ir_ty_text()) { return ir_ty_text() }
        if sema_binop_is_arith(op) == 1 { return ir_ty_int() }
        if sema_binop_is_compare(op) == 1 { return ir_ty_bool() }
        if sema_binop_is_logic(op) == 1 {
            if lt == ir_ty_int() {
                if rt == ir_ty_int() {
                    return ir_ty_int()
                }
            }
            return ir_ty_bool()
        }
        return ir_ty_int()
    }
    if kind == nd_unary() {
        return sema_expr_type(c, src, toks, ast_child(node, 1))
    }
    if kind == nd_call() {
        var callee = ast_child(node, 0)
        if ast_kind(callee) == nd_ident() {
            var ctok = ast_child(callee, 0)
            var rty = sctx_fn_ret_type(c, src, toks, tok_text(src, toks, ctok))
            if rty >= 0 {
                return rty
            }
        }
        return ir_ty_int()
    }
    if kind == nd_generic_call() {
        return ir_ty_int()
    }
    if kind == nd_method_call() {
        return ir_ty_int()
    }
    if kind == nd_field() {
        return ir_ty_int()
    }
    if kind == nd_index() {
        return ir_ty_int()
    }
    return ir_ty_int()
}

func sema_compare_operand_ok(lt: int, rt: int): int {
    if lt == rt {
        return 1
    }
    if lt == ir_ty_bool() {
        if rt == ir_ty_int() {
            return 1
        }
    }
    if rt == ir_ty_bool() {
        if lt == ir_ty_int() {
            return 1
        }
    }
    return 0
}

func sema_check_binop_types(c: int, src: str, toks: int, node: int): int {
    var op = ast_child(node, 0)
    var left = ast_child(node, 1)
    var right = ast_child(node, 2)
    if sema_check_expr(c, src, toks, left) != 0 { return 1 }
    if sema_check_expr(c, src, toks, right) != 0 { return 1 }
    var lt = sema_expr_type(c, src, toks, left)
    var rt = sema_expr_type(c, src, toks, right)
    if (op == binop_add()) & (lt == ir_ty_text()) & (rt == ir_ty_text()) { return 0 }
    var want = ir_ty_int()
    if sema_binop_is_logic(op) == 1 {
        if lt == ir_ty_int() {
            if rt == ir_ty_int() {
                want = ir_ty_int()
            } else {
                want = ir_ty_bool()
            }
        } else {
            want = ir_ty_bool()
        }
    }
    if sema_binop_is_arith(op) == 1 {
        want = ir_ty_int()
    }
    if sema_binop_is_compare(op) == 1 {
        if sema_compare_operand_ok(lt, rt) == 1 {
            return 0
        }
        want = ir_ty_int()
    }
    if lt != want {
        if ast_kind(left) == nd_ident() {
            return sema_type_mismatch_at(src, toks, ast_child(left, 0), want, lt)
        }
        return sema_err("type mismatch in binary expression (left operand)")
    }
    if rt != want {
        if ast_kind(right) == nd_ident() {
            return sema_type_mismatch_at(src, toks, ast_child(right, 0), want, rt)
        }
        return sema_err("type mismatch in binary expression (right operand)")
    }
    return 0
}

func sctx_name_known(c: int, src: str, toks: int, want: str): int {
    if sctx_tok_list_has(sctx_names(c), src, toks, want) == 1 { return 1 }
    if sctx_tok_list_has(sctx_globals(c), src, toks, want) == 1 { return 1 }
    if sctx_tok_list_has(sctx_fn_names(c), src, toks, want) == 1 { return 1 }
    if (sctx_self_ok(c) == 1) & (str_eq(want, "self") == 1) { return 1 }
    return 0
}

func sctx_fn_arity(c: int, src: str, toks: int, want: str): int {
    var names = sctx_fn_names(c)
    var ars = sctx_fn_arities(c)
    var i = 0
    var n = int_vec_len(names)
    while (i < n) {
        if str_eq(tok_text(src, toks, int_vec_get(names, i)), want) == 1 {
            return int_vec_get(ars, i)
        }
        i = i + 1
    }
    return 0 - 1
}

func sctx_fn_ret_type(c: int, src: str, toks: int, want: str): int {
    var names = sctx_fn_names(c)
    var rts = sctx_fn_ret_types(c)
    var i = 0
    var n = int_vec_len(names)
    while (i < n) {
        if str_eq(tok_text(src, toks, int_vec_get(names, i)), want) == 1 {
            return int_vec_get(rts, i)
        }
        i = i + 1
    }
    return 0 - 1
}

func sctx_add_fn(c: int, src: str, toks: int, name_tok: int, arity: int, ret_ty: int): int {
    var nm = tok_text(src, toks, name_tok)
    if sctx_tok_list_has(sctx_fn_names(c), src, toks, nm) == 1 {
        diag_emit_loc(src, tok_start(toks, name_tok))
        stderr("sema: duplicate function '")
        stderr(nm)
        stderr("'")
        stderr(char_to_str(10))
        return 1
    }
    int_vec_push(sctx_fn_names(c), name_tok)
    int_vec_push(sctx_fn_arities(c), arity)
    int_vec_push(sctx_fn_ret_types(c), ret_ty)
    return 0
}

func sctx_add_global(c: int, src: str, toks: int, name_tok: int, ty: int): int {
    var nm = tok_text(src, toks, name_tok)
    if sctx_tok_list_has(sctx_globals(c), src, toks, nm) == 1 {
        diag_emit_loc(src, tok_start(toks, name_tok))
        stderr("sema: duplicate global '")
        stderr(nm)
        stderr("'")
        stderr(char_to_str(10))
        return 1
    }
    if sctx_tok_list_has(sctx_fn_names(c), src, toks, nm) == 1 {
        diag_emit_loc(src, tok_start(toks, name_tok))
        stderr("sema: global '")
        stderr(nm)
        stderr("' conflicts with function")
        stderr(char_to_str(10))
        return 1
    }
    int_vec_push(sctx_globals(c), name_tok)
    int_vec_push(sctx_global_types(c), ty)
    return 0
}

func sema_unknown_at(src: str, toks: int, name_tok: int): int {
    diag_emit_loc(src, tok_start(toks, name_tok))
    stderr("sema: unknown identifier '")
    stderr(tok_text(src, toks, name_tok))
    stderr("'")
    stderr(char_to_str(10))
    return 1
}

func sema_check_expr(c: int, src: str, toks: int, node: int): int {
    if (node < 0) { return 0 }
    var kind = ast_kind(node)
    if kind == nd_int_lit() { return 0 }
    if kind == nd_bool_lit() { return 0 }
    if kind == nd_str_lit() { return 0 }
    if kind == nd_text_lit() { return 0 }
    if kind == nd_ident() {
        var itok = ast_child(node, 0)
        var nm = tok_text(src, toks, itok)
        if sctx_name_known(c, src, toks, nm) == 0 {
            return sema_unknown_at(src, toks, itok)
        }
        return 0
    }
    if kind == nd_binop() {
        return sema_check_binop_types(c, src, toks, node)
    }
    if kind == nd_unary() {
        return sema_check_expr(c, src, toks, ast_child(node, 1))
    }
    if kind == nd_call() {
        return sema_check_call(c, src, toks, node)
    }
    if kind == nd_generic_call() {
        return sema_check_generic_call(c, src, toks, node)
    }
    if kind == nd_method_call() {
        return sema_check_method_call(c, src, toks, node)
    }
    if kind == nd_field() {
        return sema_check_expr(c, src, toks, ast_child(node, 0))
    }
    if kind == nd_index() {
        if sema_check_expr(c, src, toks, ast_child(node, 0)) != 0 { return 1 }
        return sema_check_expr(c, src, toks, ast_child(node, 1))
    }
    if kind == nd_text_slice() {
        if sema_check_expr(c, src, toks, ast_child(node, 0)) != 0 { return 1 }
        if sema_check_expr(c, src, toks, ast_child(node, 1)) != 0 { return 1 }
        return sema_check_expr(c, src, toks, ast_child(node, 2))
    }
    if kind == nd_obj_lit() {
        return sema_check_obj_lit(c, src, toks, node)
    }
    if kind == nd_array_lit() {
        var elems = ast_child(node, 0)
        var i = 0
        while (i < int_vec_len(elems)) {
            if sema_check_expr(c, src, toks, int_vec_get(elems, i)) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    if kind == nd_range() {
        if sema_check_expr(c, src, toks, ast_child(node, 0)) != 0 { return 1 }
        return sema_check_expr(c, src, toks, ast_child(node, 1))
    }
    return 0
}

func sema_check_call(c: int, src: str, toks: int, node: int): int {
    var callee = ast_child(node, 0)
    var args = ast_child(node, 1)
    var ai = 0
    while (ai < int_vec_len(args)) {
        if sema_check_expr(c, src, toks, int_vec_get(args, ai)) != 0 { return 1 }
        ai = ai + 1
    }
    if ast_kind(callee) != nd_ident() {
        return sema_check_expr(c, src, toks, callee)
    }
    var ctok = ast_child(callee, 0)
    var nm = tok_text(src, toks, ctok)
    var arity = sctx_fn_arity(c, src, toks, nm)
    if (arity < 0) {
        return sema_unknown_at(src, toks, ctok)
    }
    if (int_vec_len(args) != arity) {
        diag_emit_loc(src, tok_start(toks, ctok))
        stderr("sema: wrong number of arguments for '")
        stderr(nm)
        stderr("': expected ")
        stderr(int_to_str(arity))
        stderr(", got ")
        stderr(int_to_str(int_vec_len(args)))
        stderr(char_to_str(10))
        return 1
    }
    return 0
}

func sema_check_generic_call(c: int, src: str, toks: int, node: int): int {
    var callee = ast_child(node, 0)
    var args = ast_child(node, 2)
    var ai = 0
    while (ai < int_vec_len(args)) {
        if sema_check_expr(c, src, toks, int_vec_get(args, ai)) != 0 { return 1 }
        ai = ai + 1
    }
    if ast_kind(callee) != nd_ident() {
        return sema_check_expr(c, src, toks, callee)
    }
    var ctok = ast_child(callee, 0)
    var nm = tok_text(src, toks, ctok)
    var arity = sctx_fn_arity(c, src, toks, nm)
    if (arity < 0) {
        return sema_unknown_at(src, toks, ctok)
    }
    if (int_vec_len(args) != arity) {
        diag_emit_loc(src, tok_start(toks, ctok))
        stderr("sema: wrong number of arguments for '")
        stderr(nm)
        stderr("': expected ")
        stderr(int_to_str(arity))
        stderr(", got ")
        stderr(int_to_str(int_vec_len(args)))
        stderr(char_to_str(10))
        return 1
    }
    return 0
}

func sema_check_method_call(c: int, src: str, toks: int, node: int): int {
    if sema_check_expr(c, src, toks, ast_child(node, 0)) != 0 { return 1 }
    var args = ast_child(node, 2)
    var ai = 0
    while (ai < int_vec_len(args)) {
        if sema_check_expr(c, src, toks, int_vec_get(args, ai)) != 0 { return 1 }
        ai = ai + 1
    }
    var mtok = ast_child(node, 1)
    var mname = tok_text(src, toks, mtok)
    if sctx_tok_list_has(sctx_fn_names(c), src, toks, mname) == 1 { return 0 }
    if sctx_tok_list_has(sctx_methods(c), src, toks, mname) == 1 { return 0 }
    diag_emit_loc(src, tok_start(toks, mtok))
    stderr("sema: unknown method '")
    stderr(mname)
    stderr("'")
    stderr(char_to_str(10))
    return 1
}

func sema_check_obj_lit(c: int, src: str, toks: int, node: int): int {
    // Obj lit: [kind, type_tok_or_-1, field_inits]
    var type_tok = ast_child(node, 0)
    if (type_tok < 0) == 0 {
        var tnm = tok_text(src, toks, type_tok)
        if sctx_tok_list_has(sctx_types(c), src, toks, tnm) == 0 {
            diag_emit_loc(src, tok_start(toks, type_tok))
            stderr("sema: unknown type '")
            stderr(tnm)
            stderr("' in object literal")
            stderr(char_to_str(10))
            return 1
        }
    }
    var inits = ast_child(node, 1)
    var i = 0
    while (i < int_vec_len(inits)) {
        var fi = int_vec_get(inits, i)
        // field_init: [kind, field_tok, value]
        if sema_check_expr(c, src, toks, ast_child(fi, 1)) != 0 { return 1 }
        i = i + 1
    }
    return 0
}

func sema_check_stmt(c: int, src: str, toks: int, node: int): int {
    if (node < 0) { return 0 }
    var kind = ast_kind(node)
    if kind == nd_var_decl() {
        var name_tok = ast_child(node, 0)
        var type_node = ast_child(node, 1)
        var init = ast_child(node, 2)
        var vty = sema_type_from_node(type_node, src, toks)
        if (init < 0) == 0 {
            if sema_check_expr(c, src, toks, init) != 0 { return 1 }
            if (type_node < 0) {
                vty = sema_expr_type(c, src, toks, init)
            } else {
                var got = sema_expr_type(c, src, toks, init)
                if got != vty {
                    return sema_type_mismatch_at(src, toks, name_tok, vty, got)
                }
            }
        }
        sctx_define_typed(c, name_tok, vty)
        return 0
    }
    if kind == nd_assign() {
        var target = ast_child(node, 0)
        var value = ast_child(node, 1)
        if sema_check_expr(c, src, toks, value) != 0 { return 1 }
        if ast_kind(target) == nd_ident() {
            var ttok = ast_child(target, 0)
            var nm = tok_text(src, toks, ttok)
            if sctx_name_known(c, src, toks, nm) == 0 {
                return sema_unknown_at(src, toks, ttok)
            }
            var want = sctx_lookup_var_type(c, src, toks, nm)
            var got = sema_expr_type(c, src, toks, value)
            if got != want {
                return sema_type_mismatch_at(src, toks, ttok, want, got)
            }
        } else {
            if sema_check_expr(c, src, toks, target) != 0 { return 1 }
        }
        return 0
    }
    if kind == nd_return() {
        var e = ast_child(node, 0)
        var ret_ty = sctx_cur_ret_ty(c)
        if (e < 0) == 0 {
            if sema_check_expr(c, src, toks, e) != 0 { return 1 }
            var got = sema_expr_type(c, src, toks, e)
            if ret_ty != got {
                return sema_err("return type mismatch")
            }
        } else {
            if ret_ty != ir_ty_void() {
                return sema_err("return type mismatch")
            }
        }
        return 0
    }
    if kind == nd_expr_stmt() {
        return sema_check_expr(c, src, toks, ast_child(node, 0))
    }
    if kind == nd_if() {
        if sema_check_expr(c, src, toks, ast_child(node, 0)) != 0 { return 1 }
        if sema_check_block_or_stmt(c, src, toks, ast_child(node, 1)) != 0 { return 1 }
        var els = ast_child(node, 2)
        if (els < 0) == 0 {
            if (els == 2147483647) == 0 {
                return sema_check_block_or_stmt(c, src, toks, els)
            }
        }
        return 0
    }
    if kind == nd_while() {
        if sema_check_expr(c, src, toks, ast_child(node, 0)) != 0 { return 1 }
        if sema_check_block_or_stmt(c, src, toks, ast_child(node, 1)) != 0 { return 1 }
        var upd = ast_child(node, 2)
        if (upd < 0) == 0 {
            if (upd == 2147483647) == 0 {
                return sema_check_expr(c, src, toks, upd)
            }
        }
        return 0
    }
    if kind == nd_flux() {
        if sema_check_expr(c, src, toks, ast_child(node, 1)) != 0 { return 1 }
        sctx_scope_push(c)
        sctx_define(c, ast_child(node, 0))
        var rc = sema_check_block_or_stmt(c, src, toks, ast_child(node, 2))
        sctx_scope_pop(c)
        return rc
    }
    if kind == nd_block() {
        return sema_check_block_or_stmt(c, src, toks, node)
    }
    return 0
}

func sema_check_block_or_stmt(c: int, src: str, toks: int, node: int): int {
    if (node < 0) { return 0 }
    if ast_kind(node) == nd_block() {
        sctx_scope_push(c)
        var stmts = ast_child(node, 0)
        var i = 0
        while (i < int_vec_len(stmts)) {
            if sema_check_stmt(c, src, toks, int_vec_get(stmts, i)) != 0 {
                sctx_scope_pop(c)
                return 1
            }
            i = i + 1
        }
        sctx_scope_pop(c)
        return 0
    }
    return sema_check_stmt(c, src, toks, node)
}

func sema_check_func_node(c: int, src: str, toks: int, fn: int): int {
    sctx_scope_push(c)
    var ret_node = ast_child(fn, 2)
    sctx_set_cur_ret_ty(c, sema_type_from_node(ret_node, src, toks))
    var params = ast_child(fn, 1)
    var pi = 0
    while (pi < int_vec_len(params)) {
        var p = int_vec_get(params, pi)
        var pty = sema_type_from_node(ast_child(p, 1), src, toks)
        sctx_define_typed(c, ast_child(p, 0), pty)
        pi = pi + 1
    }
    var body = ast_child(fn, 3)
    var rc = 0
    if (body < 0) == 0 {
        rc = sema_check_block_or_stmt(c, src, toks, body)
    }
    sctx_scope_pop(c)
    return rc
}

func sema_collect_toplevel(c: int, src: str, toks: int, file_node: int): int {
    var children = ast_child(file_node, 0)
    var n = int_vec_len(children)
    var i = 0
    while (i < n) {
        var ch = int_vec_get(children, i)
        var k = ast_kind(ch)
        if k == nd_func() {
            var f_ret = sema_type_from_node(ast_child(ch, 2), src, toks)
            if sctx_add_fn(c, src, toks, ast_child(ch, 0), int_vec_len(ast_child(ch, 1)), f_ret) != 0 {
                return 1
            }
        }
        if k == nd_extern_func() {
            var e_ret = sema_type_from_node(ast_child(ch, 2), src, toks)
            if sctx_add_fn(c, src, toks, ast_child(ch, 0), int_vec_len(ast_child(ch, 1)), e_ret) != 0 {
                return 1
            }
        }
        if k == nd_var_decl() {
            var g_type_node = ast_child(ch, 1)
            var gty = sema_type_from_node(g_type_node, src, toks)
            // Untyped globals: infer from initializer (same as local var decls).
            if (g_type_node < 0) {
                var g_init = ast_child(ch, 2)
                if (g_init < 0) == 0 {
                    gty = sema_expr_type(c, src, toks, g_init)
                }
            }
            if sctx_add_global(c, src, toks, ast_child(ch, 0), gty) != 0 {
                return 1
            }
        }
        if k == nd_class() {
            int_vec_push(sctx_types(c), ast_child(ch, 0))
            var members = ast_child(ch, 1)
            var mi = 0
            while (mi < int_vec_len(members)) {
                var m = int_vec_get(members, mi)
                if ast_kind(m) == nd_func() {
                    var mtok = ast_child(m, 0)
                    int_vec_push(sctx_methods(c), mtok)
                    // Class methods lower with implicit self as first arg (+1 arity).
                    var arity = int_vec_len(ast_child(m, 1)) + 1
                    if (sctx_fn_arity(c, src, toks, tok_text(src, toks, mtok)) < 0) {
                        var m_ret = sema_type_from_node(ast_child(m, 2), src, toks)
                        if sctx_add_fn(c, src, toks, mtok, arity, m_ret) != 0 {
                            return 1
                        }
                    }
                }
                mi = mi + 1
            }
        }
        if k == nd_impl() {
            var methods = ast_child(ch, 2)
            var mi = 0
            while (mi < int_vec_len(methods)) {
                var m = int_vec_get(methods, mi)
                if ast_kind(m) == nd_func() {
                    var mtok = ast_child(m, 0)
                    int_vec_push(sctx_methods(c), mtok)
                    var mnm = tok_text(src, toks, mtok)
                    // Impl methods lower as free funcs; register arity unless a free
                    // func with the same name already exists (receiver-first demos).
                    if (sctx_fn_arity(c, src, toks, mnm) < 0) {
                        var im_ret = sema_type_from_node(ast_child(m, 2), src, toks)
                        if sctx_add_fn(c, src, toks, mtok, int_vec_len(ast_child(m, 1)), im_ret) != 0 {
                            return 1
                        }
                    }
                }
                mi = mi + 1
            }
        }
        i = i + 1
    }
    return 0
}

func sema_check_names(file_node: int, src: str, toks: int): int {
    var c = sctx_new()
    if sema_collect_toplevel(c, src, toks, file_node) != 0 {
        sctx_free(c)
        return 1
    }
    // Global inits may reference other globals / funcs.
    var children = ast_child(file_node, 0)
    var i = 0
    while (i < int_vec_len(children)) {
        var ch = int_vec_get(children, i)
        if ast_kind(ch) == nd_var_decl() {
            var init = ast_child(ch, 2)
            if (init < 0) == 0 {
                if sema_check_expr(c, src, toks, init) != 0 {
                    sctx_free(c)
                    return 1
                }
            }
        }
        i = i + 1
    }
    i = 0
    while (i < int_vec_len(children)) {
        var ch2 = int_vec_get(children, i)
        var k2 = ast_kind(ch2)
        if k2 == nd_func() {
            if sema_check_func_node(c, src, toks, ch2) != 0 {
                sctx_free(c)
                return 1
            }
        }
        if k2 == nd_impl() {
            var methods = ast_child(ch2, 2)
            var mi = 0
            while (mi < int_vec_len(methods)) {
                var m = int_vec_get(methods, mi)
                if ast_kind(m) == nd_func() {
                    if sema_check_func_node(c, src, toks, m) != 0 {
                        sctx_free(c)
                        return 1
                    }
                }
                mi = mi + 1
            }
        }
        if k2 == nd_class() {
            var members2 = ast_child(ch2, 1)
            var mj = 0
            while (mj < int_vec_len(members2)) {
                var mm = int_vec_get(members2, mj)
                if ast_kind(mm) == nd_func() {
                    sctx_set_self_ok(c, 1)
                    if sema_check_func_node(c, src, toks, mm) != 0 {
                        sctx_set_self_ok(c, 0)
                        sctx_free(c)
                        return 1
                    }
                    sctx_set_self_ok(c, 0)
                }
                mj = mj + 1
            }
        }
        i = i + 1
    }
    sctx_free(c)
    return 0
}

// 1 = native may lower: package/import/funcs/extern; struct/class with fields and
// class-body methods (receiver-first / `self`); traits + impls.
func sema_class_members_ok(members: int): int {
    var n = int_vec_len(members)
    var j = 0
    while (j < n) {
        var mk = ast_kind(int_vec_get(members, j))
        if (mk == nd_class_field()) == 0 {
            if (mk == nd_func()) == 0 {
                return 0
            }
        }
        j = j + 1
    }
    return 1
}

func sema_file_only_native_subset(file_node: int): int {
    var children = ast_child(file_node, 0)
    var n = int_vec_len(children)
    var i = 0
    while (i < n) {
        var ch = int_vec_get(children, i)
        var k = ast_kind(ch)
        if k == nd_class() {
            var mem = ast_child(ch, 1)
            if sema_class_members_ok(mem) == 0 {
                return 0
            }
        }
        i = i + 1
    }
    return 1
}

//@diva-file:/home/joeblack/Documents/diva/compiler/src/loader.diva
// Package loader: merge package sources in dependency order for native build (no subprocess compiler).

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "std/str.diva"
import "cell.diva"

// When DIVA_CHECK_TRACE is set, merge/check prints stderr milestones (pure-driver debugging).
func loader_check_trace(): int {
    var v = host_getenv("DIVA_CHECK_TRACE")
    var v_hold = v
    if str_len(v_hold) > 0 {
        return 1
    }
    return 0
}

func loader_stdlib_dir(): str {
    var p = host_getenv("DI_STDLIB_DIR")
    var p_hold = p
    if (str_len(p_hold) > 0) {
        return p_hold
    }
    return "stdlib"
}

func loader_newline(): str {
    var std = loader_stdlib_dir()
    var std_hold = std
    var p = path_join_dir(std_hold, "std/lf.txt")
    var s = read_file(p)
    var s_hold = s
    if (!(str_len(s_hold) < 1)) {
        return str_slice(s_hold, 0, 1)
    }
    return ""
}

func path_join_dir(base: str, rel: str): str {
    var nb = str_len(base)
    if nb == 0 {
        return rel
    }
    if str_byte(base, nb - 1) == 47 {
        var b = str_builder_new()
        str_builder_append(b, base)
        str_builder_append(b, rel)
        var r = str_builder_to_str(b)
        str_builder_free(b)
        return r
    }
    var b2 = str_builder_new()
    str_builder_append(b2, base)
    str_builder_append(b2, "/")
    str_builder_append(b2, rel)
    var r2 = str_builder_to_str(b2)
    str_builder_free(b2)
    return r2
}

func dirname_of_file(path: str): str {
    var n = str_len(path)
    var i = n - 1
    while ((i < 0) == 0) {
        if str_byte(path, i) == 47 {
            if i == 0 {
                return "/"
            }
            return str_slice(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

func path_is_package_dir(root: str): int {
    var nl = str_len(root)
    if nl >= 5 {
        var suf = str_slice(root, nl - 5, 5)
        if str_eq(suf, ".diva") == 1 {
            return 0
        }
    }
    var msz = file_size(path_join_dir(root, "package.diva"))
    if msz < 0 {
        return 0
    }
    return 1
}

func package_manifest_kind_value(root: str): str {
    var mf = path_join_dir(root, "package.diva")
    if (file_size(mf) < 0) {
        return ""
    }
    var text = read_file(mf)
    var text_hold = text
    var text_len = str_len(text_hold)
    if text_len == 0 {
        return ""
    }
    var n = text_len
    var i = 0
    while (i < n) {
        var line_end = i
        while (line_end < n & str_byte(text, line_end) != 10) {
            line_end = line_end + 1
        }
        var line = str_slice(text, i, line_end - i)
        var ln = str_len(line)
        while (ln > 0 & str_byte(line, ln - 1) == 13) {
            ln = ln - 1
        }
        if (ln > 0) {
            var j = 0
            while (j < ln & (str_byte(line, j) == 32 | str_byte(line, j) == 9)) {
                j = j + 1
            }
            if !((j + 4) > ln) {
                if str_eq(str_slice(line, j, 4), "kind") == 1 {
                    var k = j + 4
                    while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                        k = k + 1
                    }
                    if (k < ln & str_byte(line, k) == 61) {
                        k = k + 1
                        while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                            k = k + 1
                        }
                        if (k < ln & str_byte(line, k) == 34) {
                            var q = k + 1
                            while (q < ln & str_byte(line, q) != 34) {
                                q = q + 1
                            }
                            if (q > k + 1) {
                                return str_slice(line, k + 1, q - k - 1)
                            }
                        }
                    }
                }
            }
        }
        i = line_end + 1
    }
    return ""
}

func package_is_kernel_dir(root: str): int {
    return str_eq(package_manifest_kind_value(root), "kernel")
}

// Package identity (Issue #24): `name = "…"` from package.diva.
func package_manifest_name(root: str): str {
    var mf = path_join_dir(root, "package.diva")
    if (file_size(mf) < 0) {
        return ""
    }
    var text = read_file(mf)
    var text_hold = text
    var text_len = str_len(text_hold)
    if text_len == 0 {
        return ""
    }
    var n = text_len
    var i = 0
    while (i < n) {
        var line_end = i
        while (line_end < n & str_byte(text, line_end) != 10) {
            line_end = line_end + 1
        }
        var line = str_slice(text, i, line_end - i)
        var ln = str_len(line)
        while (ln > 0 & str_byte(line, ln - 1) == 13) {
            ln = ln - 1
        }
        if (ln > 0) {
            var j = 0
            while (j < ln & (str_byte(line, j) == 32 | str_byte(line, j) == 9)) {
                j = j + 1
            }
            if !((j + 4) > ln) {
                if str_eq(str_slice(line, j, 4), "name") == 1 {
                    var k = j + 4
                    while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                        k = k + 1
                    }
                    if (k < ln & str_byte(line, k) == 61) {
                        k = k + 1
                        while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                            k = k + 1
                        }
                        if (k < ln & str_byte(line, k) == 34) {
                            var q = k + 1
                            while (q < ln & str_byte(line, q) != 34) {
                                q = q + 1
                            }
                            if (q > k + 1) {
                                return str_slice(line, k + 1, q - k - 1)
                            }
                        }
                    }
                }
            }
        }
        i = line_end + 1
    }
    return ""
}

// Newline-separated dep alias names (`dep.math_lib = …` → `math_lib`).
func package_manifest_dep_names(root: str): str {
    var mf = path_join_dir(root, "package.diva")
    if (file_size(mf) < 0) {
        return ""
    }
    var text = read_file(mf)
    var text_hold = text
    var text_len = str_len(text_hold)
    if text_len == 0 {
        return ""
    }
    var nl = loader_newline()
    var b = str_builder_new()
    var n = text_len
    var i = 0
    while (i < n) {
        var line_end = i
        while (line_end < n & str_byte(text, line_end) != 10) {
            line_end = line_end + 1
        }
        var line = str_slice(text, i, line_end - i)
        var ln = str_len(line)
        while (ln > 0 & str_byte(line, ln - 1) == 13) {
            ln = ln - 1
        }
        if (ln > 4) {
            var j = 0
            while (j < ln & (str_byte(line, j) == 32 | str_byte(line, j) == 9)) {
                j = j + 1
            }
            if !((j + 4) > ln) {
                if str_eq(str_slice(line, j, 4), "dep.") == 1 {
                    var k = j + 4
                    while (k < ln & (str_byte(line, k) != 32 & str_byte(line, k) != 9 & str_byte(line, k) != 61)) {
                        k = k + 1
                    }
                    if (k > j + 4) {
                        str_builder_append(b, str_slice(line, j + 4, k - j - 4))
                        str_builder_append(b, nl)
                    }
                }
            }
        }
        i = line_end + 1
    }
    var r = str_builder_to_str(b)
    str_builder_free(b)
    return r
}

func loader_djb2(s: str): int {
    var h = 5381
    var n = str_len(s)
    var i = 0
    while (i < n) {
        h = h * 33 + str_byte(s, i)
        i = i + 1
    }
    if (h < 0) {
        h = 0 - h
    }
    return h
}

func loader_hash_combine(a: int, b: int): int {
    var h = a * 31 + b
    if (h < 0) {
        h = 0 - h
    }
    return h
}

func loader_cache_dir(): str {
    var v = host_getenv("DIVA_CACHE_DIR")
    var v_hold = v
    if str_len(v_hold) > 0 {
        return v_hold
    }
    return ".diva/cache"
}

func loader_cache_enabled(): int {
    var v = host_getenv("DIVA_PKG_CACHE")
    var v_hold = v
    if str_eq(v_hold, "0") == 1 {
        return 0
    }
    return 1
}

func loader_module_graph_trace(): int {
    var v = host_getenv("DIVA_MODULE_GRAPH")
    var v_hold = v
    if str_len(v_hold) > 0 {
        return 1
    }
    return 0
}

func loader_pkg_cache_trace(): int {
    var v = host_getenv("DIVA_PKG_CACHE_TRACE")
    var v_hold = v
    if str_len(v_hold) > 0 {
        return 1
    }
    return 0
}

func loader_mkdir_p(path: str): int {
    var n = str_len(path)
    if n == 0 {
        return 0
    }
    var acc = ""
    var i = 0
    if str_byte(path, 0) == 47 {
        acc = "/"
        i = 1
        while ((i < n) & (str_byte(path, i) == 47)) {
            i = i + 1
        }
    }
    while (i < n) {
        var j = i
        while ((j < n) & (str_byte(path, j) != 47)) {
            j = j + 1
        }
        var seg = str_slice(path, i, j - i)
        if str_len(seg) > 0 {
            acc = path_join_dir(acc, seg)
            if mkdir(acc) != 0 {
                return 1
            }
        }
        i = j
        while ((i < n) & (str_byte(path, i) == 47)) {
            i = i + 1
        }
    }
    return 0
}

func loader_cache_path(pkg_name: str, fp: int): str {
    var base = loader_cache_dir()
    var safe = pkg_name
    if str_len(safe) == 0 {
        safe = "_anon"
    }
    return path_join_dir(path_join_dir(base, safe), str_concat(int_to_str(fp), ".merged"))
}

func loader_cache_read(pkg_name: str, fp: int): str {
    var p = loader_cache_path(pkg_name, fp)
    if (file_size(p) < 0) {
        return ""
    }
    return read_file(p)
}

func loader_cache_write(pkg_name: str, fp: int, merged: str): int {
    var p = loader_cache_path(pkg_name, fp)
    var dir = dirname_of_file(p)
    if loader_mkdir_p(dir) != 0 {
        return 1
    }
    if write_text_file(p, merged) != 0 {
        return 1
    }
    return 0
}

func loader_log_module_graph(root: str): int {
    if loader_module_graph_trace() == 0 {
        return 0
    }
    var from = package_manifest_name(root)
    if str_len(from) == 0 {
        from = loader_path_basename(root)
    }
    var deps = package_manifest_dep_names(root)
    var deps_hold = deps
    var nl = loader_newline()
    var pos = 0
    var dn = str_len(deps_hold)
    while (pos < dn) {
        var le = pos
        while (le < dn & str_byte(deps_hold, le) != 10) {
            le = le + 1
        }
        var alias = str_slice(deps_hold, pos, le - pos)
        pos = le + 1
        if str_len(alias) > 0 {
            var rel = package_manifest_dep_value(root, alias)
            if str_len(rel) > 0 {
                var target = path_join_dir(root, rel)
                var to = package_manifest_name(target)
                if str_len(to) == 0 {
                    to = alias
                }
                stderr("module-graph: ")
                stderr(from)
                stderr(" -> ")
                stderr(to)
                stderr(nl)
            }
        }
    }
    return 0
}

func fingerprint_emit_file(abs_path: str, done: str, stack: str, stdroot: str, acc_cell: int): str {
    var abs_p = abs_path
    var done_p = done
    var stack_p = stack
    var std_p = stdroot
    var nl = loader_newline()
    if path_in_done(done_p, abs_p, nl) == 1 {
        return done_p
    }
    if path_in_done(stack_p, abs_p, nl) == 1 {
        return ""
    }
    if (file_size(abs_p) < 0) {
        return ""
    }
    var src = read_file(abs_p)
    var src_hold = src
    var acc = mut_get(acc_cell)
    acc = loader_hash_combine(acc, loader_djb2(src_hold))
    mut_set(acc_cell, acc)
    var deps = list_resolved_imports(src_hold, abs_p, std_p, nl)
    var deps_hold = deps
    var done2 = done_p
    var b_stack = str_builder_new()
    str_builder_append(b_stack, stack_p)
    str_builder_append(b_stack, abs_p)
    str_builder_append(b_stack, nl)
    var stack2 = str_builder_to_str(b_stack)
    str_builder_free(b_stack)
    var pos = 0
    var dn = str_len(deps_hold)
    while (pos < dn) {
        var le = pos
        while (le < dn & str_byte(deps_hold, le) != 10) {
            le = le + 1
        }
        var dep = str_slice(deps_hold, pos, le - pos)
        pos = le + 1
        var dep_hold = dep
        if (str_len(dep_hold) > 0) {
            var dr = fingerprint_emit_file(dep_hold, done2, stack2, std_p, acc_cell)
            var dr_hold = dr
            if str_len(dr_hold) == 0 {
                return ""
            }
            done2 = dr_hold
        }
    }
    var b_done = str_builder_new()
    str_builder_append(b_done, done2)
    str_builder_append(b_done, abs_p)
    str_builder_append(b_done, nl)
    var new_done = str_builder_to_str(b_done)
    str_builder_free(b_done)
    return new_done
}

func fingerprint_package(root: str): int {
    var root_p = root
    var stdroot = loader_stdlib_dir()
    var std_hold = stdroot
    var man = path_join_dir(root_p, "package.diva")
    if (file_size(man) < 0) {
        return 0 - 1
    }
    var ent = package_entry_relative(man)
    var ent_hold = ent
    if str_len(ent_hold) == 0 {
        return 0 - 1
    }
    var ep = path_join_dir(root_p, ent_hold)
    var acc_cell = mut_new(loader_djb2(read_file(man)))
    var r = fingerprint_emit_file(ep, "", "", std_hold, acc_cell)
    var r_hold = r
    var fp = mut_get(acc_cell)
    int_vec_free(acc_cell)
    if str_len(r_hold) == 0 {
        return 0 - 1
    }
    return fp
}

func loader_path_basename(path: str): str {
    var n = str_len(path)
    var i = n - 1
    while (i >= 0) {
        if str_byte(path, i) == 47 {
            return str_slice(path, i + 1, n - (i + 1))
        }
        i = i - 1
    }
    return str_slice(path, 0, n)
}

// Look up `dep.<name> = "..."` in package.diva. Returns relative path or "".
func package_manifest_dep_value(root: str, dep_name: str): str {
    var mf = path_join_dir(root, "package.diva")
    if (file_size(mf) < 0) {
        return ""
    }
    var text = read_file(mf)
    var text_hold = text
    var text_len = str_len(text_hold)
    if text_len == 0 {
        return ""
    }
    var key_b = str_builder_new()
    str_builder_append(key_b, "dep.")
    str_builder_append(key_b, dep_name)
    var key = str_builder_to_str(key_b)
    str_builder_free(key_b)
    var key_len = str_len(key)
    var n = text_len
    var i = 0
    while (i < n) {
        var line_end = i
        while (line_end < n & str_byte(text, line_end) != 10) {
            line_end = line_end + 1
        }
        var line = str_slice(text, i, line_end - i)
        var ln = str_len(line)
        while (ln > 0 & str_byte(line, ln - 1) == 13) {
            ln = ln - 1
        }
        if (ln > 0) {
            var j = 0
            while (j < ln & (str_byte(line, j) == 32 | str_byte(line, j) == 9)) {
                j = j + 1
            }
            if !((j + key_len) > ln) {
                if str_eq(str_slice(line, j, key_len), key) == 1 {
                    var k = j + key_len
                    while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                        k = k + 1
                    }
                    if (k < ln & str_byte(line, k) == 61) {
                        k = k + 1
                        while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                            k = k + 1
                        }
                        if (k < ln & str_byte(line, k) == 34) {
                            var q = k + 1
                            while (q < ln & str_byte(line, q) != 34) {
                                q = q + 1
                            }
                            if (q > k + 1) {
                                return str_slice(line, k + 1, q - k - 1)
                            }
                        }
                    }
                }
            }
        }
        i = line_end + 1
    }
    return ""
}

// Walk parents of a source file until a directory containing package.diva is found.
func find_enclosing_package_root(file_path: str): str {
    var dir = dirname_of_file(file_path)
    var guard = 0
    while (guard < 32) {
        if path_is_package_dir(dir) == 1 {
            return dir
        }
        if str_eq(dir, ".") == 1 | str_eq(dir, "/") == 1 {
            return ""
        }
        var climb = dirname_of_file(dir)
        if str_eq(climb, dir) == 1 {
            return ""
        }
        dir = climb
        guard = guard + 1
    }
    return ""
}

func import_looks_like_dep_alias(imp: str): int {
    var n = str_len(imp)
    if n == 0 {
        return 0
    }
    // Canonical: pkg/<name>
    if !(n < 4) {
        if str_eq(str_slice(imp, 0, 4), "pkg/") == 1 {
            return 1
        }
    }
    // Bare alias: math_lib (no slash / dot)
    var i = 0
    while (i < n) {
        var b = str_byte(imp, i)
        if b == 47 {
            return 0
        }
        if b == 46 {
            return 0
        }
        i = i + 1
    }
    return 1
}

func import_dep_alias_name(imp: str): str {
    var n = str_len(imp)
    if !(n < 4) {
        if str_eq(str_slice(imp, 0, 4), "pkg/") == 1 {
            return str_slice(imp, 4, n - 4)
        }
    }
    return imp
}

func resolve_dep_alias_import(cur_file: str, imp: str): str {
    if import_looks_like_dep_alias(imp) == 0 {
        return ""
    }
    var alias = import_dep_alias_name(imp)
    var root = find_enclosing_package_root(cur_file)
    if str_len(root) == 0 {
        if !(str_len(imp) < 4) {
            if str_eq(str_slice(imp, 0, 4), "pkg/") == 1 {
                stderr("loader: pkg/ import requires package.diva ancestor\n")
            }
        }
        return ""
    }
    var rel = package_manifest_dep_value(root, alias)
    if str_len(rel) == 0 {
        stderr("loader: unknown package dependency '")
        stderr(alias)
        stderr("'\n")
        return ""
    }
    var target = path_join_dir(root, rel)
    if path_is_package_dir(target) == 1 {
        var man = path_join_dir(target, "package.diva")
        var ent = package_entry_relative(man)
        if str_len(ent) == 0 {
            return ""
        }
        return path_join_dir(target, ent)
    }
    return target
}

func package_entry_relative(manifest_path: str): str {
    var text = read_file(manifest_path)
    var text_hold = text
    var text_len = str_len(text_hold)
    if text_len == 0 {
        return ""
    }
    var n = text_len
    var i = 0
    while (i < n) {
        var line_end = i
        while (line_end < n & str_byte(text, line_end) != 10) {
            line_end = line_end + 1
        }
        var line = str_slice(text, i, line_end - i)
        var ln = str_len(line)
        while (ln > 0 & str_byte(line, ln - 1) == 13) {
            ln = ln - 1
        }
        if (ln > 0) {
            var j = 0
            while (j < ln & (str_byte(line, j) == 32 | str_byte(line, j) == 9)) {
                j = j + 1
            }
            if !((j + 5) > ln) {
                if str_eq(str_slice(line, j, 5), "entry") == 1 {
                    var k = j + 5
                    while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                        k = k + 1
                    }
                    if (k < ln & str_byte(line, k) == 61) {
                        k = k + 1
                        while (k < ln & (str_byte(line, k) == 32 | str_byte(line, k) == 9)) {
                            k = k + 1
                        }
                        if (k < ln & str_byte(line, k) == 34) {
                            var q = k + 1
                            while (q < ln & str_byte(line, q) != 34) {
                                q = q + 1
                            }
                            if (q > k + 1) {
                                return str_slice(line, k + 1, q - k - 1)
                            }
                        }
                    }
                }
            }
        }
        i = line_end + 1
    }
    return ""
}

func resolve_import_path(cur_file: str, imp: str, stdroot: str): str {
    var imp_p = imp
    var cur_p = cur_file
    var std_p = stdroot
    if !((str_len(imp_p)) < 4) {
        if str_eq(str_slice(imp_p, 0, 4), "std/") == 1 {
            return path_join_dir(std_p, imp_p)
        }
    }
    var via_dep = resolve_dep_alias_import(cur_p, imp_p)
    if str_len(via_dep) > 0 {
        return via_dep
    }
    return path_join_dir(dirname_of_file(cur_p), imp_p)
}

func import_kw_match(src: str, i: int): int {
    if str_byte(src, i) != 105     { return 0 }
    if str_byte(src, i + 1) != 109 { return 0 }
    if str_byte(src, i + 2) != 112 { return 0 }
    if str_byte(src, i + 3) != 111 { return 0 }
    if str_byte(src, i + 4) != 114 { return 0 }
    if str_byte(src, i + 5) != 116 { return 0 }
    if str_byte(src, i + 6) != 32  { return 0 }
    if str_byte(src, i + 7) != 34  { return 0 }
    return 1
}

func list_resolved_imports(src: str, cur_abs: str, stdroot: str, nl: str): str {
    var src_p = src
    var cur_p = cur_abs
    var std_p = stdroot
    var nl_p = nl
    var b = str_builder_new()
    var n = str_len(src_p)
    var i = 0
    while (i < n) {
        if !((i + 8) > n) {
            if import_kw_match(src_p, i) == 1 {
                var at_sol = 0
                if i == 0 {
                    at_sol = 1
                } else {
                    if str_byte(src_p, i - 1) == 10 {
                        at_sol = 1
                    }
                }
                if at_sol == 1 {
                    var q = i + 8
                    while (q < n & str_byte(src_p, q) != 34) {
                        q = q + 1
                    }
                    if (q < n) {
                        var inner = str_slice(src_p, i + 8, q - i - 8)
                        var rp = resolve_import_path(cur_p, inner, std_p)
                        str_builder_append(b, rp)
                        str_builder_append(b, nl_p)
                    }
                    i = q + 1
                } else {
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    var r = str_builder_to_str(b)
    str_builder_free(b)
    return r
}

func path_in_done(done: str, p: str, nl: str): int {
    var b = str_builder_new()
    str_builder_append(b, nl)
    str_builder_append(b, done)
    var wrapped = str_builder_to_str(b)
    str_builder_free(b)
    var b2 = str_builder_new()
    str_builder_append(b2, nl)
    str_builder_append(b2, p)
    str_builder_append(b2, nl)
    var search = str_builder_to_str(b2)
    str_builder_free(b2)
    if str_contains(wrapped, search) == 1 {
        return 1
    }
    return 0
}

func merge_emit_file(abs_path: str, done: str, stack: str, stdroot: str, out: int): str {
    var abs_p = abs_path
    var done_p = done
    var stack_p = stack
    var std_p = stdroot
    var nl = loader_newline()
    if path_in_done(done_p, abs_p, nl) == 1 {
        return done_p
    }
    if path_in_done(stack_p, abs_p, nl) == 1 {
        stderr("loader: import cycle at ")
        stderr(abs_p)
        stderr(nl)
        return ""
    }
    if (file_size(abs_p) < 0) {
        stderr("loader: cannot read ")
        stderr(abs_p)
        stderr(nl)
        return ""
    }
    var src = read_file(abs_p)
    var src_hold = src
    var deps = list_resolved_imports(src_hold, abs_p, std_p, nl)
    var deps_hold = deps
    var done2 = done_p
    var b_stack = str_builder_new()
    str_builder_append(b_stack, stack_p)
    str_builder_append(b_stack, abs_p)
    str_builder_append(b_stack, nl)
    var stack2 = str_builder_to_str(b_stack)
    str_builder_free(b_stack)
    var pos = 0
    var dn = str_len(deps_hold)
    while (pos < dn) {
        var le = pos
        while (le < dn & str_byte(deps_hold, le) != 10) {
            le = le + 1
        }
        var dep = str_slice(deps_hold, pos, le - pos)
        pos = le + 1
        var dep_hold = dep
        if (str_len(dep_hold) > 0) {
            var dr = merge_emit_file(dep_hold, done2, stack2, std_p, out)
            var dr_hold = dr
            var dr_len = str_len(dr_hold)
            if dr_len == 0 {
                return ""
            }
            done2 = dr_hold
        }
    }
    // Issue #54: mark file origin for path:line:col diagnostics (comment; lexer skips).
    str_builder_append(out, "//@diva-file:")
    str_builder_append(out, abs_p)
    str_builder_append(out, nl)
    str_builder_append(out, src_hold)
    str_builder_append(out, nl)
    var b_done = str_builder_new()
    str_builder_append(b_done, done2)
    str_builder_append(b_done, abs_p)
    str_builder_append(b_done, nl)
    var new_done = str_builder_to_str(b_done)
    str_builder_free(b_done)
    return new_done
}

func merge_file_sources(path: str): str {
    // Resolve stdlib + newline before read_file(path): pure builtins must leave r15 (environ
    // anchor for host_getenv) valid across IO builtins (see pure_elf_builtins.diva).
    var path_p = path
    var stdroot = loader_stdlib_dir()
    var std_hold = stdroot
    var nl = loader_newline()
    var src = read_file(path_p)
    var src_hold = src
    var src_len = str_len(src_hold)
    if src_len == 0 {
        return ""
    }
    var b = str_builder_new()
    var done = ""
    var r = merge_emit_file(path_p, done, "", std_hold, b)
    var r_hold = r
    var r_len = str_len(r_hold)
    if r_len == 0 {
        str_builder_free(b)
        return ""
    }
    var merged = str_builder_to_str(b)
    str_builder_free(b)
    return merged
}

func merge_package_sources(root: str): str {
    var root_p = root
    var stdroot = loader_stdlib_dir()
    var std_hold = stdroot
    loader_log_module_graph(root_p)
    var pkg_name = package_manifest_name(root_p)
    if str_len(pkg_name) == 0 {
        pkg_name = loader_path_basename(root_p)
    }
    var fp = fingerprint_package(root_p)
    if loader_cache_enabled() == 1 {
        if fp >= 0 {
            var cached = loader_cache_read(pkg_name, fp)
            var cached_hold = cached
            if str_len(cached_hold) > 0 {
                if loader_pkg_cache_trace() == 1 {
                    stderr("loader: cache hit ")
                    stderr(pkg_name)
                    stderr(" fp=")
                    stderr(int_to_str(fp))
                    stderr(loader_newline())
                }
                return cached_hold
            }
        }
    }
    if loader_check_trace() == 1 {
        stderr("[check-trace] merge_package_sources: after loader_stdlib_dir\n")
    }
    var man = path_join_dir(root_p, "package.diva")
    var ent = package_entry_relative(man)
    if loader_check_trace() == 1 {
        stderr("[check-trace] merge_package_sources: after package_entry_relative\n")
    }
    var ent_hold = ent
    var ent_len = str_len(ent_hold)
    if ent_len == 0 {
        stderr("loader: no entry= in package.diva under ")
        stderr(root_p)
        stderr(loader_newline())
        return ""
    }
    var ep = path_join_dir(root_p, ent_hold)
    if loader_check_trace() == 1 {
        stderr("[check-trace] merge_package_sources: before merge_emit_file\n")
    }
    var b = str_builder_new()
    var done = ""
    var r = merge_emit_file(ep, done, "", std_hold, b)
    var r_hold = r
    var r_len = str_len(r_hold)
    if r_len == 0 {
        str_builder_free(b)
        return ""
    }
    var merged = str_builder_to_str(b)
    str_builder_free(b)
    if loader_cache_enabled() == 1 {
        if fp >= 0 {
            if str_len(merged) > 0 {
                loader_cache_write(pkg_name, fp, merged)
                if loader_pkg_cache_trace() == 1 {
                    stderr("loader: cache store ")
                    stderr(pkg_name)
                    stderr(" fp=")
                    stderr(int_to_str(fp))
                    stderr(loader_newline())
                }
            }
        }
    }
    return merged
}

// Absolute paths (newline-separated) for `diva watch`: transitive imports + package.diva.
func collect_watch_files(path: str): str {
    var path_p = path
    var stdroot = loader_stdlib_dir()
    var std_hold = stdroot
    var nl = loader_newline()
    var entry = path_p
    var man = ""
    if path_is_package_dir(path_p) == 1 {
        man = path_join_dir(path_p, "package.diva")
        var ent = package_entry_relative(man)
        var ent_hold = ent
        if str_len(ent_hold) == 0 {
            return ""
        }
        entry = path_join_dir(path_p, ent_hold)
    } else {
        var pn = str_len(path_p)
        if pn < 5 {
            return ""
        }
        if str_eq(str_slice(path_p, pn - 5, 5), ".diva") == 0 {
            return ""
        }
    }
    var throwaway = str_builder_new()
    var done = ""
    var r = merge_emit_file(entry, done, "", std_hold, throwaway)
    str_builder_free(throwaway)
    var r_hold = r
    if str_len(r_hold) == 0 {
        return ""
    }
    if str_len(man) > 0 {
        if path_in_done(r_hold, man, nl) == 0 {
            var b = str_builder_new()
            str_builder_append(b, r_hold)
            str_builder_append(b, man)
            str_builder_append(b, nl)
            var out = str_builder_to_str(b)
            str_builder_free(b)
            return out
        }
    }
    return r_hold
}
//@diva-file:/home/joeblack/Documents/diva/compiler/src/main.diva
// Diva compiler driver — native pipeline (lexer → parser → sema → IR → x86).
// build/run emit a single in-process ELF (cg_module_to_bin + pure ELF builtins); no cc/ld/runtime.o.

import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"
import "std/conv.diva"
import "std/str.diva"
import "cell.diva"
import "tokens.diva"
import "lexer.diva"
import "ast.diva"
import "parser.diva"
import "ir.diva"
import "ir_builder.diva"
import "ir_dump.diva"
import "codegen_x86.diva"
import "ast_dump.diva"
import "sema.diva"
import "loader.diva"

// When DIVA_NATIVE_CMD_IR_DEBUG is non-empty, cmd_ir prints stderr milestones (native-driver bring-up).
func native_cmd_ir_debug(): int {
    var v = host_getenv("DIVA_NATIVE_CMD_IR_DEBUG")
    var v_hold = v
    if str_len(v_hold) > 0 { return 1 }
    return 0
}

func cmd_print_usage(): int {
    stderr("usage: diva <command> [args]\n")
    stderr("  lex <file.diva> | parse <file.diva> | ir <file.diva> | asm <file.diva>\n")
    stderr("  emit-ir <file.diva|package-dir> | build <file.diva|package-dir> [--ast|-g] | run <...>\n")
    stderr("  watch <file.diva|package-dir> | check <package-dir> | new <path> [--lib|--kernel]\n")
    stderr("  compiler-version | pipeline\n")
    stderr("Environment: DI_STDLIB_DIR (stdlib search path)\n")
    stderr("  DIVA_WATCH_MAX_ITERS=N exits after N poll cycles (CI smoke)\n")
    stderr("  diva build -g embeds DWARF via scripts/embed-dwarf-debug.py (needs python3)\n")
    stderr("  diva new <path> [--lib|--kernel|--system] (native scaffolding)\n")
    return 1
}

// Default write target when `build` has no second path and DIVA_NATIVE_EXE_OUT is unset.
// Prefer ROOT_DIR/build/ — never /tmp (wiped; we already lost good builds that way).
func native_default_exe_out(): str {
    var root = host_getenv("ROOT_DIR")
    if str_len(root) > 0 {
        return path_join_dir(root, "build/diva-native-exe")
    }
    return "build/diva-native-exe"
}

func native_tmp_exe(): str {
    return native_default_exe_out()
}

func system_exit_code(rc: int): int {
    if (rc < 0) {
        return 1
    }
    if rc == 0 {
        return 0
    }
    if (rc < 256) {
        return rc
    }
    return rc / 256
}

// Native x86_64 PIE ELF generator - no cc, no as, no ld!
func get_low_byte(x: int): int {
    return x - (x / 256) * 256
}

func encode_elf_header(out: int, code_len: int): int {
    int_vec_push(out, 127) // ELF magic
    int_vec_push(out, 69)
    int_vec_push(out, 76)
    int_vec_push(out, 70)
    int_vec_push(out, 2)   // 64-bit
    int_vec_push(out, 1)   // little endian
    int_vec_push(out, 1)   // version
    int_vec_push(out, 0)   // OS ABI
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 3)   // e_type: ET_DYN (PIE)
    int_vec_push(out, 0)
    int_vec_push(out, 62)  // e_machine: x86_64
    int_vec_push(out, 0)
    int_vec_push(out, 1)   // e_version
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_entry: 0x1000
    int_vec_push(out, 16)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 64)  // e_phoff
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_shoff
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_flags
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 64)  // e_ehsize
    int_vec_push(out, 0)
    int_vec_push(out, 56)  // e_phentsize
    int_vec_push(out, 0)
    int_vec_push(out, 1)   // e_phnum (1 segment for now)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_shentsize
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_shnum
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // e_shstrndx
    int_vec_push(out, 0)
    return 0
}

func encode_phdr(out: int, code_len: int): int {
    int_vec_push(out, 1)   // p_type: PT_LOAD
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 5)   // p_flags: rwx
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // p_offset
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // p_vaddr (PIE base)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // p_paddr
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    var lo = get_low_byte(code_len + 64 + 56)
    var hi = get_low_byte((code_len + 64 + 56) / 256)
    int_vec_push(out, lo)   // p_filesz
    int_vec_push(out, hi)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, lo)   // p_memsz
    int_vec_push(out, hi)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)   // p_align
    int_vec_push(out, 16)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    return 0
}

func hex_char(n: int): int {
    if (n < 10) { return 48 + n }
    return 87 + n
}

// Write text via syscall-backed builtin — no shell for content.
func native_write_text_bytes(path: str, data: str): int {
    return write_text_file(path, data)
}

// Materialize ELF bytes without building one giant hex string (large programs OOM the builder).
func native_write_exe(data: int, path: str): int {
    if unlink(path) != 0 {
        return 1
    }
    var n = int_vec_len(data)
    var pos = 0
    var first = 1
    while (pos < n) {
        var take = 64000
        if (pos + take > n) {
            take = n - pos
        }
        if write_elf_chunk(path, data, pos, take, first) != 0 {
            return 1
        }
        pos = pos + take
        first = 0
    }
    if chmod_executable(path) != 0 {
        return 1
    }
    return 0
}

// Split ELF phdr helpers: native codegen cannot pass >6 ints to one callee (rdi gets clobbered).
func make_phdr_ro_load(out: int, file_size: int, align: int): int {
    int_vec_push(out, 1)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 4)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, file_size & 255)
    int_vec_push(out, (file_size / 256) & 255)
    int_vec_push(out, (file_size / 65536) & 255)
    int_vec_push(out, (file_size / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, file_size & 255)
    int_vec_push(out, (file_size / 256) & 255)
    int_vec_push(out, (file_size / 65536) & 255)
    int_vec_push(out, (file_size / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, align & 255)
    int_vec_push(out, (align / 256) & 255)
    int_vec_push(out, (align / 65536) & 255)
    int_vec_push(out, (align / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    return 0
}

// Second half of make_phdr_rx_load: emits code_len, code_size, and final align fields.
func make_phdr_rx_load_b(out: int, code_len: int, code_size: int, align: int): int {
    int_vec_push(out, code_len & 255)
    int_vec_push(out, (code_len / 256) & 255)
    int_vec_push(out, (code_len / 65536) & 255)
    int_vec_push(out, (code_len / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, code_size & 255)
    int_vec_push(out, (code_size / 256) & 255)
    int_vec_push(out, (code_size / 65536) & 255)
    int_vec_push(out, (code_size / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, align & 255)
    int_vec_push(out, (align / 256) & 255)
    int_vec_push(out, (align / 65536) & 255)
    int_vec_push(out, (align / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    return 0
}

func make_phdr_rx_load(out: int, code_len: int, code_size: int, align: int): int {
    int_vec_push(out, 1)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 5)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, 0)
    int_vec_push(out, align & 255)
    int_vec_push(out, (align / 256) & 255)
    int_vec_push(out, (align / 65536) & 255)
    int_vec_push(out, (align / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, align & 255)
    int_vec_push(out, (align / 256) & 255)
    int_vec_push(out, (align / 65536) & 255)
    int_vec_push(out, (align / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    int_vec_push(out, align & 255)
    int_vec_push(out, (align / 256) & 255)
    int_vec_push(out, (align / 65536) & 255)
    int_vec_push(out, (align / 16777216) & 255)
    int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0) int_vec_push(out, 0)
    make_phdr_rx_load_b(out, code_len, code_size, align)
    return 0
}

func native_require_no_externs(m: int, src: str, toks: int): int {
    // Pinned seed may lag codegen (new pure builtins). One-shot bootstrap: set
    // DIVA_SKIP_NATIVE_EXTERN_CHECK=1 when rebuilding the driver from sources.
    var skip = host_getenv("DIVA_SKIP_NATIVE_EXTERN_CHECK")
    var skip_hold = skip
    if (!(str_len(skip_hold) < 1)) {
        return 0
    }
    var ec = mod_extern_count(m)
    var unresolved = 0
    var i = 0
    while (i < ec) {
        var etok = int_vec_get(mod_externs(m), i)
        var nm = tok_text(src, toks, etok)
        var supported = 0
        if str_eq(nm, "write") == 1 { supported = 1 }
        if str_eq(nm, "exit") == 1 { supported = 1 }
        if str_eq(nm, "abort") == 1 { supported = 1 }
        if str_eq(nm, "print_str") == 1 { supported = 1 }
        if str_eq(nm, "print_int") == 1 { supported = 1 }
        if str_eq(nm, "str_len") == 1 { supported = 1 }
        if str_eq(nm, "str_byte") == 1 { supported = 1 }
        if str_eq(nm, "str_eq") == 1 { supported = 1 }
        if str_eq(nm, "int_vec_new") == 1 { supported = 1 }
        if str_eq(nm, "int_vec_push") == 1 { supported = 1 }
        if str_eq(nm, "int_vec_len") == 1 { supported = 1 }
        if str_eq(nm, "int_vec_get") == 1 { supported = 1 }
        if str_eq(nm, "int_vec_free") == 1 { supported = 1 }
        if str_eq(nm, "str_builder_new") == 1 { supported = 1 }
        if str_eq(nm, "str_builder_append") == 1 { supported = 1 }
        if str_eq(nm, "str_builder_len") == 1 { supported = 1 }
        if str_eq(nm, "str_builder_to_str") == 1 { supported = 1 }
        if str_eq(nm, "str_builder_free") == 1 { supported = 1 }
        if str_eq(nm, "print_hex") == 1 { supported = 1 }
        if str_eq(nm, "int_to_str") == 1 { supported = 1 }
        if str_eq(nm, "str_slice") == 1 { supported = 1 }
        if str_eq(nm, "file_size") == 1 { supported = 1 }
        if str_eq(nm, "read_file") == 1 { supported = 1 }
        if str_eq(nm, "host_argc") == 1 { supported = 1 }
        if str_eq(nm, "host_argv") == 1 { supported = 1 }
        if str_eq(nm, "host_getenv") == 1 { supported = 1 }
        if str_eq(nm, "host_system") == 1 { supported = 1 }
        if str_eq(nm, "mkdir") == 1 { supported = 1 }
        if str_eq(nm, "write_text_file") == 1 { supported = 1 }
        if str_eq(nm, "unlink") == 1 { supported = 1 }
        if str_eq(nm, "chmod_executable") == 1 { supported = 1 }
        if str_eq(nm, "write_elf_chunk") == 1 { supported = 1 }
        if str_eq(nm, "mem_alloc") == 1 { supported = 1 }
        if str_eq(nm, "mem_free") == 1 { supported = 1 }
        if str_eq(nm, "mem_get") == 1 { supported = 1 }
        if str_eq(nm, "mem_set") == 1 { supported = 1 }
        if str_eq(nm, "str_from_text") == 1 { supported = 1 }
        if str_eq(nm, "text_len") == 1 { supported = 1 }
        if str_eq(nm, "text_from_str") == 1 { supported = 1 }
        if str_eq(nm, "text_byte") == 1 { supported = 1 }
        if str_eq(nm, "text_cmp") == 1 { supported = 1 }
        if str_eq(nm, "text_concat") == 1 { supported = 1 }
        if str_eq(nm, "text_slice") == 1 { supported = 1 }
        if supported == 0 {
            if unresolved == 0 {
                err_line("native build: unresolved extern runtime dependencies remain:")
            }
            stderr("  - ")
            stderr(nm)
            stderr(char_to_str(10))
            unresolved = unresolved + 1
        }
        i = i + 1
    }
    if unresolved != 0 {
        err_line("native build: implement these builtins in pure ELF path (see pure_elf_builtins.diva). If the pinned seed lags new externs, set DIVA_SKIP_NATIVE_EXTERN_CHECK=1 for a one-shot driver rebuild.")
        return 1
    }
    return 0
}

// Emit ELF binary from code bytes (main_ent = entry offset) and write to exe_out. Returns 0 on success.
func native_emit_elf_hdr(elf: int, entry: int): int {
    int_vec_push(elf, 127) int_vec_push(elf, 69) int_vec_push(elf, 76) int_vec_push(elf, 70)
    int_vec_push(elf, 2) int_vec_push(elf, 1) int_vec_push(elf, 1) int_vec_push(elf, 0)
    var i = 0 while (i < 8) { int_vec_push(elf, 0) i = i + 1 }
    int_vec_push(elf, 3) int_vec_push(elf, 0)
    int_vec_push(elf, 62) int_vec_push(elf, 0)
    int_vec_push(elf, 1) int_vec_push(elf, 0) int_vec_push(elf, 0) int_vec_push(elf, 0)
    int_vec_push(elf, entry & 255)
    int_vec_push(elf, (entry / 256) & 255)
    int_vec_push(elf, (entry / 65536) & 255)
    int_vec_push(elf, (entry / 16777216) & 255)
    int_vec_push(elf, 0) int_vec_push(elf, 0) int_vec_push(elf, 0) int_vec_push(elf, 0)
    int_vec_push(elf, 64) i = 1 while (i < 8) { int_vec_push(elf, 0) i = i + 1 }
    i = 0 while (i < 8) { int_vec_push(elf, 0) i = i + 1 }
    int_vec_push(elf, 0) int_vec_push(elf, 0) int_vec_push(elf, 0) int_vec_push(elf, 0)
    int_vec_push(elf, 64) int_vec_push(elf, 0)
    int_vec_push(elf, 56) int_vec_push(elf, 0)
    int_vec_push(elf, 2) int_vec_push(elf, 0)
    int_vec_push(elf, 0) int_vec_push(elf, 0)
    int_vec_push(elf, 0) int_vec_push(elf, 0)
    int_vec_push(elf, 0) int_vec_push(elf, 0)
    return 0
}

func native_emit_pure_elf(code: int, main_ent: int, exe_out: str, quiet: int): int {
    var code_len = int_vec_len(code)
    var align = 4096
    var code_size = code_len
    var rem = code_size % align
    if rem != 0 { code_size = code_size + align - rem }
    var file_sz = align + code_size
    var elf = int_vec_new()
    var entry = 4096 + main_ent
    native_emit_elf_hdr(elf, entry)
    make_phdr_ro_load(elf, file_sz, align)
    make_phdr_rx_load(elf, code_len, code_size, align)
    var i = int_vec_len(elf) while (i < align) { int_vec_push(elf, 0) i = i + 1 }
    i = 0 while (i < code_len) { int_vec_push(elf, int_vec_get(code, i)) i = i + 1 }
    i = code_len while (i < code_size) { int_vec_push(elf, 0) i = i + 1 }
    var res = native_write_exe(elf, exe_out)
    int_vec_free(elf)
    if res != 0 {
        if quiet == 0 { err_line("build: writing native ELF failed (native_write_exe); check write_elf_chunk, unlink, chmod_executable") }
        return 1
    }
    return 0
}

// quiet: when 1, omit stderr on failure (caller may fall back to bootstrap).
func native_compile_and_link(merged_src: str, quiet: int, exe_out: str): int {
    var stream = lex_source(merged_src)
    if stream == 0 {
        if quiet == 0 { err_line("lexer error") }
        return 1
    }
    var pr = parse_source(merged_src, stream, 0)
    if int_vec_get(pr, 1) != 0 {
        if quiet == 0 { err_line("parse error") }
        return 1
    }
    var ast = int_vec_get(pr, 0)
    if sema_file_only_native_subset(ast) == 0 {
        if quiet == 0 { err_line("native build: unsupported surface (package/struct/class/trait/toplevel let)") }
        return 1
    }
    if sema_check_file(merged_src, stream, ast) != 0 { return 1 }
    var ir_result = build_ir(merged_src, stream, ast)
    var m = int_vec_get(ir_result, 0)
    var strv = int_vec_get(ir_result, 1)
    if native_require_no_externs(m, merged_src, stream) != 0 { return 1 }
    var code = int_vec_new()
    var main_ent = cg_module_to_bin(m, merged_src, stream, strv, code)
    if main_ent < 0 {
        if quiet == 0 { err_line("native codegen failed: unresolved branch/call target or offset-size mismatch") }
        int_vec_free(code)
        return 1
    }
    return native_emit_pure_elf(code, main_ent, exe_out, quiet)
}

// 1 = source needs the bootstrap compiler (parse/native-subset gap); 0 = try native pipeline.
func native_driver_should_delegate(merged: str): int {
    return 0
}

func err_line(msg: str): int {
    stderr(msg)
    stderr(char_to_str(10))
    return 0
}

func read_source(path: str): str {
    var path_p = path
    if (file_size(path_p) < 0) {
        stderr("error: cannot read file: ")
        stderr(path_p)
        stderr(char_to_str(10))
        return ""
    }
    return read_file(path_p)
}

func path_is_diva_file(p: str): int {
    var n = str_len(p)
    if (n < 5) {
        return 0
    }
    var suf = str_slice(p, n - 5, 5)
    return str_eq(suf, ".diva")
}

func build_path_is_package_dir(path: str): int {
    if path_is_diva_file(path) == 1 {
        return 0
    }
    return path_is_package_dir(path)
}

// Real LF byte from file (bootstrap / cwd-agnostic). String literals use `tok_str_value` (`\n` → ASCII 10).
// Resolve via cwd-relative paths first, then DI_STDLIB_DIR/std/lf.txt, then ROOT_DIR.
func newline_str(): str {
    var s = read_file("compiler/res/lf.txt")
    var s_hold = s
    if (!(str_len(s_hold) < 1)) {
        return str_slice(s_hold, 0, 1)
    }
    s = read_file("res/lf.txt")
    s_hold = s
    if (!(str_len(s_hold) < 1)) {
        return str_slice(s_hold, 0, 1)
    }
    var stdroot = loader_stdlib_dir()
    s = read_file(path_join_dir(stdroot, "std/lf.txt"))
    s_hold = s
    if (!(str_len(s_hold) < 1)) {
        return str_slice(s_hold, 0, 1)
    }
    var root = host_getenv("ROOT_DIR")
    var root_hold = root
    if str_len(root_hold) > 0 {
        s = read_file(path_join_dir(root_hold, "compiler/res/lf.txt"))
        s_hold = s
        if (!(str_len(s_hold) < 1)) {
            return str_slice(s_hold, 0, 1)
        }
    }
    var empty = ""
    return empty
}

func path_basename(path: str): str {
    var n = str_len(path)
    while (n > 0 & str_byte(path, n - 1) == 47) {
        n = n - 1
    }
    if n == 0 {
        var empty = ""
        return empty
    }
    var i = n - 1
    while (i >= 0) {
        if str_byte(path, i) == 47 {
            return str_slice(path, i + 1, n - (i + 1))
        }
        i = i - 1
    }
    return str_slice(path, 0, n)
}

// Shell-safe subset for mkdir -p (no spaces, quotes, globs, dot-segments).
// No `continue` here: the driver subset may not implement continue, which would
// make every path look invalid after the first character.
func new_path_shell_safe(p: str): int {
    var n = str_len(p)
    if n == 0 {
        return 0
    }
    var i = 0
    while (i < n) {
        var c = str_byte(p, i)
        var ok = 0
        if c == 47 { ok = 1 }
        if c == 45 { ok = 1 }
        if c == 95 { ok = 1 }
        if (c >= 48 & c <= 57) { ok = 1 }
        if (c >= 65 & c <= 90) { ok = 1 }
        if (c >= 97 & c <= 122) { ok = 1 }
        if ok == 0 {
            return 0
        }
        i = i + 1
    }
    return 1
}

// Create directory trees one component at a time (mkdir / EEXIST); paths are caller-validated safe.
func native_mkdir_p(path: str): int {
    var n = str_len(path)
    if n == 0 {
        return 0
    }
    var acc = ""
    var i = 0
    if str_byte(path, 0) == 47 {
        acc = "/"
        i = 1
        while ((i < n) & (str_byte(path, i) == 47)) {
            i = i + 1
        }
    }
    while (i < n) {
        var j = i
        while ((j < n) & (str_byte(path, j) != 47)) {
            j = j + 1
        }
        var seg = str_slice(path, i, j - i)
        if str_len(seg) > 0 {
            acc = path_join_dir(acc, seg)
            if mkdir(acc) != 0 {
                err_line("new: could not create directory tree")
                return 1
            }
        }
        i = j
        while ((i < n) & (str_byte(path, i) == 47)) {
            i = i + 1
        }
    }
    return 0
}

func cmd_new(): int {
    if (host_argc() < 3) {
        err_line("usage: diva new <path> [--lib|--kernel|--system]   (or: diva new --lib <path>)")
        return 1
    }
    var want_lib = 0
    var want_kernel = 0
    var want_system = 0
    var path = ""
    var i = 2
    while (i < host_argc()) {
        var a = host_argv(i)
        if str_eq(a, "--lib") == 1 {
            want_lib = 1
        } else {
            if str_eq(a, "--kernel") == 1 {
                want_kernel = 1
            } else {
                if str_eq(a, "--system") == 1 {
                    want_system = 1
                } else {
                if str_byte(a, 0) != 45 {
                    if str_len(path) == 0 {
                        // Copy argv text: host_argv pointers may alias one buffer reused each call.
                        path = str_concat(a, "")
                    }
                }
                }
            }
        }
        i = i + 1
    }
    var kind_count = want_lib + want_kernel + want_system
    if kind_count > 1 {
        err_line("new: choose at most one of --lib, --kernel, --system")
        return 1
    }
    if str_len(path) == 0 {
        err_line("usage: diva new <path> [--lib|--kernel|--system]")
        return 1
    }
    if new_path_shell_safe(path) == 0 {
        err_line("new: path must use only [A-Za-z0-9_/-] (no dots, spaces, or shell metacharacters)")
        return 1
    }
    var manifest_path = path_join_dir(path, "package.diva")
    var msz = file_size(manifest_path)
    // di_runtime_file_size returns -1 on ENOENT. Native subset may lower signed compares / `!= 0`
    // incorrectly for negative values; int_to_str + str_eq matches the working check used elsewhere.
    if str_eq(int_to_str(msz), "-1") == 0 {
        err_line("new: destination already exists (package.diva present)")
        return 1
    }
    if native_mkdir_p(path) != 0 {
        return 1
    }
    var src_dir = path_join_dir(path, "src")
    if native_mkdir_p(src_dir) != 0 {
        return 1
    }
    var nm = path_basename(path)
    if str_len(nm) == 0 {
        nm = "app"
    }
    var nl = newline_str()
    if str_len(nl) == 0 {
        err_line("new: could not load a newline byte (lf.txt); set DI_STDLIB_DIR or ROOT_DIR, or run from the repo tree")
        return 1
    }
    var mf = str_builder_new()
    str_builder_append(mf, "name = \"")
    str_builder_append(mf, nm)
    str_builder_append(mf, "\"")
    str_builder_append(mf, nl)
    if want_lib == 1 {
        str_builder_append(mf, "kind = \"lib\"")
        str_builder_append(mf, nl)
        str_builder_append(mf, "entry = \"src/lib.diva\"")
        str_builder_append(mf, nl)
    } else if want_kernel == 1 {
        str_builder_append(mf, "kind = \"kernel\"")
        str_builder_append(mf, nl)
        str_builder_append(mf, "entry = \"src/boot.diva\"")
        str_builder_append(mf, nl)
    } else if want_system == 1 {
        str_builder_append(mf, "kind = \"system\"")
        str_builder_append(mf, nl)
        str_builder_append(mf, "entry = \"src/system.diva\"")
        str_builder_append(mf, nl)
    } else {
        str_builder_append(mf, "kind = \"app\"")
        str_builder_append(mf, nl)
        str_builder_append(mf, "entry = \"src/main.diva\"")
        str_builder_append(mf, nl)
    }
    var mf_s = str_builder_to_str(mf)
    str_builder_free(mf)
    if native_write_text_bytes(path_join_dir(path, "package.diva"), mf_s) != 0 {
        err_line("new: writing package.diva failed")
        return 1
    }
    var main_body = ""
    if want_lib == 1 {
        main_body = "// Library package: add funcs here; depend from apps via package.diva deps."
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "func lib_ping(): int {")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "    return 1")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "}")
        main_body = str_concat(main_body, nl)
        if native_write_text_bytes(path_join_dir(src_dir, "lib.diva"), main_body) != 0 {
            err_line("new: writing src/lib.diva failed")
            return 1
        }
    } else if want_kernel == 1 {
        main_body = "func kmain(): int {"
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "    var boot_magic = 42")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "    return boot_magic")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "}")
        main_body = str_concat(main_body, nl)
        if native_write_text_bytes(path_join_dir(src_dir, "boot.diva"), main_body) != 0 {
            err_line("new: writing src/boot.diva failed")
            return 1
        }
    } else if want_system == 1 {
        main_body = "// Freestanding/system template — see docs/freestanding.md"
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "extern func sys_exit(code: int): void")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "func main(): int {")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "    sys_exit(0)")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "    return 0")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "}")
        main_body = str_concat(main_body, nl)
        if native_write_text_bytes(path_join_dir(src_dir, "system.diva"), main_body) != 0 {
            err_line("new: writing src/system.diva failed")
            return 1
        }
    } else {
        main_body = "extern func print_str(s: str): void"
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "func main(): int {")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "    print_str(\"new_smoke_ok\")")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "    return 0")
        main_body = str_concat(main_body, nl)
        main_body = str_concat(main_body, "}")
        main_body = str_concat(main_body, nl)
        if native_write_text_bytes(path_join_dir(src_dir, "main.diva"), main_body) != 0 {
            err_line("new: writing src/main.diva failed")
            return 1
        }
    }
    var gitig = str_builder_new()
    str_builder_append(gitig, "/build/")
    str_builder_append(gitig, nl)
    str_builder_append(gitig, "*.o")
    str_builder_append(gitig, nl)
    str_builder_append(gitig, "/tmp/")
    str_builder_append(gitig, nl)
    if native_write_text_bytes(path_join_dir(path, ".gitignore"), str_builder_to_str(gitig)) != 0 {
        str_builder_free(gitig)
        err_line("new: writing .gitignore failed")
        return 1
    }
    str_builder_free(gitig)
    var rd = str_builder_new()
    str_builder_append(rd, "# ")
    str_builder_append(rd, nm)
    str_builder_append(rd, nl)
    str_builder_append(rd, nl)
    str_builder_append(rd, "Created with `diva new`.")
    str_builder_append(rd, nl)
    str_builder_append(rd, nl)
    if want_kernel == 1 {
        str_builder_append(rd, "Kernel package scaffold. Validate with:")
        str_builder_append(rd, nl)
        str_builder_append(rd, "`diva parse ")
        str_builder_append(rd, path_join_dir(path, "src/boot.diva"))
        str_builder_append(rd, "`")
        str_builder_append(rd, nl)
    } else if want_system == 1 {
        str_builder_append(rd, "System/freestanding scaffold. See docs/freestanding.md.")
        str_builder_append(rd, nl)
        str_builder_append(rd, "Validate: `diva check ")
        str_builder_append(rd, path)
        str_builder_append(rd, "`")
        str_builder_append(rd, nl)
    } else if want_lib == 1 {
        str_builder_append(rd, "Library scaffold. Validate with:")
        str_builder_append(rd, nl)
        str_builder_append(rd, "`diva check ")
        str_builder_append(rd, path)
        str_builder_append(rd, "`")
        str_builder_append(rd, nl)
    } else {
        str_builder_append(rd, "Run: `diva run ")
        str_builder_append(rd, path)
        str_builder_append(rd, "`")
        str_builder_append(rd, nl)
    }
    if native_write_text_bytes(path_join_dir(path, "README.md"), str_builder_to_str(rd)) != 0 {
        str_builder_free(rd)
        err_line("new: writing README.md failed")
        return 1
    }
    str_builder_free(rd)
    print_str("[native] created package at ")
    print_str(path)
    stdout(nl)
    return 0
}

func cmd_lex(path: str): int {
    return lex_file_to_stdout(path)
}

func cmd_parse(path: str): int {
    var src = read_source(path)
    var src_hold = src
    var src_len = str_len(src_hold)
    if src_len == 0 { return 1 }
    var stream = lex_source(src_hold)
    if stream == 0 { err_line("lexer error") return 1 }
    var pr = parse_source(src_hold, stream, 0)
    var ast = int_vec_get(pr, 0)
    var had_err = int_vec_get(pr, 1)
    if had_err != 0 { err_line("parse failed") return 1 }
    var children = ast_child(ast, 0)
    var n = int_vec_len(children)
    var b = str_builder_new()
    str_builder_append(b, "parsed ")
    str_builder_append(b, int_to_str(n))
    str_builder_append(b, " top-level declarations")
    print_str(str_builder_to_str(b))
    str_builder_free(b)
    return 0
}

func cmd_ir(path: str): int {
    var path_p = path
    var dbg = native_cmd_ir_debug()
    var src = merge_file_sources(path_p)
    // Pin merged source: downstream calls (including debug printing) may reuse the same slot as `src`.
    var src_hold = src
    var src_len = str_len(src_hold)
    if src_len == 0 { return 1 }
    if dbg == 1 { err_line("native cmd_ir: merged") }
    var stream = lex_source(src_hold)
    if stream == 0 { return 1 }
    if dbg == 1 { err_line("native cmd_ir: lexed") }
    var pr = parse_source(src_hold, stream, 0)
    var ast = int_vec_get(pr, 0)
    if int_vec_get(pr, 1) != 0 { err_line("parse failed") return 1 }
    if dbg == 1 { err_line("native cmd_ir: parsed") }
    if sema_check_file(src_hold, stream, ast) != 0 { return 1 }
    if dbg == 1 { err_line("native cmd_ir: sema ok") }
    var ir_result = build_ir(src_hold, stream, ast)
    if dbg == 1 { err_line("native cmd_ir: build_ir ok") }
    var m = int_vec_get(ir_result, 0)
    dump_module(m, src_hold, stream)
    return 0
}

func cmd_asm(path: str): int {
    var path_p = path
    var src = merge_file_sources(path_p)
    var src_hold = src
    var src_len = str_len(src_hold)
    if src_len == 0 { return 1 }
    var stream = lex_source(src_hold)
    if stream == 0 { return 1 }
    var pr = parse_source(src_hold, stream, 0)
    var ast = int_vec_get(pr, 0)
    if int_vec_get(pr, 1) != 0 { print_str("parse failed") return 1 }
    if sema_check_file(src_hold, stream, ast) != 0 { return 1 }
    var ir_result = build_ir(src_hold, stream, ast)
    var m = int_vec_get(ir_result, 0)
    cg_module_print(m, src_hold, stream, int_vec_get(ir_result, 1), newline_str())
    return 0
}

func cmd_emit_ir(path: str): int {
    var src = ""
    if path_is_package_dir(path) == 1 {
        src = merge_package_sources(path)
    } else {
        if path_is_diva_file(path) == 0 {
            err_line("emit-ir: expected a .diva file or a package directory")
            return 1
        }
        src = merge_file_sources(path)
    }
    var src_hold = src
    var src_len = str_len(src_hold)
    if src_len == 0 { return 1 }
    var stream = lex_source(src_hold)
    if stream == 0 { return 1 }
    var pr = parse_source(src_hold, stream, 1)
    if int_vec_get(pr, 1) != 0 {
        err_line("emit-ir: parse failed")
        return 1
    }
    var ast = int_vec_get(pr, 0)
    if sema_check_file(src_hold, stream, ast) != 0 { return 1 }
    var ir_result = build_ir(src_hold, stream, ast)
    var m = int_vec_get(ir_result, 0)
    dump_module(m, src_hold, stream)
    return 0
}

func cmd_build_ast(path: str): int {
    var src = read_source(path)
    var src_hold = src
    var src_len = str_len(src_hold)
    if src_len == 0 { return 1 }
    var stream = lex_source(src_hold)
    if stream == 0 { return 1 }
    var pr = parse_source(src_hold, stream, 0)
    var ast = int_vec_get(pr, 0)
    if int_vec_get(pr, 1) != 0 {
        err_line("parse failed")
        return 1
    }
    ast_dump_program(path, src_hold, stream, ast, newline_str())
    return 0
}

func pick_build_path(): str {
    var path = ""
    var i = 2
    while (i < host_argc()) {
        var a = host_argv(i)
        if str_byte(a, 0) != 45 {
            if str_len(path) == 0 {
                path = a
            }
        }
        i = i + 1
    }
    return path
}

// Second positional after source: `diva build <src> <out>`. Else DIVA_NATIVE_EXE_OUT, else build/diva-native-exe.
func pick_build_out_path(): str {
    var first = ""
    var second = ""
    var i = 2
    while (i < host_argc()) {
        var a = host_argv(i)
        if str_byte(a, 0) != 45 {
            if str_len(first) == 0 {
                first = a
            } else {
                if str_len(second) == 0 {
                    second = a
                }
            }
        }
        i = i + 1
    }
    if str_len(second) > 0 {
        return second
    }
    var envp = host_getenv("DIVA_NATIVE_EXE_OUT")
    if str_len(envp) > 0 {
        return envp
    }
    return native_default_exe_out()
}

func build_wants_ast(): int {
    var i = 2
    while (i < host_argc()) {
        if str_eq(host_argv(i), "--ast") == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

func build_wants_g(): int {
    var i = 2
    while (i < host_argc()) {
        if str_eq(host_argv(i), "-g") == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

// Source path recorded in DWARF (entry .diva for packages).
func dwarf_debug_src_path(path: str): str {
    if build_path_is_package_dir(path) == 1 {
        var man = path_join_dir(path, "package.diva")
        var ent = package_entry_relative(man)
        if str_len(ent) == 0 {
            return path
        }
        return path_join_dir(path, ent)
    }
    return path
}

// Post-process pure ELF with scripts/embed-dwarf-debug.py (Issue #63).
func native_embed_dwarf(exe_out: str, src_path: str): int {
    var root = host_getenv("ROOT_DIR")
    var script = "scripts/embed-dwarf-debug.py"
    if str_len(root) > 0 {
        script = path_join_dir(root, "scripts/embed-dwarf-debug.py")
    }
    var b = str_builder_new()
    str_builder_append(b, "python3 ")
    str_builder_append(b, script)
    str_builder_append(b, " ")
    str_builder_append(b, exe_out)
    str_builder_append(b, " ")
    str_builder_append(b, src_path)
    var cmd = str_builder_to_str(b)
    str_builder_free(b)
    var rc = host_system(cmd)
    return system_exit_code(rc)
}

// Lex + parse + sema for a lib/app package (merged sources). No seed forwarding.
func cmd_check(): int {
    if (host_argc() < 3) {
        err_line("usage: diva check <package-dir>")
        return 1
    }
    var path = host_argv(2)
    var path_h = path
    if path_is_package_dir(path_h) == 0 {
        err_line("check: expected a package directory (with package.diva)")
        return 1
    }
    var merged = merge_package_sources(path_h)
    // Pin before loader_check_trace / err_line (getenv + IO may clobber `merged`'s slot).
    var merged_hold = merged
    if loader_check_trace() == 1 {
        err_line("check-trace: after merge_package_sources")
    }
    var merged_len = str_len(merged_hold)
    if merged_len == 0 {
        err_line("check: could not merge package sources (see loader messages above)")
        return 1
    }
    if native_driver_should_delegate(merged_hold) == 1 {
        err_line("check: native driver cannot handle this source surface yet")
        return 1
    }
    if loader_check_trace() == 1 {
        err_line("check-trace: before lex_source")
    }
    var stream = lex_source(merged_hold)
    if stream == 0 {
        err_line("lexer error")
        return 1
    }
    if loader_check_trace() == 1 {
        err_line("check-trace: before parse_source")
    }
    var pr = parse_source(merged_hold, stream, 0)
    if int_vec_get(pr, 1) != 0 {
        err_line("check: parse failed")
        return 1
    }
    if loader_check_trace() == 1 {
        err_line("check-trace: before sema_check_file")
    }
    var ast = int_vec_get(pr, 0)
    if sema_check_file(merged_hold, stream, ast) != 0 {
        return 1
    }
    return 0
}

func cmd_build(): int {
    var path = pick_build_path()
    if str_len(path) == 0 {
        err_line("build: missing output path (e.g. diva build compiler)")
        return 1
    }
    if build_wants_ast() == 1 {
        if path_is_package_dir(path) == 1 {
            err_line("build --ast: use a single .diva file")
            return 1
        }
        if path_is_diva_file(path) == 0 {
            err_line("build --ast: expected a .diva file")
            return 1
        }
        return cmd_build_ast(path)
    }
    return native_build_path(path, 0)
}

// Shared by `build` and `watch`. quiet=1 suppresses the success line (watch prints its own).
func native_build_path(path: str, quiet: int): int {
    var merged = ""
    if build_path_is_package_dir(path) == 1 {
        merged = merge_package_sources(path)
        var merged_hold = merged
        var merged_len = str_len(merged_hold)
        if merged_len == 0 {
            err_line("build: could not merge package sources (see loader messages above)")
            return 1
        }
    } else {
        if path_is_diva_file(path) == 0 {
            err_line("build: expected a .diva file or a package directory containing package.diva")
            return 1
        }
        merged = merge_file_sources(path)
        var merged_try = merged
        var merged_try_len = str_len(merged_try)
        if merged_try_len == 0 {
            merged = read_source(path)
        }
    }
    var merged_out = merged
    var merged_out_hold = merged_out
    var merged_final_len = str_len(merged_out_hold)
    if merged_final_len == 0 {
        return 1
    }
    if native_driver_should_delegate(merged_out_hold) == 1 {
        err_line("build: native driver cannot handle this source surface yet")
        return 1
    }
    var exe_out = pick_build_out_path()
    if native_compile_and_link(merged_out_hold, quiet, exe_out) != 0 {
        return 1
    }
    if build_wants_g() == 1 {
        var dbg_src = dwarf_debug_src_path(path)
        if native_embed_dwarf(exe_out, dbg_src) != 0 {
            if quiet == 0 {
                err_line("build -g: embed-dwarf-debug.py failed (need python3 + scripts/embed-dwarf-debug.py)")
            }
            return 1
        }
        if quiet == 0 {
            err_line("[native] DWARF -g sections embedded (addr2line)")
        }
    }
    if quiet == 0 {
        if build_path_is_package_dir(path) == 1 {
            if package_is_kernel_dir(path) == 1 {
                var kmsg = str_concat("[native] built kernel ELF (kmain entry) at ", exe_out)
                print_str(kmsg)
                stdout(newline_str())
                return 0
            }
        }
        var built_msg = str_concat("[native] built executable at ", exe_out)
        print_str(built_msg)
        stdout(newline_str())
    }
    return 0
}

func watch_file_fp(path: str): int {
    var sz = file_size(path)
    if sz < 0 {
        return 0 - 1
    }
    var s = read_file(path)
    var h = sz + 1
    var i = 0
    var n = str_len(s)
    while (i < n) {
        h = h * 131 + str_byte(s, i)
        i = i + 1
    }
    return h
}

func watch_make_snapshot(files: str): str {
    var nl = newline_str()
    var b = str_builder_new()
    var pos = 0
    var n = str_len(files)
    while (pos < n) {
        var le = pos
        while (le < n & str_byte(files, le) != 10) {
            le = le + 1
        }
        var p = str_slice(files, pos, le - pos)
        pos = le + 1
        if str_len(p) > 0 {
            str_builder_append(b, p)
            str_builder_append(b, "|")
            str_builder_append(b, int_to_str(watch_file_fp(p)))
            str_builder_append(b, nl)
        }
    }
    var out = str_builder_to_str(b)
    str_builder_free(b)
    return out
}

func watch_count_lines(s: str): int {
    var n = str_len(s)
    var c = 0
    var i = 0
    while (i < n) {
        if str_byte(s, i) == 10 {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

func watch_poll_sleep(): int {
    host_system("sleep 1")
    return 0
}

func watch_max_iters(): int {
    var v = host_getenv("DIVA_WATCH_MAX_ITERS")
    var v_hold = v
    if str_len(v_hold) == 0 {
        return 0
    }
    return str_to_int(v_hold)
}

func cmd_watch(): int {
    if host_argc() < 3 {
        err_line("usage: diva watch <file.diva|package-dir>")
        return 1
    }
    var path = host_argv(2)
    var path_h = path
    if build_path_is_package_dir(path_h) == 0 {
        if path_is_diva_file(path_h) == 0 {
            err_line("watch: expected a .diva file or a package directory")
            return 1
        }
    }
    var files = collect_watch_files(path_h)
    var files_h = files
    if str_len(files_h) == 0 {
        err_line("watch: could not resolve dependency files (see loader messages above)")
        return 1
    }
    var nfiles = watch_count_lines(files_h)
    err_line(str_concat("[watch] watching ", str_concat(int_to_str(nfiles), " files (poll 1s; DIVA_WATCH_MAX_ITERS to exit)")))
    err_line("[watch] building...")
    if native_build_path(path_h, 1) != 0 {
        err_line("[watch] build failed (continuing)")
    } else {
        err_line(str_concat("[watch] ok -> ", pick_build_out_path()))
    }
    var snap = watch_make_snapshot(files_h)
    var iters = 0
    var max_i = watch_max_iters()
    while (1 == 1) {
        if max_i > 0 {
            if iters >= max_i {
                err_line("[watch] max iters reached; exiting")
                return 0
            }
        }
        watch_poll_sleep()
        iters = iters + 1
        files = collect_watch_files(path_h)
        files_h = files
        if str_len(files_h) == 0 {
            err_line("[watch] dependency resolve failed (continuing)")
        } else {
            var snap2 = watch_make_snapshot(files_h)
            if str_eq(snap, snap2) == 0 {
                err_line("[watch] change detected; debouncing...")
                watch_poll_sleep()
                files = collect_watch_files(path_h)
                files_h = files
                snap2 = watch_make_snapshot(files_h)
                err_line("[watch] rebuilding...")
                if native_build_path(path_h, 1) != 0 {
                    err_line("[watch] build failed (continuing)")
                } else {
                    err_line(str_concat("[watch] ok -> ", pick_build_out_path()))
                }
                snap = snap2
            }
        }
    }
    return 0
}

func cmd_run_file(path: str): int {
    var merged = ""
    if build_path_is_package_dir(path) == 1 {
        merged = merge_package_sources(path)
        var merged_hold = merged
        var merged_len = str_len(merged_hold)
        if merged_len == 0 {
            err_line("run: could not merge package sources (see loader messages above)")
            return 1
        }
    } else {
        if path_is_diva_file(path) == 0 {
            err_line("run: expected a .diva file or a package directory")
            return 1
        }
        // Use merged source to handle imports
        merged = merge_file_sources(path)
        var merged_try = merged
        var merged_try_len = str_len(merged_try)
        if merged_try_len == 0 {
            merged = read_source(path)
        }
    }
    var merged_out = merged
    var merged_out_hold = merged_out
    var merged_final_len = str_len(merged_out_hold)
    if merged_final_len == 0 {
        return 1
    }
    if native_driver_should_delegate(merged_out_hold) == 1 {
        err_line("run: native driver cannot handle this source surface yet")
        return 1
    }
    var exe_out = native_default_exe_out()
    if native_compile_and_link(merged_out_hold, 0, exe_out) != 0 {
        return 1
    }
    var rc = host_system(exe_out)
    return system_exit_code(rc)
}

func main(): int {
    if (host_argc() < 2) {
        return cmd_print_usage()
    }
    var a1 = host_argv(1)

    if str_eq(a1, "check") == 1 {
        return cmd_check()
    }

    if str_eq(a1, "new") == 1 {
        return cmd_new()
    }

    if str_eq(a1, "lex") == 1 {
        if (host_argc() < 3) {
            err_line("usage: diva lex <file.diva>")
            return 1
        }
        return cmd_lex(host_argv(2))
    }

    if str_eq(a1, "parse") == 1 {
        if (host_argc() < 3) {
            err_line("usage: diva parse <file.diva>")
            return 1
        }
        return cmd_parse(host_argv(2))
    }

    if str_eq(a1, "ir") == 1 {
        if (host_argc() < 3) {
            err_line("usage: diva ir <file.diva>")
            return 1
        }
        return cmd_ir(host_argv(2))
    }

    if str_eq(a1, "asm") == 1 {
        if (host_argc() < 3) {
            err_line("usage: diva asm <file.diva>")
            return 1
        }
        return cmd_asm(host_argv(2))
    }

    if str_eq(a1, "emit-ir") == 1 {
        if (host_argc() < 3) {
            err_line("usage: diva emit-ir <file.diva|package-dir>")
            return 1
        }
        var p = host_argv(2)
        return cmd_emit_ir(p)
    }

    if str_eq(a1, "build") == 1 {
        return cmd_build()
    }

    if str_eq(a1, "watch") == 1 {
        return cmd_watch()
    }

    if str_eq(a1, "run") == 1 {
        if (host_argc() < 3) {
            err_line("usage: diva run <file.diva|package-dir>")
            return 1
        }
        return cmd_run_file(host_argv(2))
    }

    if str_eq(a1, "compiler-version") == 1 {
        print_str("diva compiler v0.5.0")
        print_str("  native: lex, parse, sema, Diva IR, x86_64 binary (ELF PIE)")
        print_str("  build/run: in-process x86_64 ELF PIE (no external linker)")
        return 0
    }

    if str_eq(a1, "pipeline") == 1 {
        print_str("Diva compiler pipeline:")
        print_str("  source -> lexer -> parser -> AST -> sema -> IR -> x86_64 binary -> ELF PIE")
        return 0
    }

    err_line("unknown command; try: diva (no args shows usage)")
    return 1
}

