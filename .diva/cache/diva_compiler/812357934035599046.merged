    return n
}

// Class: [kind, name_tok, members_handle, type_params_handle]
func ast_class(name_tok: int, members: int): int {
    return ast_class_generic(name_tok, int_vec_new(), members)
}

func ast_class_generic(name_tok: int, type_params: int, members: int): int {
    var n = int_vec_new()
    int_vec_push(n, nd_class())
    int_vec_push(n, name_tok)
    int_vec_push(n, members)
    int_vec_push(n, type_params)
    return n
