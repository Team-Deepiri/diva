func ast_class_type_params(node: int): int {
    if int_vec_len(node) < 4 {
        return int_vec_new()
    }
    return ast_child(node, 3)
}

// Trait: [kind, name_tok, methods_handle (int_vec of nd_func, body may be empty)]
func ast_trait(name_tok: int, methods: int): int {
    var n = int_vec_new()
    int_vec_push(n, nd_trait())
    int_vec_push(n, name_tok)
    int_vec_push(n, methods)
