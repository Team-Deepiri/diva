import "std/vec.diva"
import "std/math.diva"

func binary_search(handle: int, target: int): int {
    var lo = 0
    var hi = int_vec_len(handle) - 1
    while lo <= hi {
        var mid = lo + (hi - lo) / 2
        var val = int_vec_get(handle, mid)
        if val == target {
            return mid
        }
        if val < target {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return 0 - 1
}

func lower_bound(handle: int, target: int): int {
    var lo = 0
    var hi = int_vec_len(handle)
    while lo < hi {
        var mid = lo + (hi - lo) / 2
        if int_vec_get(handle, mid) < target {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

func upper_bound(handle: int, target: int): int {
    var lo = 0
    var hi = int_vec_len(handle)
    while lo < hi {
        var mid = lo + (hi - lo) / 2
        if int_vec_get(handle, mid) <= target {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

func vec_unique(handle: int): int {
    var n = int_vec_len(handle)
    var result = int_vec_new()
    var i = 0
    while i < n {
        var val = int_vec_get(handle, i)
        var found = 0
        var j = 0
        while j < int_vec_len(result) {
            if int_vec_get(result, j) == val {
                found = 1
                j = int_vec_len(result)
            }
            j = j + 1
        }
        if found == 0 {
            int_vec_push(result, val)
        }
        i = i + 1
    }
    return result
}

func vec_flatten(handles: int): int {
    var n = int_vec_len(handles)
    var result = int_vec_new()
    var i = 0
    while i < n {
        var inner = int_vec_get(handles, i)
        var m = int_vec_len(inner)
        var j = 0
        while j < m {
            int_vec_push(result, int_vec_get(inner, j))
            j = j + 1
        }
        i = i + 1
    }
    return result
}

func vec_zip(a: int, b: int): int {
    var na = int_vec_len(a)
    var nb = int_vec_len(b)
    var n = na
    if nb < n {
        n = nb
    }
    var result = int_vec_new()
    var i = 0
    while i < n {
        int_vec_push(result, int_vec_get(a, i))
        int_vec_push(result, int_vec_get(b, i))
        i = i + 1
    }
    return result
}

func vec_take(handle: int, count: int): int {
    var n = int_vec_len(handle)
    if count > n {
        count = n
    }
    var result = int_vec_new()
    var i = 0
    while i < count {
        int_vec_push(result, int_vec_get(handle, i))
        i = i + 1
    }
    return result
}

func vec_drop(handle: int, count: int): int {
    var n = int_vec_len(handle)
    if count > n {
        count = n
    }
    var result = int_vec_new()
    var i = count
    while i < n {
        int_vec_push(result, int_vec_get(handle, i))
        i = i + 1
    }
    return result
}

func vec_slice(handle: int, start: int, length: int): int {
    var n = int_vec_len(handle)
    var result = int_vec_new()
    var end = start + length
    if end > n {
        end = n
    }
    var i = start
    while i < end {
        int_vec_push(result, int_vec_get(handle, i))
        i = i + 1
    }
    return result
}

func vec_rotate_left(handle: int, k: int): int {
    var n = int_vec_len(handle)
    if n == 0 {
        return int_vec_new()
    }
    var shift = k - (k / n) * n
    var result = int_vec_new()
    var i = shift
    while i < n {
        int_vec_push(result, int_vec_get(handle, i))
        i = i + 1
    }
    i = 0
    while i < shift {
        int_vec_push(result, int_vec_get(handle, i))
        i = i + 1
    }
    return result
}

func vec_rotate_right(handle: int, k: int): int {
    var n = int_vec_len(handle)
    if n == 0 {
        return int_vec_new()
    }
    var shift = k - (k / n) * n
    return vec_rotate_left(handle, n - shift)
}

func vec_is_sorted(handle: int): int {
    var n = int_vec_len(handle)
    if n <= 1 {
        return 1
    }
    var i = 0
    while i < n - 1 {
        if int_vec_get(handle, i) > int_vec_get(handle, i + 1) {
            return 0
        }
        i = i + 1
    }
    return 1
}

func vec_all_equal(handle: int): int {
    var n = int_vec_len(handle)
    if n <= 1 {
        return 1
    }
    var first = int_vec_get(handle, 0)
    var i = 1
    while i < n {
        if int_vec_get(handle, i) != first {
            return 0
        }
        i = i + 1
    }
    return 1
}

func vec_product(handle: int): int {
    var n = int_vec_len(handle)
    if n == 0 {
        return 0
    }
    var prod = 1
    var i = 0
    while i < n {
        prod = prod * int_vec_get(handle, i)
        i = i + 1
    }
    return prod
}

func vec_avg(handle: int): int {
    var n = int_vec_len(handle)
    if n == 0 {
        return 0
    }
    var total = 0
    var i = 0
    while i < n {
        total = total + int_vec_get(handle, i)
        i = i + 1
    }
    return total / n
}

func fibonacci(n: int): int {
    if n <= 0 {
        return 0
    }
    if n == 1 {
        return 1
    }
    var a = 0
    var b = 1
    var i = 2
    while i <= n {
        var tmp = a + b
        a = b
        b = tmp
        i = i + 1
    }
    return b
}

func factorial(n: int): int {
    if n <= 1 {
        return 1
    }
    var result = 1
    var i = 2
    while i <= n {
        result = result * i
        i = i + 1
    }
    return result
}

func pow_int(base: int, exp: int): int {
    if exp <= 0 {
        return 1
    }
    var result = 1
    var i = 0
    while i < exp {
        result = result * base
        i = i + 1
    }
    return result
}

func is_prime(n: int): int {
    if n < 2 {
        return 0
    }
    if n == 2 {
        return 1
    }
    if n - (n / 2) * 2 == 0 {
        return 0
    }
    var d = 3
    while d * d <= n {
        if n - (n / d) * d == 0 {
            return 0
        }
        d = d + 2
    }
    return 1
}

func next_prime(n: int): int {
    var candidate = n + 1
    while is_prime(candidate) == 0 {
        candidate = candidate + 1
    }
    return candidate
}
