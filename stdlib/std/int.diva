func sign(x: int): int {
    if (x < 0) {
        return 0 - 1
    }
    if (x > 0) {
        return 1
    }
    return 0
}

func is_even(x: int): bool {
    return (x / 2) * 2 == x
}

func is_odd(x: int): bool {
    return !is_even(x)
}

func gcd(a: int, b: int): int {
    var left = a
    var right = b

    if (left < 0) {
        left = 0 - left
    }
    if (right < 0) {
        right = 0 - right
    }

    while right != 0 {
        var quotient = left / right
        var remainder = left - quotient * right
        left = right
        right = remainder
    }

    return left
}
