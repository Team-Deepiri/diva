import "std/host.diva"
import "std/vec.diva"

func str_hash(s: str): int {
    var h = 5381
    var n = str_len(s)
    var i = 0
    while (i < n) {
        h = h * 33 + str_byte(s, i)
        i = i + 1
    }
    if (h < 0) {
        h = 0 - h
    }
    return h
}

func int_hash(x: int): int {
    var v = x
    if (v < 0) {
        v = 0 - v
    }
    v = v * 2654435761
    if (v < 0) {
        v = 0 - v
    }
    return v
}

func vec_fill(handle: int, count: int, value: int): int {
    var i = 0
    while (i < count) {
        int_vec_push(handle, value)
        i = i + 1
    }
    return count
}

func vec_set_at(handle: int, index: int, value: int): int {
    var n = int_vec_len(handle)
    var tmp = int_vec_new()
    if tmp == 0 {
        return 0 - 1
    }
    var i = 0
    while (i < n) {
        if i == index {
            int_vec_push(tmp, value)
        } else {
            int_vec_push(tmp, int_vec_get(handle, i))
        }
        i = i + 1
    }
    return tmp
}

func vec_copy(src: int): int {
    var dst = int_vec_new()
    if dst == 0 {
        return 0
    }
    var n = int_vec_len(src)
    var i = 0
    while (i < n) {
        int_vec_push(dst, int_vec_get(src, i))
        i = i + 1
    }
    return dst
}

func vec_from_range(start: int, end: int): int {
    var v = int_vec_new()
    if v == 0 {
        return 0
    }
    var i = start
    while (i < end) {
        int_vec_push(v, i)
        i = i + 1
    }
    return v
}

func vec_map_add(handle: int, addend: int): int {
    var result = int_vec_new()
    if result == 0 {
        return 0
    }
    var n = int_vec_len(handle)
    var i = 0
    while (i < n) {
        int_vec_push(result, int_vec_get(handle, i) + addend)
        i = i + 1
    }
    return result
}

func vec_map_mul(handle: int, factor: int): int {
    var result = int_vec_new()
    if result == 0 {
        return 0
    }
    var n = int_vec_len(handle)
    var i = 0
    while (i < n) {
        int_vec_push(result, int_vec_get(handle, i) * factor)
        i = i + 1
    }
    return result
}

func vec_filter_gt(handle: int, threshold: int): int {
    var result = int_vec_new()
    if result == 0 {
        return 0
    }
    var n = int_vec_len(handle)
    var i = 0
    while (i < n) {
        var v = int_vec_get(handle, i)
        if (v > threshold) {
            int_vec_push(result, v)
        }
        i = i + 1
    }
    return result
}

func vec_filter_lt(handle: int, threshold: int): int {
    var result = int_vec_new()
    if result == 0 {
        return 0
    }
    var n = int_vec_len(handle)
    var i = 0
    while (i < n) {
        var v = int_vec_get(handle, i)
        if (v < threshold) {
            int_vec_push(result, v)
        }
        i = i + 1
    }
    return result
}
