// Native `text` value type — the `(data_ptr, len, cap)` fat pointer.
//
// `text` is a compiler-known type (IR ty 5). Its value is the address of an
// 24-byte descriptor `[data_ptr, len, cap]`. Literals (`text"..."`) are stored in
// the RX segment right before their bytes, so O(1) length and interior-NUL
// safety hold. `str` remains the NUL-terminated C pointer for hosted I/O;
// the bridge (text_from_str / str_from_text) converts between the two.
//
// Pure-ELF (native) driver only in Phase 1 — see docs/text-native-direction.md.
// These externs are supported in the pure ELF path (native_require_no_externs).
import "std/host.diva"

extern func text_from_str(s: str): text
extern func str_from_text(t: text): str
extern func text_len(t: text): int
extern func text_byte(t: text, index: int): int
extern func text_cmp(a: text, b: text): int
extern func text_concat(a: text, b: text): text
extern func text_slice(t: text, start: int, len: int): text

func text_is_empty(t: text): bool {
    if text_len(t) == 0 { return true }
    return false
}

// str bridge composition (#153): text from a decimal integer's string form.
func text_from_int(n: int): text {
    return text_from_str(int_to_str(n))
}

// str bridge composition (#153): parse a leading decimal integer from text.
func int_from_text(t: text): int {
    var n = text_len(t)
    var i = 0
    var neg = 0
    var acc = 0
    if n > 0 {
        if text_byte(t, 0) == 45 { neg = 1 i = 1 }
    }
    while i < n {
        var c = text_byte(t, i)
        if (c >= 48) & (c <= 57) {
            acc = acc * 10 + (c - 48)
        }
        i = i + 1
    }
    if neg == 1 { return 0 - acc }
    return acc
}