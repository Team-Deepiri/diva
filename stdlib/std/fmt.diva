import "std/host.diva"
import "std/io.diva"
import "std/vec.diva"

// Issue #127: integer-to-decimal wrapper around the host builtin.
func itoa(n: int): str {
    return int_to_str(n)
}

func concat(a: str, b: str): str {
    var out = str_builder_new()
    if out == 0 {
        return ""
    }
    str_builder_append(out, a)
    str_builder_append(out, b)
    var result = str_builder_to_str(out)
    str_builder_free(out)
    return result
}

// Replace every "{}" placeholder in template with value. No format specs,
// escaping, or positional arguments: use concat for multi-value assembly.
func format(template: str, value: str): str {
    var out = str_builder_new()
    if out == 0 {
        return ""
    }
    var n = str_len(template)
    var i = 0
    while (i < n) {
        if (str_byte(template, i) == 123) & (i + 1 < n) & (str_byte(template, i + 1) == 125) {
            str_builder_append(out, value)
            i = i + 2
        } else {
            str_builder_append(out, str_slice(template, i, 1))
            i = i + 1
        }
    }
    var result = str_builder_to_str(out)
    str_builder_free(out)
    return result
}

func println(text: str): int {
    var b = str_builder_new()
    if b == 0 {
        return 0 - 1
    }
    str_builder_append(b, text)
    str_builder_append(b, "\n")
    var line = str_builder_to_str(b)
    str_builder_free(b)
    return stdout(line)
}

func eprintln(text: str): int {
    var b = str_builder_new()
    if b == 0 {
        return 0 - 1
    }
    str_builder_append(b, text)
    str_builder_append(b, "\n")
    var line = str_builder_to_str(b)
    str_builder_free(b)
    return stderr(line)
}

func fmt_int(label: str, value: int): str {
    var b = str_builder_new()
    if b == 0 {
        return ""
    }
    str_builder_append(b, label)
    str_builder_append(b, int_to_str(value))
    var result = str_builder_to_str(b)
    str_builder_free(b)
    return result
}

func fmt_str(label: str, value: str): str {
    var b = str_builder_new()
    if b == 0 {
        return ""
    }
    str_builder_append(b, label)
    str_builder_append(b, value)
    var result = str_builder_to_str(b)
    str_builder_free(b)
    return result
}

func fmt_bool(label: str, value: bool): str {
    var b = str_builder_new()
    if b == 0 {
        return ""
    }
    str_builder_append(b, label)
    if (value) {
        str_builder_append(b, "true")
    } else {
        str_builder_append(b, "false")
    }
    var result = str_builder_to_str(b)
    str_builder_free(b)
    return result
}

func join(parts: int, sep: str): str {
    var b = str_builder_new()
    if b == 0 {
        return ""
    }
    var n = int_vec_len(parts)
    var i = 0
    while (i < n) {
        if (i > 0) {
            str_builder_append(b, sep)
        }
        str_builder_append(b, int_to_str(int_vec_get(parts, i)))
        i = i + 1
    }
    var result = str_builder_to_str(b)
    str_builder_free(b)
    return result
}

func pad_left(s: str, width: int, fill: str): str {
    var slen = str_len(s)
    if (width <= slen) {
        return s
    }
    var b = str_builder_new()
    if b == 0 {
        return s
    }
    var i = 0
    while (i < width - slen) {
        str_builder_append(b, fill)
        i = i + 1
    }
    str_builder_append(b, s)
    var result = str_builder_to_str(b)
    str_builder_free(b)
    return result
}

func pad_right(s: str, width: int, fill: str): str {
    var slen = str_len(s)
    if (width <= slen) {
        return s
    }
    var b = str_builder_new()
    if b == 0 {
        return s
    }
    str_builder_append(b, s)
    var i = 0
    while (i < width - slen) {
        str_builder_append(b, fill)
        i = i + 1
    }
    var result = str_builder_to_str(b)
    str_builder_free(b)
    return result
}
