func all(left: bool, right: bool): bool {
    if left {
        if right {
            return true
        }
    }
    return false
}

func any(left: bool, right: bool): bool {
    if left {
        return true
    }
    if right {
        return true
    }
    return false
}

func bool_to_int(value: bool): int {
    if value {
        return 1
    }
    return 0
}
