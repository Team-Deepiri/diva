// valid_symbols — top-level declarations for documentSymbol tests.
import "std/io.diva"
import "std/json.diva"
func alpha(): void {
    print_str("alpha\n")
}

func count_to(n: int): void {
    var i = 0
    while i < n {
        i = i + 1
    }
}

class Counter {
    var value: int

    func bump(amount: int): int {
        self.value = self.value + amount
        return self.value
    }
}

struct Point {
    x: int
    y: int
}

trait Shape {
    func measure(): int
}
