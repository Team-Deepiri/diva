{
  "name": "diri-lang",
  "displayName": "Di Language",
  "description": "Language support for Di (.di) files.",
  "version": "0.0.1",
  "publisher": "deepiri",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:di"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "di",
        "aliases": ["Di", "di", "Di", "di"],
        "extensions": [".di"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "di",
        "scopeName": "source.di",
        "path": "./syntaxes/diri.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "di",
        "path": "./snippets/diri.json"
      }
    ]
  }
}
