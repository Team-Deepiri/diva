{
  "name": "diva-lang",
  "displayName": "Diva Language",
  "description": "Language support for Diva (.diva) files.",
  "version": "0.0.1",
  "publisher": "deepiri",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "icon.png",
  "contributes": {
    "languages": [
      {
        "id": "diva",
        "aliases": ["Diva", "diva"],
        "extensions": [".diva"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "diva",
        "scopeName": "source.diva",
        "path": "./syntaxes/diva.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "diva",
        "path": "./snippets/diva.json"
      }
    ]
  }
}
