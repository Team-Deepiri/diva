{
  "Main Function": {
    "prefix": "main",
    "body": [
      "func main(): int {",
      "    $0",
      "    return 0",
      "}"
    ],
    "description": "Create a Di main function"
  },
  "Extern Print Int": {
    "prefix": "printint",
    "body": [
      "extern func print_int(x: int): void"
    ],
    "description": "Declare print_int runtime function"
  },
  "Extern Print Str": {
    "prefix": "printstr",
    "body": [
      "extern func print_str(x: str): void"
    ],
    "description": "Declare print_str runtime function"
  },
  "Package": {
    "prefix": "package",
    "body": [
      "package ${1:name}"
    ],
    "description": "Declare a Di package"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "import \"${1:module.diva}\""
    ],
    "description": "Import another Di source file"
  },
  "Package Dependency Import": {
    "prefix": "pkgimport",
    "body": [
      "import \"pkg/${1:dependency_name}\""
    ],
    "description": "Import another Di package dependency"
  },
  "Manifest": {
    "prefix": "dimod",
    "body": [
      "name = \"${1:my_package}\"",
      "kind = \"${2:app}\"",
      "entry = \"${3:src/main.diva}\""
    ],
    "description": "Create a di.mod manifest"
  },
  "Manifest Dependency": {
    "prefix": "didep",
    "body": [
      "dep.${1:math_lib} = \"${2:../math_lib}\""
    ],
    "description": "Add a package dependency to di.mod"
  },
  "Std IO Import": {
    "prefix": "stdio",
    "body": [
      "import \"std/io.diva\""
    ],
    "description": "Import Di std io helpers"
  },
  "Std Math Import": {
    "prefix": "stdmath",
    "body": [
      "import \"std/math.diva\""
    ],
    "description": "Import Di std math helpers"
  },
  "Std Assert Import": {
    "prefix": "stdassert",
    "body": [
      "import \"std/assert.diva\""
    ],
    "description": "Import Di std assertion helpers"
  },
  "Function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:x}: ${3:int}): ${4:int} {",
      "    $0",
      "}"
    ],
    "description": "Create a Di function"
  },
  "Generic Function": {
    "prefix": "genfunc",
    "body": [
      "func ${1:name}[${2:T}](${3:value}: ${2:T}): ${2:T} {",
      "    return ${3:value}",
      "}"
    ],
    "description": "Create a Di generic function"
  },
  "Trait": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "    func ${2:method}(): ${3:int}",
      "}"
    ],
    "description": "Create a Di trait declaration"
  },
  "Impl": {
    "prefix": "impl",
    "body": [
      "impl ${1:Trait} for ${2:Type}"
    ],
    "description": "Create a Di trait implementation declaration"
  },
  "Kernel Entry": {
    "prefix": "kmain",
    "body": [
      "func kmain(): int {",
      "    $0",
      "    return 0",
      "}"
    ],
    "description": "Create a Di kernel entry function"
  },
  "If Else": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "    $2",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "Create a Di if/else block"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "Create a Di while loop"
  },
  "While Update Loop": {
    "prefix": "whileupdate",
    "body": [
      "while ${1:condition} => ${2:update} {",
      "    $0",
      "}"
    ],
    "description": "Create a Di while loop with update clause"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "    var ${2:x} :: ${3:int}",
      "    var ${4:y} :: ${5:int}",
      "}"
    ],
    "description": "Create a Di class declaration"
  },
  "Object Literal": {
    "prefix": "objectlit",
    "body": [
      "${1:Point} { ${2:x}: ${3:1}, ${4:y}: ${5:2} }"
    ],
    "description": "Create a Di object literal"
  },
  "Int Array": {
    "prefix": "intarray",
    "body": [
      "var ${1:values} :: int[] = [${2:1}, ${3:2}, ${4:3}]"
    ],
    "description": "Create a Di int array literal"
  },
  "Flux Loop": {
    "prefix": "flux",
    "body": [
      "flux ${1:value} in ${2:iterable} {",
      "    $0",
      "}"
    ],
    "description": "Create a Di flux loop"
  },
  "Starter File": {
    "prefix": "di",
    "body": [
      "extern func print_str(x: str): void",
      "extern func print_int(x: int): void",
      "",
      "func main(): int {",
      "    $0",
      "    return 0",
      "}"
    ],
    "description": "Create a Di starter file"
  }
}
