{
  "Main Function": {
    "prefix": "main",
    "body": [
      "func main(): int {",
      "    $0",
      "    return 0",
      "}"
    ],
    "description": "Create a Di main function"
  },
  "Extern Print Int": {
    "prefix": "printint",
    "body": [
      "extern func print_int(x: int): void"
    ],
    "description": "Declare print_int runtime function"
  },
  "Extern Print Str": {
    "prefix": "printstr",
    "body": [
      "extern func print_str(x: str): void"
    ],
    "description": "Declare print_str runtime function"
  },
  "Package": {
    "prefix": "package",
    "body": [
      "package ${1:name}"
    ],
    "description": "Declare a Di package"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "import \"${1:module.di}\""
    ],
    "description": "Import another Di source file"
  },
  "Function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:x}: ${3:int}): ${4:int} {",
      "    $0",
      "}"
    ],
    "description": "Create a Di function"
  },
  "If Else": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "    $2",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "Create a Di if/else block"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "Create a Di while loop"
  },
  "While Update Loop": {
    "prefix": "whileupdate",
    "body": [
      "while ${1:condition} => ${2:update} {",
      "    $0",
      "}"
    ],
    "description": "Create a Di while loop with update clause"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "    var ${2:x} :: ${3:int}",
      "    var ${4:y} :: ${5:int}",
      "}"
    ],
    "description": "Create a Di class declaration"
  },
  "Object Literal": {
    "prefix": "objectlit",
    "body": [
      "${1:Point} { ${2:x}: ${3:1}, ${4:y}: ${5:2} }"
    ],
    "description": "Create a Di object literal"
  },
  "Int Array": {
    "prefix": "intarray",
    "body": [
      "var ${1:values} :: int[] = [${2:1}, ${3:2}, ${4:3}]"
    ],
    "description": "Create a Di int array literal"
  },
  "Flux Loop": {
    "prefix": "flux",
    "body": [
      "flux ${1:value} in ${2:iterable} {",
      "    $0",
      "}"
    ],
    "description": "Create a Di flux loop"
  },
  "Starter File": {
    "prefix": "di",
    "body": [
      "extern func print_str(x: str): void",
      "extern func print_int(x: int): void",
      "",
      "func main(): int {",
      "    $0",
      "    return 0",
      "}"
    ],
    "description": "Create a Di starter file"
  }
}
