import "std/io.diva"
import "std/fmt.diva"
import "std/matrix.diva"

func print_matrix(label: str, m: int): int {
    println(label)
    var r = 0
    while r < matrix_rows(m) {
        var c = 0
        stdout("  ")
        while c < matrix_cols(m) {
            stdout(int_to_str(matrix_get(m, r, c)))
            stdout(" ")
            c = c + 1
        }
        stdout("\n")
        r = r + 1
    }
    return 0
}

func main(): int {
    var a = matrix_new(2, 3)
    a = matrix_set(a, 0, 0, 1)
    a = matrix_set(a, 0, 1, 2)
    a = matrix_set(a, 0, 2, 3)
    a = matrix_set(a, 1, 0, 4)
    a = matrix_set(a, 1, 1, 5)
    a = matrix_set(a, 1, 2, 6)
    print_matrix("matrix A (2x3):", a)

    var t = matrix_transpose(a)
    print_matrix("transpose (3x2):", t)

    var id = matrix_identity(3)
    print_matrix("identity 3x3:", id)
    println(fmt_int("trace: ", matrix_trace(id)))

    var scaled = matrix_scale(a, 10)
    print_matrix("A * 10:", scaled)

    matrix_free(a)
    matrix_free(t)
    matrix_free(id)
    matrix_free(scaled)
    return 0
}
